+++ b/docs/versioning/header.css
@@ -0,0 +1,89 @@
+/* Shared header treatment for Material release snapshots and Zensical Current. */
+@media screen and (min-width: 60em) {
+    .md-version {
+        position: relative;
+        height: 2.4rem;
+        margin-left: 0.4rem;
+    }
+
+    .md-version__current {
+        box-sizing: border-box;
+        min-width: 5.25rem;
+        height: 1.8rem;
+        margin: 0.3rem 0;
+        padding: 0 0.65rem;
+        border: 1px solid var(--md-accent-fg-color);
+        border-radius: 0.2rem;
+        color: inherit;
+        font-weight: 600;
+    }
+
+    .md-version__list {
+        top: calc(100% - 0.3rem);
+        right: auto;
+        left: 1.4rem;
+        width: 9.5rem;
+        max-height: 19rem;
+        margin-right: 0;
+        margin-left: 0;
+        padding: 0;
+        overflow-y: auto;
+        border: 1px solid var(--md-default-fg-color--lightest);
+        border-radius: 0.2rem;
+        background: var(--md-default-bg-color);
+        box-shadow: var(--md-shadow-z2);
+        scrollbar-width: thin;
+    }
+
+    .md-version:is(:focus-within, :hover) .md-version__list {
+        max-height: 19rem;
+    }
+
+    .md-version__item {
+        margin: 0;
+        border-bottom: 1px solid var(--md-default-fg-color--lightest);
+    }
+
+    .md-version__item:last-child {
+        border-bottom: 0;
+    }
+
+    .md-version__link {
+        display: flex;
+        align-items: center;
+        min-height: 2.05rem;
+        padding: 0.45rem 0.7rem;
+        color: var(--md-default-fg-color);
+        font-size: 0.7rem;
+        line-height: 1.1;
+        white-space: nowrap;
+    }
+
+    .md-version__link:is(:focus, :hover) {
+        background: var(--md-default-fg-color--lightest);
+        color: var(--md-accent-fg-color);
+    }
+
+    /* Minor aliases remain redirects, but patches are the selectable versions. */
+    .md-version__alias {
+        display: none;
+    }
+
+    /* Match the wider search field used by the historical Material header. */
+    .md-search {
+        width: 13rem;
+        height: 2.4rem;
+    }
+
+    .md-search__button {
+        width: 100%;
+        height: 1.8rem;
+        padding-right: 0.6rem;
+        border-radius: 0.1rem;
+        background: var(--md-default-fg-color--lightest);
+    }
+
+    .md-search__button::after {
+        display: none;
+    }
+}
