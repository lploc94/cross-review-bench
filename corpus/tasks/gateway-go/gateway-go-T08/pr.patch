diff --git a/internal/config/quota_zone_test.go b/internal/config/quota_zone_test.go
new file mode 100644
index 0000000..9a4effe
--- /dev/null
+++ b/internal/config/quota_zone_test.go
@@ -0,0 +1,24 @@
+package config
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestQuotaTimeZone(t *testing.T) {
+	cfg, err := LoadFrom(lookupFrom(validEnv()))
+	if err != nil || cfg.QuotaZone != time.UTC {
+		t.Fatalf("default zone: %v, %v", cfg.QuotaZone, err)
+	}
+	env := validEnv()
+	env["QUOTA_TIME_ZONE"] = "Asia/Tokyo"
+	cfg, err = LoadFrom(lookupFrom(env))
+	if err != nil || cfg.QuotaZone.String() != "Asia/Tokyo" {
+		t.Fatalf("Asia/Tokyo: %v, %v", cfg.QuotaZone, err)
+	}
+	env["QUOTA_TIME_ZONE"] = "Mars/Olympus"
+	if _, err := LoadFrom(lookupFrom(env)); err == nil || !strings.Contains(err.Error(), "QUOTA_TIME_ZONE") {
+		t.Errorf("unknown zone: %v", err)
+	}
+}
