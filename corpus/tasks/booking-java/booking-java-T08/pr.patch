diff --git a/src/main/resources/db/migration/V2__allotments.sql b/src/main/resources/db/migration/V2__allotments.sql
new file mode 100644
index 0000000..bbb33f4
--- /dev/null
+++ b/src/main/resources/db/migration/V2__allotments.sql
@@ -0,0 +1,12 @@
+CREATE TABLE allotment (
+    id           BIGSERIAL PRIMARY KEY,
+    room_type_id BIGINT      NOT NULL REFERENCES room_type (id),
+    channel      VARCHAR(32) NOT NULL,
+    night        DATE        NOT NULL,
+    rooms        INTEGER     NOT NULL CHECK (rooms >= 0),
+    release_on   DATE        NOT NULL,
+    version      BIGINT      NOT NULL DEFAULT 0,
+    UNIQUE (room_type_id, channel, night)
+);
+
+CREATE INDEX allotment_room_type_night ON allotment (room_type_id, night, release_on);
diff --git a/src/test/java/com/innkeep/booking/api/AllotmentApiTest.java b/src/test/java/com/innkeep/booking/api/AllotmentApiTest.java
new file mode 100644
index 0000000..8b70445
--- /dev/null
+++ b/src/test/java/com/innkeep/booking/api/AllotmentApiTest.java
@@ -0,0 +1,85 @@
+package com.innkeep.booking.api;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.innkeep.booking.domain.Property;
+import com.innkeep.booking.domain.RoomType;
+import com.innkeep.booking.support.IntegrationTestBase;
+import java.time.LocalDate;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.ResultActions;
+
+class AllotmentApiTest extends IntegrationTestBase {
+
+  private static final String BODY =
+      """
+      {"from": "2027-06-01", "to": "2027-06-03", "rooms": 2, "releaseDays": 14}""";
+
+  @BeforeEach
+  void setUp() {
+    Property property = data.harbourHouse();
+    RoomType room = data.roomType(property, "double", 2, "100.00");
+    data.rooms(property, room, LocalDate.parse("2027-06-01"), LocalDate.parse("2027-06-03"), 4);
+  }
+
+  private ResultActions putAllotment(String channel, String body) throws Exception {
+    return mvc.perform(
+        put("/api/v1/admin/properties/harbour-house/room-types/double/allotments/" + channel)
+            .header("Authorization", ADMIN_AUTH)
+            .contentType(MediaType.APPLICATION_JSON)
+            .content(body));
+  }
+
+  @Test
+  void anAllotmentIsKeptPerNightWithItsReleaseDay() throws Exception {
+    putAllotment("atlas-travel", BODY).andExpect(status().isNoContent());
+
+    assertThat(
+            jdbc.queryForList(
+                "select channel || ' ' || night || ' ' || rooms || ' ' || release_on"
+                    + " from allotment order by night",
+                String.class))
+        .containsExactly(
+            "atlas-travel 2027-06-01 2 2027-05-18", "atlas-travel 2027-06-02 2 2027-05-19");
+  }
+
+  @Test
+  void aBadChannelMoreRoomsThanTheTotalOrANightWithoutInventoryIsRefused() throws Exception {
+    putAllotment("Atlas Travel", BODY).andExpect(status().isBadRequest());
+    putAllotment("atlas-travel", BODY.replace("\"rooms\": 2", "\"rooms\": 5"))
+        .andExpect(status().isConflict());
+    putAllotment("atlas-travel", BODY.replace("2027-06-03", "2027-06-04"))
+        .andExpect(status().isConflict());
+    assertThat(jdbc.queryForObject("select count(*) from allotment", Integer.class)).isZero();
+  }
+
+  @Test
+  void onlyTheChannelRouteCanHoldKeptRooms() throws Exception {
+    putAllotment("atlas-travel", BODY.replace("\"rooms\": 2", "\"rooms\": 4"))
+        .andExpect(status().isNoContent());
+    String hold =
+        """
+        {"stay": {"roomType": "double", "checkIn": "2027-06-01", "checkOut": "2027-06-03",
+                  "rooms": 1, "guests": 2},
+         "guest": {"name": "Ilse Varga", "email": "guest@example.com", "phone": "+351 000"}}""";
+
+    mvc.perform(
+            post("/api/v1/properties/harbour-house/holds")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content(hold))
+        .andExpect(status().isConflict());
+    mvc.perform(
+            post("/api/v1/admin/properties/harbour-house/channels/atlas-travel/holds")
+                .header("Authorization", ADMIN_AUTH)
+                .contentType(MediaType.APPLICATION_JSON)
+                .content(hold))
+        .andExpect(status().isCreated())
+        .andExpect(jsonPath("$.rooms").value(1));
+  }
+}
