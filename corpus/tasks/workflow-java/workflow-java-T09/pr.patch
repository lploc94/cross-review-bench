@@ -0,0 +1,155 @@
+package com.papertrail.workflow.api;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.papertrail.workflow.domain.StepKind;
+import com.papertrail.workflow.service.DocumentService;
+import com.papertrail.workflow.support.IntegrationTestBase;
+import com.papertrail.workflow.support.TestData;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+
+class DocumentSearchApiTest extends IntegrationTestBase {
+
+  private static final String AUTH = "Authorization";
+
+  @Autowired private DocumentService documents;
+  @Autowired private ObjectMapper json;
+
+  private long owner;
+  private long approver;
+  private long stranger;
+
+  @BeforeEach
+  void setUp() {
+    owner = data.user("Ines Berg");
+    approver = data.user("Tomas Vale");
+    stranger = data.user("Omar Lind");
+    data.publish("Contract", TestData.step(1, StepKind.SINGLE, approver, null, 0, 480));
+  }
+
+  private long draft(String title) {
+    return data.draft(data.principal(owner), "Contract", title);
+  }
+
+  private JsonNode search(long caller, String query) throws Exception {
+    String body =
+        mvc.perform(
+                get("/api/v1/documents/search").param("q", query).header(AUTH, data.bearer(caller)))
+            .andExpect(status().isOk())
+            .andReturn()
+            .getResponse()
+            .getContentAsString();
+    return json.readTree(body);
+  }
+
+  private static List<String> titles(JsonNode page) {
+    List<String> titles = new ArrayList<>();
+    page.get("items").forEach(item -> titles.add(item.get("title").asText()));
+    return titles;
+  }
+
+  @Test
+  void matchesWholeWordsWithoutCaseAndRanksTheBestMatchFirst() throws Exception {
+    draft("Merger memo");
+    draft("Merger review: merger terms");
+    draft("Mergers and acquisitions");
+    draft("Lease renewal");
+
+    JsonNode page = search(owner, "MERGER");
+
+    assertThat(titles(page)).containsExactly("Merger review: merger terms", "Merger memo");
+    assertThat(page.get("total").asLong()).isEqualTo(2);
+    assertThat(page.get("nextCursor").isNull()).isTrue();
+  }
+
+  @Test
+  void phrasesAndExclusionsFollowWebSearchSyntax() throws Exception {
+    draft("Supplier contract renewal");
+    draft("Contract with supplier");
+    draft("Supplier contract draft");
+
+    assertThat(titles(search(owner, "\"supplier contract\" -draft")))
+        .containsExactly("Supplier contract renewal");
+    assertThat(titles(search(owner, "renewal or draft"))).hasSize(2);
+  }
+
+  @Test
+  void pagesCoverEveryMatchOnce() throws Exception {
+    for (int i = 0; i < 5; i++) {
+      draft("Budget line " + i);
+    }
+    var seen = new HashSet<String>();
+    String cursor = null;
+    int pages = 0;
+    do {
+      var request =
+          get("/api/v1/documents/search")
+              .param("q", "budget")
+              .param("size", "2")
+              .header(AUTH, data.bearer(owner));
+      if (cursor != null) {
+        request.param("cursor", cursor);
+      }
+      JsonNode page =
+          json.readTree(mvc.perform(request).andReturn().getResponse().getContentAsString());
+      titles(page).forEach(title -> assertThat(seen.add(title)).isTrue());
+      assertThat(page.get("total").asLong()).isEqualTo(5);
+      cursor = page.get("nextCursor").isNull() ? null : page.get("nextCursor").asText();
+      pages++;
+    } while (cursor != null);
+
+    assertThat(seen).hasSize(5);
+    assertThat(pages).isEqualTo(3);
+  }
+
+  @Test
+  void resultsFollowThePermissionRule() throws Exception {
+    long submitted = draft("Merger memo");
+    documents.submit(data.principal(owner), submitted);
+    draft("Merger draft notes");
+
+    assertThat(titles(search(approver, "merger"))).containsExactly("Merger memo");
+    assertThat(titles(search(stranger, "merger"))).isEmpty();
+    assertThat(titles(search(data.admin("Ops Admin"), "merger"))).hasSize(2);
+  }
+
+  @Test
+  void aQueryIsRequiredAndCursorsAreChecked() throws Exception {
+    mvc.perform(get("/api/v1/documents/search").header(AUTH, data.bearer(owner)))
+        .andExpect(status().isBadRequest())
+        .andExpect(jsonPath("$.type").value("urn:workflow:problem:invalid-request"));
+    mvc.perform(get("/api/v1/documents/search").param("q", "  ").header(AUTH, data.bearer(owner)))
+        .andExpect(status().isBadRequest());
+    mvc.perform(
+            get("/api/v1/documents/search")
+                .param("q", "x".repeat(201))
+                .header(AUTH, data.bearer(owner)))
+        .andExpect(status().isBadRequest());
+    mvc.perform(
+            get("/api/v1/documents/search")
+                .param("q", "merger")
+                .param("cursor", "next-page")
+                .header(AUTH, data.bearer(owner)))
+        .andExpect(status().isBadRequest())
+        .andExpect(jsonPath("$.type").value("urn:workflow:problem:invalid-request"));
+  }
+
+  @Test
+  void aTitleChangeIsSearchableAtOnce() throws Exception {
+    long id = draft("Quarterly figures");
+    documents.updateDraft(data.principal(owner), id, "Annual figures", "Invented body text");
+
+    assertThat(titles(search(owner, "annual"))).containsExactly("Annual figures");
+    assertThat(titles(search(owner, "quarterly"))).isEmpty();
+  }
+}
