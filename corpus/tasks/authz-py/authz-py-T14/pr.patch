diff --git a/src/authz/services/email_changes.py b/src/authz/services/email_changes.py
new file mode 100644
index 0000000..4ef8d41
--- /dev/null
+++ b/src/authz/services/email_changes.py
@@ -0,0 +1,149 @@
+"""Changing the address of one's own account, confirmed through a link sent to the new one."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import UTC, datetime, timedelta
+
+from authz.domain.emails import normalize_email
+from authz.domain.principal import Principal
+from authz.errors import (
+    ConflictError,
+    GoneError,
+    InvalidInputError,
+    NotFoundError,
+    PermissionDenied,
+    RateLimited,
+)
+from authz.infra.clock import Clock
+from authz.infra.db import Database
+from authz.infra.hashing import MAX_PASSWORD_LENGTH, PasswordHasher
+from authz.infra.mailer import EmailMessage, Mailer
+from authz.infra.randomness import RandomSource, hash_token
+from authz.infra.rate_limiter import RateLimiter, RateLimitRule
+from authz.logging import get_logger
+from authz.models import EmailChange, User
+from authz.repositories.users import EmailChangeRepository, UserRepository
+
+log = get_logger(__name__)
+
+
+@dataclass(frozen=True, slots=True)
+class EmailChangePolicy:
+    ttl: timedelta
+    link_base: str
+    request_rule: RateLimitRule
+
+
+def confirmation_email(to: str, link: str, expires_at: datetime) -> EmailMessage:
+    body = (
+        "Someone asked to use this address for their account.\n\n"
+        f"If it was you, open the link below while signed in to that account:\n{link}\n\n"
+        f"The link works once, until {expires_at.astimezone(UTC):%Y-%m-%d %H:%M} UTC. "
+        "If you did not ask for this, ignore this message; nothing changes."
+    )
+    return EmailMessage(
+        to=to, subject="Confirm your new email address", body=body, kind="email_change"
+    )
+
+
+def change_notice(to: str, new_address: str) -> EmailMessage:
+    body = (
+        f"Someone signed in to your account asked to change its email address to {new_address}.\n\n"
+        "Nothing changes until the link sent to that address is opened while signed in. If this "
+        "was not you, someone knows your password: contact your administrator."
+    )
+    return EmailMessage(
+        to=to, subject="Your email address is being changed", body=body, kind="email_change_notice"
+    )
+
+
+class EmailChangeService:
+    def __init__(
+        self,
+        *,
+        db: Database,
+        clock: Clock,
+        random: RandomSource,
+        hasher: PasswordHasher,
+        limiter: RateLimiter,
+        mailer: Mailer,
+        policy: EmailChangePolicy,
+    ) -> None:
+        self._db = db
+        self._clock = clock
+        self._random = random
+        self._hasher = hasher
+        self._limiter = limiter
+        self._mailer = mailer
+        self._policy = policy
+
+    async def request(self, principal: Principal, *, new_email: str, password: str) -> EmailChange:
+        """Email a confirmation link to the new address and a notice to the current one.
+
+        The answer does not depend on whether the new address already has an account; that is
+        only checked by confirm(), whose caller has proved they read that mailbox.
+        """
+        try:
+            address = normalize_email(new_email)
+        except InvalidInputError as exc:
+            raise InvalidInputError(exc.message, details={"field": "new_email"}) from exc
+        limit = await self._limiter.hit(self._policy.request_rule, str(principal.user_id))
+        if not limit.allowed:
+            raise RateLimited(limit.retry_after)
+        async with self._db.read() as session:
+            user = await UserRepository(session).get(principal.user_id)
+        if user is None:
+            raise NotFoundError("user")
+        if len(password) > MAX_PASSWORD_LENGTH or not await self._hasher.verify(
+            user.password_hash, password
+        ):
+            log.info("user.email_change_refused", reason="bad_password", user_id=str(user.id))
+            raise PermissionDenied("the password is incorrect", details={"field": "password"})
+
+        token = self._random.token()
+        now = self._clock.now()
+        async with self._db.transaction() as session:
+            # Requests and confirmations of one user take this lock first, so they run one at
+            # a time and a user never has more than one pending change.
+            current = await UserRepository(session).get(user.id, for_update=True)
+            if current is None:
+                raise NotFoundError("user")
+            if address == current.email:
+                raise InvalidInputError(
+                    "this is already the address of the account", details={"field": "new_email"}
+                )
+            changes = EmailChangeRepository(session)
+            await changes.discard_pending(current.id)
+            change = await changes.add(
+                user_id=current.id,
+                new_email=address,
+                token_hash=hash_token(token),
+                now=now,
+                expires_at=now + self._policy.ttl,
+            )
+        link = f"{self._policy.link_base}/account/email/confirm?token={token}"
+        await self._mailer.send(change_notice(current.email, address))
+        await self._mailer.send(confirmation_email(address, link, change.expires_at))
+        log.info("user.email_change_requested", user_id=str(user.id), change_id=str(change.id))
+        return change
+
+    async def confirm(self, principal: Principal, token: str) -> User:
+        """Move the account to the address of the link, if no other account has it by now."""
+        now = self._clock.now()
+        async with self._db.transaction() as session:
+            users = UserRepository(session)
+            user = await users.get(principal.user_id, for_update=True)
+            changes = EmailChangeRepository(session)
+            change = await changes.get_by_hash_for_update(hash_token(token))
+            # Someone else's link looks unknown, and is not spent.
+            if user is None or change is None or change.user_id != user.id:
+                raise NotFoundError("email change")
+            if change.used_at is not None:
+                raise ConflictError("the address change has already been confirmed")
+            if now >= change.expires_at:
+                raise GoneError("the confirmation link has expired")
+            await users.set_email(user, change.new_email, now)
+            await changes.mark_used(change, now)
+        log.info("user.email_changed", user_id=str(user.id), change_id=str(change.id))
+        return user
