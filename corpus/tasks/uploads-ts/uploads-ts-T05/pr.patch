+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { MAX_RETENTION_RULES } from "../../src/domain/retention.js";
+import { buildTestApp, type TestApp } from "../helpers/app.js";
+import {
+  createTenant,
+  expectStatus,
+  issueKey,
+  storeFile,
+  tenantUsage,
+  type ErrorResponse,
+  type TestTenant,
+} from "../helpers/fixtures.js";
+
+const DAY_S = 86_400;
+
+interface RuleBody {
+  prefix: string;
+  days: number;
+  createdAt: string;
+  updatedAt: string;
+}
+
+describe("retention rules", () => {
+  let t: TestApp;
+  let tenant: TestTenant;
+
+  beforeEach(async () => {
+    t = await buildTestApp({ env: { CLEANUP_BATCH_SIZE: "2" } });
+    tenant = await createTenant(t.pool, t.clock);
+  });
+
+  afterEach(async () => {
+    await t.close();
+  });
+
+  function putRule(prefix: string, days: unknown, who: TestTenant = tenant) {
+    return t.app.inject({ method: "PUT", url: `/v1/retention/${prefix}`, headers: who.headers, payload: { days } });
+  }
+
+  function deleteRule(prefix: string, who: TestTenant = tenant) {
+    return t.app.inject({ method: "DELETE", url: `/v1/retention/${prefix}`, headers: who.headers });
+  }
+
+  async function listRules(who: TestTenant = tenant): Promise<[string, number][]> {
+    const response = await t.app.inject({ url: "/v1/retention", headers: who.headers });
+    expectStatus(response, 200);
+    return response.json<{ data: RuleBody[] }>().data.map((rule) => [rule.prefix, rule.days]);
+  }
+
+  async function deletedPaths(): Promise<string[]> {
+    const result = await t.pool.query<{ path: string }>(
+      "SELECT path FROM files WHERE tenant_id = $1 AND status = 'deleted' ORDER BY path",
+      [tenant.tenantId],
+    );
+    return result.rows.map((row) => row.path);
+  }
+
+  it("creates, changes, lists and removes the caller's rules", async () => {
+    const created = await putRule("logs/2030/", 30);
+    expectStatus(created, 200);
+    expect(created.json<RuleBody>()).toEqual({
+      prefix: "logs/2030/",
+      days: 30,
+      createdAt: "2030-01-15T10:00:00.000Z",
+      updatedAt: "2030-01-15T10:00:00.000Z",
+    });
+    expectStatus(await putRule("archive/", 3650), 200);
+    t.clock.advanceSeconds(60);
+    expect((await putRule("logs/2030/", 7)).json<RuleBody>().updatedAt).toBe("2030-01-15T10:01:00.000Z");
+    expect(await listRules()).toEqual([["archive/", 3650], ["logs/2030/", 7]]);
+
+    const other = await createTenant(t.pool, t.clock, { name: "Harbor Logistics" });
+    expect(await listRules(other)).toEqual([]);
+    expectStatus(await deleteRule("archive/", other), 404);
+    expectStatus(await deleteRule("archive/"), 204);
+    expectStatus(await deleteRule("archive/"), 404);
+    expect(await listRules()).toEqual([["logs/2030/", 7]]);
+  });
+
+  it("validates prefixes, days, scopes and the number of rules", async () => {
+    for (const prefix of ["logs", "logs//", "a%5Cb/", "by-id/x/"]) {
+      const response = await putRule(prefix, 30);
+      expectStatus(response, 400);
+      expect(response.json<ErrorResponse>().error.code).toBe("validation_error");
+    }
+    for (const days of [0, 36_501, 1.5, "30", null]) expectStatus(await putRule("logs/", days), 400);
+    const reader = await issueKey(t.pool, t.clock, tenant.tenantId, ["tenant:read"]);
+    expectStatus(await putRule("logs/", 30, reader), 403);
+    expectStatus(await deleteRule("logs/", reader), 403);
+
+    for (let i = 0; i < MAX_RETENTION_RULES; i++) expectStatus(await putRule(`f${i}/`, 10), 200);
+    const over = await putRule("one-more/", 10);
+    expectStatus(over, 400);
+    expect(over.json<ErrorResponse>().error.details).toEqual({ limit: MAX_RETENTION_RULES });
+    expectStatus(await putRule("f0/", 20), 200);
+  });
+
+  it("deletes files once they reach their rule's age, releasing bytes and removing objects", async () => {
+    const old = await storeFile(t.app, tenant, "logs/old.log", "o".repeat(100));
+    await storeFile(t.app, tenant, "keep/old.txt", "k".repeat(50));
+    t.clock.advanceSeconds(DAY_S);
+    await storeFile(t.app, tenant, "logs/new.log", "n".repeat(10));
+    expectStatus(await putRule("logs/", 30), 200);
+
+    t.clock.advanceSeconds(29 * DAY_S - 1);
+    expect((await t.cleanup.runOnce()).expiredFiles).toBe(0);
+    t.clock.advanceSeconds(1);
+    expect((await t.cleanup.runOnce()).expiredFiles).toBe(1);
+    expect(await deletedPaths()).toEqual(["logs/old.log"]);
+    expect(await tenantUsage(t.pool, tenant.tenantId)).toBe(60);
+    await expect(access(path.join(t.storageRoot ?? "", "objects", "t", tenant.tenantId, old.id))).rejects.toThrow();
+    const row = await t.pool.query("SELECT 1 FROM files WHERE id = $1 AND object_deleted_at IS NOT NULL", [old.id]);
+    expect(row.rowCount).toBe(1);
+
+    t.clock.advanceSeconds(DAY_S);
+    expect((await t.cleanup.runOnce()).expiredFiles).toBe(1);
+    expect(await tenantUsage(t.pool, tenant.tenantId)).toBe(50);
+  });
+
+  it("applies the rule with the longest matching prefix", async () => {
+    for (const p of ["logs/app.log", "logs/audit/2030.log", "logs-old/x.log"]) await storeFile(t.app, tenant, p, "x");
+    expectStatus(await putRule("logs/", 1), 200);
+    expectStatus(await putRule("logs/audit/", 3650), 200);
+    t.clock.advanceSeconds(2 * DAY_S);
+    expect((await t.cleanup.runOnce()).expiredFiles).toBe(1);
+    expect(await deletedPaths()).toEqual(["logs/app.log"]);
+  });
+
+  it("covers files of every live status, in batches, and only the rule's tenant", async () => {
+    const other = await createTenant(t.pool, t.clock, { name: "Harbor Logistics" });
+    await storeFile(t.app, other, "tmp/theirs.bin", "x");
+    const ids: string[] = [];
+    for (const name of ["a", "b", "c", "d"]) ids.push((await storeFile(t.app, tenant, `tmp/${name}.bin`, name)).id);
+    await t.pool.query("UPDATE files SET status = 'quarantined', next_scan_at = NULL WHERE id = $1", [ids[0]]);
+    await t.pool.query("UPDATE files SET status = 'available', next_scan_at = NULL WHERE id = $1", [ids[1]]);
+    expectStatus(await t.app.inject({ method: "DELETE", url: "/v1/files/tmp/d.bin", headers: tenant.headers }), 204);
+    expectStatus(await putRule("tmp/", 7), 200);
+
+    t.clock.advanceSeconds(7 * DAY_S);
+    expect((await t.cleanup.runOnce()).expiredFiles).toBe(3);
+    expect(await deletedPaths()).toEqual(["tmp/a.bin", "tmp/b.bin", "tmp/c.bin", "tmp/d.bin"]);
+    expect(await tenantUsage(t.pool, tenant.tenantId)).toBe(0);
+    expect(await tenantUsage(t.pool, other.tenantId)).toBe(1);
+  });
+
+  it("leaves files whose rule was removed or lengthened after the job picked them", async () => {
+    const first = await storeFile(t.app, tenant, "tmp/first.txt", "f");
+    t.clock.advanceSeconds(1);
+    await storeFile(t.app, tenant, "drafts/a.txt", "a");
+    await storeFile(t.app, tenant, "exports/b.txt", "b");
+    for (const prefix of ["tmp/", "drafts/", "exports/"]) expectStatus(await putRule(prefix, 1), 200);
+    t.clock.advanceSeconds(2 * DAY_S);
+
+    // Hold the job on the oldest file while the rules of the other two change.
+    const holder = await t.pool.connect();
+    try {
+      await holder.query("BEGIN");
+      await holder.query("SELECT id FROM files WHERE id = $1 FOR UPDATE", [first.id]);
+      const run = t.cleanup.applyRetention();
+      for (let attempt = 0; attempt < 500; attempt++) {
+        const waiting = await t.pool.query(
+          "SELECT 1 FROM pg_stat_activity WHERE datname = current_database() AND wait_event_type = 'Lock'",
+        );
+        if (waiting.rowCount !== 0) break;
+        await new Promise((resolve) => setTimeout(resolve, 20));
+      }
+      expectStatus(await deleteRule("drafts/"), 204);
+      expectStatus(await putRule("exports/", 3650), 200);
+      await holder.query("ROLLBACK");
+      await run;
+    } finally {
+      holder.release();
+    }
+    expect(await deletedPaths()).toEqual(["tmp/first.txt"]);
+  });
+});
