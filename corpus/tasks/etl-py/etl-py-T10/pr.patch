diff --git a/tests/load/test_placeholder_customers.py b/tests/load/test_placeholder_customers.py
new file mode 100644
index 0000000..e68d703
--- /dev/null
+++ b/tests/load/test_placeholder_customers.py
@@ -0,0 +1,81 @@
+"""Orders for customers the CRM has not sent yet: placeholder customer versions."""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+
+from etl.infra.tables import check_results, customers, orders
+from tests.helpers.db import rows
+from tests.helpers.factories import customer_obj, order_row, write_customers, write_orders
+
+RUN_AT = datetime(2026, 4, 1, 8, 0, tzinfo=UTC)  # the FrozenClock's default
+
+
+def versions(db, customer_id):
+    return rows(db, customers, order_by="valid_from", customer_id=customer_id)
+
+
+def test_an_order_for_an_unknown_customer_gets_a_placeholder(pipeline, db, tmp_path):
+    result = pipeline.run("orders", write_orders(tmp_path, [order_row(customer_id="C-9")]))
+
+    (placeholder,) = versions(db, "C-9")
+    assert placeholder["is_placeholder"] is True
+    assert placeholder["is_current"] is True
+    assert (placeholder["loaded_at"], placeholder["valid_to"]) == (RUN_AT, None)
+    assert placeholder["run_id"] == result.run_id
+    assert all(placeholder[name] is None for name in ("email", "full_name", "phone", "country"))
+    (order,) = rows(db, orders)
+    assert order["customer_key"] == placeholder["customer_key"]
+    assert all(check.passed for check in result.checks if check.severity == "error")
+
+
+def test_one_placeholder_per_customer_across_orders_and_runs(pipeline, db, clock, tmp_path):
+    first = [
+        order_row(order_id="O-1", customer_id="C-9"),
+        order_row(order_id="O-2", customer_id="C-9"),
+    ]
+    pipeline.run("orders", write_orders(tmp_path, first, name="a.csv"))
+    clock.advance(hours=1)
+    later = [order_row(order_id="O-3", customer_id="C-9", updated_at="02.03.2026 11:00:00")]
+    pipeline.run("orders", write_orders(tmp_path, later, name="b.csv"))
+
+    (placeholder,) = versions(db, "C-9")
+    assert {order["customer_key"] for order in rows(db, orders)} == {placeholder["customer_key"]}
+
+
+def test_known_customers_get_no_placeholder(pipeline, db, tmp_path):
+    pipeline.run("customers", write_customers(tmp_path, [customer_obj(customer_id="C-1")]))
+
+    pipeline.run("orders", write_orders(tmp_path, [order_row(customer_id="C-1")]))
+
+    (version,) = versions(db, "C-1")
+    assert version["is_placeholder"] is False
+    assert rows(db, orders)[0]["customer_key"] == version["customer_key"]
+
+
+def test_the_crm_row_replaces_the_placeholder(pipeline, db, clock, tmp_path):
+    pipeline.run("orders", write_orders(tmp_path, [order_row(customer_id="C-9")]))
+    clock.set(datetime(2026, 4, 2, 10, 0, tzinfo=UTC))
+    crm = customer_obj(customer_id="C-9", updated_at="2026-04-02T09:00:00Z")
+
+    result = pipeline.run("customers", write_customers(tmp_path, [crm]))
+
+    placeholder, real = versions(db, "C-9")
+    assert placeholder["is_placeholder"] is True
+    assert (placeholder["is_current"], placeholder["valid_to"]) == (
+        False,
+        datetime(2026, 4, 2, 9, 0, tzinfo=UTC),
+    )
+    assert (real["is_current"], real["is_placeholder"]) == (True, False)
+    assert real["email"] == "ada.example@example.com"
+    assert real["country"] == "DE"
+    assert result.counts.loaded == 1
+    # The order keeps the version that was current when it was loaded.
+    assert rows(db, orders)[0]["customer_key"] == placeholder["customer_key"]
+
+
+def test_an_orders_run_checks_the_customers_it_writes(pipeline, db, tmp_path):
+    result = pipeline.run("orders", write_orders(tmp_path, [order_row(customer_id="C-9")]))
+
+    checked = {row["check_name"] for row in rows(db, check_results, run_id=result.run_id)}
+    assert "customers.customer_id.unique_current" in checked
