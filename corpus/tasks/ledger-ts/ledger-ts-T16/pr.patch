+  describe("search by amount", () => {
+    async function ids(query: string): Promise<string[]> {
+      const response = await t.app.inject({ method: "GET", url: `/transfers?${query}`, headers: tenant.headers });
+      expect(response.statusCode, query).toBe(200);
+      return response.json<TransferPage>().data.map((x) => x.id);
+    }
+
+    async function postAmounts(amounts: string[], currency: "USD" | "EUR" = "USD"): Promise<TransferBody[]> {
+      const wallet = await fundedWallet(t.app, tenant, "100000", currency);
+      const merchant = await openAccount(t.app, tenant, { currency });
+      const posted: TransferBody[] = [];
+      for (const amount of amounts) {
+        t.clock.advanceSeconds(1);
+        posted.push(await transfer(t.app, tenant, wallet.id, merchant.id, amount, currency));
+      }
+      return posted;
+    }
+
+    it("includes amount_min and excludes amount_max", async () => {
+      const [a100, a250, a500, a999, a1000] = await postAmounts(["100", "250", "500", "999", "1000"]);
+      expect(await ids("currency=USD&amount_min=250&amount_max=1000")).toEqual([a999?.id, a500?.id, a250?.id]);
+      expect(await ids("currency=USD&amount_max=250")).toEqual([a100?.id]);
+      const atLeast1000 = await ids("currency=USD&amount_min=1000");
+      expect(atLeast1000).toContain(a1000?.id);
+      expect(atLeast1000).not.toContain(a999?.id);
+    });
+
+    it("only returns transfers of the requested currency", async () => {
+      const [usd] = await postAmounts(["700"]);
