+package com.innkeep.booking.api;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.innkeep.booking.domain.RoomType;
+import com.innkeep.booking.support.IntegrationTestBase;
+import java.time.LocalDate;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.ResultActions;
+
+class StayRestrictionApiTest extends IntegrationTestBase {
+
+  private RoomType room;
+
+  @BeforeEach
+  void setUp() {
+    var property = data.harbourHouse();
+    room = data.roomType(property, "double", 2, "100.00");
+    data.rooms(property, room, LocalDate.parse("2027-06-01"), LocalDate.parse("2027-06-30"), 2);
+  }
+
+  private ResultActions restrict(String restrictions) throws Exception {
+    return mvc.perform(
+        put("/api/v1/admin/properties/harbour-house/room-types/double/restrictions")
+            .header("Authorization", ADMIN_AUTH)
+            .contentType(MediaType.APPLICATION_JSON)
+            .content(restrictions));
+  }
+
+  private ResultActions quote(String checkIn, String checkOut) throws Exception {
+    return mvc.perform(
+        post("/api/v1/properties/harbour-house/quotes")
+            .contentType(MediaType.APPLICATION_JSON)
+            .content(
+                "{\"roomType\":\"double\",\"checkIn\":\"%s\",\"checkOut\":\"%s\",\"rooms\":1,"
+                        .formatted(checkIn, checkOut)
+                    + "\"guests\":2}"));
+  }
+
+  @Test
+  void restrictionsAreReplacedAsAWhole() throws Exception {
+    restrict("[{\"startDate\":\"2027-06-10\",\"endDate\":\"2027-06-12\",\"minStay\":3}]")
+        .andExpect(status().isOk());
+    restrict(
+            "[{\"startDate\":\"2027-06-20\",\"endDate\":\"2027-06-20\",\"closedToArrival\":true},"
+                + "{\"startDate\":\"2027-06-01\",\"endDate\":\"2027-06-05\",\"minStay\":2}]")
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.length()").value(2));
+
+    mvc.perform(
+            get("/api/v1/admin/properties/harbour-house/room-types/double/restrictions")
+                .header("Authorization", ADMIN_AUTH))
+        .andExpect(jsonPath("$.length()").value(2))
+        .andExpect(jsonPath("$[0].startDate").value("2027-06-01"))
+        .andExpect(jsonPath("$[0].minStay").value(2))
+        .andExpect(jsonPath("$[1].closedToArrival").value(true));
+    quote("2027-06-10", "2027-06-12").andExpect(status().isOk());
+  }
+
+  @Test
+  void aRestrictionNeedsARuleAndSensibleDates() throws Exception {
+    for (String rule : new String[] {"", ",\"minStay\":0", ",\"minStay\":61"}) {
+      restrict("[{\"startDate\":\"2027-06-10\",\"endDate\":\"2027-06-12\"" + rule + "}]")
+          .andExpect(status().isBadRequest());
+    }
+    restrict("[{\"startDate\":\"2027-06-12\",\"endDate\":\"2027-06-10\",\"minStay\":2}]")
+        .andExpect(status().isBadRequest());
+  }
+
+  @Test
+  void aQuoteBreakingARuleNamesTheRuleAndTheNight() throws Exception {
+    restrict("[{\"startDate\":\"2027-06-10\",\"endDate\":\"2027-06-12\",\"minStay\":3}]");
+
+    quote("2027-06-11", "2027-06-13")
+        .andExpect(status().isBadRequest())
+        .andExpect(jsonPath("$.type").value("urn:innkeep:problem:stay-restricted"))
+        .andExpect(jsonPath("$.rule").value("min-stay"))
+        .andExpect(jsonPath("$.night").value("2027-06-11"));
+    quote("2027-06-11", "2027-06-14").andExpect(status().isOk());
+  }
+
+  @Test
+  void aHoldArrivingOnAClosedNightTakesNoRooms() throws Exception {
+    restrict(
+        "[{\"startDate\":\"2027-06-10\",\"endDate\":\"2027-06-10\",\"closedToArrival\":true}]");
+
+    mvc.perform(
+            post("/api/v1/properties/harbour-house/holds")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content(
+                    "{\"stay\":{\"roomType\":\"double\",\"checkIn\":\"2027-06-10\","
+                        + "\"checkOut\":\"2027-06-12\",\"rooms\":1,\"guests\":2},"
+                        + "\"guest\":{\"name\":\"Ines Lark\",\"email\":\"guest@example.com\"}}"))
+        .andExpect(status().isBadRequest())
+        .andExpect(jsonPath("$.rule").value("closed-to-arrival"));
+    assertThat(held(room, LocalDate.parse("2027-06-10"))).isZero();
+  }
+}
