+package com.papertrail.workflow.api;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.hamcrest.Matchers.containsString;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.delete;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.multipart;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.header;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.papertrail.workflow.domain.PermissionLevel;
+import com.papertrail.workflow.domain.StepKind;
+import com.papertrail.workflow.service.DocumentService;
+import com.papertrail.workflow.service.PermissionService;
+import com.papertrail.workflow.support.IntegrationTestBase;
+import com.papertrail.workflow.support.TestData;
+import java.nio.charset.StandardCharsets;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.mock.web.MockMultipartFile;
+import org.springframework.test.web.servlet.ResultActions;
+
+class AttachmentApiTest extends IntegrationTestBase {
+
+  private static final String AUTH = "Authorization";
+  private static final byte[] RECEIPT = "Invented receipt 42.00".getBytes(StandardCharsets.UTF_8);
+
+  @Autowired private DocumentService documents;
+  @Autowired private PermissionService permissions;
+
+  private long owner;
+  private long approver;
+  private long document;
+
+  @BeforeEach
+  void setUp() {
+    owner = data.user("Ines Berg");
+    approver = data.user("Tomas Vale");
+    data.publish("Expenses", TestData.step(1, StepKind.SINGLE, approver, null, 0, 480));
+    document = data.draft(data.principal(owner), "Expenses", "Travel claim");
+  }
+
+  private String path() {
+    return "/api/v1/documents/" + document + "/attachments";
+  }
+
+  private ResultActions upload(long userId, String name, String type, byte[] content)
+      throws Exception {
+    return mvc.perform(
+        multipart(path())
+            .file(new MockMultipartFile("file", name, type, content))
+            .header(AUTH, data.bearer(userId)));
+  }
+
+  private long uploaded(String name) throws Exception {
+    return idFrom(
+        upload(owner, name, "text/plain", RECEIPT).andExpect(status().isCreated()).andReturn());
+  }
+
+  @Test
+  void theOwnerUploadsAndAnApproverDownloadsTheSameBytes() throws Exception {
+    upload(owner, "C:\\Users\\ines\\receipt.txt", "Text/Plain; charset=UTF-8", RECEIPT)
+        .andExpect(status().isCreated())
+        .andExpect(jsonPath("$.fileName").value("receipt.txt"))
+        .andExpect(jsonPath("$.contentType").value("text/plain"))
+        .andExpect(jsonPath("$.sizeBytes").value(RECEIPT.length));
+    long id = jdbc.queryForObject("select id from document_attachment", Long.class);
+    documents.submit(data.principal(owner), document);
+
+    mvc.perform(get(path()).header(AUTH, data.bearer(approver)))
+        .andExpect(jsonPath("$[0].id").value(id))
+        .andExpect(jsonPath("$[0].sha256").value(sha256Of(id)))
+        .andExpect(jsonPath("$[0].content").doesNotExist());
+    byte[] body =
+        mvc.perform(get(path() + "/" + id).header(AUTH, data.bearer(approver)))
+            .andExpect(status().isOk())
+            .andExpect(header().string("Content-Type", "text/plain"))
+            .andExpect(header().string("X-Content-Type-Options", "nosniff"))
+            .andExpect(header().string("Content-Disposition", containsString("receipt.txt")))
