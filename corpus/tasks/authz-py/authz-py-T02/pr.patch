@@ -0,0 +1,45 @@
+"""Organisation API keys."""
+
+from __future__ import annotations
+
+import uuid
+from typing import Annotated
+
+from fastapi import APIRouter, Depends, Response, status
+
+from authz.api.deps import Authorized, ContainerDep, require
+from authz.api.routers.auth import NO_STORE
+from authz.api.schemas.common import ListResponse
+from authz.api.schemas.organizations import ApiKeyCreate, ApiKeyResponse, CreatedApiKeyResponse
+from authz.domain.permissions import Permission
+
+router = APIRouter(prefix="/v1/orgs/{org_id}/api-keys", tags=["api-keys"])
+
+CanManageKeys = Annotated[Authorized, Depends(require(Permission.MEMBERS_MANAGE))]
+
+
+@router.post("", status_code=status.HTTP_201_CREATED, response_model=CreatedApiKeyResponse)
+async def create_api_key(
+    body: ApiKeyCreate, auth: CanManageKeys, container: ContainerDep, response: Response
+) -> CreatedApiKeyResponse:
+    key, token = await container.api_keys.create(
+        auth.principal, auth.org_id, name=body.name, role_id=body.role_id
+    )
+    response.headers.update(NO_STORE)
+    return CreatedApiKeyResponse(**ApiKeyResponse.of(key).model_dump(), key=token)
+
+
+@router.get("", response_model=ListResponse[ApiKeyResponse])
+async def list_api_keys(
+    auth: CanManageKeys, container: ContainerDep
+) -> ListResponse[ApiKeyResponse]:
+    keys = await container.api_keys.list_keys(auth.org_id)
+    return ListResponse(data=[ApiKeyResponse.of(key) for key in keys])
+
+
+@router.delete("/{key_id}", status_code=status.HTTP_204_NO_CONTENT)
+async def revoke_api_key(
+    key_id: uuid.UUID, auth: CanManageKeys, container: ContainerDep
+) -> Response:
+    await container.api_keys.revoke(auth.principal, auth.org_id, key_id)
+    return Response(status_code=status.HTTP_204_NO_CONTENT)
