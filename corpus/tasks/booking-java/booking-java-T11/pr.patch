+package com.innkeep.booking.unit;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.innkeep.booking.domain.DisplayRate;
+import java.math.BigDecimal;
+import java.util.Currency;
+import org.junit.jupiter.api.Test;
+
+class DisplayRateTest {
+
+  private static final Currency EUR = Currency.getInstance("EUR");
+
+  private static BigDecimal convert(String to, String rate, String amount) {
+    return new DisplayRate(EUR, Currency.getInstance(to), new BigDecimal(rate))
+        .convert(new BigDecimal(amount));
+  }
+
+  @Test
+  void convertsAndRoundsToTheMinorUnitsOfTheDisplayCurrency() {
+    assertThat(convert("USD", "1.085", "210.00")).isEqualTo(new BigDecimal("227.85"));
+    assertThat(convert("USD", "1.085", "99.99")).isEqualTo(new BigDecimal("108.49"));
+    assertThat(convert("JPY", "162", "99.99")).isEqualTo(new BigDecimal("16198"));
+  }
+}
