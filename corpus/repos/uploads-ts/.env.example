NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://uploads:uploads@localhost:5432/uploads
DATABASE_POOL_MAX=10
SIGNING_SECRET=replace-with-at-least-32-random-characters
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.data/storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REQUEST_TIMEOUT_MS=30000
MAX_UPLOAD_BYTES=104857600
UPLOAD_SESSION_TTL_S=86400
UPLOAD_CHUNK_LEASE_S=600
SIGNED_URL_MAX_TTL_S=604800
LIST_MAX_LIMIT=1000
SCANNER=noop
SCANNER_URL=
SCANNER_TIMEOUT_MS=30000
SCAN_MAX_ATTEMPTS=5
SCAN_BACKOFF_BASE_S=30
SCAN_BACKOFF_MAX_S=3600
SCAN_BATCH_SIZE=10
SCAN_POLL_INTERVAL_MS=2000
SCAN_CLAIM_LEASE_S=300
CLEANUP_INTERVAL_S=300
CLEANUP_BATCH_SIZE=100
DELETED_GRACE_S=86400
SHUTDOWN_TIMEOUT_MS=10000
