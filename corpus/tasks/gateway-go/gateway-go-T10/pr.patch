+		u, err := url.Parse(o)
+		switch {
+		case o == "*" && len(c.AllowOrigins) > 1:
+			p.add(fmt.Sprintf("cors.allow_origins[%d]", i), "\"*\" cannot be combined with other origins")
+		case o == "*":
+		case err != nil || (u.Scheme != "http" && u.Scheme != "https") || u.Host == "" || u.Path != "" || u.RawQuery != "":
+			p.add(fmt.Sprintf("cors.allow_origins[%d]", i), "must be \"*\" or an origin such as https://app.example.com, got %q", o)
+		}
+	}
+	for i, m := range c.AllowMethods {
+		if !slices.Contains(knownMethods, m) {
+			p.add(fmt.Sprintf("cors.allow_methods[%d]", i), "must be one of %s, got %q", strings.Join(knownMethods, ", "), m)
+		}
+	}
+	if c.MaxAge.D() < 0 || c.MaxAge.D() > 24*time.Hour {
+		p.add("cors.max_age", "must not be negative and at most 24h")
+	}
 }
 
