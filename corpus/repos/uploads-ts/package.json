{
  "name": "uploads-ts",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant file upload and storage HTTP API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cli.json",
    "start": "node dist/main.js",
    "migrate": "node dist/scripts/migrate.js",
    "admin": "node dist/scripts/admin.js",
    "uploadctl": "node dist/cli/scripts/uploadctl.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/multipart": "10.1.4",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
