+// stdin is where enqueue-batch reads jobs from when -file is "-".
+var stdin io.Reader = os.Stdin
+
+// enqueueBatchCmd enqueues the jobs of an NDJSON file in one request: one object per line with
+// the fields of enqueue's request body. Blank lines are skipped.
+func enqueueBatchCmd(ctx context.Context, c *client.Client, args []string, stdout, stderr io.Writer) error {
+	fs := newFlags("enqueue-batch", stderr)
+	queue := fs.String("queue", "default", "queue name")
+	file := fs.String("file", "-", `NDJSON file of jobs, one {"type", "payload", "priority", "max_attempts", "run_at"} object per line ("-": stdin)`)
+	if err := parse(fs, args); err != nil {
+		return err
+	}
+	if fs.NArg() > 0 {
+		fmt.Fprintln(stderr, "jobctl enqueue-batch: no arguments are accepted")
+		fs.Usage()
+		return errUsage
+	}
+	in := stdin
+	if *file != "-" {
+		f, err := os.Open(*file)
+		if err != nil {
+			return err
+		}
+		defer f.Close()
+		in = f
+	}
+	reqs, err := readJobLines(in)
+	if err != nil {
+		return err
+	}
+	jobs, err := c.EnqueueBatch(ctx, *queue, reqs)
+	if err != nil {
+		return err
+	}
+	for _, j := range jobs {
+		fmt.Fprintf(stdout, "enqueued job %d (%s/%s)\n", j.ID, j.Queue, j.Type)
+	}
+	return nil
+}
+
+// readJobLines decodes one enqueue request per non-blank line of r.
+func readJobLines(r io.Reader) ([]client.EnqueueRequest, error) {
+	sc := bufio.NewScanner(r)
+	sc.Buffer(make([]byte, 0, 64<<10), 1<<20)
+	var reqs []client.EnqueueRequest
+	for n := 1; sc.Scan(); n++ {
+		line := bytes.TrimSpace(sc.Bytes())
+		if len(line) == 0 {
+			continue
+		}
+		dec := json.NewDecoder(bytes.NewReader(line))
+		dec.DisallowUnknownFields()
+		var req client.EnqueueRequest
+		if err := dec.Decode(&req); err != nil {
+			return nil, fmt.Errorf("line %d: %w", n, err)
+		}
+		reqs = append(reqs, req)
+	}
+	if err := sc.Err(); err != nil {
+		return nil, fmt.Errorf("read jobs: %w", err)
+	}
+	if len(reqs) == 0 {
+		return nil, errors.New("no jobs to enqueue")
+	}
+	return reqs, nil
+}
