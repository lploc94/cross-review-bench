@@ -0,0 +1,94 @@
+package com.innkeep.booking.service;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import com.innkeep.booking.domain.DateRange;
+import com.innkeep.booking.domain.GuestDetails;
+import com.innkeep.booking.domain.InsufficientAvailabilityException;
+import com.innkeep.booking.domain.Property;
+import com.innkeep.booking.domain.RoomType;
+import com.innkeep.booking.support.IntegrationTestBase;
+import java.time.Instant;
+import java.time.LocalDate;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+
+class AllotmentServiceTest extends IntegrationTestBase {
+
+  private static final LocalDate MAY_10 = LocalDate.parse("2027-05-10");
+  private static final LocalDate MAY_12 = LocalDate.parse("2027-05-12");
+  private static final DateRange STAY = new DateRange(MAY_10, MAY_12);
+  private static final GuestDetails GUEST =
+      new GuestDetails("Ilse Varga", "guest@example.com", "+351 000 000 001");
+
+  @Autowired private AllotmentService allotments;
+  @Autowired private AvailabilityService availability;
+  @Autowired private CalendarService calendar;
+  @Autowired private HoldService holds;
+
+  private Property property;
+  private RoomType room;
+
+  @BeforeEach
+  void setUp() {
+    property = data.harbourHouse();
+    room = data.roomType(property, "double", 2, "100.00");
+    data.rooms(property, room, MAY_10, MAY_12, 3);
+    allotments.set(property.getCode(), room.getCode(), "atlas-travel", STAY, 2, 3);
+  }
+
+  private Integer[] free() {
+    return calendar.calendar(property.getCode(), room.getCode(), STAY).stream()
+        .map(CalendarDay::available)
+        .toArray(Integer[]::new);
+  }
+
+  @Test
+  void keptRoomsAreNotOfferedBeforeTheReleaseDay() {
+    assertThat(availability.search(property.getCode(), STAY, 1, 2))
+        .extracting(AvailabilityRow::availableRooms)
+        .containsExactly(1);
+    assertThat(availability.search(property.getCode(), STAY, 2, 2)).isEmpty();
+    assertThat(free()).containsExactly(1, 1);
+    assertThatThrownBy(() -> data.hold(property, room, MAY_10, MAY_12, 2))
+        .isInstanceOf(InsufficientAvailabilityException.class);
+  }
+
+  @Test
+  void fromTheReleaseDayTheRoomsAreForSale() {
+    // three days before each night: May 7 for the first, May 8 for the second
+    clock.set(Instant.parse("2027-05-07T09:00:00Z"));
+    assertThat(free()).containsExactly(3, 1);
+
+    clock.set(Instant.parse("2027-05-08T09:00:00Z"));
+    assertThat(availability.search(property.getCode(), STAY, 3, 2)).hasSize(1);
+    data.hold(property, room, MAY_10, MAY_12, 3);
+    assertThat(held(room, MAY_10)).isEqualTo(3);
+  }
+
+  @Test
+  void aChannelHoldUsesItsOwnAllotmentFirstThenPublicRooms() {
+    assertThatThrownBy(
+            () ->
+                holds.createForChannel(
+                    "north-coast", property.getCode(), room.getCode(), STAY, 2, 2, GUEST))
+        .isInstanceOf(InsufficientAvailabilityException.class);
+
+    holds.createForChannel("atlas-travel", property.getCode(), room.getCode(), STAY, 3, 4, GUEST);
+    assertThat(held(room, MAY_10)).isEqualTo(3);
+    assertThat(jdbc.queryForObject("select sum(rooms) from allotment", Integer.class)).isZero();
+  }
+
+  @Test
+  void settingAgainReplacesRoomsAndReleaseDay() {
+    allotments.set(property.getCode(), room.getCode(), "atlas-travel", STAY, 1, 0);
+
+    assertThat(free()).containsExactly(2, 2);
+    assertThat(
+            jdbc.queryForList(
+                "select release_on::text from allotment order by night", String.class))
+        .containsExactly("2027-05-10", "2027-05-11");
+  }
+}
