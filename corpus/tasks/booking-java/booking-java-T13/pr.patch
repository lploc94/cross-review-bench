@@ -0,0 +1,33 @@
+package com.innkeep.booking.service;
+
+import com.innkeep.booking.config.BookingConfig;
+import jakarta.persistence.EntityManager;
+import org.springframework.stereotype.Component;
+
+/**
+ * Bounds how long the current transaction waits for row locks: every later statement in it gives up
+ * after {@code booking.lock-timeout} instead of waiting for another transaction to finish.
+ */
+@Component
+public class LockWaits {
+
+  private final EntityManager entities;
+  private final BookingConfig config;
+
+  public LockWaits(EntityManager entities, BookingConfig config) {
+    this.entities = entities;
+    this.config = config;
+  }
+
+  /**
+   * Sets {@code lock_timeout} for the current transaction only ({@code set_config(…, true)}), so it
+   * ends with the commit or rollback and never reaches other work on the pooled connection. Call it
+   * inside the transaction, before the first statement that may wait.
+   */
+  public void limitCurrentTransaction() {
+    entities
+        .createNativeQuery("select set_config('lock_timeout', :limit, true)")
+        .setParameter("limit", config.lockTimeout().toMillis() + "ms")
+        .getSingleResult();
+  }
+}
