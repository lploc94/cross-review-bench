+++ b/tests/unit/test_totp.py
@@ -0,0 +1,25 @@
+from __future__ import annotations
+
+from datetime import UTC, datetime
+
+import pytest
+
+from authz.domain import totp
+
+# The SHA-1 secret of RFC 6238 Appendix B, "12345678901234567890", in base32.
+RFC_SECRET = totp.encode_secret(b"12345678901234567890")
+
+
+@pytest.mark.parametrize(
+    ("unix_time", "code"),
+    [(59, "287082"), (1111111109, "081804"), (1234567890, "005924"), (2000000000, "279037")],
+)
+def test_codes_match_the_rfc_test_vectors(unix_time, code):
+    moment = datetime.fromtimestamp(unix_time, UTC)
+
+    assert totp.code_at(RFC_SECRET, totp.time_step(moment)) == code
+
+
+@pytest.mark.parametrize("code", ["", "12345", "1234567", "12a456", "١٢٣٤٥٦"])
+def test_malformed_codes_never_match(code):
+    assert totp.matching_step(RFC_SECRET, code, datetime(2026, 3, 2, tzinfo=UTC)) is None
