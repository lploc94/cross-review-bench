+
+    async def export(
+        self, org_id: uuid.UUID, *, action: str | None = None
+    ) -> AsyncIterator[ExportedEvent]:
+        """Every event of the organisation, newest first, with the actor's current email.
+
+        Pages are read from one snapshot, so an export is consistent even while events are
+        being written, and a long export never holds more than one page in memory.
+        """
+        session = await self._db.snapshot()
+        async for item in self._export_pages(session, org_id, action):
+            yield item
+        await session.close()
+
+    async def _export_pages(
+        self, session: AsyncSession, org_id: uuid.UUID, action: str | None
+    ) -> AsyncIterator[ExportedEvent]:
+        events = AuditRepository(session)
+        users = UserRepository(session)
+        after: Cursor | None = None
+        while True:
+            rows = await events.page(
+                org_id, limit=self._export_page_size, after=after, action=action
+            )
+            page = rows[: self._export_page_size]
+            for event in page:
+                email = None
+                if event.actor_id is not None:
+                    email = await users.email_of(event.actor_id)
+                yield ExportedEvent(event=event, actor_email=email)
+            if len(rows) <= self._export_page_size:
+                return
+            after = Cursor(created_at=page[-1].created_at, id=str(page[-1].id))
diff --git a/tests/api/test_audit_export.py b/tests/api/test_audit_export.py
new file mode 100644
index 0000000..12a4fad
--- /dev/null
+++ b/tests/api/test_audit_export.py
@@ -0,0 +1,120 @@
+from __future__ import annotations
+
+import json
+import uuid
+from typing import Any
+
+import pytest
+
+from authz.config import Settings
+from authz.domain.principal import Actor
+from authz.services.audit import AuditAction
+from tests.conftest import make_settings
+from tests.helpers.clock import FrozenClock
+from tests.helpers.factories import org_with_member, signed_in
+
+
+@pytest.fixture
+def settings(migrated_database: str, redis_url: str) -> Settings:
+    # Small pages, so a handful of events spans several of them.
+    return make_settings(migrated_database, redis_url, audit_export_page_size=10)
+
+
+def lines(body: str) -> list[dict[str, Any]]:
+    return [json.loads(line) for line in body.splitlines()]
+
+
+async def test_export_streams_every_event_newest_first(client, container, clock: FrozenClock):
+    org, owner, _ = await org_with_member(client, container, "viewer")
+    base = f"/v1/orgs/{org['id']}/projects"
+    for number in range(23):
+        clock.advance(seconds=1)
+        response = await client.post(
+            base, json={"name": f"Project {number}"}, headers=owner.headers
+        )
+        assert response.status_code == 201
+
+    response = await client.get(f"/v1/orgs/{org['id']}/audit/export", headers=owner.headers)
+
+    assert response.status_code == 200
+    assert response.headers["content-type"].startswith("application/x-ndjson")
+    assert response.headers["content-disposition"] == (
+        f'attachment; filename="audit-{org["id"]}.ndjson"'
+    )
+    events = lines(response.text)
+    created = [e["data"]["name"] for e in events if e["action"] == "project.created"]
+    assert created == [f"Project {number}" for number in reversed(range(23))]
+    assert events[-1]["action"] == "org.created"
+    ids = [e["id"] for e in events]
+    assert len(ids) == len(set(ids))
+
+
+async def test_export_names_the_actor(client, container):
+    org, owner, _ = await org_with_member(client, container, "viewer")
+    async with container.db.transaction() as session:
+        await container.audit_log.record(
+            session,
+            Actor.system(),
+            org_id=uuid.UUID(org["id"]),
+            action=AuditAction.ORG_UPDATED,
+            target_type="organization",
+            target_id=org["id"],
+            data={"name": "Acme Rockets"},
+        )
+
+    response = await client.get(f"/v1/orgs/{org['id']}/audit/export", headers=owner.headers)
+
+    events = lines(response.text)
+    assert events[0]["action"] == "org.updated"
+    assert events[0]["actor_id"] is None
+    assert events[0]["actor_email"] is None
+    by_owner = [e for e in events if e["actor_id"] == str(owner.id)]
+    assert by_owner
+    assert {e["actor_email"] for e in by_owner} == {owner.email}
+
+
+async def test_export_filters_by_action(client, container):
+    org, owner, _ = await org_with_member(client, container, "viewer")
+    await client.post(
+        f"/v1/orgs/{org['id']}/projects", json={"name": "Vega"}, headers=owner.headers
+    )
+
+    response = await client.get(
+        f"/v1/orgs/{org['id']}/audit/export",
+        params={"action": "project.created"},
+        headers=owner.headers,
+    )
+
+    assert [(e["action"], e["data"]) for e in lines(response.text)] == [
+        ("project.created", {"name": "Vega"})
+    ]
+
+
+async def test_export_of_an_empty_selection_is_empty(client, container):
+    org, owner, _ = await org_with_member(client, container, "viewer")
+
+    response = await client.get(
+        f"/v1/orgs/{org['id']}/audit/export",
+        params={"action": "project.deleted"},
+        headers=owner.headers,
+    )
+
+    assert response.status_code == 200
+    assert response.text == ""
+
+
+async def test_export_requires_audit_read(client, container):
+    org, _, member = await org_with_member(client, container, "member")
+
+    response = await client.get(f"/v1/orgs/{org['id']}/audit/export", headers=member.headers)
+
+    assert response.status_code == 403
+
+
+async def test_export_of_another_organisation_is_not_found(client, container):
+    org, _, _ = await org_with_member(client, container, "viewer")
+    stranger = await signed_in(client, container)
+
+    response = await client.get(f"/v1/orgs/{org['id']}/audit/export", headers=stranger.headers)
+
+    assert response.status_code == 404
