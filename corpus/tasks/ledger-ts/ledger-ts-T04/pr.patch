 });
 
 export type CreateAccountBody = z.infer<typeof createAccountBodySchema>;
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+/** The longest period one statement may cover, in days. */
+export const MAX_STATEMENT_DAYS = 366;
+
+const statementDaySchema = z.iso.date({ error: "must be a calendar date (YYYY-MM-DD)" });
+
+function startOfDay(day: string): Date {
+  return new Date(`${day}T00:00:00.000Z`);
+}
+
+/**
+ * `from` and `to` are calendar days in UTC and both are included, so from=2030-01-01&to=2030-01-31
+ * is the whole of January. The statement period is the half-open interval from the start of
+ * `from` to the start of the day after `to`.
+ */
+export const statementQuerySchema = z
+  .object({
+    from: statementDaySchema,
+    to: statementDaySchema,
+    format: z.enum(["json", "csv"]).default("json"),
+  })
+  .refine((query) => query.from <= query.to, {
+    error: "from must not be after to",
+    path: ["to"],
+  })
+  .transform((query) => {
+    const start = startOfDay(query.from);
+    const end = new Date(startOfDay(query.to).getTime() + DAY_MS);
+    return { ...query, period: { start, end } };
+  })
+  .refine(
+    ({ period }) => period.end.getTime() - period.start.getTime() <= MAX_STATEMENT_DAYS * DAY_MS,
+    { error: `a statement covers at most ${MAX_STATEMENT_DAYS} days`, path: ["to"] },
+  );
+
+export type StatementQuery = z.output<typeof statementQuerySchema>;
