@@ -0,0 +1,44 @@
+package com.innkeep.booking.service;
+
+import com.innkeep.booking.config.BookingConfig;
+import com.innkeep.booking.domain.DisplayRate;
+import com.innkeep.booking.domain.ValidationException;
+import java.math.BigDecimal;
+import java.util.Currency;
+import java.util.Locale;
+import java.util.Map;
+import java.util.regex.Pattern;
+import org.springframework.stereotype.Service;
+
+/**
+ * Looks up the configured display rates ({@code booking.display-rates}). A price can always be
+ * shown in its own currency; any other currency needs a rate from the property's currency.
+ */
+@Service
+public class DisplayCurrencyService {
+
+  private static final Pattern CODE = Pattern.compile("[A-Z]{3}");
+
+  private final Map<String, Map<String, BigDecimal>> rates;
+
+  public DisplayCurrencyService(BookingConfig config) {
+    this.rates = config.displayRates();
+  }
+
+  /** The rate from {@code from} to the requested display currency, or a validation error. */
+  public DisplayRate rate(Currency from, String displayCurrency) {
+    String code = displayCurrency == null ? "" : displayCurrency.trim().toUpperCase(Locale.ROOT);
+    if (!CODE.matcher(code).matches()) {
+      throw new ValidationException("display must be a three-letter currency code");
+    }
+    if (code.equals(from.getCurrencyCode())) {
+      return new DisplayRate(from, from, BigDecimal.ONE);
+    }
+    BigDecimal rate = rates.getOrDefault(from.getCurrencyCode(), Map.of()).get(code);
+    if (rate == null) {
+      throw new ValidationException(
+          "prices in " + from.getCurrencyCode() + " cannot be shown in " + code);
+    }
+    return new DisplayRate(from, Currency.getInstance(code), rate);
+  }
+}
