+// progress describes where a job stands for wait: its state and, once it has been leased, the
+// attempt it is on or the last one that ran ("running, attempt 3/5"). A job running its last
+// attempt is marked as such.
+func progress(j client.Job) string {
+	switch {
+	case j.Attempts == 0:
+		return j.State
+	case j.State == "running" && j.Attempts >= j.MaxAttempts:
+		return fmt.Sprintf("running, attempt %d/%d (last)", j.Attempts, j.MaxAttempts)
+	case j.State == "available":
+		return fmt.Sprintf("available, attempt %d/%d failed, retrying at %s", j.Attempts, j.MaxAttempts,
+			j.RunAt.Format(time.RFC3339))
+	default:
+		return fmt.Sprintf("%s, attempt %d/%d", j.State, j.Attempts, j.MaxAttempts)
+	}
+}
