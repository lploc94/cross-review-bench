+package com.innkeep.booking.api.dto;
+
+import com.innkeep.booking.domain.DateRange;
+import jakarta.validation.constraints.Min;
+import jakarta.validation.constraints.NotNull;
+import java.time.LocalDate;
+
+/**
+ * Rooms kept for a channel on every night from {@code from} up to {@code to} (exclusive), released
+ * to public sale {@code releaseDays} before each night.
+ */
+public record AllotmentRequest(
+    @NotNull LocalDate from, @NotNull LocalDate to, @Min(0) int rooms, @Min(0) int releaseDays) {
+
+  public DateRange range() {
+    return new DateRange(from, to);
+  }
+}
