+// IsFinalAttempt reports whether the job running under ctx is on its last attempt: if the
+// handler returns an error now, the job becomes dead instead of being retried. Handlers use it
+// to escalate only when no retry will follow, for example to notify a person or to release
+// something the job reserved. It returns false when ctx does not belong to a running job.
+func IsFinalAttempt(ctx context.Context) bool {
+	l, ok := ctx.Value(leaseKey{}).(*lease)
+	return ok && l.final
+}
