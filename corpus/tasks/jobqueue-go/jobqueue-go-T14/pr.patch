+// queueConcurrency reads a comma-separated list of queue=n entries, such as
+// "emails=2,reports=1". Each queue may appear once and n must be between 1 and maxConcurrency.
+func (r *reader) queueConcurrency(name string) map[string]int {
+	v, ok := r.get(name)
+	if !ok {
+		return nil
+	}
+	out := make(map[string]int)
+	seen := make(map[string]bool)
+	for _, item := range strings.Split(v, ",") {
+		item = strings.TrimSpace(item)
+		if item == "" {
+			continue
+		}
+		queue, raw, ok := strings.Cut(item, "=")
+		queue, raw = strings.TrimSpace(queue), strings.TrimSpace(raw)
+		if !ok || queue == "" {
+			r.fail(name, "entry %q must look like queue=n", item)
+			continue
+		}
+		if seen[queue] {
+			r.fail(name, "queue %q is listed more than once", queue)
+			continue
+		}
+		seen[queue] = true
+		n, err := strconv.Atoi(raw)
+		switch {
+		case err != nil:
+			r.fail(name, "queue %q: %q is not an integer", queue, raw)
+			continue
+		case n < 1 || n > maxConcurrency:
+			r.fail(name, "queue %q: must be between 1 and %d, got %d", queue, maxConcurrency, n)
+			continue
+		}
+		out[queue] = n
+	}
+	return out
+}
