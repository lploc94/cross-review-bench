diff --git a/src/etl/store/schema_drift.py b/src/etl/store/schema_drift.py
new file mode 100644
index 0000000..3171617
--- /dev/null
+++ b/src/etl/store/schema_drift.py
@@ -0,0 +1,28 @@
+"""Header drift recorded per run in `etl.schema_drift`."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+
+from sqlalchemy import Connection, insert, select
+
+from etl.infra.tables import schema_drift
+from etl.sources.base import ColumnDrift, DriftKind
+
+
+def save(connection: Connection, *, run_id: int, drift: Sequence[ColumnDrift]) -> None:
+    if not drift:
+        return
+    connection.execute(
+        insert(schema_drift),
+        [{"run_id": run_id, "column_name": item.column, "kind": item.kind} for item in drift],
+    )
+
+
+def for_run(connection: Connection, run_id: int) -> list[ColumnDrift]:
+    rows = connection.execute(
+        select(schema_drift.c.column_name, schema_drift.c.kind)
+        .where(schema_drift.c.run_id == run_id)
+        .order_by(schema_drift.c.id)
+    )
+    return [ColumnDrift(row.column_name, DriftKind(row.kind)) for row in rows]
