-func (s *Store) SetQuotaZone(loc *time.Location) { s.zone = loc }
+// and is set at startup, before the store serves requests. The zone's offset is read once here,
+// so that naming the day of a request needs no zone lookup.
+func (s *Store) SetQuotaZone(loc *time.Location) {
+	s.zone = loc
+	_, secs := s.clock.Now().In(loc).Zone()
+	s.offset = time.Duration(secs) * time.Second
