+/** The batch's events per aggregate, each group in id order. */
+function groupByAggregate(events: readonly OutboxEvent[]): OutboxEvent[][] {
+  const groups = new Map<string, OutboxEvent[]>();
+  for (const event of events) {
+    const key = `${event.tenantId}:${event.aggregateId}`;
+    const group = groups.get(key);
+    if (group) {
+      group.push(event);
+    } else {
+      groups.set(key, [event]);
+    }
+  }
+  return [...groups.values()];
+}
