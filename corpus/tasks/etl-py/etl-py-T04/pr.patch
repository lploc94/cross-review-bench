+"""`etl fx load <file>`: daily reference exchange rates."""
+
+from pathlib import Path
+from typing import Annotated
+
+import typer
+
+from etl.api import fx as fx_api
+from etl.cli.common import app_context, guarded
+from etl.cli.output import echo_json
+
+fx_app = typer.Typer(help="Reference exchange rates.", no_args_is_help=True)
+
+
+@fx_app.command("load")
+@guarded
+def load_command(
+    ctx: typer.Context,
+    path: Annotated[Path, typer.Argument(help="CSV file: day,currency,rate_to_eur.")],
+    as_json: Annotated[bool, typer.Option("--json", help="Print JSON.")] = False,
+) -> None:
+    """Load daily rates to EUR; a rate already stored for a day and currency is replaced."""
+    view = fx_api.load_rates(app_context(ctx), path)
+    if as_json:
+        echo_json(view)
+        return
+    if view.rates == 0:
+        typer.echo("no rates in the file")
+        return
+    typer.echo(
+        f"loaded {view.rates} rates for {', '.join(view.currencies)},"
+        f" {view.first_day} to {view.last_day}"
+    )
