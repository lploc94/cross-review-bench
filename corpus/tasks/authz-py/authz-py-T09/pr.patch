diff --git a/tests/api/test_bulk_role_assignments.py b/tests/api/test_bulk_role_assignments.py
new file mode 100644
index 0000000..eb82307
--- /dev/null
+++ b/tests/api/test_bulk_role_assignments.py
@@ -0,0 +1,146 @@
+from __future__ import annotations
+
+from tests.helpers.factories import add_member, org_with_member, role_id, signed_in
+
+
+def _path(org):
+    return f"/v1/orgs/{org['id']}/role-assignments"
+
+
+async def _project(client, org, owner, name="Apollo"):
+    response = await client.post(
+        f"/v1/orgs/{org['id']}/projects", json={"name": name}, headers=owner.headers
+    )
+    assert response.status_code == 201
+    return response.json()
+
+
+async def test_bulk_creates_every_item(client, container):
+    org, owner, viewer = await org_with_member(client, container, "viewer")
+    other = await signed_in(client, container)
+    await add_member(container, org["id"], other, "viewer")
+    member_role = await role_id(container, org["id"], "member")
+    apollo = await _project(client, org, owner)
+
+    response = await client.post(
+        f"{_path(org)}:bulk",
+        json={
+            "items": [
+                {"user_id": str(viewer.id), "role_id": str(member_role)},
+                {
+                    "user_id": str(other.id),
+                    "role_id": str(member_role),
+                    "project_id": apollo["id"],
+                },
+            ]
+        },
+        headers=owner.headers,
+    )
+
+    assert response.status_code == 200
+    results = response.json()["data"]
+    assert len(results) == 2
+    assert {r["status"] for r in results} == {"created"}
+    assert all(r["error"] is None for r in results)
+    listed = await client.get(_path(org), headers=owner.headers)
+    assert {a["id"] for a in listed.json()["data"]} == {r["assignment_id"] for r in results}
+    events = await client.get(
+        f"/v1/orgs/{org['id']}/audit",
+        params={"action": "role_assignment.created"},
+        headers=owner.headers,
+    )
+    assert len(events.json()["data"]) == 2
+
+
+async def test_failed_items_do_not_stop_the_others(client, container):
+    org, owner, viewer = await org_with_member(client, container, "viewer")
+    stranger = await signed_in(client, container)
+    member_role = await role_id(container, org["id"], "member")
+
+    response = await client.post(
+        f"{_path(org)}:bulk",
+        json={
+            "items": [
+                {"user_id": str(viewer.id), "role_id": str(member_role)},
+                {"user_id": str(stranger.id), "role_id": str(member_role)},
+            ]
+        },
+        headers=owner.headers,
+    )
+
+    assert response.status_code == 200
+    by_user = {r["user_id"]: r for r in response.json()["data"]}
+    assert by_user[str(viewer.id)]["status"] == "created"
+    failed = by_user[str(stranger.id)]
+    assert failed["status"] == "failed"
+    assert failed["assignment_id"] is None
+    assert failed["error"]["code"] == "not_found"
+    assert failed["error"]["details"] == {"resource": "member"}
+    listed = await client.get(_path(org), headers=owner.headers)
+    assert [a["user_id"] for a in listed.json()["data"]] == [str(viewer.id)]
+
+
+async def test_existing_assignment_and_ungrantable_role_fail_per_item(client, container):
+    org, owner, admin = await org_with_member(client, container, "admin")
+    first = await signed_in(client, container)
+    second = await signed_in(client, container)
+    third = await signed_in(client, container)
+    for user in (first, second, third):
+        await add_member(container, org["id"], user, "viewer")
+    member_role = await role_id(container, org["id"], "member")
+    owner_role = await role_id(container, org["id"], "owner")
+    existing = await client.post(
+        _path(org),
+        json={"user_id": str(first.id), "role_id": str(member_role)},
+        headers=owner.headers,
+    )
+    assert existing.status_code == 201
+
+    response = await client.post(
+        f"{_path(org)}:bulk",
+        json={
+            "items": [
+                {"user_id": str(first.id), "role_id": str(member_role)},
+                {"user_id": str(second.id), "role_id": str(owner_role)},
+                {"user_id": str(third.id), "role_id": str(member_role)},
+            ]
+        },
+        headers=admin.headers,
+    )
+
+    assert response.status_code == 200
+    by_user = {r["user_id"]: r for r in response.json()["data"]}
+    assert by_user[str(first.id)]["error"]["code"] == "conflict"
+    assert by_user[str(second.id)]["error"]["code"] == "permission_denied"
+    assert by_user[str(third.id)]["status"] == "created"
+    listed = await client.get(_path(org), headers=owner.headers)
+    assert sorted(a["user_id"] for a in listed.json()["data"]) == sorted(
+        [str(first.id), str(third.id)]
+    )
+
+
+async def test_bulk_needs_members_manage(client, container):
+    org, _, viewer = await org_with_member(client, container, "viewer")
+    member_role = await role_id(container, org["id"], "member")
+
+    response = await client.post(
+        f"{_path(org)}:bulk",
+        json={"items": [{"user_id": str(viewer.id), "role_id": str(member_role)}]},
+        headers=viewer.headers,
+    )
+
+    assert response.status_code == 403
+
+
+async def test_bulk_rejects_empty_and_oversized_requests(client, container):
+    org, owner, viewer = await org_with_member(client, container, "viewer")
+    member_role = await role_id(container, org["id"], "member")
+    item = {"user_id": str(viewer.id), "role_id": str(member_role)}
+
+    empty = await client.post(f"{_path(org)}:bulk", json={"items": []}, headers=owner.headers)
+    too_many = await client.post(
+        f"{_path(org)}:bulk", json={"items": [item] * 101}, headers=owner.headers
+    )
+
+    assert empty.status_code == 422
+    assert too_many.status_code == 422
