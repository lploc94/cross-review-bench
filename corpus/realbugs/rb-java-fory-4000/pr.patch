+  EXPECT_EQ(local.value(), expected.value());
+  Error error;
+  EXPECT_EQ(ctx.read_uint8(error), 0xc3);
+  EXPECT_TRUE(error.ok()) << error.to_string();
+  ctx.detach();
+}
