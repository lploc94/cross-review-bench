@@ -0,0 +1,43 @@
+import type { Queryable } from "../db/pool.js";
+
+/** A file's tags in byte order. */
+export async function listTags(db: Queryable, fileId: string): Promise<string[]> {
+  const result = await db.query<{ tag: string }>(
+    "SELECT tag FROM file_tags WHERE file_id = $1 ORDER BY tag",
+    [fileId],
+  );
+  return result.rows.map((row) => row.tag);
+}
+
+/**
+ * Add a tag unless the file already has `maxTags` of them; a tag the file already has is left as
+ * it is. Returns whether a row was inserted. The count is only reliable while the caller holds the
+ * file's row lock, which every writer of a file's tags takes first.
+ */
+export async function insertTagIfRoom(
+  db: Queryable,
+  tag: { fileId: string; tenantId: string; tag: string; maxTags: number; now: Date },
+): Promise<boolean> {
+  const result = await db.query(
+    `INSERT INTO file_tags (file_id, tenant_id, tag, created_at)
+     SELECT $1::uuid, $2::uuid, $3::text, $4::timestamptz
+     WHERE (SELECT count(*) FROM file_tags WHERE file_id = $1) < $5
+     ON CONFLICT ON CONSTRAINT file_tags_unique DO NOTHING`,
+    [tag.fileId, tag.tenantId, tag.tag, tag.now, tag.maxTags],
+  );
+  return result.rowCount === 1;
+}
+
+export async function hasTag(db: Queryable, fileId: string, tag: string): Promise<boolean> {
+  const result = await db.query("SELECT 1 FROM file_tags WHERE file_id = $1 AND tag = $2", [fileId, tag]);
+  return result.rowCount === 1;
+}
+
+export async function deleteTag(db: Queryable, fileId: string, tag: string): Promise<void> {
+  await db.query("DELETE FROM file_tags WHERE file_id = $1 AND tag = $2", [fileId, tag]);
+}
+
+/** Remove every tag of a file (it is being deleted or replaced). */
+export async function deleteTagsOf(db: Queryable, fileId: string): Promise<void> {
+  await db.query("DELETE FROM file_tags WHERE file_id = $1", [fileId]);
+}
