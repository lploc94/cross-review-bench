+import { CollectionNotKeptError, SyncClient, type SyncClientOptions } from "@sync/client";
+import { ManualClock, formatHlc, seededRandom, type CollectionName, type PullResponse, type SyncEvent } from "@sync/shared";
+import { describe, expect, it } from "vitest";
+import { ScriptedTransport } from "../helpers/clients.js";
+import { tempDbPath } from "../helpers/tempFiles.js";
+
+const clock = new ManualClock();
+const DEVICE = "0b6f4a52-8d0e-4c43-9a51-6d2f0e7a9c11";
+
+function event(seq: number, collection: CollectionName, docId: string, value: string): SyncEvent {
+  return {
+    seq,
+    mutationId: `00000000-0000-4000-8000-${String(seq).padStart(12, "0")}`,
+    deviceId: DEVICE,
+    collection,
+    docId,
+    field: "title",
+    value,
+    hlc: formatHlc({ wallMs: clock.now() - 1_000, counter: seq, node: "phone" }),
+    serverReceivedAt: new Date(clock.now()).toISOString(),
+  };
+}
+
+function page(events: SyncEvent[], nextAfter: number, hasMore = false): PullResponse {
+  return { events, nextAfter, hasMore };
+}
+
+/** The feed of these tests: notes and tasks interleaved. */
+const FEED = [event(1, "notes", "n1", "Trip"), event(2, "tasks", "t1", "Pack"), event(3, "notes", "n2", "Menu"), event(4, "tasks", "t2", "Shop")];
+
+function open(transport: ScriptedTransport, options: Partial<SyncClientOptions> = {}): SyncClient {
+  return SyncClient.open({ dbPath: ":memory:", transport, clock, random: seededRandom(3), pullLimit: 2, ...options });
+}
+
+/** Run `action` (another connection's work) when the transport is asked for its pull number `index`. */
+function beforePull(transport: ScriptedTransport, index: number, action: () => Promise<unknown>): void {
+  const pull = transport.pull.bind(transport);
+  transport.pull = async (request) => {
+    if (transport.pulls.length === index) await action();
+    return pull(request);
+  };
+}
+
+/** A replica of tasks only, at the end of a feed of [notes n1, tasks t1, notes n2]. */
+async function tasksOnlyReplica(): Promise<{ dbPath: string; feed: SyncEvent[] }> {
+  const feed = [event(1, "notes", "n1", "Trip"), event(2, "tasks", "t1", "Pack"), event(3, "notes", "n2", "Menu")];
+  const dbPath = tempDbPath();
+  const first = open(new ScriptedTransport().answerPull(page(feed, 3)), { dbPath, collections: ["tasks"], pullLimit: 3 });
+  await first.sync();
+  await first.close();
+  return { dbPath, feed };
+}
+
+describe("a replica of some collections", () => {
+  it("skips the other collections' events but moves its cursor past them", async () => {
+    const transport = new ScriptedTransport().answerPull(page(FEED.slice(0, 2), 2, true), page(FEED.slice(2), 4));
+    const client = open(transport, { collections: ["tasks"] });
+    expect(await client.sync()).toEqual({ pushed: 0, pulled: 4, applied: 2 });
+    expect(client.list("tasks").map((doc) => doc.fields.title)).toEqual(["Pack", "Shop"]);
+    expect(client.pullCursor()).toBe(4);
+    expect(client.collections()).toEqual({ kept: ["tasks"], pending: [] });
+    await client.close();
+  });
+
+  it("refuses to read or write the other collections", async () => {
+    const client = open(new ScriptedTransport(), { collections: ["tasks"] });
+    expect(() => client.set("notes", "n1", { title: "x" })).toThrow(CollectionNotKeptError);
+    expect(() => client.setMany([{ collection: "tasks", id: "t1", fields: { title: "ok" } }, { collection: "notes", id: "n1", fields: { title: "x" } }])).toThrow(
+      /does not keep notes/,
+    );
+    expect(() => client.get("notes", "n1")).toThrow(CollectionNotKeptError);
+    expect(() => client.list("notes")).toThrow(CollectionNotKeptError);
+    expect(client.pendingCount()).toBe(0);
+    await client.close();
+  });
+
+  it("rejects an empty, unknown or repeated collections option", () => {
+    for (const collections of [[], ["contacts"], ["notes", "notes"]]) {
+      expect(() => open(new ScriptedTransport(), { collections: collections as CollectionName[] })).toThrow(RangeError);
+    }
+  });
+
+  it("re-pulls an added collection only on resync(), resuming after a failure", async () => {
+    const dbPath = tempDbPath();
+    const transport = new ScriptedTransport().answerPull(page(FEED.slice(0, 2), 2, true), page(FEED.slice(2), 4));
+    const first = open(transport, { dbPath, collections: ["tasks"] });
+    await first.sync();
+    await first.close();
+
+    const client = open(transport, { dbPath, collections: ["notes", "tasks"] });
+    expect(client.collections()).toEqual({ kept: ["tasks"], pending: ["notes"] });
+    expect(() => client.get("notes", "n1")).toThrow(/call resync\(\) first/);
+    transport.answerPull(page([], 4));
+    await client.sync();
+    expect(() => client.list("notes")).toThrow(CollectionNotKeptError);
+
+    transport.answerPull(page(FEED.slice(0, 2), 2, true), new Error("connection reset"));
+    await expect(client.resync()).rejects.toThrow("connection reset");
+    expect(client.collections().pending).toEqual(["notes"]);
+
+    transport.answerPull(page(FEED.slice(2), 4), page([event(6, "notes", "n3", "Later")], 6));
+    expect(await client.resync()).toEqual({ pushed: 0, pulled: 2, applied: 2 });
+    expect(transport.pulls.slice(-4)).toEqual([
+      { after: 0, limit: 2 },
+      { after: 2, limit: 2 },
+      { after: 2, limit: 2 },
+      { after: 4, limit: 2 },
+    ]);
+    expect(client.list("notes").map((doc) => doc.fields.title)).toEqual(["Trip", "Menu", "Later"]);
+    expect(client.list("tasks")).toHaveLength(2);
+    expect(client.collections()).toEqual({ kept: ["notes", "tasks"], pending: [] });
+    await client.close();
+  });
+
+  it("re-pulls everything another connection skipped while the re-pull was running", async () => {
+    const feed = [event(1, "notes", "n1", "Trip"), event(2, "notes", "n2", "Menu"), event(3, "tasks", "t1", "Pack")];
+    const dbPath = tempDbPath();
+    const first = open(new ScriptedTransport().answerPull(page(feed.slice(0, 1), 1)), { dbPath, collections: ["tasks"] });
+    await first.sync();
+    await first.close();
+
+    // A adds notes and re-pulls; B, another connection to the file, syncs while A waits for its
+    // first page, which runs past A's cursor.
+    const transport = new ScriptedTransport().answerPull(page(feed.slice(0, 2), 2, true), page(feed.slice(2), 3), page([], 3));
+    const a = open(transport, { dbPath, collections: ["notes", "tasks"] });
+    const b = open(new ScriptedTransport().answerPull(page(feed.slice(1), 3)), { dbPath });
+    beforePull(transport, 0, () => b.sync());
+    await a.resync();
+    expect(b.pullCursor()).toBe(3);
+    expect(a.list("notes").map((doc) => doc.fields.title)).toEqual(["Trip", "Menu"]);
+    expect(a.list("tasks").map((doc) => doc.fields.title)).toEqual(["Pack"]);
+    await a.close();
+    await b.close();
+  });
+
+  it("starts over when another connection drops and adds the collection again mid-way", async () => {
+    const { dbPath, feed } = await tasksOnlyReplica();
+    const transport = new ScriptedTransport().answerPull(
+      page(feed.slice(0, 2), 2, true),
+      page(feed.slice(2), 3),
+      page(feed.slice(0, 2), 2, true),
+      page(feed.slice(2), 3),
+      page([], 3),
+    );
+    const a = open(transport, { dbPath, collections: ["notes", "tasks"] });
+    beforePull(transport, 1, async () => {
+      // Another process: notes left out (its documents deleted), then added back.
+      await open(new ScriptedTransport(), { dbPath, collections: ["tasks"] }).close();
+      await open(new ScriptedTransport(), { dbPath, collections: ["notes", "tasks"] }).close();
+    });
+    await a.resync();
+    expect(transport.pulls.map((request) => request.after)).toEqual([0, 2, 0, 2, 3]);
+    expect(a.list("notes").map((doc) => doc.fields.title)).toEqual(["Trip", "Menu"]);
+    await a.close();
+  });
+
+  it("lets a resync() finish quietly when another connection completed the same re-pull", async () => {
+    const { dbPath, feed } = await tasksOnlyReplica();
+    const transport = new ScriptedTransport().answerPull(page(feed.slice(0, 2), 2, true), page([], 3));
+    const a = open(transport, { dbPath, collections: ["notes", "tasks"] });
+    const b = open(new ScriptedTransport().answerPull(page(feed.slice(0, 2), 2, true), page(feed.slice(2), 3), page([], 3)), { dbPath });
+    beforePull(transport, 0, () => b.resync());
+    expect(await a.resync()).toEqual({ pushed: 0, pulled: 0, applied: 0 });
+    for (const client of [a, b]) {
+      expect(client.collections()).toEqual({ kept: ["notes", "tasks"], pending: [] });
+      expect(client.list("notes").map((doc) => doc.fields.title)).toEqual(["Trip", "Menu"]);
+    }
+    await a.close();
+    await b.close();
+  });
+
+  it("deletes the documents of a collection left out, keeping its unpushed writes", async () => {
+    const dbPath = tempDbPath();
+    const first = open(new ScriptedTransport(), { dbPath });
+    first.set("notes", "n1", { title: "Draft" });
+    first.set("tasks", "t1", { title: "Call" });
+    await first.close();
+
+    const client = open(new ScriptedTransport(), { dbPath, collections: ["tasks"] });
+    expect(() => client.get("notes", "n1")).toThrow(CollectionNotKeptError);
+    expect(client.get("tasks", "t1")?.fields).toEqual({ title: "Call" });
+    expect(client.pendingCount()).toBe(2);
+    await client.close();
+
+    const reopened = open(new ScriptedTransport(), { dbPath });
+    expect(reopened.collections()).toEqual({ kept: ["tasks"], pending: [] });
+    await reopened.close();
+  });
+});
