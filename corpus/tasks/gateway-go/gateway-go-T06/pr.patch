 	Response    HeaderTransform // applied to responses returned to the client
@@ -86,6 +87,16 @@ func (r *Route) ForwardPath(u *url.URL) (path, rawPath string) {
 	return path, rawPath
 }
 
+// Pool returns the balancer that serves a request: the canary's when the canary takes the
+// request, the route's own otherwise. key is the consumer id, or the client address on routes
+// without authentication; it makes the canary choice sticky.
+func (r *Route) Pool(req *http.Request, key string) *Balancer {
+	if r.Canary != nil && r.Canary.takes(req, key) {
+		return r.Canary.balancer
+	}
+	return r.balancer
+}
+
 // Next picks the upstream for the next attempt, see Balancer.Next.
 func (r *Route) Next(skip func(*Upstream) bool) *Upstream { return r.balancer.Next(skip) }
 
