+import type { PushResponse } from "@sync/shared";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { ConsistencyService } from "../../src/services/consistencyService.js";
+import { buildTestApp, type TestApp } from "../helpers/app.js";
+import { addDevice, createUser, hlc, mutation, pull, push, type TestDevice } from "../helpers/fixtures.js";
+
+let t: TestApp;
+let ada: TestDevice;
+let now: number;
+
+beforeEach(async () => {
+  t = await buildTestApp();
+  ada = await createUser(t);
+  now = t.clock.now();
+});
+
+afterEach(async () => {
+  await t.close();
+});
+
+function increment(delta: number, at: string) {
+  return mutation({ collection: "tasks", docId: "task-1", op: "increment", fields: { timeSpentSec: delta }, hlc: at });
+}
+
+async function task() {
+  const result = await t.pool.query<{ fields: Record<string, unknown>; updated_seq: string }>(
+    "SELECT fields, updated_seq FROM documents WHERE user_id = $1 AND collection = 'tasks' AND doc_id = 'task-1'",
+    [ada.userId],
+  );
+  return result.rows[0];
+}
+
+describe("counter fields", () => {
+  it("add up the increments of every device, whatever their timestamps", async () => {
+    const phone = await addDevice(t, ada);
+    await push(t, ada, [mutation({ collection: "tasks", docId: "task-1", fields: { title: "Write report" }, hlc: hlc(now - 50) })]);
+    await push(t, ada, [increment(600, hlc(now - 40))]);
+    await push(t, phone, [increment(300, hlc(now - 45, 0, "device-b")), increment(-60, hlc(now - 44, 0, "device-b"))]);
+    expect((await task())?.fields).toEqual({ title: "Write report", timeSpentSec: 840 });
+
+    const page = (await pull(t, ada)).json<{ events: { field: string; value: unknown; seq: number }[] }>();
+    expect(page.events.map((e) => [e.field, e.value])).toEqual([
+      ["title", "Write report"],
+      ["timeSpentSec", 600],
+      ["timeSpentSec", 300],
+      ["timeSpentSec", -60],
+    ]);
+    expect((await task())?.updated_seq).toBe(String(page.events.at(-1)?.seq));
+  });
+
+  it("counts an increment pushed again once", async () => {
+    const m = increment(120, hlc(now - 10));
+    await push(t, ada, [m]);
+    const again = await push(t, ada, [m, increment(30, hlc(now - 5))]);
+    expect(again.json<PushResponse>().acked).toHaveLength(2);
+    expect((await task())?.fields).toEqual({ timeSpentSec: 150 });
+  });
+
+  it("refuses to set a counter or to increment another field", async () => {
+    const set = await push(t, ada, [mutation({ collection: "tasks", docId: "task-1", fields: { timeSpentSec: 5 }, hlc: hlc(now) })]);
+    expect(set.statusCode).toBe(422);
+    const other = await push(t, ada, [mutation({ collection: "tasks", op: "increment", fields: { priority: 1 }, hlc: hlc(now) })]);
+    expect(other.statusCode).toBe(422);
+    expect(await task()).toBeUndefined();
+  });
+
+  it("leaves the documents consistent with the change feed", async () => {
+    await push(t, ada, [increment(10, hlc(now - 30)), mutation({ collection: "tasks", docId: "task-1", fields: { done: true }, hlc: hlc(now - 20) })]);
+    await push(t, ada, [increment(5, hlc(now - 10))]);
+    const report = await new ConsistencyService({ pool: t.pool, pageSize: 2 }).verifyUser(ada.userId);
+    expect(report).toMatchObject({ events: 3, documents: 1, problems: [] });
+  });
+});
