+package com.papertrail.workflow.config;
+
+import jakarta.validation.constraints.Max;
+import jakarta.validation.constraints.Min;
+import jakarta.validation.constraints.NotEmpty;
+import java.util.List;
+import java.util.Locale;
+import java.util.regex.Pattern;
+import org.springframework.boot.context.properties.ConfigurationProperties;
+import org.springframework.boot.context.properties.bind.DefaultValue;
+import org.springframework.validation.annotation.Validated;
+
+/**
+ * Limits for files attached to documents, under {@code workflow.attachments}: the largest file in
+ * bytes, how many files one document may hold, and the content types accepted.
+ */
+@Validated
+@ConfigurationProperties(prefix = "workflow.attachments")
+public record AttachmentSettings(
+    @DefaultValue("5242880") @Min(1) @Max(26_214_400) int maxBytes,
+    @DefaultValue("10") @Min(1) @Max(100) int maxPerDocument,
+    @DefaultValue({"application/pdf", "image/png", "image/jpeg", "text/plain"}) @NotEmpty
+        List<String> allowedTypes) {
+
+  private static final Pattern MEDIA_TYPE = Pattern.compile("[a-z0-9.+-]{1,49}/[a-z0-9.+-]{1,50}");
+
+  public AttachmentSettings {
+    allowedTypes =
+        allowedTypes == null
+            ? List.of()
+            : allowedTypes.stream()
+                .map(type -> type.trim().toLowerCase(Locale.ROOT))
+                .filter(type -> !type.isEmpty())
+                .toList();
+    for (String type : allowedTypes) {
+      if (!MEDIA_TYPE.matcher(type).matches()) {
+        throw new IllegalArgumentException(
+            "workflow.attachments.allowed-types takes types such as application/pdf");
+      }
+    }
+  }
+}
