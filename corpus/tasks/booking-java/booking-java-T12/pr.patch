+package com.innkeep.booking.service;
+
+import com.innkeep.booking.domain.StayRestriction;
+import java.time.LocalDate;
+
+/** One restriction of a room type, as an admin sends it and as it is listed. */
+public record StayRestrictionDraft(
+    LocalDate startDate, LocalDate endDate, Integer minStay, boolean closedToArrival) {
+
+  public static StayRestrictionDraft from(StayRestriction restriction) {
+    return new StayRestrictionDraft(
