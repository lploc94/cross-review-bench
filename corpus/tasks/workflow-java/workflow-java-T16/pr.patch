diff --git a/src/main/resources/db/migration/V3__out_of_office.sql b/src/main/resources/db/migration/V3__out_of_office.sql
new file mode 100644
index 0000000..ab0826b
--- /dev/null
+++ b/src/main/resources/db/migration/V3__out_of_office.sql
@@ -0,0 +1,15 @@
+-- An out-of-office period: inclusive dates in the business zone and the user who stands in.
+ALTER TABLE app_user
+    ADD COLUMN away_from     DATE,
+    ADD COLUMN away_until    DATE,
+    ADD COLUMN substitute_id BIGINT REFERENCES app_user (id),
+    ADD CONSTRAINT app_user_away CHECK (
+        (away_from IS NULL AND away_until IS NULL AND substitute_id IS NULL)
+        OR (away_from IS NOT NULL AND away_until IS NOT NULL AND away_until >= away_from
+            AND substitute_id IS NOT NULL AND substitute_id <> id)
+    );
+
+-- The absent assignee a task was created for, when a substitute holds it.
+ALTER TABLE approval_task
+    ADD COLUMN on_behalf_of_id BIGINT REFERENCES app_user (id),
+    ADD CONSTRAINT approval_task_on_behalf CHECK (on_behalf_of_id <> assignee_id);
