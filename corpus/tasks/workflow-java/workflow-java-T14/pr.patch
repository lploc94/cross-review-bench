+  }
+
+  private String sha256Of(long id) {
+    return jdbc.queryForObject(
+        "select encode(sha256(content), 'hex') from document_attachment where id = ?",
+        String.class,
+        id);
+  }
+
+  @Test
+  void strangersGetNotFoundAndViewersOnlyRead() throws Exception {
+    long id = uploaded("receipt.txt");
+    long stranger = data.user("Omar Lind");
+    long viewer = data.user("Nadia Roy");
+    permissions.grant(data.principal(owner), document, viewer, PermissionLevel.VIEW);
+
+    mvc.perform(get(path()).header(AUTH, data.bearer(stranger))).andExpect(status().isNotFound());
+    mvc.perform(get(path() + "/" + id).header(AUTH, data.bearer(stranger)))
+        .andExpect(status().isNotFound());
+    upload(stranger, "x.txt", "text/plain", RECEIPT).andExpect(status().isNotFound());
+    mvc.perform(get(path() + "/" + id).header(AUTH, data.bearer(viewer)))
+        .andExpect(status().isOk());
+    upload(viewer, "x.txt", "text/plain", RECEIPT).andExpect(status().isForbidden());
+    mvc.perform(delete(path() + "/" + id).header(AUTH, data.bearer(viewer)))
+        .andExpect(status().isForbidden());
+  }
+
+  @Test
+  void sizeTypeAndCountLimitsAreProblems() throws Exception {
+    upload(owner, "big.txt", "text/plain", new byte[4097])
+        .andExpect(status().isPayloadTooLarge())
+        .andExpect(jsonPath("$.type").value("urn:workflow:problem:too-large"));
+    upload(owner, "page.html", "text/html", RECEIPT)
+        .andExpect(status().isUnsupportedMediaType())
+        .andExpect(jsonPath("$.type").value("urn:workflow:problem:unsupported-media-type"));
+    upload(owner, "empty.txt", "text/plain", new byte[0]).andExpect(status().isBadRequest());
+    upload(owner, "full.txt", "text/plain", new byte[4096]).andExpect(status().isCreated());
+    upload(owner, "b.pdf", "application/pdf", RECEIPT).andExpect(status().isCreated());
+    upload(owner, "c.png", "image/png", RECEIPT).andExpect(status().isCreated());
+
+    upload(owner, "d.png", "image/png", RECEIPT)
+        .andExpect(status().isConflict())
+        .andExpect(jsonPath("$.type").value("urn:workflow:problem:conflict"));
+  }
+
+  @Test
+  void aFileNameIsCountedInCharactersNotUtf16Units() throws Exception {
+    String wide = Character.toString(0x20000); // two UTF-16 units, one character
+    String name = wide.repeat(200);
+
+    upload(owner, name + wide, "text/plain", RECEIPT).andExpect(status().isBadRequest());
+    upload(owner, name, "text/plain", RECEIPT).andExpect(status().isCreated());
+
+    assertThat(jdbc.queryForObject("select file_name from document_attachment", String.class))
+        .isEqualTo(name);
+  }
+
+  @Test
+  void attachmentsChangeOnlyWhileTheDocumentIsADraft() throws Exception {
+    long first = uploaded("a.txt");
+    long second = uploaded("b.txt");
+    mvc.perform(delete(path() + "/" + first).header(AUTH, data.bearer(owner)))
+        .andExpect(status().isNoContent());
+    documents.submit(data.principal(owner), document);
+
+    upload(owner, "c.txt", "text/plain", RECEIPT)
+        .andExpect(status().isConflict())
+        .andExpect(jsonPath("$.type").value("urn:workflow:problem:invalid-transition"));
+    mvc.perform(delete(path() + "/" + second).header(AUTH, data.bearer(owner)))
+        .andExpect(status().isConflict());
+    assertThat(jdbc.queryForObject("select count(*) from document_attachment", Integer.class))
+        .isEqualTo(1);
+  }
+}
