+-- Labels a tenant attaches to its accounts ({"team": "payments"}): a flat object of strings,
+-- validated by the API. The GIN index serves the containment filter `labels @> '{"k": "v"}'`.
+ALTER TABLE accounts
+    ADD COLUMN labels jsonb NOT NULL DEFAULT '{}'::jsonb
+        CONSTRAINT accounts_labels_object_check CHECK (jsonb_typeof(labels) = 'object');
+
+CREATE INDEX accounts_labels_idx ON accounts USING gin (labels jsonb_path_ops);
