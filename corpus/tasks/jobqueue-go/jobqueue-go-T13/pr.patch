+package store_test
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/relaywork/jobqueue/internal/domain"
+)
+
+func TestReportProgress(t *testing.T) {
+	s, clk := newStore(t)
+	ctx := context.Background()
+	job := mustEnqueue(t, s, domain.NewJob{})
+	if got := mustGet(t, s, job.ID); got.Progress != nil {
+		t.Fatalf("new job has progress %+v", got.Progress)
+	}
+	mustLease(t, s, "default", "w1", 1)
+
+	clk.Advance(time.Second)
+	if err := s.ReportProgress(ctx, job.ID, "w1", 25, "fetched 1 of 4 pages"); err != nil {
+		t.Fatal(err)
+	}
+	clk.Advance(time.Second)
+	if err := s.ReportProgress(ctx, job.ID, "w1", 50, ""); err != nil {
+		t.Fatal(err)
+	}
+	got := mustGet(t, s, job.ID)
+	want := domain.Progress{Percent: 50, UpdatedAt: clk.Now()}
+	if got.Progress == nil || *got.Progress != want {
+		t.Fatalf("progress = %+v, want %+v", got.Progress, want)
+	}
+	if !got.UpdatedAt.Equal(clk.Now()) {
+		t.Errorf("updated_at = %s, want %s", got.UpdatedAt, clk.Now())
+	}
+
+	t.Run("other worker", func(t *testing.T) {
+		wantErr(t, s.ReportProgress(ctx, job.ID, "w2", 90, ""), domain.ErrLeaseLost)
+	})
+	t.Run("invalid", func(t *testing.T) {
+		var verr *domain.ValidationError
+		if err := s.ReportProgress(ctx, job.ID, "w1", 101, ""); !errors.As(err, &verr) {
+			t.Errorf("error = %v, want a ValidationError", err)
+		}
+	})
+	if err := s.Complete(ctx, job.ID, "w1"); err != nil {
+		t.Fatal(err)
+	}
+	t.Run("after the attempt", func(t *testing.T) {
+		wantErr(t, s.ReportProgress(ctx, job.ID, "w1", 100, ""), domain.ErrLeaseLost)
+		if got := mustGet(t, s, job.ID); got.Progress == nil || got.Progress.Percent != 50 {
+			t.Errorf("progress after completion = %+v, want the last report kept", got.Progress)
+		}
+	})
+}
+
+func TestProgressIsClearedForTheNextAttempt(t *testing.T) {
+	s, clk := newStore(t)
+	ctx := context.Background()
+	job := mustEnqueue(t, s, domain.NewJob{MaxAttempts: 2})
+
+	mustLease(t, s, "default", "w1", 1)
+	if err := s.ReportProgress(ctx, job.ID, "w1", 70, "almost"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.Fail(ctx, job.ID, "w1", "timeout", clk.Now()); err != nil {
+		t.Fatal(err)
+	}
+	if got := mustGet(t, s, job.ID); got.Progress == nil || got.Progress.Percent != 70 {
+		t.Fatalf("progress of the failed attempt = %+v, want it kept", got.Progress)
+	}
+	leased := mustLease(t, s, "default", "w2", 1)
+	if len(leased) != 1 || leased[0].Progress != nil {
+		t.Fatalf("second attempt leased %+v, want no progress", leased)
+	}
+
+	if err := s.ReportProgress(ctx, job.ID, "w2", 10, ""); err != nil {
+		t.Fatal(err)
+	}
+	if dead, err := s.Fail(ctx, job.ID, "w2", "timeout", clk.Now()); err != nil || dead.State != domain.StateDead {
+		t.Fatalf("Fail = %+v, %v; want dead", dead, err)
+	}
+	requeued, err := s.Requeue(ctx, job.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if requeued.Progress != nil {
+		t.Errorf("requeued job progress = %+v, want none", requeued.Progress)
+	}
+}
