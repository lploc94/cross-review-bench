diff --git a/src/main/java/com/innkeep/booking/service/StayRestrictionService.java b/src/main/java/com/innkeep/booking/service/StayRestrictionService.java
new file mode 100644
index 0000000..8ef5437
--- /dev/null
+++ b/src/main/java/com/innkeep/booking/service/StayRestrictionService.java
@@ -0,0 +1,123 @@
+package com.innkeep.booking.service;
+
+import com.innkeep.booking.config.BookingConfig;
+import com.innkeep.booking.domain.DateRange;
+import com.innkeep.booking.domain.RoomType;
+import com.innkeep.booking.domain.StayRestrictedException;
+import com.innkeep.booking.domain.StayRestriction;
+import com.innkeep.booking.domain.ValidationException;
+import com.innkeep.booking.persistence.RoomTypeRepository;
+import com.innkeep.booking.persistence.StayRestrictionRepository;
+import java.time.LocalDate;
+import java.time.temporal.ChronoUnit;
+import java.util.List;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.support.TransactionTemplate;
+
+/**
+ * Minimum-stay and closed-to-arrival rules per room type. Only the rules of a stay's arrival night
+ * count; where restrictions overlap the strictest wins: closed if any of them closes the night,
+ * else the longest minimum.
+ */
+@Service
+public class StayRestrictionService {
+
+  private static final int MAX_RESTRICTIONS = 100;
+  private static final int MAX_NIGHTS = 366;
+
+  private final CatalogService catalog;
+  private final StayRestrictionRepository restrictions;
+  private final BookingConfig config;
+  private final TransactionTemplate tx;
+  private final RoomTypeRepository roomTypes;
+
+  public StayRestrictionService(
+      CatalogService catalog,
+      StayRestrictionRepository restrictions,
+      BookingConfig config,
+      TransactionTemplate tx,
+      RoomTypeRepository roomTypes) {
+    this.catalog = catalog;
+    this.restrictions = restrictions;
+    this.config = config;
+    this.tx = tx;
+    this.roomTypes = roomTypes;
+  }
+
+  /** Throws {@link StayRestrictedException} when the stay breaks a rule of its arrival night. */
+  public void requireAllowed(RoomType type, DateRange stay) {
+    LocalDate arrival = stay.checkIn();
+    int minimum = 1;
+    for (StayRestriction restriction : restrictions.findCovering(type.getId(), arrival)) {
+      if (restriction.isClosedToArrival()) {
+        throw new StayRestrictedException(
+            "closed-to-arrival", arrival, "arrival on " + arrival + " is closed");
+      }
+      if (restriction.getMinStay() != null) {
+        minimum = Math.max(minimum, restriction.getMinStay());
+      }
+    }
+    if (stay.nights() < minimum) {
+      throw new StayRestrictedException(
+          "min-stay",
+          arrival,
+          "a stay arriving on " + arrival + " must last at least " + minimum + " nights");
+    }
+  }
+
+  public List<StayRestriction> list(String propertyCode, String roomTypeCode) {
+    return restrictions.findByRoomTypeIdOrderByStartDateAscIdAsc(
+        catalog.roomType(propertyCode, roomTypeCode).getId());
+  }
+
+  /**
+   * Replaces every restriction of the room type with the given ones (none clears them). The room
+   * type row is locked first, so two replacements of the same room type apply one after the other.
+   * The lock is {@code FOR NO KEY UPDATE}: rows that reference the room type (holds, reservations,
+   * inventory) take a key share lock on insert, which it does not block.
+   */
+  public List<StayRestriction> replace(
+      String propertyCode, String roomTypeCode, List<StayRestrictionDraft> drafts) {
+    if (drafts.size() > MAX_RESTRICTIONS) {
+      throw new ValidationException("at most " + MAX_RESTRICTIONS + " restrictions per room type");
+    }
+    drafts.forEach(this::validate);
+    return tx.execute(
+        status -> {
+          RoomType type = catalog.roomType(propertyCode, roomTypeCode);
+          roomTypes.lockForUpdate(type.getId());
+          restrictions.deleteByRoomType(type.getId());
+          for (StayRestrictionDraft draft : drafts) {
+            restrictions.save(
+                new StayRestriction(
+                    type,
+                    draft.startDate(),
+                    draft.endDate(),
+                    draft.minStay(),
+                    draft.closedToArrival()));
+          }
+          return restrictions.findByRoomTypeIdOrderByStartDateAscIdAsc(type.getId());
+        });
+  }
+
+  private void validate(StayRestrictionDraft draft) {
+    if (draft == null
+        || draft.startDate() == null
+        || draft.endDate() == null
+        || draft.endDate().isBefore(draft.startDate())
+        || ChronoUnit.DAYS.between(draft.startDate(), draft.endDate()) >= MAX_NIGHTS) {
+      throw new ValidationException(
+          "a restriction needs a start date and an end date on or after it, at most "
+              + MAX_NIGHTS
+              + " nights apart");
+    }
+    if (draft.minStay() == null && !draft.closedToArrival()) {
+      throw new ValidationException("a restriction needs a minimum stay or closed to arrival");
+    }
+    if (draft.minStay() != null
+        && (draft.minStay() < 1 || draft.minStay() > config.maxNightsPerStay())) {
+      throw new ValidationException(
+          "minimum stay must be between 1 and " + config.maxNightsPerStay() + " nights");
+    }
+  }
+}
