+package store_test
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/relaywork/jobqueue/internal/domain"
+)
+
+func TestQueueStats(t *testing.T) {
+	s, clk := newStore(t)
+	ctx := context.Background()
+	a := mustEnqueue(t, s, domain.NewJob{Queue: "alpha"})
+	mustEnqueue(t, s, domain.NewJob{Queue: "alpha"})
+	mustEnqueue(t, s, domain.NewJob{Queue: "alpha", RunAt: t0.Add(time.Hour)})
+	cancelled := mustEnqueue(t, s, domain.NewJob{Queue: "beta"})
+	if _, err := s.Cancel(ctx, cancelled.ID); err != nil {
+		t.Fatal(err)
+	}
+	clk.Advance(time.Minute)
+	if leased := mustLease(t, s, "alpha", "w1", 1); len(leased) != 1 || leased[0].ID != a.ID {
+		t.Fatalf("leased %v, want job %d", ids(leased), a.ID)
+	}
+
+	stats, err := s.QueueStats(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(stats) != 2 || stats[0].Queue != "alpha" || stats[1].Queue != "beta" {
+		t.Fatalf("QueueStats = %+v", stats)
+	}
+	alpha := stats[0]
+	if alpha.Counts[domain.StateAvailable] != 2 || alpha.Counts[domain.StateRunning] != 1 || alpha.Total() != 3 ||
+		len(alpha.Counts) != len(domain.States) {
+		t.Errorf("alpha counts = %v", alpha.Counts)
+	}
+	if alpha.OldestAvailable == nil || !alpha.OldestAvailable.Equal(t0) {
+		t.Errorf("alpha oldest available = %v, want %s", alpha.OldestAvailable, t0)
+	}
+	beta := stats[1]
+	if beta.Counts[domain.StateCancelled] != 1 || beta.Total() != 1 || beta.OldestAvailable != nil {
+		t.Errorf("beta = %+v", beta)
+	}
+}
