+    async def _record_failure(self, user_id: uuid.UUID) -> None:
+        """Count a wrong password and lock the account once the count reaches the threshold.
+
+        Failures while the account is locked are counted but do not extend the lock; the first
+        failure after a lock has expired starts the count over.
+        """
+        now = self._clock.now()
+        async with self._db.transaction() as session:
+            users = UserRepository(session)
+            user = await users.get(user_id, for_update=True)
+            if user is None:
+                return
+            if user.is_locked(now):
+                await users.set_login_failures(user, user.failed_logins + 1, user.locked_until)
+                log.info("auth.login_failed", reason="locked", user_id=str(user_id))
+                return
+            failures = 1 if user.locked_until is not None else user.failed_logins + 1
+            locked_until = None
+            if failures >= self._policy.lockout_threshold:
+                locked_until = now + self._policy.lockout_duration
+            await users.set_login_failures(user, failures, locked_until)
+        if locked_until is None:
+            log.info("auth.login_failed", reason="bad_password", user_id=str(user_id))
+        else:
+            log.warning(
+                "auth.account_locked",
+                user_id=str(user_id),
+                failures=failures,
+                locked_until=locked_until.isoformat(),
+            )
