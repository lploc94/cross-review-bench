diff --git a/internal/api/queues.go b/internal/api/queues.go
new file mode 100644
index 0000000..083e966
--- /dev/null
+++ b/internal/api/queues.go
@@ -0,0 +1,80 @@
+package api
+
+import (
+	"context"
+	"net/http"
+
+	"github.com/relaywork/jobqueue/internal/domain"
+	"github.com/relaywork/jobqueue/internal/metrics"
+	"github.com/relaywork/jobqueue/internal/store"
+)
+
+// queueJSON is the API representation of a queue's statistics.
+type queueJSON struct {
+	Queue  string                 `json:"queue"`
+	Counts map[domain.State]int64 `json:"counts"`
+	Total  int64                  `json:"total"`
+	// OldestAvailableAgeSeconds is how long the oldest due available job has been waiting.
+	OldestAvailableAgeSeconds *float64 `json:"oldest_available_age_seconds"`
+}
+
+func (s *Server) toQueueJSON(q store.QueueStats) queueJSON {
+	out := queueJSON{Queue: q.Queue, Counts: q.Counts, Total: q.Total()}
+	if q.OldestAvailable != nil {
+		age := max(s.clock.Now().Sub(*q.OldestAvailable).Seconds(), 0)
+		out.OldestAvailableAgeSeconds = &age
+	}
+	return out
+}
+
+// GET /v1/queues lists every queue that has jobs, with its statistics.
+func (s *Server) listQueues(w http.ResponseWriter, r *http.Request) error {
+	stats, err := s.store.QueueStats(r.Context())
+	if err != nil {
+		return err
+	}
+	out := struct {
+		Queues []queueJSON `json:"queues"`
+	}{Queues: make([]queueJSON, len(stats))}
+	for i, q := range stats {
+		out.Queues[i] = s.toQueueJSON(q)
+	}
+	s.writeJSON(w, http.StatusOK, out)
+	return nil
+}
+
+// GET /v1/queues/{queue} returns one queue's statistics; a queue without jobs has zero counts.
+func (s *Server) getQueue(w http.ResponseWriter, r *http.Request) error {
+	queue := r.PathValue("queue")
+	if err := domain.ValidateQueueName(queue); err != nil {
+		return domain.Invalid("queue", "%s", err)
+	}
+	q, err := s.store.QueueStatsOf(r.Context(), queue)
+	if err != nil {
+		return err
+	}
+	s.writeJSON(w, http.StatusOK, s.toQueueJSON(q))
+	return nil
+}
+
+// registerQueueMetrics exposes the number of jobs per queue and state as a gauge that is
+// refreshed from the store on each scrape of /metrics.
+func (s *Server) registerQueueMetrics(reg *metrics.Registry) {
+	s.queued = reg.NewGauge("jobqueue_queue_jobs", "Jobs per queue and state.", "queue", "state")
+	reg.Collect(s.collectQueueStats)
+}
+
+// collectQueueStats refreshes the queue gauge. A failure is logged and leaves the previous
+// values in place: the scrape itself must not fail because of it.
+func (s *Server) collectQueueStats(ctx context.Context) {
+	stats, err := s.store.QueueStats(ctx)
+	if err != nil {
+		s.log.Warn("collect queue statistics", "error", err)
+		return
+	}
+	for _, q := range stats {
+		for _, state := range domain.States {
+			s.queued.Set(float64(q.Counts[state]), q.Queue, string(state))
+		}
+	}
+}
