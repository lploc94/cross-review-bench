+  /**
+   * Searches the titles of the documents the caller can see, best match first. The query takes web
+   * search syntax: words, "quoted phrases", {@code or} and {@code -word}.
+   */
+  @Transactional(readOnly = true)
+  public SearchPageView search(Principal actor, String text, String cursor, Integer size) {
+    if (text == null || text.isBlank()) {
+      throw new ValidationException("q is required");
+    }
+    String query = text.trim();
+    if (query.length() > MAX_QUERY) {
+      throw new ValidationException("q may not exceed " + MAX_QUERY + " characters");
+    }
+    int limit = Pages.limit(size);
+    TitleMatch.Page page =
+        documents.searchVisible(
+            actor.userId(), actor.admin(), query, decodeCursor(cursor), limit + 1);
+    List<TitleMatch> rows = page.matches();
+    boolean more = rows.size() > limit;
+    List<TitleMatch> kept = more ? rows.subList(0, limit) : rows;
+    Map<Long, Document> byId =
+        kept.isEmpty()
+            ? Map.of()
+            : documents.findDetailsByIdIn(kept.stream().map(TitleMatch::id).toList()).stream()
+                .collect(Collectors.toMap(Document::getId, Function.identity()));
+    List<DocumentSummary> items =
+        kept.stream().map(match -> DocumentSummary.of(byId.get(match.id()))).toList();
+    String next = more ? encodeCursor(kept.get(kept.size() - 1)) : null;
+    return new SearchPageView(items, page.total(), next);
+  }
+
+  /** A search cursor is the rank and id of the last match on the previous page. */
+  static String encodeCursor(TitleMatch last) {
+    return last.rank() + ":" + last.id();
+  }
+
+  static TitleMatch decodeCursor(String cursor) {
+    if (cursor == null) {
+      return null;
+    }
+    int colon = cursor.indexOf(':');
+    try {
+      if (colon > 0) {
+        float rank = Float.parseFloat(cursor.substring(0, colon));
+        long id = Long.parseLong(cursor.substring(colon + 1));
+        if (Float.isFinite(rank)) {
+          return new TitleMatch(id, rank);
+        }
+      }
+    } catch (NumberFormatException e) {
+      // reported below
+    }
+    throw new ValidationException("cursor is not a search cursor");
+  }
+
