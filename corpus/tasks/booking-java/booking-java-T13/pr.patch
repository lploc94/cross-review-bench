diff --git a/src/test/java/com/innkeep/booking/service/ReservationNoShowTest.java b/src/test/java/com/innkeep/booking/service/ReservationNoShowTest.java
new file mode 100644
index 0000000..27606f7
--- /dev/null
+++ b/src/test/java/com/innkeep/booking/service/ReservationNoShowTest.java
@@ -0,0 +1,224 @@
+package com.innkeep.booking.service;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import com.innkeep.booking.domain.ConflictException;
+import com.innkeep.booking.domain.Property;
+import com.innkeep.booking.domain.Reservation;
+import com.innkeep.booking.domain.ReservationStatus;
+import com.innkeep.booking.domain.RoomType;
+import com.innkeep.booking.support.IntegrationTestBase;
+import com.innkeep.booking.support.LogCapture;
+import java.sql.Date;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.transaction.PlatformTransactionManager;
+import org.springframework.transaction.support.TransactionTemplate;
+
+class ReservationNoShowTest extends IntegrationTestBase {
+
+  // Thursday 10 June to Sunday 13 June 2027: 100.00, then 110.00 on Friday and Saturday.
+  private static final LocalDate CHECK_IN = LocalDate.parse("2027-06-10");
+  private static final LocalDate CHECK_OUT = LocalDate.parse("2027-06-13");
+  // 11:00 on 11 June in Lisbon (UTC+1 in summer).
+  private static final Instant NO_SHOW_FROM = Instant.parse("2027-06-11T10:00:00Z");
+
+  @Autowired private ReservationService reservations;
+  @Autowired private BookingMaintenanceJob maintenance;
+  @Autowired private PlatformTransactionManager transactions;
+
+  private Property property;
+  private RoomType room;
+  private Reservation reservation;
+
+  @BeforeEach
+  void setUp() {
+    property = data.harbourHouse();
+    room = data.roomType(property, "double", 2, "100.00");
+    data.rooms(property, room, CHECK_IN, CHECK_OUT, 3);
+    reservation = data.book(property, room, CHECK_IN, CHECK_OUT, 1);
+  }
+
+  @Test
+  void aStayCannotBeMarkedBeforeTheCheckOutTimeOfTheDayAfterArrival() {
+    clock.set(NO_SHOW_FROM.minusSeconds(1));
+
+    assertThatThrownBy(() -> reservations.markNoShow(reservation.getReference()))
+        .isInstanceOf(ConflictException.class)
+        .hasMessageContaining("no-show");
+    assertThat(reservations.get(reservation.getReference()).getStatus())
+        .isEqualTo(ReservationStatus.CONFIRMED);
+    assertThat(payments.refundCount()).isZero();
+  }
+
+  @Test
+  void theFirstNightIsKeptAndTheRestIsRefundedAndReleased() {
+    clock.set(NO_SHOW_FROM);
+
+    NoShowOutcome outcome = reservations.markNoShow(reservation.getReference());
+
+    assertThat(outcome.reservation().getStatus()).isEqualTo(ReservationStatus.NO_SHOW);
+    assertThat(outcome.fee().amount().toPlainString()).isEqualTo("100.00");
+    assertThat(outcome.refund().amount().toPlainString()).isEqualTo("220.00");
+    assertThat(payments.movements().get(1).key()).isEqualTo("no-show-" + reservation.getId());
+    assertThat(booked(room, CHECK_IN)).isEqualTo(1);
+    assertThat(booked(room, CHECK_IN.plusDays(1))).isZero();
+    assertThat(booked(room, CHECK_IN.plusDays(2))).isZero();
+  }
+
+  @Test
+  void aNoShowIsNeitherCheckedInNorCancelledNorMarkedTwice() {
+    clock.set(NO_SHOW_FROM);
+    reservations.markNoShow(reservation.getReference());
+
+    assertThatThrownBy(() -> reservations.checkIn(reservation.getReference()))
+        .isInstanceOf(ConflictException.class);
+    assertThatThrownBy(() -> reservations.cancel(reservation.getReference()))
+        .isInstanceOf(ConflictException.class);
+    assertThatThrownBy(() -> reservations.markNoShow(reservation.getReference()))
+        .isInstanceOf(ConflictException.class);
+    assertThat(payments.refundCount()).isEqualTo(1);
+  }
+
+  @Test
+  void theJobMarksOnlyDueConfirmedStaysAndOnlyOnce() {
+    Reservation arrived = data.book(property, room, CHECK_IN, CHECK_OUT, 1);
+    Reservation later = data.book(property, room, CHECK_IN.plusDays(1), CHECK_OUT, 1);
+    clock.set(Instant.parse("2027-06-10T16:00:00Z"));
+    reservations.checkIn(arrived.getReference());
+    clock.set(NO_SHOW_FROM);
+
+    assertThat(maintenance.markNoShows()).isEqualTo(1);
+    assertThat(maintenance.markNoShows()).isZero();
+
+    assertThat(reservations.get(reservation.getReference()).getStatus())
+        .isEqualTo(ReservationStatus.NO_SHOW);
+    assertThat(reservations.get(arrived.getReference()).getStatus())
+        .isEqualTo(ReservationStatus.CHECKED_IN);
+    assertThat(reservations.get(later.getReference()).getStatus())
+        .isEqualTo(ReservationStatus.CONFIRMED);
+    assertThat(payments.refundCount()).isEqualTo(1);
+  }
+
+  @Test
+  void aDeclinedRefundSkipsThatStayAndTheJobMarksTheOthers() throws Exception {
+    Reservation second = data.book(property, room, CHECK_IN, CHECK_OUT, 1);
+    clock.set(NO_SHOW_FROM);
+    payments.failNextRefund();
+
+    String logged =
+        LogCapture.during(
+            ReservationService.class.getName(),
+            () -> assertThat(maintenance.markNoShows()).isEqualTo(1));
+
+    assertThat(reservations.get(reservation.getReference()).getStatus())
+        .isEqualTo(ReservationStatus.CONFIRMED);
+    assertThat(reservations.get(second.getReference()).getStatus())
+        .isEqualTo(ReservationStatus.NO_SHOW);
+    assertThat(booked(room, CHECK_IN.plusDays(1))).isEqualTo(1);
+    assertThat(logged)
+        .contains("\"reservationId\":" + reservation.getId())
+        .contains("PaymentFailedException")
+        .doesNotContain(reservation.getReference());
+
+    assertThat(maintenance.markNoShows()).isEqualTo(1);
+    assertThat(reservations.get(reservation.getReference()).getStatus())
+        .isEqualTo(ReservationStatus.NO_SHOW);
+    assertThat(payments.refundCount()).isEqualTo(2);
+  }
+
+  @Test
+  void anyOtherFailureForOneStaySkipsItAndTheJobMarksTheOthers() throws Exception {
+    Reservation second = data.book(property, room, CHECK_IN, CHECK_OUT, 1);
+    clock.set(NO_SHOW_FROM);
+    payments.failNextRefundWith(new IllegalStateException("gateway client misconfigured"));
+
+    String logged =
+        LogCapture.during(
+            ReservationService.class.getName(),
+            () -> assertThat(maintenance.markNoShows()).isEqualTo(1));
+
+    assertThat(reservations.get(reservation.getReference()).getStatus())
+        .isEqualTo(ReservationStatus.CONFIRMED);
+    assertThat(reservations.get(second.getReference()).getStatus())
+        .isEqualTo(ReservationStatus.NO_SHOW);
+    assertThat(logged)
+        .contains("no-show skipped")
+        .contains("\"reservationId\":" + reservation.getId())
+        .contains("IllegalStateException")
+        .doesNotContain("misconfigured")
+        .doesNotContain(reservation.getReference());
+  }
+
+  @Test
+  void aStayWhoseInventoryRowIsBusyIsSkippedWithinTheLockTimeout() throws Exception {
+    RoomType suite = data.roomType(property, "suite", 2, "200.00");
+    data.rooms(property, suite, CHECK_IN, CHECK_OUT, 1);
+    Reservation other = data.book(property, suite, CHECK_IN, CHECK_OUT, 1);
+    clock.set(NO_SHOW_FROM);
+    var locked = new CountDownLatch(1);
+    var release = new CountDownLatch(1);
+    try (var pool = Executors.newSingleThreadExecutor()) {
+      var blocker =
+          pool.submit(
+              () ->
+                  new TransactionTemplate(transactions)
+                      .execute(
+                          status -> {
+                            jdbc.update(
+                                "update inventory set booked = booked"
+                                    + " where room_type_id = ? and night = ?",
+                                room.getId(),
+                                Date.valueOf(CHECK_IN.plusDays(1)));
+                            locked.countDown();
+                            awaitQuietly(release);
+                            return null;
+                          }));
+      assertThat(locked.await(10, TimeUnit.SECONDS)).isTrue();
+
+      assertThat(maintenance.markNoShows()).isEqualTo(1);
+
+      release.countDown();
+      blocker.get(10, TimeUnit.SECONDS);
+    }
+    assertThat(reservations.get(reservation.getReference()).getStatus())
+        .isEqualTo(ReservationStatus.CONFIRMED);
+    assertThat(reservations.get(other.getReference()).getStatus())
+        .isEqualTo(ReservationStatus.NO_SHOW);
+
+    assertThat(maintenance.markNoShows()).isEqualTo(1);
+    assertThat(reservations.get(reservation.getReference()).getStatus())
+        .isEqualTo(ReservationStatus.NO_SHOW);
+    assertThat(booked(room, CHECK_IN.plusDays(1))).isZero();
+  }
+
+  private static void awaitQuietly(CountDownLatch latch) {
+    try {
+      latch.await(30, TimeUnit.SECONDS);
+    } catch (InterruptedException e) {
+      Thread.currentThread().interrupt();
+    }
+  }
+
+  @Test
+  void theLogNamesTheReservationIdButNotItsReference() throws Exception {
+    clock.set(NO_SHOW_FROM);
+
+    String logged =
+        LogCapture.during(
+            ReservationService.class.getName(),
+            () -> reservations.markNoShow(reservation.getReference()));
+
+    assertThat(logged)
+        .doesNotContain(reservation.getReference())
+        .contains("\"reservationId\":" + reservation.getId())
+        .contains("\"refundAmount\":220.00");
+  }
+}
