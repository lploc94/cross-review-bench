diff --git a/tests/pipeline/test_metrics.py b/tests/pipeline/test_metrics.py
new file mode 100644
index 0000000..57f7bb0
--- /dev/null
+++ b/tests/pipeline/test_metrics.py
@@ -0,0 +1,118 @@
+"""The Prometheus textfile-collector file written after every run."""
+
+from __future__ import annotations
+
+import stat
+from pathlib import Path
+
+import pytest
+
+from etl.config import load_settings
+from etl.errors import ConfigError, TooManyRejects
+from etl.pipeline.runner import Pipeline
+from tests.helpers.clock import DEFAULT_NOW
+from tests.helpers.factories import product_row, write_products
+
+URL = "postgresql://etl:secret@db.internal:5432/warehouse"
+
+
+@pytest.fixture
+def metrics_file(tmp_path: Path) -> Path:
+    directory = tmp_path / "textfile"
+    directory.mkdir()
+    return directory / "etl.prom"
+
+
+@pytest.fixture
+def metered(db, settings, clock, metrics_file) -> Pipeline:
+    return Pipeline(db, settings.model_copy(update={"metrics_file": metrics_file}), clock)
+
+
+def samples(path: Path) -> dict[str, float]:
+    values = {}
+    for line in path.read_text(encoding="utf-8").splitlines():
+        if line and not line.startswith("#"):
+            name, value = line.rsplit(" ", 1)
+            values[name] = float(value)
+    return values
+
+
+def test_without_a_metrics_file_nothing_is_written(pipeline, tmp_path):
+    pipeline.run("products", write_products(tmp_path, [product_row()]))
+
+    assert list(tmp_path.rglob("*.prom")) == []
+
+
+def test_a_successful_run_is_described(metered, metrics_file, tmp_path):
+    rows = [product_row(sku="A"), product_row(sku="B")]
+    metered.run("products", write_products(tmp_path, rows))
+
+    assert samples(metrics_file) == {
+        'etl_runs_total{source="products",status="succeeded"}': 1,
+        'etl_rows_total{source="products",kind="read"}': 2,
+        'etl_rows_total{source="products",kind="loaded"}': 2,
+        'etl_rows_total{source="products",kind="rejected"}': 0,
+        'etl_rows_total{source="products",kind="skipped"}': 0,
+        'etl_last_success_timestamp_seconds{source="products"}': DEFAULT_NOW.timestamp(),
+        'etl_run_duration_seconds{source="products"}': 0,
+    }
+    text = metrics_file.read_text(encoding="utf-8")
+    assert "# TYPE etl_runs_total counter\n" in text
+    assert "# TYPE etl_rows_total counter\n" in text
+    assert "# TYPE etl_last_success_timestamp_seconds gauge\n" in text
+    assert "# HELP etl_run_duration_seconds " in text
+
+
+def test_a_failed_run_is_described_too(metered, metrics_file, tmp_path):
+    rows = [product_row(sku="A", price="x"), product_row(sku="B")]
+
+    with pytest.raises(TooManyRejects):
+        metered.run("products", write_products(tmp_path, rows))
+
+    values = samples(metrics_file)
+    assert values['etl_runs_total{source="products",status="failed"}'] == 1
+    assert values['etl_rows_total{source="products",kind="rejected"}'] == 1
+    assert values['etl_rows_total{source="products",kind="loaded"}'] == 0
+    assert not any(name.startswith("etl_last_success") for name in values)
+
+
+def test_the_file_is_readable_by_the_collector_and_nothing_else_is_left(
+    metered, metrics_file, tmp_path
+):
+    metered.run("products", write_products(tmp_path, [product_row()]))
+
+    assert stat.S_IMODE(metrics_file.stat().st_mode) == 0o644
+    assert [path.name for path in metrics_file.parent.iterdir()] == ["etl.prom"]
+
+
+def test_a_metrics_file_that_cannot_be_written_does_not_fail_the_run(
+    metered, metrics_file, tmp_path
+):
+    metrics_file.parent.rmdir()
+
+    result = metered.run("products", write_products(tmp_path, [product_row()]))
+
+    assert result.counts.loaded == 1
+    assert not metrics_file.parent.exists()
+
+
+@pytest.fixture
+def environment(monkeypatch):
+    monkeypatch.setenv("DATABASE_URL", URL)
+    monkeypatch.delenv("METRICS_FILE", raising=False)
+    return monkeypatch
+
+
+def test_the_metrics_file_setting_is_checked(environment, metrics_file):
+    assert load_settings().metrics_file is None
+
+    environment.setenv("METRICS_FILE", str(metrics_file))
+    assert load_settings().metrics_file == metrics_file
+
+    environment.setenv("METRICS_FILE", str(metrics_file.with_suffix(".txt")))
+    with pytest.raises(ConfigError, match=r"METRICS_FILE: must end in \.prom"):
+        load_settings()
+
+    environment.setenv("METRICS_FILE", str(metrics_file.parent / "missing" / "etl.prom"))
+    with pytest.raises(ConfigError, match="is not a directory"):
+        load_settings()
