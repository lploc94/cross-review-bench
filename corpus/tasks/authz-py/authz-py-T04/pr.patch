+            await users.start_totp_enrolment(user, secret, self._clock.now())
+        log.info("auth.totp_enrolment_started", user_id=str(user.id))
+        return secret
+
+    async def confirm_totp_enrolment(self, principal: Principal, code: str) -> None:
+        """Turn two-factor authentication on once the authenticator shows a valid code."""
+        async with self._db.transaction() as session:
+            users = UserRepository(session)
+            user = await users.get(principal.user_id, for_update=True)
+            if user is None:
+                raise NotFoundError("user")
+            if user.totp_enabled:
+                raise ConflictError("two-factor authentication is already on")
+            if user.totp_secret is None:
+                raise ConflictError("no two-factor enrolment has been started")
+            if totp.matching_step(user.totp_secret, code, self._clock.now()) is None:
+                raise InvalidInputError("the code is incorrect", details={"field": "code"})
+            await users.enable_totp(user, self._clock.now())
+        log.info("auth.totp_enabled", user_id=str(principal.user_id))
+
     async def _open_session(
         self, session: AsyncSession, user: User, client: ClientInfo
     ) -> TokenPair:
diff --git a/tests/api/test_totp.py b/tests/api/test_totp.py
new file mode 100644
index 0000000..040e2f9
--- /dev/null
+++ b/tests/api/test_totp.py
@@ -0,0 +1,96 @@
+from __future__ import annotations
+
+from authz.domain import totp
+from tests.helpers.clock import FrozenClock
+from tests.helpers.factories import LoggedIn, login, signed_in
+
+
+def code(secret: str, clock: FrozenClock, steps: int = 0) -> str:
+    return totp.code_at(secret, totp.time_step(clock.now()) + steps)
+
+
+async def enrol(client, me: LoggedIn, clock: FrozenClock) -> str:
+    started = await client.post("/v1/me/totp", json={"password": me.password}, headers=me.headers)
+    assert started.status_code == 201, started.text
+    secret: str = started.json()["secret"]
+    confirmed = await client.post(
+        "/v1/me/totp/confirm", json={"code": code(secret, clock)}, headers=me.headers
+    )
+    assert confirmed.status_code == 204, confirmed.text
+    return secret
+
+
+async def second_step(client, me: LoggedIn, one_time_code: str, mfa_token: str | None = None):
+    if mfa_token is None:
+        mfa_token = (await login(client, me.email)).json()["mfa_token"]
+    return await client.post(
+        "/v1/auth/login/totp", json={"mfa_token": mfa_token, "code": one_time_code}
+    )
+
+
+async def test_enrolment_returns_a_secret_and_needs_the_password(client, container):
+    me = await signed_in(client, container)
+
+    wrong = await client.post("/v1/me/totp", json={"password": "not it"}, headers=me.headers)
+    response = await client.post("/v1/me/totp", json={"password": me.password}, headers=me.headers)
+
+    assert wrong.status_code == 401
+    assert response.status_code == 201
+    assert response.headers["cache-control"] == "no-store"
+    assert len(response.json()["secret"]) == 32
+    assert response.json()["period"] == 30
+
+
+async def test_login_completes_with_the_current_code(client, container, clock: FrozenClock):
+    me = await signed_in(client, container)
+    secret = await enrol(client, me, clock)
+    clock.advance(minutes=5)
+
+    first = await login(client, me.email)
+    second = await second_step(client, me, code(secret, clock), first.json()["mfa_token"])
+
+    assert first.status_code == 200
+    assert first.json()["mfa_required"] is True
+    assert first.json()["expires_in"] == container.settings.mfa_token_ttl_seconds
+    assert "access_token" not in first.json()
+    assert second.status_code == 200, second.text
+    me_again = await client.get(
+        "/v1/me", headers={"Authorization": f"Bearer {second.json()['access_token']}"}
+    )
+    assert me_again.status_code == 200
+    again = await client.post("/v1/me/totp", json={"password": me.password}, headers=me.headers)
+    assert again.status_code == 409
+
+
+async def test_a_wrong_code_spends_the_mfa_token(client, container, clock):
+    me = await signed_in(client, container)
+    secret = await enrol(client, me, clock)
+    clock.advance(minutes=5)
+    mfa_token = (await login(client, me.email)).json()["mfa_token"]
+
+    wrong = await second_step(client, me, code(secret, clock, 2), mfa_token)
+    retry = await second_step(client, me, code(secret, clock), mfa_token)
+
+    assert wrong.json()["error"]["code"] == "invalid_credentials"
+    assert retry.json()["error"]["code"] == "invalid_token"
+
+
+async def test_mfa_token_expires(client, container, clock: FrozenClock):
+    me = await signed_in(client, container)
+    secret = await enrol(client, me, clock)
+    mfa_token = (await login(client, me.email)).json()["mfa_token"]
+    clock.advance(seconds=container.settings.mfa_token_ttl_seconds)
+
+    response = await second_step(client, me, code(secret, clock), mfa_token)
+
+    assert response.status_code == 401
+    assert response.json()["error"]["code"] == "invalid_token"
+
+
+async def test_previous_step_is_accepted_but_not_older(client, container, clock):
+    me = await signed_in(client, container)
+    secret = await enrol(client, me, clock)
+    clock.advance(minutes=5)
+
+    assert (await second_step(client, me, code(secret, clock, -2))).status_code == 401
+    assert (await second_step(client, me, code(secret, clock, -1))).status_code == 200
