diff --git a/src/main/java/com/papertrail/workflow/domain/RejectionReason.java b/src/main/java/com/papertrail/workflow/domain/RejectionReason.java
new file mode 100644
index 0000000..50a3dfe
--- /dev/null
+++ b/src/main/java/com/papertrail/workflow/domain/RejectionReason.java
@@ -0,0 +1,22 @@
+package com.papertrail.workflow.domain;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Embeddable;
+import java.util.regex.Pattern;
+
+/** A reason a definition offers for rejecting its documents: a stable code and a label. */
+@Embeddable
+public record RejectionReason(
+    @Column(nullable = false, length = 40) String code,
+    @Column(nullable = false, length = 120) String label) {
+
+  private static final Pattern CODE = Pattern.compile("[A-Z][A-Z0-9_]{0,39}");
+
+  public RejectionReason {
+    if (code == null || !CODE.matcher(code).matches()) {
+      throw new ValidationException(
+          "a rejection reason code is 1 to 40 upper-case letters, digits or underscores");
+    }
+    label = AppUser.requireText(label, "label", 120);
+  }
+}
