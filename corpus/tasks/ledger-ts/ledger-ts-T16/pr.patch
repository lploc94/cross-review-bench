+/**
+ * Amounts of different currencies are not comparable, so an amount range needs `currency`;
+ * `currency` alone lists the transfers of that currency.
+ */
+export const listTransfersQuerySchema = paginationQuerySchema
+  .extend({ account_id: idSchema.optional(), currency: currencySchema.optional() })
+  .and(createdRangeSchema)
+  .and(amountRangeSchema)
+  .refine(
+    (query) =>
+      query.currency !== undefined ||
+      (query.amount_min === undefined && query.amount_max === undefined),
+    { error: "amount_min and amount_max need a currency", path: ["currency"] },
+  );
