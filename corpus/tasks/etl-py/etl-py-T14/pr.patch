diff --git a/tests/pipeline/test_run_pruning.py b/tests/pipeline/test_run_pruning.py
new file mode 100644
index 0000000..e54a5e3
--- /dev/null
+++ b/tests/pipeline/test_run_pruning.py
@@ -0,0 +1,67 @@
+from __future__ import annotations
+
+from datetime import timedelta
+
+import pytest
+
+from etl.api.runs import prune_runs
+from etl.errors import InvalidRequest, TooManyRejects
+from etl.infra.tables import check_results, products, rejects, runs
+from tests.helpers.db import count, rows
+from tests.helpers.factories import product_row, write_products
+
+
+def product_history(pipeline, clock, tmp_path):
+    """Runs 1 and 2 are superseded, run 3 failed, run 4 holds the product."""
+    for updated_at in ("2026-03-01T09:00:00Z", "2026-03-02T09:00:00Z"):
+        pipeline.run("products", write_products(tmp_path, [product_row(updated_at=updated_at)]))
+        clock.advance(hours=1)
+    with pytest.raises(TooManyRejects):
+        pipeline.run("products", write_products(tmp_path, [product_row(price="abc")] * 3))
+    clock.advance(hours=1)
+    pipeline.run(
+        "products", write_products(tmp_path, [product_row(updated_at="2026-03-03T09:00Z")])
+    )
+
+
+def test_runs_nothing_needs_are_deleted_with_their_rejects_and_checks(
+    pipeline, context, clock, tmp_path
+):
+    product_history(pipeline, clock, tmp_path)
+    clock.advance(days=31)
+
+    view = prune_runs(context, older_than_days=30)
+
+    assert (view.runs, view.rejects, view.check_results) == (3, 3, 8)
+    assert view.before == clock.now() - timedelta(days=30)
+    assert [run["id"] for run in rows(context.engine, runs)] == [4]
+    assert count(context.engine, rejects) == 0
+    assert {row["run_id"] for row in rows(context.engine, check_results)} == {4}
+    assert [row["run_id"] for row in rows(context.engine, products)] == [4]
+
+
+def test_recent_runs_are_kept(pipeline, context, clock, tmp_path):
+    product_history(pipeline, clock, tmp_path)
+    clock.advance(days=29)
+
+    view = prune_runs(context, older_than_days=30)
+
+    assert view.runs == 0
+    assert count(context.engine, runs) == 4
+
+
+def test_a_dry_run_counts_without_deleting(pipeline, context, clock, tmp_path):
+    product_history(pipeline, clock, tmp_path)
+    clock.advance(days=31)
+
+    dry = prune_runs(context, older_than_days=30, dry_run=True)
+
+    assert (dry.dry_run, dry.runs, dry.rejects, dry.check_results) == (True, 3, 3, 8)
+    assert count(context.engine, runs) == 4
+    assert count(context.engine, rejects) == 3
+
+
+def test_the_retention_must_be_a_positive_number_of_days(context, db):
+    for days in (0, -1, 36_501):
+        with pytest.raises(InvalidRequest, match="--older-than"):
+            prune_runs(context, older_than_days=days)
