+package com.papertrail.workflow.service;
+
+import com.papertrail.workflow.config.AttachmentSettings;
+import com.papertrail.workflow.domain.ConflictException;
+import com.papertrail.workflow.domain.Document;
+import com.papertrail.workflow.domain.DocumentAttachment;
+import com.papertrail.workflow.domain.DocumentStateMachine;
+import com.papertrail.workflow.domain.NotFoundException;
+import com.papertrail.workflow.domain.Principal;
+import com.papertrail.workflow.domain.TooLargeException;
+import com.papertrail.workflow.domain.UnsupportedTypeException;
+import com.papertrail.workflow.domain.ValidationException;
+import com.papertrail.workflow.persistence.DocumentAttachmentRepository;
+import com.papertrail.workflow.service.Views.AttachmentView;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.time.Clock;
+import java.time.Instant;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Files attached to a document. Anyone who can see the document lists and downloads them; only the
+ * owner adds or removes them, and only while the document is a draft. Changes take the document row
+ * lock, so the per-document limit holds under concurrent uploads and no file is added once the
+ * document has been submitted.
+ */
+@Service
+public class AttachmentService {
+
+  static final int MAX_FILE_NAME = 200;
+
+  private final DocumentAttachmentRepository attachments;
+  private final DocumentAccess access;
+  private final EventLog events;
+  private final AttachmentSettings settings;
+  private final Clock clock;
+
+  public AttachmentService(
+      DocumentAttachmentRepository attachments,
+      DocumentAccess access,
+      EventLog events,
+      AttachmentSettings settings,
+      Clock clock) {
+    this.attachments = attachments;
+    this.access = access;
+    this.events = events;
+    this.settings = settings;
+    this.clock = clock;
+  }
+
+  @Transactional
+  public AttachmentView add(
+      Principal actor, long documentId, String fileName, String contentType, byte[] content) {
+    Document document = access.lockVisible(actor, documentId);
+    DocumentStateMachine.requireAttachable(document, actor);
+    String name = cleanName(fileName);
+    if (content.length == 0) {
+      throw new ValidationException("the file is empty");
+    }
+    if (content.length > settings.maxBytes()) {
+      throw new TooLargeException("a file may not exceed " + settings.maxBytes() + " bytes");
+    }
+    String type = baseType(contentType);
+    if (!settings.allowedTypes().contains(type)) {
+      throw new UnsupportedTypeException("accepted file types are " + settings.allowedTypes());
+    }
+    if (attachments.countByDocumentId(documentId) >= settings.maxPerDocument()) {
+      throw new ConflictException(
+          "a document holds at most " + settings.maxPerDocument() + " attachments");
+    }
+    Instant now = clock.instant();
+    String sha256 = sha256(content);
+    long id =
+        attachments
+            .save(
+                new DocumentAttachment(document, name, type, content, sha256, actor.userId(), now))
+            .getId();
+    events.audit(
+        document,
+        actor.userId(),
+        "ATTACHMENT_ADDED",
+        Map.of("attachmentId", id, "sizeBytes", content.length, "type", type),
+        now);
+    return new AttachmentView(id, name, type, content.length, sha256, actor.userId(), now);
+  }
+
+  @Transactional(readOnly = true)
+  public List<AttachmentView> list(Principal actor, long documentId) {
+    access.visible(actor, documentId);
+    return attachments.findViews(documentId);
+  }
+
+  @Transactional(readOnly = true)
+  public DocumentAttachment download(Principal actor, long documentId, long attachmentId) {
+    access.visible(actor, documentId);
+    return find(documentId, attachmentId);
+  }
+
+  @Transactional
+  public void remove(Principal actor, long documentId, long attachmentId) {
+    Document document = access.lockVisible(actor, documentId);
+    DocumentStateMachine.requireAttachable(document, actor);
+    attachments.delete(find(documentId, attachmentId));
+    events.audit(
+        document,
+        actor.userId(),
+        "ATTACHMENT_REMOVED",
+        Map.of("attachmentId", attachmentId),
+        clock.instant());
+  }
+
+  private DocumentAttachment find(long documentId, long attachmentId) {
+    return attachments
+        .findByIdAndDocumentId(attachmentId, documentId)
+        .orElseThrow(() -> new NotFoundException("attachment not found"));
+  }
+
+  /**
+   * The media type without parameters, lower-cased: {@code Text/Plain; charset=x} is text/plain.
+   */
+  static String baseType(String contentType) {
+    String type = contentType == null ? "" : contentType;
+    int semicolon = type.indexOf(';');
+    return (semicolon < 0 ? type : type.substring(0, semicolon)).trim().toLowerCase(Locale.ROOT);
+  }
+
+  /** The last segment of the name the client sent; some browsers send the whole local path. */
+  static String cleanName(String original) {
+    String name = original == null ? "" : original;
+    name = name.substring(Math.max(name.lastIndexOf('/'), name.lastIndexOf('\\')) + 1).strip();
+    if (name.isEmpty()
+        || name.codePointCount(0, name.length()) > MAX_FILE_NAME
+        || name.chars().anyMatch(Character::isISOControl)) {
+      throw new ValidationException(
+          "a file name has 1 to " + MAX_FILE_NAME + " characters and no control characters");
+    }
+    return name;
+  }
+
+  static String sha256(byte[] content) {
+    try {
+      return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(content));
+    } catch (NoSuchAlgorithmException e) {
+      throw new IllegalStateException("SHA-256 is not available", e);
+    }
+  }
+}
