new file mode 100644
index 0000000..7818586
--- /dev/null
+++ b/src/domain/transferLimit.ts
@@ -0,0 +1,23 @@
+import type { CurrencyCode } from "./currency.js";
+
+/** The most an API key may send per UTC day in one currency, in minor units. */
+export interface DailyTransferLimit {
+  readonly amountMinor: bigint;
+  readonly currency: CurrencyCode;
+}
+
+export interface LimitWindow {
+  /** Inclusive. */
+  readonly start: Date;
+  /** Exclusive: the moment the allowance resets. */
+  readonly end: Date;
+}
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+/** The day `now` falls in, from 00:00 UTC to the next 00:00 UTC. */
+export function dailyWindow(now: Date): LimitWindow {
+  const start = new Date(now.getTime());
+  start.setHours(0, 0, 0, 0);
+  return { start, end: new Date(start.getTime() + DAY_MS) };
+}
