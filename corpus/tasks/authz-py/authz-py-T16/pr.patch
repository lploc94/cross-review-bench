+
+    async def revoke_others(self, principal: Principal) -> list[uuid.UUID]:
+        """Sign the caller out everywhere else: revoke every other active session of theirs."""
+        if principal.session_id is None:
+            raise InvalidInputError("only a login session can sign out the other sessions")
+        async with self._db.transaction() as session:
+            revoked = await SessionRepository(session).revoke_all_except(
+                principal.user_id, principal.session_id, self._clock.now(), "revoked_others"
+            )
+        log.info(
+            "session.revoked_others",
+            user_id=str(principal.user_id),
+            kept_session_id=str(principal.session_id),
+            revoked=len(revoked),
+        )
+        return revoked
