+func TestPoolOnExhausted(t *testing.T) {
+	st := newFakeStore(
+		domain.Job{ID: 1, Type: "flaky", Attempts: 0, MaxAttempts: 3},  // attempts left
+		domain.Job{ID: 2, Type: "flaky", Attempts: 2, MaxAttempts: 3},  // its last attempt fails
+		domain.Job{ID: 3, Type: "strict", Attempts: 2, MaxAttempts: 3}, // permanent failure: failed, not dead
+		domain.Job{ID: 4, Type: "ok", Attempts: 2, MaxAttempts: 3},     // its last attempt succeeds
+	)
+	exhausted := make(chan worker.Outcome, 4)
+	h := newHarness(t, st, registry(map[string]worker.HandlerFunc{
+		"flaky":  func(context.Context, domain.Job) error { return errors.New("upstream unavailable") },
+		"strict": func(context.Context, domain.Job) error { return domain.Permanent(errors.New("bad payload")) },
+		"ok":     func(context.Context, domain.Job) error { return nil },
+	}), func(o *worker.Options) {
+		o.OnExhausted = func(out worker.Outcome) { exhausted <- out }
+	})
+	h.start(t, context.Background())
+
+	// OnExhausted runs before OnSettled, so once every outcome is in, so is every call.
+	for range 4 {
+		h.next(t)
+	}
+	if len(exhausted) != 1 {
+		t.Fatalf("OnExhausted called %d times, want once", len(exhausted))
+	}
+	out := <-exhausted
+	if out.Job.ID != 2 || out.State != domain.StateDead || out.Err == nil || out.Job.Attempts != 3 {
+		t.Errorf("OnExhausted outcome = %+v, want job 2 dead after attempt 3", out)
+	}
+}
