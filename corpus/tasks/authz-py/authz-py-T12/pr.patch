diff --git a/tests/api/test_ownership_transfer.py b/tests/api/test_ownership_transfer.py
new file mode 100644
index 0000000..0e89167
--- /dev/null
+++ b/tests/api/test_ownership_transfer.py
@@ -0,0 +1,145 @@
+from __future__ import annotations
+
+import uuid
+
+from tests.helpers.factories import add_member, disable_user, org_with_member, role_id, signed_in
+
+
+def transfer_url(org: dict[str, object]) -> str:
+    return f"/v1/orgs/{org['id']}/transfer-ownership"
+
+
+async def roles_of(client, org, viewer) -> dict[str, str]:
+    response = await client.get(f"/v1/orgs/{org['id']}/members", headers=viewer.headers)
+    assert response.status_code == 200
+    return {member["user_id"]: member["role"] for member in response.json()["data"]}
+
+
+async def test_owner_hands_over_and_becomes_admin(client, container):
+    org, owner, admin = await org_with_member(client, container, "admin")
+
+    response = await client.post(
+        transfer_url(org), json={"user_id": str(admin.id)}, headers=owner.headers
+    )
+
+    assert response.status_code == 200, response.text
+    body = response.json()
+    assert body["new_owner"]["user_id"] == str(admin.id)
+    assert body["new_owner"]["role"] == "owner"
+    assert body["previous_owner"]["user_id"] == str(owner.id)
+    assert body["previous_owner"]["role"] == "admin"
+    assert await roles_of(client, org, admin) == {str(owner.id): "admin", str(admin.id): "owner"}
+
+
+async def test_owner_can_stay_owner(client, container):
+    org, owner, member = await org_with_member(client, container, "member")
+
+    response = await client.post(
+        transfer_url(org),
+        json={"user_id": str(member.id), "stay_owner": True},
+        headers=owner.headers,
+    )
+
+    assert response.status_code == 200, response.text
+    assert response.json()["previous_owner"]["role"] == "owner"
+    assert await roles_of(client, org, owner) == {str(owner.id): "owner", str(member.id): "owner"}
+
+
+async def test_the_previous_owner_loses_owner_rights(client, container):
+    org, owner, admin = await org_with_member(client, container, "admin")
+    await client.post(transfer_url(org), json={"user_id": str(admin.id)}, headers=owner.headers)
+
+    again = await client.post(
+        transfer_url(org), json={"user_id": str(admin.id)}, headers=owner.headers
+    )
+    rename = await client.patch(
+        f"/v1/orgs/{org['id']}", json={"name": "Renamed"}, headers=owner.headers
+    )
+
+    assert again.status_code == 403
+    assert rename.status_code == 403
+
+
+async def test_admins_cannot_transfer(client, container):
+    org, owner, admin = await org_with_member(client, container, "admin")
+    member = await signed_in(client, container)
+    await add_member(container, org["id"], member, "member")
+
+    response = await client.post(
+        transfer_url(org), json={"user_id": str(member.id)}, headers=admin.headers
+    )
+
+    assert response.status_code == 403
+    assert await roles_of(client, org, admin) == {
+        str(owner.id): "owner",
+        str(admin.id): "admin",
+        str(member.id): "member",
+    }
+
+
+async def test_target_must_be_a_member(client, container):
+    org, owner, _ = await org_with_member(client, container, "admin")
+    outsider = await signed_in(client, container)
+
+    for user_id in (outsider.id, uuid.uuid4()):
+        response = await client.post(
+            transfer_url(org), json={"user_id": str(user_id)}, headers=owner.headers
+        )
+        assert response.status_code == 404
+        assert response.json()["error"]["details"]["resource"] == "member"
+
+
+async def test_refuses_self_existing_owners_and_disabled_accounts(client, container):
+    org, owner, co_owner = await org_with_member(client, container, "owner")
+    disabled = await signed_in(client, container)
+    await add_member(container, org["id"], disabled, "viewer")
+    await disable_user(container, disabled.id)
+
+    to_self = await client.post(
+        transfer_url(org), json={"user_id": str(owner.id)}, headers=owner.headers
+    )
+    to_owner = await client.post(
+        transfer_url(org), json={"user_id": str(co_owner.id)}, headers=owner.headers
+    )
+    to_disabled = await client.post(
+        transfer_url(org), json={"user_id": str(disabled.id)}, headers=owner.headers
+    )
+
+    assert to_self.status_code == 422
+    assert to_owner.status_code == 409
+    assert to_disabled.status_code == 409
+    assert (await roles_of(client, org, owner))[str(owner.id)] == "owner"
+
+
+async def test_unknown_fields_are_rejected(client, container):
+    org, owner, admin = await org_with_member(client, container, "admin")
+
+    response = await client.post(
+        transfer_url(org),
+        json={"user_id": str(admin.id), "keep_owner": True},
+        headers=owner.headers,
+    )
+
+    assert response.status_code == 422
+
+
+async def test_transfer_is_audited(client, container):
+    org, owner, viewer = await org_with_member(client, container, "viewer")
+    viewer_role = await role_id(container, org["id"], "viewer")
+
+    await client.post(transfer_url(org), json={"user_id": str(viewer.id)}, headers=owner.headers)
+    events = (
+        await client.get(f"/v1/orgs/{org['id']}/audit", headers=viewer.headers)
+    ).json()["data"]
+
+    transferred = [e for e in events if e["action"] == "org.ownership_transferred"]
+    changed = {e["target_id"] for e in events if e["action"] == "member.role_changed"}
+    assert len(transferred) == 1
+    assert transferred[0]["actor_id"] == str(owner.id)
+    assert transferred[0]["target_id"] == str(viewer.id)
+    assert transferred[0]["data"] == {
+        "from_user_id": str(owner.id),
+        "previous_role_id": str(viewer_role),
+        "stayed_owner": False,
+    }
+    assert changed == {str(owner.id), str(viewer.id)}
