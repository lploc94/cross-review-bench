 from authz.infra.db import to_driver_url
 
@@ -27,3 +29,20 @@ def test_driver_url_rejects_other_databases():
 
 async def test_ping(container):
     await container.db.ping()
+
+
+async def test_snapshot_sees_one_state_and_cannot_write(container):
+    count = text("SELECT count(*) FROM users")
+    snapshot = await container.db.snapshot()
+    try:
+        before = (await snapshot.execute(count)).scalar_one()
+        async with container.db.transaction() as session:
+            await session.execute(
+                text("INSERT INTO users (id, email, password_hash) VALUES (:id, :email, 'x')"),
+                {"id": "6f1c1d2e-0000-4000-8000-000000000001", "email": "snap@example.com"},
+            )
+        assert (await snapshot.execute(count)).scalar_one() == before
+        with pytest.raises(DBAPIError, match="read-only transaction"):
+            await snapshot.execute(text("DELETE FROM users"))
+    finally:
+        await snapshot.close()
