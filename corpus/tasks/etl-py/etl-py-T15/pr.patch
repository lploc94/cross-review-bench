+"""Rejected rows fed through their source's normaliser and loader again."""
+
+from __future__ import annotations
+
+import pytest
+
+from etl.domain import money
+from etl.errors import InvalidRequest, RunNotFound, TooManyRejects
+from etl.infra.tables import customers, products, rejects, runs
+from etl.pipeline.extract import IN_THE_FUTURE
+from etl.pipeline.replay import CHANGED_WHEN_STORED
+from tests.helpers.db import count, rows
+from tests.helpers.factories import (
+    customer_obj,
+    order_row,
+    product_row,
+    write_customers,
+    write_orders,
+    write_products,
+)
+
+AHEAD = "2026-04-01T10:00:00Z"  # two hours after the clock
+
+
+def add_currency(monkeypatch, code):
+    monkeypatch.setitem(money.CURRENCIES, code, money.Currency(code, 2))
+
+
+def test_rows_rejected_for_a_cause_now_gone_are_loaded_as_a_new_run(
+    pipeline, db, monkeypatch, tmp_path
+):
+    first = pipeline.run(
+        "products",
+        write_products(
+            tmp_path,
+            [
+                *(product_row(sku=f"SKU-{n}") for n in (1, 4, 5, 6, 7, 8)),
+                product_row(sku="SKU-2", currency="RSD"),
+                product_row(sku="SKU-3", currency="RSD"),
+            ],
+        ),
+    )
+    add_currency(monkeypatch, "RSD")
+
+    result = pipeline.reprocess(first.run_id)
+
+    assert (result.counts.read, result.counts.loaded, result.counts.rejected) == (2, 2, 0)
+    assert result.high_water == first.high_water
+    loaded = {row["product_id"]: row["run_id"] for row in rows(db, products)}
+    assert loaded == {"SKU-2": 2, "SKU-3": 2} | {f"SKU-{n}": 1 for n in (1, 4, 5, 6, 7, 8)}
+    (run,) = rows(db, runs, id=result.run_id)
+    assert (run["source"], run["path"], run["status"]) == (
+        "products",
+        f"rejects of run {first.run_id}",
+        "succeeded",
+    )
+    assert count(db, rejects, run_id=first.run_id) == 2
+
+
+def test_rows_dated_ahead_of_their_run_stay_rejected(pipeline, db, clock, monkeypatch, tmp_path):
+    first = pipeline.run(
+        "products",
+        write_products(
+            tmp_path,
+            [
+                *(product_row(sku=f"SKU-{n}") for n in range(1, 7)),
+                product_row(sku="SKU-A", name="Ahead", updated_at=AHEAD),
+                product_row(sku="SKU-B", currency="RSD", updated_at=AHEAD),
+            ],
+            name="first.csv",
+        ),
+    )
+    clock.advance(hours=1)
+    pipeline.run(
+        "products",
+        write_products(
+            tmp_path,
+            [product_row(sku="SKU-A", name="Changed later", updated_at="2026-04-01T08:30:00Z")],
+            name="second.csv",
+        ),
+    )
+    add_currency(monkeypatch, "RSD")
+    clock.advance(hours=3)
+
+    result = pipeline.reprocess(first.run_id)
+    again = pipeline.reprocess(result.run_id)
+
+    assert (result.counts.read, result.counts.rejected, result.counts.loaded) == (2, 2, 0)
+    assert {item["reason"] for item in rows(db, rejects, run_id=result.run_id)} == {IN_THE_FUTURE}
+    assert (again.counts.rejected, again.counts.loaded) == (2, 0)
+    names = {row["product_id"]: row["name"] for row in rows(db, products)}
+    assert names["SKU-A"] == "Changed later"
+    assert "SKU-B" not in names
+
+
+def test_reprocessing_a_reprocess_run_counts_the_skew_from_the_file_run(
+    pipeline, db, clock, monkeypatch, tmp_path
+):
+    first = pipeline.run(
+        "products",
+        write_products(
+            tmp_path,
+            [
+                *(product_row(sku=f"SKU-{n}") for n in range(1, 8)),
+                product_row(sku="SKU-X", name="Ahead", currency="RSD", updated_at=AHEAD),
+            ],
+            name="first.csv",
+        ),
+    )
+    clock.advance(hours=1)
+    pipeline.run(
+        "products",
+        write_products(
+            tmp_path,
+            [product_row(sku="SKU-X", name="Changed later", updated_at="2026-04-01T08:30:00Z")],
+            name="second.csv",
+        ),
+    )
+    clock.advance(days=2)
+    early = pipeline.reprocess(first.run_id)  # RSD still unknown: rejected again
+    clock.advance(days=1)
+    add_currency(monkeypatch, "RSD")
+
+    result = pipeline.reprocess(early.run_id)
+
+    assert (result.counts.read, result.counts.rejected, result.counts.loaded) == (1, 1, 0)
+    assert [item["reason"] for item in rows(db, rejects, run_id=result.run_id)] == [IN_THE_FUTURE]
+    names = {row["product_id"]: row["name"] for row in rows(db, products)}
+    assert names["SKU-X"] == "Changed later"
+    read_at = {row["id"]: row["source_read_at"] for row in rows(db, runs)}
+    (started,) = [row["started_at"] for row in rows(db, runs, id=first.run_id)]
+    assert read_at == {first.run_id: None, 2: None, early.run_id: started, result.run_id: started}
+
+
+def test_rows_that_fail_again_are_rejected_under_the_new_run(pipeline, db, tmp_path):
+    objects = [customer_obj(customer_id=f"C-{n}") for n in range(9)]
+    objects += [customer_obj(customer_id="B-1", email="nobody"), customer_obj(customer_id="B-\x00")]
+    first = pipeline.run("customers", write_customers(tmp_path, objects, raw_lines={2: "{oops"}))
+
+    result = pipeline.reprocess(first.run_id)
+
+    assert (result.counts.read, result.counts.rejected, result.counts.loaded) == (2, 2, 0)
+    again = rows(db, rejects, run_id=result.run_id, order_by="line_no")
+    assert [(item["line_no"], item["reason"]) for item in again] == [
+        (11, "email: not an email address"),
+        (12, CHANGED_WHEN_STORED),
+    ]
+    assert count(db, customers) == 9
+
+
+def test_orders_failed_runs_and_unknown_runs_are_refused(pipeline, db, tmp_path):
+    pipeline.run("customers", write_customers(tmp_path, [customer_obj()]))
+    lines = [order_row(order_id=f"O-{n}") for n in range(3)]
+    orders = pipeline.run(
+        "orders", write_orders(tmp_path, [*lines, order_row(order_id="O-9", currency="ABC")])
+    )
+    with pytest.raises(TooManyRejects):
+        pipeline.run("products", write_products(tmp_path, [product_row(price="abc")]))
+
+    with pytest.raises(InvalidRequest, match="orders rejects cannot be reprocessed"):
+        pipeline.reprocess(orders.run_id)
+    with pytest.raises(InvalidRequest, match="run 3 failed"):
+        pipeline.reprocess(3)
+    with pytest.raises(RunNotFound):
+        pipeline.reprocess(99)
+    assert count(db, runs) == 3
