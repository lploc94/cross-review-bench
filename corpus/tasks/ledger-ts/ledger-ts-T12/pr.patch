diff --git a/test/api/accountLabels.test.ts b/test/api/accountLabels.test.ts
new file mode 100644
index 0000000..4c86ee9
--- /dev/null
+++ b/test/api/accountLabels.test.ts
@@ -0,0 +1,142 @@
+import type { LightMyRequestResponse } from "fastify";
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { buildTestApp, type TestApp } from "../helpers/app.js";
+import {
+  createTenant,
+  getAccount,
+  issueKey,
+  openAccount,
+  type AccountBody,
+  type ErrorResponse,
+  type TestTenant,
+} from "../helpers/fixtures.js";
+
+interface AccountPage {
+  data: AccountBody[];
+}
+
+describe("account names and labels", () => {
+  let t: TestApp;
+  let tenant: TestTenant;
+
+  beforeAll(async () => {
+    t = await buildTestApp();
+  });
+
+  afterAll(async () => {
+    await t.close();
+  });
+
+  beforeEach(async () => {
+    tenant = await createTenant(t.pool, t.clock);
+  });
+
+  function patch(id: string, payload: object, key: TestTenant = tenant): Promise<LightMyRequestResponse> {
+    return t.app.inject({ method: "PATCH", url: `/accounts/${id}`, headers: key.headers, payload });
+  }
+
+  async function listIds(query: string): Promise<string[]> {
+    const response = await t.app.inject({ method: "GET", url: `/accounts?${query}`, headers: tenant.headers });
+    expect(response.statusCode, response.body).toBe(200);
+    return response.json<AccountPage>().data.map((a) => a.id);
+  }
+
+  it("opens accounts without labels", async () => {
+    expect((await openAccount(t.app, tenant)).labels).toEqual({});
+  });
+
+  it("renames an account and replaces its labels", async () => {
+    const account = await openAccount(t.app, tenant, { name: "Old name" });
+    t.clock.advanceSeconds(5);
+    const renamed = await patch(account.id, { name: "  Payroll  ", labels: { team: "hr", env: "prod" } });
+    expect(renamed.statusCode).toBe(200);
+    expect(renamed.json<AccountBody>()).toMatchObject({
+      name: "Payroll",
+      labels: { team: "hr", env: "prod" },
+      updated_at: t.clock.now().toISOString(),
+    });
+
+    const relabelled = await patch(account.id, { labels: { team: "finance" } });
+    expect(relabelled.json<AccountBody>()).toMatchObject({ name: "Payroll", labels: { team: "finance" } });
+    const renamedOnly = await patch(account.id, { name: "Payroll EU" });
+    expect(renamedOnly.json<AccountBody>().labels).toEqual({ team: "finance" });
+    expect((await patch(account.id, { labels: {} })).json<AccountBody>().labels).toEqual({});
+    expect((await getAccount(t.app, tenant, account.id)).name).toBe("Payroll EU");
+  });
+
+  it("validates names and labels", async () => {
+    const account = await openAccount(t.app, tenant);
+    const tooMany = Object.fromEntries(Array.from({ length: 21 }, (_, i) => [`k${i}`, "v"]));
+    const bodies = [
+      {},
+      { name: "" },
+      { name: "x".repeat(201) },
+      { labels: { "bad key": "v" } },
+      { labels: { "k:v": "v" } },
+      { labels: { ["x".repeat(41)]: "v" } },
+      { labels: { team: "x".repeat(101) } },
+      { labels: { team: 1 } },
+      { labels: ["team"] },
+      { labels: tooMany },
+      { currency: "EUR" },
+      { name: "Pay\u0000roll" },
+      { name: "Lone \ud800" },
+      { labels: { team: "a\u0000b" } },
+      { labels: { team: "\udc00" } },
+      { labels: { team: "x\ud83d" } },
+    ];
+    for (const payload of bodies) {
+      const response = await patch(account.id, payload);
+      expect(response.statusCode, JSON.stringify(payload)).toBe(400);
+      expect(response.json<ErrorResponse>().error.code).toBe("validation_error");
+    }
+    expect((await patch(account.id, { labels: { "team.name_1-a": "", other: "x".repeat(100) } })).statusCode).toBe(200);
+    expect((await patch(account.id, { name: "Ops \ud83d\ude00", labels: { team: "🙂" } })).statusCode).toBe(200);
+  });
+
+  it("filters the list by every label given", async () => {
+    const payroll = await openAccount(t.app, tenant);
+    const ops = await openAccount(t.app, tenant);
+    const plain = await openAccount(t.app, tenant);
+    await patch(payroll.id, { labels: { team: "hr", region: "eu:west" } });
+    await patch(ops.id, { labels: { team: "ops", region: "eu:west" } });
+
+    expect(await listIds("label=team:hr")).toEqual([payroll.id]);
+    expect((await listIds("label=region:eu:west")).sort()).toEqual([payroll.id, ops.id].sort());
+    expect(await listIds("label=region:eu:west&label=team:ops")).toEqual([ops.id]);
+    expect(await listIds("label=team:hr&label=team:ops")).toEqual([]);
+    expect(await listIds("label=team:HR")).toEqual([]);
+    expect(await listIds("")).toContain(plain.id);
+  });
+
+  it("finds every value a PATCH accepts, counting characters the same way", async () => {
+    const account = await openAccount(t.app, tenant);
+    const rockets = "\u{1F680}".repeat(100);
+    expect((await patch(account.id, { labels: { team: rockets } })).statusCode).toBe(200);
+    expect(await listIds(new URLSearchParams({ label: `team:${rockets}` }).toString())).toEqual([account.id]);
+    expect((await patch(account.id, { labels: { team: `${rockets}\u{1F680}` } })).statusCode).toBe(400);
+    const tooLong = await t.app.inject({
+      method: "GET",
+      url: `/accounts?${new URLSearchParams({ label: `team:${rockets}\u{1F680}` }).toString()}`,
+      headers: tenant.headers,
+    });
+    expect(tooLong.statusCode).toBe(400);
+  });
+
+  it("rejects malformed label filters", async () => {
+    for (const query of ["label=team", "label=:hr", "label=bad key:x", `label=team:${"x".repeat(101)}`, "label=team:a%00b"]) {
+      const response = await t.app.inject({ method: "GET", url: `/accounts?${query}`, headers: tenant.headers });
+      expect(response.statusCode, query).toBe(400);
+    }
+  });
+
+  it("needs accounts:write and hides other tenants' accounts", async () => {
+    const account = await openAccount(t.app, tenant, { name: "Mine" });
+    const readOnly = await issueKey(t.pool, t.clock, tenant.tenantId, ["accounts:read"]);
+    expect((await patch(account.id, { name: "x" }, readOnly)).statusCode).toBe(403);
+
+    const other = await createTenant(t.pool, t.clock, { name: "Other" });
+    expect((await patch(account.id, { name: "Theirs" }, other)).statusCode).toBe(404);
+    expect((await getAccount(t.app, tenant, account.id)).name).toBe("Mine");
+  });
+});
