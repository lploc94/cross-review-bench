diff --git a/test/api/uploadLimits.test.ts b/test/api/uploadLimits.test.ts
new file mode 100644
index 0000000..5d9b3d0
--- /dev/null
+++ b/test/api/uploadLimits.test.ts
@@ -0,0 +1,145 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { buildTestApp, type TestApp } from "../helpers/app.js";
+import {
+  createTenant,
+  expectStatus,
+  issueKey,
+  multipartBody,
+  putFile,
+  storeFile,
+  tenantUsage,
+  type ErrorResponse,
+  type SessionBody,
+  type TenantBody,
+  type TestTenant,
+} from "../helpers/fixtures.js";
+
+describe("per-tenant upload size limits", () => {
+  let t: TestApp;
+  let tenant: TestTenant;
+
+  beforeEach(async () => {
+    t = await buildTestApp({ env: { MAX_UPLOAD_BYTES: "8192" } });
+    tenant = await createTenant(t.pool, t.clock, { quotaBytes: 100_000 });
+  });
+
+  afterEach(async () => {
+    await t.close();
+  });
+
+  function patchTenant(payload: unknown, key: TestTenant = tenant) {
+    return t.app.inject({ method: "PATCH", url: "/v1/tenant", headers: key.headers, payload: payload as object });
+  }
+
+  async function limitUploads(maxUploadBytes: number | null): Promise<TenantBody> {
+    const response = await patchTenant({ maxUploadBytes });
+    expectStatus(response, 200);
+    return response.json<TenantBody>();
+  }
+
+  it("sets, reports and clears the tenant's limit", async () => {
+    const tenantBody = await t.app.inject({ url: "/v1/tenant", headers: tenant.headers });
+    expect(tenantBody.json<TenantBody>().maxUploadBytes).toBeNull();
+
+    expect(await limitUploads(1000)).toMatchObject({ maxUploadBytes: 1000, quotaBytes: 100_000 });
+    expect((await t.app.inject({ url: "/v1/tenant", headers: tenant.headers })).json<TenantBody>()).toMatchObject({
+      maxUploadBytes: 1000,
+    });
+
+    const both = await patchTenant({ quotaBytes: 50_000, maxUploadBytes: 2000 });
+    expectStatus(both, 200);
+    expect(both.json<TenantBody>()).toMatchObject({ quotaBytes: 50_000, maxUploadBytes: 2000 });
+
+    // Changing only the quota keeps the limit.
+    const quotaOnly = await patchTenant({ quotaBytes: 60_000 });
+    expect(quotaOnly.json<TenantBody>()).toMatchObject({ quotaBytes: 60_000, maxUploadBytes: 2000 });
+
+    expect(await limitUploads(null)).toMatchObject({ quotaBytes: 60_000, maxUploadBytes: null });
+  });
+
+  it.each([
+    [{}],
+    [{ maxUploadBytes: 0 }],
+    [{ maxUploadBytes: 8193 }],
+    [{ maxUploadBytes: 1.5 }],
+    [{ maxUploadBytes: "100" }],
+  ])("refuses %j", async (payload) => {
+    expectStatus(await patchTenant(payload), 400);
+  });
+
+  it("needs tenant:admin to change the limit", async () => {
+    const reader = await issueKey(t.pool, t.clock, tenant.tenantId, ["tenant:read"]);
+    expectStatus(await patchTenant({ maxUploadBytes: 100 }, reader), 403);
+  });
+
+  it("refuses raw uploads over the tenant's limit, announced or not", async () => {
+    await limitUploads(1000);
+    const announced = await putFile(t.app, tenant, "big.bin", Buffer.alloc(1001));
+    expectStatus(announced, 413);
+    expect(announced.json<ErrorResponse>().error).toMatchObject({
+      code: "payload_too_large",
+      details: { limitBytes: 1000 },
+    });
+
+    const chunked = await t.app.inject({
+      method: "PUT",
+      url: "/v1/files/big.bin",
+      headers: { ...tenant.headers, "content-type": "application/octet-stream", "transfer-encoding": "chunked" },
+      payload: Buffer.alloc(1500),
+    });
+    expectStatus(chunked, 413);
+    expect(chunked.json<ErrorResponse>().error.details).toEqual({ limitBytes: 1000 });
+    expect(await tenantUsage(t.pool, tenant.tenantId)).toBe(0);
+
+    const exact = await storeFile(t.app, tenant, "exact.bin", Buffer.alloc(1000));
+    expect(exact.size).toBe(1000);
+  });
+
+  it("refuses multipart uploads over the tenant's limit", async () => {
+    await limitUploads(1000);
+    const form = multipartBody([
+      { name: "path", value: "big.bin" },
+      { name: "file", filename: "big.bin", contentType: "application/octet-stream", content: Buffer.alloc(1001) },
+    ]);
+    const response = await t.app.inject({
+      method: "POST",
+      url: "/v1/files",
+      headers: { ...tenant.headers, "content-type": form.contentType },
+      payload: form.payload,
+    });
+    expectStatus(response, 413);
+    expect(response.json<ErrorResponse>().error.details).toEqual({ limitBytes: 1000 });
+    expect(await tenantUsage(t.pool, tenant.tenantId)).toBe(0);
+  });
+
+  it("refuses resumable sessions larger than the tenant's limit", async () => {
+    await limitUploads(1000);
+    const createSession = (size: number) =>
+      t.app.inject({ method: "POST", url: "/v1/uploads", headers: tenant.headers, payload: { path: "s.bin", size } });
+    const tooLarge = await createSession(1001);
+    expectStatus(tooLarge, 413);
+    expect(tooLarge.json<ErrorResponse>().error.details).toEqual({ limitBytes: 1000 });
+    expect(await tenantUsage(t.pool, tenant.tenantId)).toBe(0);
+
+    const fits = await createSession(1000);
+    expectStatus(fits, 201);
+    expect(fits.json<SessionBody>().size).toBe(1000);
+  });
+
+  it("keeps the service's limit for other tenants", async () => {
+    await limitUploads(1000);
+    const other = await createTenant(t.pool, t.clock, { name: "Harbor Logistics", quotaBytes: 100_000 });
+    expectStatus(await putFile(t.app, other, "big.bin", Buffer.alloc(8192)), 201);
+    const over = await putFile(t.app, other, "bigger.bin", Buffer.alloc(8193));
+    expectStatus(over, 413);
+    expect(over.json<ErrorResponse>().error.details).toEqual({ limitBytes: 8192 });
+  });
+
