@@ -0,0 +1,107 @@
+from __future__ import annotations
+
+from tests.helpers.factories import DEFAULT_PASSWORD, bearer, login, make_user, signed_in
+
+
+async def _request(client, me, new_email, password=DEFAULT_PASSWORD):
+    return await client.post(
+        "/v1/me/email", json={"new_email": new_email, "password": password}, headers=me.headers
+    )
+
+
+async def _confirm(client, headers, token):
+    return await client.post("/v1/me/email/confirm", json={"token": token}, headers=headers)
+
+
+async def test_confirmed_change_moves_the_account_to_the_new_address(client, container, mailer):
+    me = await signed_in(client, container, "nina@example.com")
+
+    requested = await _request(client, me, " Nina.New@Example.COM ")
+    token = mailer.last_email_change_token("nina.new@example.com")
+    confirmed = await _confirm(client, me.headers, token)
+
+    assert requested.status_code == 202
+    assert requested.json()["new_email"] == "nina.new@example.com"
+    assert token not in requested.text
+    [notice] = [m for m in mailer.to("nina@example.com") if m.kind == "email_change_notice"]
+    assert "nina.new@example.com" in notice.body
