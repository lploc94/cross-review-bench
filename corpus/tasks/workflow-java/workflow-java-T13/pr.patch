+  /** The definition with its steps in the portable form that {@link #importDraft} reads. */
+  @Transactional(readOnly = true)
+  public DefinitionExport export(long definitionId) {
+    return DefinitionExport.of(get(definitionId));
+  }
+
+  /**
+   * Creates a draft from an exported definition. Groups are found by name and single approvers by
+   * address; an unknown one fails the whole import. Without a version the draft takes the next
+   * version of its name. A version that is given must be above every version of that name here, so
+   * an import never reuses an existing version number or goes below the latest one.
+   */
+  @Transactional
+  public long importDraft(String name, Integer version, List<ImportedStep> steps) {
+    String trimmed = name.trim();
+    int latest = definitions.findMaxVersion(trimmed).orElse(0);
+    if (version != null && version <= latest) {
+      throw new ConflictException(
+          "definition " + trimmed + " already has versions up to " + latest);
+    }
+    WorkflowDefinition definition =
+        new WorkflowDefinition(trimmed, version == null ? latest + 1 : version, clock.instant());
+    for (ImportedStep step : steps) {
+      AppUser assignee = blank(step.assignee()) ? null : userByAddress(step);
+      UserGroup group = blank(step.group()) ? null : groupByName(step.group().trim());
+      definition.addStep(
+          step.order(), step.kind(), assignee, group, step.quorum(), slaMinutes(step));
+    }
+    return definitions.save(definition).getId();
+  }
+
+  private AppUser userByAddress(ImportedStep step) {
+    return users
+        .findByEmail(AppUser.normaliseEmail(step.assignee()))
+        .orElseThrow(
+            () ->
+                new ValidationException(
+                    "step " + step.order() + ": no user has the assignee's address"));
+  }
+
+  private UserGroup groupByName(String name) {
+    return groups
+        .findByName(name)
+        .orElseThrow(() -> new ValidationException("unknown group " + name));
+  }
+
+  /** The SLA in whole minutes, checked before it is narrowed to an int. */
+  static int slaMinutes(ImportedStep step) {
+    Duration sla;
+    try {
+      sla = Duration.parse(step.sla().trim());
+    } catch (DateTimeParseException e) {
+      throw new ValidationException(
+          "step " + step.order() + ": sla must be an ISO-8601 duration such as PT8H");
+    }
+    long minutes = sla.toMinutes();
+    if (!sla.equals(Duration.ofMinutes(minutes)) || minutes < 1 || minutes > MAX_SLA_MINUTES) {
+      throw new ValidationException(
+          "step "
+              + step.order()
+              + ": sla must be whole minutes between PT1M and PT"
+              + MAX_SLA_MINUTES / 60
+              + "H");
+    }
+    return (int) minutes;
+  }
+
+  private static boolean blank(String value) {
+    return value == null || value.isBlank();
+  }
+
