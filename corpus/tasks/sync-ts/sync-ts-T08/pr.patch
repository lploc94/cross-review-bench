diff --git a/packages/client/test/sync/collections.test.ts b/packages/client/test/sync/collections.test.ts
new file mode 100644
index 0000000..f812998
--- /dev/null
+++ b/packages/client/test/sync/collections.test.ts
@@ -0,0 +1,100 @@
+import { SyncClient, checkPage, InvalidResponseError } from "@sync/client";
+import { ManualClock, MutationValidationError, SyncError, formatHlc, seededRandom, type SyncEvent } from "@sync/shared";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { openClient, openLocalClient, ScriptedTransport, unreachableTransport, type TestClient } from "../helpers/clients.js";
+import { tempDbPath } from "../helpers/tempFiles.js";
+import { startTestServer, type TestAccount, type TestServer } from "../helpers/testServer.js";
+
+let server: TestServer;
+let laptop: TestAccount;
+let phone: TestAccount;
+const opened: TestClient[] = [];
+
+beforeEach(async () => {
+  server = await startTestServer();
+  laptop = await server.createUser("Ada");
+  phone = await server.addDevice(laptop);
+});
+
+afterEach(async () => {
+  for (const c of opened.splice(0)) await c.client.close();
+  await server.close();
+});
+
+function client(account: TestAccount, options: Parameters<typeof openClient>[2] = {}): TestClient {
+  const c = openClient(server, account, options);
+  opened.push(c);
+  return c;
+}
+
+function event(seq: number): SyncEvent {
+  return {
+    seq,
+    mutationId: `00000000-0000-4000-8000-${String(seq).padStart(12, "0")}`,
+    deviceId: "0b6f4a52-8d0e-4c43-9a51-6d2f0e7a9c11",
+    collection: "tasks",
+    docId: "t1",
+    field: "title",
+    value: `Task ${seq}`,
+    hlc: formatHlc({ wallMs: 1_000, counter: seq, node: "phone" }),
+    serverReceivedAt: new Date(1_000).toISOString(),
+  };
+}
+
+describe("a replica of some collections", () => {
+  it("receives only the events of its collections and moves its cursor to the end of the feed", async () => {
+    const full = client(laptop);
+    full.client.set("notes", "n1", { title: "Groceries" });
+    full.client.set("tasks", "t1", { title: "Buy milk", done: false });
+    full.client.set("notes", "n2", { title: "Trip" });
+    await full.client.sync();
+
+    const tasks = client(phone, { collections: ["tasks"] });
+    expect(await tasks.client.sync()).toEqual({ pushed: 0, pulled: 2, applied: 2 });
+    expect(tasks.client.get("tasks", "t1")?.fields).toEqual({ title: "Buy milk", done: false });
+    expect(tasks.client.list("notes")).toEqual([]);
+    expect(tasks.client.pullCursor()).toBe(full.client.pullCursor());
+  });
+
+  it("does not filter when it syncs every collection", async () => {
+    const transport = new ScriptedTransport().answerPull({ events: [], nextAfter: 0, hasMore: false });
+    const both = SyncClient.open({ dbPath: ":memory:", transport, clock: new ManualClock(), collections: ["tasks", "notes"] });
+    await both.sync();
+    expect(transport.pulls.map((request) => Object.keys(request))).toEqual([["after", "limit"]]);
+    await both.close();
+  });
+
+  it("refuses writes to other collections", () => {
+    const local = openLocalClient({ collections: ["notes"] });
+    expect(() => local.set("tasks", "t1", { title: "Buy milk" })).toThrow(MutationValidationError);
+    expect(local.pendingCount()).toBe(0);
+    local.set("notes", "n1", { title: "Groceries" });
+    expect(local.pendingCount()).toBe(1);
+  });
+
+  it("keeps the set it was created with", async () => {
+    const dbPath = tempDbPath();
+    const options = { dbPath, transport: unreachableTransport, clock: new ManualClock(), random: seededRandom(3) };
+    await SyncClient.open({ ...options, collections: ["notes"] }).close();
+    expect(() => SyncClient.open(options)).toThrow(SyncError);
+    expect(() => SyncClient.open({ ...options, collections: ["tasks"] })).toThrow(/syncs notes, not tasks/);
+    await SyncClient.open({ ...options, collections: ["notes"] }).close();
+  });
+
+  it("rejects empty, repeated and unknown collections", () => {
+    for (const collections of [[], ["notes", "notes"], ["contacts"]]) {
+      expect(() => openLocalClient({ collections: collections as never }), JSON.stringify(collections)).toThrow(RangeError);
+    }
+  });
+
+  it("asks the server for its collections and accepts a nextAfter past the last event", async () => {
+    const transport = new ScriptedTransport().answerPull({ events: [event(3)], nextAfter: 9, hasMore: false });
+    const c = SyncClient.open({ dbPath: ":memory:", transport, clock: new ManualClock(), collections: ["tasks"] });
+    await c.sync();
+    expect(transport.pulls).toEqual([{ after: 0, limit: 500, collections: ["tasks"] }]);
+    expect(c.pullCursor()).toBe(9);
+    await c.close();
+    expect(() => checkPage({ events: [event(3)], nextAfter: 2, hasMore: false }, 0, 10, true)).toThrow(InvalidResponseError);
+    expect(() => checkPage({ events: [], nextAfter: 7, hasMore: false }, 4, 10, true)).not.toThrow();
+  });
+});
