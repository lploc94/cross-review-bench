diff --git a/src/pager.js b/src/pager.js
index ba12c24..960956b 100644
--- a/src/pager.js
+++ b/src/pager.js
@@ -2,5 +2,13 @@
 
 /** Returns page `page` (1-based) of `items`, `size` items per page. */
 export function paginate(items, page, size) {
+  if (!Number.isInteger(size) || size <= 0) throw new RangeError("size must be a positive integer");
+  if (!Number.isInteger(page) || page < 0) throw new RangeError("page must be a positive integer");
   return items.slice((page - 1) * size, page * size);
 }
+
+/** Number of pages needed to show all `items`, `size` per page. */
+export function pageCount(items, size) {
+  if (!Number.isInteger(size) || size <= 0) throw new RangeError("size must be a positive integer");
+  return Math.floor(items.length / size);
+}
