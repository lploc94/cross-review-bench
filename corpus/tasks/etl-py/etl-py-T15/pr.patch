+@dataclass(frozen=True, slots=True)
+class StoredPayload:
+    id: int
+    line_no: int
+    payload: Any
+
+
+def payloads(
+    connection: Connection, run_id: int, *, after: StoredPayload | None, limit: int
+) -> list[StoredPayload]:
+    """The payloads of a run's rejects in file order, `limit` at a time; `after` is the last
+    one of the previous page."""
+    statement = (
+        select(rejects.c.id, rejects.c.line_no, rejects.c.payload)
+        .where(rejects.c.run_id == run_id)
+        .order_by(rejects.c.line_no, rejects.c.id)
+        .limit(limit)
+    )
+    if after is not None:
+        statement = statement.where(
+            tuple_(rejects.c.line_no, rejects.c.id) > tuple_(after.line_no, after.id)
+        )
+    return [
+        StoredPayload(row.id, row.line_no, row.payload) for row in connection.execute(statement)
+    ]
+
+
 def delete_before(connection: Connection, *, before: datetime, source: str | None = None) -> int:
