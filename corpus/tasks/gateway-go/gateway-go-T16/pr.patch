diff --git a/internal/core/passive.go b/internal/core/passive.go
new file mode 100644
index 0000000..e243708
--- /dev/null
+++ b/internal/core/passive.go
@@ -0,0 +1,161 @@
+package core
+
+import (
+	"sync"
+	"time"
+
+	"github.com/relaywork/gateway/internal/clock"
+	"github.com/relaywork/gateway/internal/config"
+)
+
+// PassivePolicy configures passive health checks of a route.
+type PassivePolicy struct {
+	ConsecutiveFailures int
+	Ejection            time.Duration
+	MaxEjectedPercent   int
+}
+
+func passivePolicy(c config.PassiveHealth) PassivePolicy {
+	return PassivePolicy{
+		ConsecutiveFailures: c.ConsecutiveFailures,
+		Ejection:            c.Ejection.D(),
+		MaxEjectedPercent:   c.MaxEjectedPercent,
+	}
+}
+
+// Passive records how the requests to a route's upstreams end and ejects the upstreams that fail
+// in a row. It is shared by all of the route's upstreams, and survives reloads that keep the
+// route's passive settings. It tracks only the upstreams of the live table: outcomes reported for
+// an upstream that a reload removed, by a request still on the old table, are ignored.
+type Passive struct {
+	policy PassivePolicy
+	clock  clock.Clock
+
+	mu       sync.Mutex
+	total    int                  // the route's upstreams
+	live     map[string]bool      // the route's upstreams, by URL; empty until setUpstreams
+	failures map[string]int       // consecutive failures, by upstream URL
+	ejected  map[string]time.Time // until when an upstream is ejected, by upstream URL
+}
+
+// NewPassive returns the passive health state of a route; setUpstreams gives it the upstreams.
+func NewPassive(p PassivePolicy, clk clock.Clock) *Passive {
+	return &Passive{
+		policy:   p,
+		clock:    clk,
+		live:     make(map[string]bool),
+		failures: make(map[string]int),
+		ejected:  make(map[string]time.Time),
+	}
+}
+
+// setUpstreams makes urls the route's upstreams. Failures and ejections of upstreams no longer in
+// the route are forgotten, so they do not use up the share. The share limit follows the new count:
+// when it dropped below the number of ejections, the ejections that end first are released until
+// the limit holds, which also keeps at least one upstream in rotation. Called once a table with the
+// route is in place.
+func (p *Passive) setUpstreams(urls []string) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	live := make(map[string]bool, len(urls))
+	for _, u := range urls {
+		live[u] = true
+	}
+	p.live = live
+	for u := range p.failures {
+		if !live[u] {
+			delete(p.failures, u)
+		}
+	}
+	for u := range p.ejected {
+		if !live[u] {
+			delete(p.ejected, u)
+		}
+	}
+	p.total = len(urls)
+
+	now := p.clock.Now()
+	for p.activeLocked(now) > p.limit() {
+		first, found := "", false
+		for u, until := range p.ejected {
+			if !found || until.Before(p.ejected[first]) || (until.Equal(p.ejected[first]) && u < first) {
+				first, found = u, true
+			}
+		}
+		if !found {
+			break
+		}
+		delete(p.ejected, first)
+	}
+}
+
+// limit is how many of the route's upstreams may be ejected at once: the configured share, and
+// never all of them.
+func (p *Passive) limit() int {
+	n := p.total * p.policy.MaxEjectedPercent / 100
+	if n >= p.total {
+		n = p.total - 1
+	}
+	return n
+}
+
+// Report records how a request admitted to the upstream at url ended. Success clears the
+// failures in a row; a failure counts, and reaching ConsecutiveFailures ejects the upstream while
+// the limit allows it. Ignored outcomes say nothing about the upstream, and neither do upstreams
+// the live table does not have.
+func (p *Passive) Report(url string, o Outcome) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if !p.live[url] {
+		return
+	}
+	switch o {
+	case Success:
+		delete(p.failures, url)
+	case Failure:
+		now := p.clock.Now()
+		if p.ejectedLocked(url, now) {
+			return
+		}
+		p.failures[url]++
+		if p.failures[url] < p.policy.ConsecutiveFailures {
+			return
+		}
+		if p.activeLocked(now) >= p.limit() {
+			return
+		}
+		delete(p.failures, url)
+		p.ejected[url] = now.Add(p.policy.Ejection)
+	}
+}
+
+// Ejected reports whether the upstream at url is ejected now.
+func (p *Passive) Ejected(url string) bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.ejectedLocked(url, p.clock.Now())
+}
+
+// ejectedLocked reports whether url is ejected at now, forgetting an ejection that has ended.
+func (p *Passive) ejectedLocked(url string, now time.Time) bool {
+	until, ok := p.ejected[url]
+	if !ok {
+		return false
+	}
+	if now.Before(until) {
+		return true
+	}
+	delete(p.ejected, url)
+	return false
+}
+
+// activeLocked counts the upstreams ejected at now.
+func (p *Passive) activeLocked(now time.Time) int {
+	n := 0
+	for url := range p.ejected {
+		if p.ejectedLocked(url, now) {
+			n++
+		}
+	}
+	return n
+}
diff --git a/internal/core/passive_health_test.go b/internal/core/passive_health_test.go
new file mode 100644
index 0000000..259e9a6
--- /dev/null
+++ b/internal/core/passive_health_test.go
@@ -0,0 +1,133 @@
+package core
+
+import (
+	"testing"
+	"time"
+)
+
+const passiveRoute = `{"routes":[{"id":"a","path":"/a","upstreams":[{"url":"http://u1"},{"url":"http://u2"}],
+  "passive_health":{"consecutive_failures":2,"ejection":"30s","max_ejected_percent":50}}]}`
+
+func TestPassiveEjectsAfterConsecutiveFailuresOnly(t *testing.T) {
+	rt, clk := newRuntime(t, passiveRoute)
+	u1 := routeOf(t, rt, "a").Upstreams[0]
+
+	u1.Report(Failure)
+	u1.Report(Success) // a success clears the failures in a row
+	u1.Report(Failure)
+	if u1.Ejected() {
+		t.Fatal("ejected before two failures in a row")
+	}
+	u1.Report(Failure)
+	if !u1.Ejected() {
+		t.Fatal("not ejected after two failures in a row")
+	}
+	for range 4 {
+		if u := routeOf(t, rt, "a").Next(nil); u == nil || u.String() != "http://u2" {
+			t.Fatalf("picked %v while u1 is ejected", u)
+		}
+	}
+
+	clk.Advance(30 * time.Second)
+	if u1.Ejected() {
+		t.Fatal("still ejected when the ejection period ended")
+	}
+}
+
+func TestPassiveLimitKeepsAShareInRotation(t *testing.T) {
+	rt, _ := newRuntime(t, `{"routes":[{"id":"a","path":"/a","upstreams":[{"url":"http://u1"},{"url":"http://u2"},{"url":"http://u3"}],
+	  "passive_health":{"consecutive_failures":1,"ejection":"30s","max_ejected_percent":50}}]}`)
+	ups := routeOf(t, rt, "a").Upstreams
+	ups[0].Report(Failure)
+	ups[1].Report(Failure)
+	if !ups[0].Ejected() || ups[1].Ejected() {
+		t.Fatal("with 50% of three upstreams, only the first failing one may be ejected")
+	}
+}
+
+func TestPassivePanicRoutingUsesEjectedUpstreams(t *testing.T) {
+	rt, _ := newRuntime(t, passiveRoute)
+	r := routeOf(t, rt, "a")
+	r.Upstreams[0].Report(Failure)
+	r.Upstreams[0].Report(Failure)
+	r.Upstreams[1].health.Set(false)
+	if u := r.NextAny(nil); u == nil {
+		t.Fatal("no upstream picked; every one is unhealthy or ejected, so all should be used")
+	}
+
+	rt2, _ := newRuntime(t, `{"routes":[{"id":"b","path":"/b","upstreams":[{"url":"http://u1"},{"url":"http://u2"}]}]}`)
+	b := routeOf(t, rt2, "b")
+	b.Upstreams[0].health.Set(false)
+	b.Upstreams[1].health.Set(false)
+	if u := b.NextAny(nil); u != nil {
+		t.Fatalf("route without passive health picked %v; want none", u)
+	}
+}
+
+// TestPassiveStateFollowsUpstreamChanges: a reload that keeps the passive settings keeps the
+// ejections of the upstreams still in the route, and frees the share of a removed upstream.
+func TestPassiveStateFollowsUpstreamChanges(t *testing.T) {
+	rt, _ := newRuntime(t, passiveRoute)
+	routeOf(t, rt, "a").Upstreams[0].Report(Failure)
+	routeOf(t, rt, "a").Upstreams[0].Report(Failure)
+	apply(t, rt, `{"routes":[{"id":"a","path":"/a","upstreams":[{"url":"http://u1"},{"url":"http://u2"},{"url":"http://u3"}],
+	  "passive_health":{"consecutive_failures":2,"ejection":"30s","max_ejected_percent":50}}]}`)
+	ups := routeOf(t, rt, "a").Upstreams
+	if !ups[0].Ejected() {
+		t.Fatal("adding an upstream reset the ejection of u1")
+	}
+	ups[1].Report(Failure)
+	ups[1].Report(Failure)
+	if ups[1].Ejected() {
+		t.Fatal("three upstreams at 50% allow one ejection; a second one was let through")
+	}
+
+	// u1 leaves the route: its ejection goes with it, and u2 may now be ejected.
+	apply(t, rt, `{"routes":[{"id":"a","path":"/a","upstreams":[{"url":"http://u2"},{"url":"http://u3"}],
+	  "passive_health":{"consecutive_failures":2,"ejection":"30s","max_ejected_percent":50}}]}`)
+	ups = routeOf(t, rt, "a").Upstreams
+	ups[0].Report(Failure)
+	ups[0].Report(Failure)
+	if !ups[0].Ejected() {
+		t.Fatal("the ejection of a removed upstream still uses up the share")
+	}
+}
+
+// TestPassiveShrinkingTheRouteReleasesExcessEjections: after a reload with fewer upstreams the
+// share is smaller, so the ejections that end first are released until it holds again, and one
+// upstream is always left in rotation.
+func TestPassiveShrinkingTheRouteReleasesExcessEjections(t *testing.T) {
+	rt, _ := newRuntime(t, `{"routes":[{"id":"a","path":"/a","upstreams":[{"url":"http://u1"},{"url":"http://u2"},{"url":"http://u3"},{"url":"http://u4"}],
+	  "passive_health":{"consecutive_failures":1,"ejection":"30s","max_ejected_percent":50}}]}`)
+	ups := routeOf(t, rt, "a").Upstreams
+	ups[0].Report(Failure)
+	ups[1].Report(Failure)
+	if !ups[0].Ejected() || !ups[1].Ejected() {
+		t.Fatal("two of four upstreams at 50% should be ejected")
+	}
+
+	apply(t, rt, `{"routes":[{"id":"a","path":"/a","upstreams":[{"url":"http://u1"},{"url":"http://u2"}],
+	  "passive_health":{"consecutive_failures":1,"ejection":"30s","max_ejected_percent":50}}]}`)
+	ups = routeOf(t, rt, "a").Upstreams
+	if ups[0].Ejected() || !ups[1].Ejected() {
+		t.Fatalf("ejected u1=%v u2=%v; want only u2, the later ejection, kept under the new limit of 1", ups[0].Ejected(), ups[1].Ejected())
+	}
+	if u := routeOf(t, rt, "a").Next(nil); u == nil || u.String() != "http://u1" {
+		t.Fatalf("Next picked %v; one upstream must stay in rotation", u)
+	}
+}
+
+// TestPassiveIgnoresReportsForRemovedUpstreams: a request still on the old table reports a failure
+// for an upstream the reload removed; it must not eject the upstream if it comes back.
+func TestPassiveIgnoresReportsForRemovedUpstreams(t *testing.T) {
+	rt, _ := newRuntime(t, passiveRoute)
+	old := routeOf(t, rt, "a")
+	apply(t, rt, `{"routes":[{"id":"a","path":"/a","upstreams":[{"url":"http://u1"}],
+	  "passive_health":{"consecutive_failures":2,"ejection":"30s","max_ejected_percent":50}}]}`)
+	old.Upstreams[1].Report(Failure)
+	old.Upstreams[1].Report(Failure)
+	apply(t, rt, passiveRoute)
+	if u := routeOf(t, rt, "a").Upstreams[1]; u.Ejected() {
+		t.Fatal("failures reported after u2 was removed ejected it when it came back")
+	}
+}
