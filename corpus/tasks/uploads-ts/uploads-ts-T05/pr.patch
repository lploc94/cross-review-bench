new file mode 100644
index 0000000..69efbdf
--- /dev/null
+++ b/src/repositories/retentionRepo.ts
@@ -0,0 +1,127 @@
+import type { Queryable } from "../db/pool.js";
+import type { RetentionRule } from "../domain/retention.js";
+import { requireRow, toSafeInteger } from "./mapping.js";
+
+interface RuleRow {
+  tenant_id: string;
+  prefix: string;
+  days: number;
+  created_at: Date;
+  updated_at: Date;
+}
+
+const COLUMNS = "tenant_id, prefix, days, created_at, updated_at";
+
+function mapRule(row: RuleRow): RetentionRule {
+  return {
+    tenantId: row.tenant_id,
+    prefix: row.prefix,
+    days: row.days,
+    createdAt: row.created_at,
+    updatedAt: row.updated_at,
+  };
+}
+
+/** The tenant's rules in prefix order. */
+export async function listRules(db: Queryable, tenantId: string): Promise<RetentionRule[]> {
+  const result = await db.query<RuleRow>(
+    `SELECT ${COLUMNS} FROM retention_rules WHERE tenant_id = $1 ORDER BY prefix`,
+    [tenantId],
+  );
+  return result.rows.map(mapRule);
+}
+
+/** How many rules the tenant has for other prefixes than `prefix`. */
+export async function countOtherRules(db: Queryable, tenantId: string, prefix: string): Promise<number> {
+  const result = await db.query<{ count: string }>(
+    "SELECT count(*) AS count FROM retention_rules WHERE tenant_id = $1 AND prefix <> $2",
+    [tenantId, prefix],
+  );
+  return toSafeInteger(requireRow(result.rows, "countOtherRules").count, "count");
+}
+
+/** Create the rule for a prefix, or change its days. */
+export async function upsertRule(
+  db: Queryable,
+  rule: { tenantId: string; prefix: string; days: number; now: Date },
+): Promise<RetentionRule> {
+  const result = await db.query<RuleRow>(
+    `INSERT INTO retention_rules (tenant_id, prefix, days, created_at, updated_at)
+     VALUES ($1, $2, $3, $4, $4)
+     ON CONFLICT (tenant_id, prefix) DO UPDATE SET days = EXCLUDED.days, updated_at = EXCLUDED.updated_at
+     RETURNING ${COLUMNS}`,
+    [rule.tenantId, rule.prefix, rule.days, rule.now],
+  );
+  return mapRule(requireRow(result.rows, "upsertRule"));
+}
+
+/** Returns false when the tenant has no rule for the prefix. */
+export async function deleteRule(db: Queryable, tenantId: string, prefix: string): Promise<boolean> {
+  const result = await db.query("DELETE FROM retention_rules WHERE tenant_id = $1 AND prefix = $2", [
+    tenantId,
+    prefix,
+  ]);
+  return result.rowCount === 1;
+}
+
+/** A live file that its retention rule says is due for deletion. */
+export interface ExpiredFile {
+  readonly id: string;
+  readonly tenantId: string;
+  readonly size: number;
+  readonly storageKey: string;
+}
+
+interface ExpiredFileRow {
+  id: string;
+  tenant_id: string;
+  size: string;
+  storage_key: string;
+}
+
+/**
+ * Up to `limit` live files older than the rule with the longest prefix that matches their path,
+ * oldest first. Days are counted as 24 hours, whatever the session's time zone.
+ */
+export async function findExpiredFiles(db: Queryable, now: Date, limit: number): Promise<ExpiredFile[]> {
+  const result = await db.query<ExpiredFileRow>(
+    `SELECT files.id, files.tenant_id, files.size, files.storage_key
+     FROM retention_rules rule
+     JOIN files ON files.tenant_id = rule.tenant_id AND starts_with(files.path, rule.prefix)
+     WHERE files.status <> 'deleted'
+       AND files.created_at <= $1::timestamptz - make_interval(hours => rule.days * 24)
+       AND NOT EXISTS (
+         SELECT 1 FROM retention_rules longer
+         WHERE longer.tenant_id = rule.tenant_id
+           AND length(longer.prefix) > length(rule.prefix)
+           AND starts_with(files.path, longer.prefix)
+       )
+     ORDER BY files.created_at, files.id
+     LIMIT $2`,
+    [now, limit],
+  );
+  return result.rows.map((row) => ({
+    id: row.id,
+    tenantId: row.tenant_id,
+    size: toSafeInteger(row.size, "files.size"),
+    storageKey: row.storage_key,
+  }));
+}
+
+/**
+ * Mark an expired file deleted. The rule is read again here, so a file whose rule was removed or
+ * lengthened since findExpiredFiles picked it is left alone.
+ */
+export async function expireFile(db: Queryable, id: string, now: Date): Promise<void> {
+  await db.query(
+    `UPDATE files SET status = 'deleted', deleted_at = $2, updated_at = $2, next_scan_at = NULL
+     WHERE id = $1
+       AND files.created_at <= $2::timestamptz - make_interval(hours => 24 * (
+         SELECT rule.days FROM retention_rules rule
+         WHERE rule.tenant_id = files.tenant_id AND starts_with(files.path, rule.prefix)
+         ORDER BY length(rule.prefix) DESC
+         LIMIT 1
+       ))`,
+    [id, now],
+  );
+}
