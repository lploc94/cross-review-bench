diff --git a/internal/proxy/canary_test.go b/internal/proxy/canary_test.go
new file mode 100644
index 0000000..1627ea3
--- /dev/null
+++ b/internal/proxy/canary_test.go
@@ -0,0 +1,63 @@
+package proxy
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+const canaryRoutes = `{"routes":[{"id":"shop","path_prefix":"/shop",
+  "upstreams":[{"url":"http://stable.internal"}],
+  "canary":{"upstreams":[{"url":"http://canary.internal"}],"percent":%d}}]}`
+
+// canaryHosts serves n requests from distinct client addresses, with the given header value,
+// and returns which upstream host each one reached.
+func canaryHosts(t *testing.T, percent, n int, header string) []string {
+	t.Helper()
+	var hosts []string
+	tr := &fakeTransport{respond: func(_ int, r *http.Request) (*http.Response, error) {
+		hosts = append(hosts, r.URL.Host)
+		return reply(r, http.StatusOK, "ok"), nil
+	}}
+	f := newFixture(t, fmt.Sprintf(canaryRoutes, percent), fixtureOptions{transport: tr})
+	for i := 0; i < n; i++ {
+		r := httptest.NewRequest(http.MethodGet, "/shop/cart", nil)
+		r.RemoteAddr = fmt.Sprintf("10.0.%d.%d:4000", i/256, i%256)
+		if header != "" {
+			r.Header.Set("X-Canary", header)
+		}
+		if w := f.do(r); w.Code != http.StatusOK {
+			t.Fatalf("request %d: status %d", i, w.Code)
+		}
+	}
+	return hosts
+}
+
+func TestCanaryHeaderForcesThePool(t *testing.T) {
+	if got := canaryHosts(t, 0, 1, "always"); got[0] != "canary.internal" {
+		t.Errorf("X-Canary: always reached %s, want the canary", got[0])
+	}
+	if got := canaryHosts(t, 100, 1, "never"); got[0] != "stable.internal" {
+		t.Errorf("X-Canary: never reached %s, want the stable upstreams", got[0])
+	}
+}
+
+func TestCanaryShareIsStickyAndProportional(t *testing.T) {
+	hosts := canaryHosts(t, 50, 400, "")
+	canary := 0
+	for _, h := range hosts {
+		if h == "canary.internal" {
+			canary++
+		}
+	}
+	if canary < 120 || canary > 280 {
+		t.Errorf("canary share %d of 400 at 50 percent", canary)
+	}
+	again := canaryHosts(t, 50, 400, "")
+	for i := range hosts {
+		if hosts[i] != again[i] {
+			t.Fatalf("client %d moved between pools", i)
+		}
+	}
+}
