+++ b/test/api/presignedUploads.test.ts
@@ -0,0 +1,122 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { UrlSigner, unixNow } from "../../src/services/urlSigner.js";
+import { buildTestApp, TEST_SIGNING_SECRET, type TestApp } from "../helpers/app.js";
+import { createTenant, expectStatus, tenantUsage, type ErrorResponse, type FileBody, type TestTenant } from "../helpers/fixtures.js";
+
+interface PresignBody {
+  url: string;
+  headers: Record<string, string>;
+  expiresAt: string;
+}
+
+describe("presigned uploads", () => {
+  let t: TestApp;
+  let tenant: TestTenant;
+
+  beforeEach(async () => {
+    t = await buildTestApp();
+    tenant = await createTenant(t.pool, t.clock);
+  });
+
+  afterEach(async () => {
+    await t.close();
+  });
+
+  function presign(payload: Record<string, unknown>, headers: Record<string, string> = tenant.headers) {
+    return t.app.inject({ method: "POST", url: "/v1/uploads/presign", headers, payload });
+  }
+
+  async function presignedUrl(path: string, size: number): Promise<string> {
+    const response = await presign({ path, size, expiresIn: 600 });
+    expectStatus(response, 200);
+    return response.json<PresignBody>().url;
+  }
+
+  function putTo(url: string, body: string) {
+    return t.app.inject({ method: "PUT", url, headers: { "content-type": "text/plain" }, payload: body });
+  }
+
+  it("stores the file without an API key, once", async () => {
+    const response = await presign({ path: "inbox/scan 1.txt", size: 13, contentType: "text/plain", expiresIn: 600 });
+    expectStatus(response, 200);
+    const presigned = response.json<PresignBody>();
+    expect(presigned.expiresAt).toBe("2030-01-15T10:10:00.000Z");
+    expect(presigned.headers).toEqual({ "content-type": "text/plain" });
+    const url = new URL(presigned.url, "http://localhost");
+    expect(url.pathname).toBe("/v1/public/uploads");
+    expect(url.searchParams.get("path")).toBe("inbox/scan 1.txt");
+
+    const stored = await putTo(presigned.url, "scanned pages");
+    expectStatus(stored, 201);
+    expect(stored.json<FileBody>()).toMatchObject({ path: "inbox/scan 1.txt", size: 13, status: "pending_scan" });
+    expect(await tenantUsage(t.pool, tenant.tenantId)).toBe(13);
+
+    const again = await putTo(presigned.url, "other content");
+    expectStatus(again, 409);
+    expect(again.json<ErrorResponse>().error.code).toBe("path_exists");
+    expect(await tenantUsage(t.pool, tenant.tenantId)).toBe(13);
+  });
+
+  it("refuses a URL whose parameters were changed", async () => {
+    const other = await createTenant(t.pool, t.clock, { name: "Harbor Logistics" });
+    const original = new URL(await presignedUrl("inbox/a.txt", 4), "http://localhost");
+    const changes: [string, string][] = [
+      ["path", "inbox/b.txt"],
+      ["size", "5"],
+      ["tenant", other.tenantId],
+      ["exp", String(Number(original.searchParams.get("exp")) + 3600)],
+      ["sig", (original.searchParams.get("sig") ?? "").toUpperCase()],
+    ];
+    for (const [name, value] of changes) {
+      const changed = new URL(original);
+      changed.searchParams.set(name, value);
+      const response = await putTo(`${changed.pathname}${changed.search}`, name === "size" ? "abcde" : "abcd");
+      expectStatus(response, 403);
+      expect(response.json<ErrorResponse>().error.code).toBe("invalid_signature");
+    }
+    expect(await tenantUsage(t.pool, other.tenantId)).toBe(0);
+  });
+
+  it("refuses an expired URL", async () => {
+    const grant = { tenantId: tenant.tenantId, path: "late.txt", size: 4, expiresAt: unixNow(t.clock) };
+    const query = new URLSearchParams({
+      tenant: grant.tenantId,
+      path: grant.path,
+      size: "4",
+      exp: String(grant.expiresAt),
+      sig: new UrlSigner(TEST_SIGNING_SECRET).signUpload(grant),
+    });
+    const response = await putTo(`/v1/public/uploads?${query.toString()}`, "late");
+    expectStatus(response, 403);
+    expect(response.json<ErrorResponse>().error.code).toBe("signed_url_expired");
+  });
+
+  it("takes only a body of the signed size", async () => {
+    const url = await presignedUrl("sized.txt", 10);
+    for (const body of ["too short", "much too long"]) {
+      const response = await putTo(url, body);
+      expectStatus(response, 400);
+      expect(response.json<ErrorResponse>().error.details).toEqual({ size: 10 });
+    }
+    expectStatus(await putTo(url, "just right"), 201);
+  });
+
+  it("reserves the quota when the file arrives", async () => {
+    const small = await createTenant(t.pool, t.clock, { name: "Small Co", quotaBytes: 8 });
+    const response = await presign({ path: "big.txt", size: 12, expiresIn: 60 }, small.headers);
+    expectStatus(response, 200);
+    const upload = await putTo(response.json<PresignBody>().url, "twelve bytes");
+    expectStatus(upload, 422);
