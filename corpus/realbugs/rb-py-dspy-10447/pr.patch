+---
+name: Bootstrap versioned documentation
+
+on:
+  workflow_dispatch:
+
+permissions: {}
+
+jobs:
+  bootstrap:
+    if: github.repository == 'stanfordnlp/dspy'
+    runs-on: ubuntu-latest
+    timeout-minutes: 180
+    concurrency:
+      group: dspy-docs-bootstrap
+      cancel-in-progress: false
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
+        with:
+          persist-credentials: false
+          fetch-depth: 0
+      - name: Set up Python 3.11
+        uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
+        with:
+          python-version: "3.11"
+      - name: Install bootstrap dependencies
+        run: |
+          grep -v 'github.com/stanfordnlp/dspy' docs/requirements.txt > "$RUNNER_TEMP/docs-requirements.txt"
+          python -m pip install -r "$RUNNER_TEMP/docs-requirements.txt" -e .
+      - name: Build Material Current
+        run: |
+          python docs/scripts/build_docs.py current \
+            --config docs/mkdocs.yml \
+            --output current-site
+      - name: Check out documentation deployment
+        uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
+        with:
+          repository: krypticmouse/dspy-docs
+          ref: master
+          path: docs-deployment
+          persist-credentials: false
+          token: ${{ secrets.GH_PAT }} # zizmor: ignore[secrets-outside-env]
+      - name: Prepare Mike deployment branch
+        run: |
+          git -C docs-deployment config user.name github-actions
+          git -C docs-deployment config user.email github-actions@github.com
+          set +e
+          git -C docs-deployment ls-remote --exit-code --heads origin versioned-docs >/dev/null
+          branch_status=$?
+          set -e
+          if [[ "$branch_status" == 0 ]]; then
+            git -C docs-deployment fetch origin versioned-docs:versioned-docs
+          elif [[ "$branch_status" != 2 ]]; then
+            exit "$branch_status"
+          fi
+      - name: Reconstruct all historical snapshots
+        run: |
+          python docs/scripts/bootstrap_versioned_docs.py \
+            --deployment docs-deployment \
+            --branch versioned-docs
+      - name: Add Material Current to the candidate deployment
+        run: |
+          python docs/scripts/publish_versioned_docs.py \
+            --repository docs-deployment \
+            --site current-site \
+            --identifier current \
+            --package-source working-tree \
+            --branch versioned-docs
+      - name: Push the complete candidate for deployment review
+        env:
+          GH_TOKEN: ${{ secrets.GH_PAT }}
+        run: |
+          gh auth setup-git
+          # This staging push does not change production or activate Mike.
+          # A reviewed dspy-docs PR promotes the candidate to master atomically.
+          git -C docs-deployment push origin versioned-docs
