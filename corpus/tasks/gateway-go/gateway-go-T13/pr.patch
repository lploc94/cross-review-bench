+
+func (l *limitedReader) Read(p []byte) (int, error) {
+	if l.exceeded.Load() {
+		return 0, errBodyTooLarge
+	}
+	if l.stopped.Load() {
+		return 0, errBodyCut
+	}
+	n, err := l.r.Read(p)
+	l.read += int64(n)
