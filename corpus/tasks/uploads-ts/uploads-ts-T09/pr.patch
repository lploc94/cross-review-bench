@@ -0,0 +1,101 @@
+import { createHmac } from "node:crypto";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { createLogger } from "../../src/infra/logger.js";
+import { findLiveFileById } from "../../src/repositories/fileRepo.js";
+import { ScanWorker } from "../../src/services/scanWorker.js";
+import { WebhookDeliveryError, WebhookNotifier, type FileAvailableEvent } from "../../src/services/webhooks.js";
+import { buildTestApp, type TestApp } from "../helpers/app.js";
+import { createTenant, expectStatus, storeFile, type TestTenant } from "../helpers/fixtures.js";
+import { png } from "../helpers/images.js";
+import { WebhookReceiver } from "../helpers/webhookReceiver.js";
+
+describe("file.available webhooks", () => {
+  let t: TestApp;
+  let tenant: TestTenant;
+  let receiver: WebhookReceiver;
+  let secret: string;
+  let notifier: WebhookNotifier;
+  const logger = createLogger({ level: "silent" });
+
+  beforeEach(async () => {
+    t = await buildTestApp({ env: { WEBHOOK_RETRY_DELAY_MS: "0", WEBHOOK_TIMEOUT_MS: "200" } });
+    tenant = await createTenant(t.pool, t.clock);
+    receiver = await WebhookReceiver.start();
+    notifier = new WebhookNotifier({ pool: t.pool, clock: t.clock, logger, settings: t.config.webhooks });
+    const payload = { url: receiver.url };
+    const response = await t.app.inject({ method: "PUT", url: "/v1/tenant/webhook", headers: tenant.headers, payload });
+    expectStatus(response, 200);
+    secret = response.json<{ secret: string }>().secret;
+  });
+
+  afterEach(async () => {
+    await receiver.close();
+    await t.close();
+  });
+
+  /** Scan everything due, then wait for the deliveries the scan started. */
+  async function scanAndDeliver(): Promise<void> {
+    const deliveries: Promise<void>[] = [];
+    const worker = new ScanWorker({
+      pool: t.pool,
+      clock: t.clock,
+      logger,
+      storage: t.storage,
+      scanner: t.scanner,
+      settings: t.config.scan,
+      notifier: {
+        fileAvailable: (file, at) => {
+          const delivery = notifier.fileAvailable(file, at);
+          deliveries.push(delivery);
+          return delivery;
+        },
+      },
+    });
+    await worker.runOnce();
+    await Promise.all(deliveries);
+  }
+
+  async function record(path: string) {
+    const stored = await storeFile(t.app, tenant, path, "plain");
+    return (await findLiveFileById(t.pool, tenant.tenantId, stored.id))!;
+  }
+
+  it("posts a signed event for each clean file", async () => {
+    const file = await storeFile(t.app, tenant, "photos/harbour.png", png(64, 48));
+    t.clock.advanceSeconds(1);
+    await storeFile(t.app, tenant, "infected.txt", "bad");
+    t.scanner.next("clean", "infected");
+    await scanAndDeliver();
+
+    expect(receiver.received).toHaveLength(1);
+    const [delivery] = receiver.received;
+    const event = JSON.parse(delivery!.body) as FileAvailableEvent;
+    expect(event).toMatchObject({
+      type: "file.available",
+      createdAt: "2030-01-15T10:00:01.000Z",
+      data: { file: { id: file.id, path: "photos/harbour.png", sha256: file.sha256, image: { width: 64, height: 48 } } },
+    });
+    expect(delivery!.headers["webhook-id"]).toBe(event.id);
+    const t0 = Date.parse("2030-01-15T10:00:01.000Z") / 1000;
+    const signature = createHmac("sha256", secret).update(`${t0}.${delivery!.body}`).digest("hex");
+    expect(delivery!.headers["webhook-signature"]).toBe(`t=${t0},v1=${signature}`);
+  });
+
+  it("retries an error status with the same event id", async () => {
+    receiver.respondWith(500, 503);
+    await notifier.fileAvailable(await record("notes.txt"), t.clock.now());
+    expect(receiver.received).toHaveLength(3);
+    expect(new Set(receiver.received.map((d) => d.headers["webhook-id"])).size).toBe(1);
+  });
+
+  it("gives up after three failed attempts, timeouts included", async () => {
+    receiver.defaultStatus = 500;
+    const file = await record("notes.txt");
+    await expect(notifier.fileAvailable(file, t.clock.now())).rejects.toMatchObject({ lastStatus: 500 });
+    receiver.silent = true;
+    const failure = notifier.fileAvailable(file, t.clock.now());
+    await expect(failure).rejects.toBeInstanceOf(WebhookDeliveryError);
+    await expect(failure).rejects.toMatchObject({ lastStatus: null });
+    expect(receiver.received).toHaveLength(6);
+  });
+});
