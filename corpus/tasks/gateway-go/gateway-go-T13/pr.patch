+// bodyBudget is how many bytes of a request body the gateway holds in memory for the route: the
+// smaller of BODY_BUFFER_LIMIT and the route's max_request_bytes.
+func (h *Handler) bodyBudget(route *core.Route) int64 {
+	if max := route.MaxRequestBytes; max > 0 && max < h.bodyLimit {
+		return max
+	}
+	return h.bodyLimit
+}
+
+// bufferLimitMessage names the limit that stopped a body the gateway had to hold in memory for
+// the route: the route's max_request_bytes when that is the smaller one, else BODY_BUFFER_LIMIT,
+// which then names the route's limit too if there is one.
+func (h *Handler) bufferLimitMessage(route *core.Route) string {
+	max := route.MaxRequestBytes
+	if max > 0 && max <= h.bodyLimit {
+		return "the request body exceeds the route's max_request_bytes of " + strconv.FormatInt(max, 10) + " bytes"
+	}
+	msg := "the request body exceeds " + strconv.FormatInt(h.bodyLimit, 10) +
+		" bytes, the most the gateway holds in memory for this route (BODY_BUFFER_LIMIT)"
+	if max > 0 {
+		msg += "; the route's max_request_bytes is " + strconv.FormatInt(max, 10) + " bytes"
+	}
+	return msg
+}
