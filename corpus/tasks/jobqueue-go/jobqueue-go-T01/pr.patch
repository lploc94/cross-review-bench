--- /dev/null
+++ b/internal/api/batch.go
@@ -0,0 +1,54 @@
+package api
+
+import (
+	"net/http"
+
+	"github.com/relaywork/jobqueue/internal/domain"
+)
+
+// maxBatchBodyBytes bounds a batch request body. Each payload is still limited to
+// domain.MaxPayloadBytes.
+const maxBatchBodyBytes = 8 << 20
+
+type enqueueBatchRequest struct {
+	Jobs []enqueueRequest `json:"jobs"`
+}
+
+type jobListJSON struct {
+	Jobs []jobJSON `json:"jobs"`
+}
+
+// POST /v1/queues/{queue}/jobs/batch
+func (s *Server) enqueueBatch(w http.ResponseWriter, r *http.Request) error {
+	queue := r.PathValue("queue")
+	if err := domain.ValidateQueueName(queue); err != nil {
+		return domain.Invalid("queue", "%s", err)
+	}
+	var req enqueueBatchRequest
+	if err := decodeJSONLimit(w, r, &req, maxBatchBodyBytes); err != nil {
+		return err
+	}
+	batch := make([]domain.NewJob, len(req.Jobs))
+	for i, j := range req.Jobs {
+		batch[i] = domain.NewJob{
+			Queue:       queue,
+			Type:        j.Type,
+			Payload:     j.Payload,
+			Priority:    j.Priority,
+			MaxAttempts: j.MaxAttempts,
+		}
+		if j.RunAt != nil {
+			batch[i].RunAt = *j.RunAt
+		}
+	}
+	jobs, err := s.store.EnqueueBatch(r.Context(), batch)
+	if err != nil {
+		return err
+	}
+	out := jobListJSON{Jobs: make([]jobJSON, len(jobs))}
+	for i, j := range jobs {
+		out.Jobs[i] = toJobJSON(j)
+	}
+	s.writeJSON(w, http.StatusCreated, out)
+	return nil
+}
