diff --git a/src/etl/pipeline/metrics.py b/src/etl/pipeline/metrics.py
new file mode 100644
index 0000000..dfdac00
--- /dev/null
+++ b/src/etl/pipeline/metrics.py
@@ -0,0 +1,128 @@
+"""Run metrics for the Prometheus node exporter's textfile collector.
+
+After every run the metrics file (`METRICS_FILE`) is rewritten from `etl.runs`, so it always
+describes every finished run, whichever process ran it. The file is replaced atomically: the
+collector reads only `*.prom` files, and the temporary file next to it ends in `.tmp`.
+"""
+
+from __future__ import annotations
+
+import os
+import tempfile
+from collections.abc import Mapping
+from datetime import timedelta
+from pathlib import Path
+from typing import TextIO
+
+from sqlalchemy import Connection, Engine, func, select, text
+from sqlalchemy.dialects.postgresql import distinct_on
+
+from etl.errors import describe_error
+from etl.infra.locks import LOCK_NAMESPACE, lock_key
+from etl.infra.tables import runs
+from etl.logging import get_logger
+from etl.store.runs import RunStatus
+
+log = get_logger(__name__)
+
+# Row counts of a run, as the `kind` label of etl_rows_total.
+ROW_KINDS = ("read", "loaded", "rejected", "skipped")
+
+# The node exporter usually runs as another user: the file must be readable by everyone.
+FILE_MODE = 0o644
+
+# Held until the writer's transaction ends.
+WRITER_LOCK = text("SELECT pg_advisory_xact_lock(CAST(:ns AS integer), CAST(:key AS integer))")
+
+
+def _escape(value: str) -> str:
+    return value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
+
+
+def _family(out: TextIO, name: str, kind: str, description: str) -> None:
+    out.write(f"# HELP {name} {description}\n# TYPE {name} {kind}\n")
+
+
+def _sample(out: TextIO, name: str, labels: Mapping[str, str], value: float) -> None:
+    rendered = ",".join(f'{key}="{_escape(label)}"' for key, label in labels.items())
+    out.write(f"{name}{{{rendered}}} {value!r}\n")
+
+
+def write_metrics(engine: Engine, path: Path) -> None:
+    """Replace the metrics file with the current metrics. Never raises: a failure is logged
+    and the previous file stays as it was, since metrics must never fail a run."""
+    try:
+        descriptor, temporary = tempfile.mkstemp(
+            dir=path.parent, prefix=f".{path.name}.", suffix=".tmp"
+        )
+        with engine.connect() as connection:
+            # Runs of different sources can finish together: one writer at a time, so a file
+            # rendered earlier never replaces one rendered later.
+            connection.execute(WRITER_LOCK, {"ns": LOCK_NAMESPACE, "key": lock_key("etl.metrics")})
+            with os.fdopen(descriptor, "w", encoding="utf-8") as out:
+                render_metrics(connection, out)
+                out.flush()
+                os.fsync(out.fileno())
+            os.chmod(temporary, FILE_MODE)
+            os.replace(temporary, path)
+    except Exception as error:
+        log.error("metrics.not_written", path=str(path), error=describe_error(error))
+
+
+def render_metrics(connection: Connection, out: TextIO) -> None:
+    """Write the metrics of every source with a finished run."""
+    finished = runs.c.status != RunStatus.RUNNING
+
+    _family(out, "etl_runs_total", "counter", "Finished runs per source and status.")
+    per_status = connection.execute(
+        select(runs.c.source, runs.c.status, func.count())
+        .where(finished)
+        .group_by(runs.c.source, runs.c.status)
+        .order_by(runs.c.source, runs.c.status)
+    )
+    for source, status, total in per_status:
+        _sample(out, "etl_runs_total", {"source": source, "status": status}, int(total))
+
+    latest = (
+        connection.execute(
+            select(runs)
+            .where(finished)
+            .ext(distinct_on(runs.c.source))
+            .order_by(runs.c.source, runs.c.id.desc())
+        )
+        .mappings()
+        .all()
+    )
+
+    _family(out, "etl_rows_total", "counter", "Rows of finished runs per source and kind.")
+    for run in latest:
+        for kind in ROW_KINDS:
+            labels = {"source": run["source"], "kind": kind}
+            _sample(out, "etl_rows_total", labels, int(run[f"rows_{kind}"]))
+
+    _family(
+        out,
+        "etl_last_success_timestamp_seconds",
+        "gauge",
+        "When the latest successful run of the source finished (Unix time).",
+    )
+    last_success = connection.execute(
+        select(runs.c.source, func.max(runs.c.finished_at))
+        .where(runs.c.status == RunStatus.SUCCEEDED)
+        .group_by(runs.c.source)
+        .order_by(runs.c.source)
+    )
+    for source, finished_at in last_success:
+        _sample(
+            out, "etl_last_success_timestamp_seconds", {"source": source}, finished_at.timestamp()
+        )
+
+    _family(
+        out,
+        "etl_run_duration_seconds",
+        "gauge",
+        "How long the latest finished run of the source took.",
+    )
+    for run in latest:
+        duration = (run["finished_at"] - run["started_at"]) / timedelta(milliseconds=1)
+        _sample(out, "etl_run_duration_seconds", {"source": run["source"]}, duration)
