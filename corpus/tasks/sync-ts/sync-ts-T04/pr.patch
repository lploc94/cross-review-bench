diff --git a/packages/client/test/e2e/counters.test.ts b/packages/client/test/e2e/counters.test.ts
new file mode 100644
index 0000000..c8985a9
--- /dev/null
+++ b/packages/client/test/e2e/counters.test.ts
@@ -0,0 +1,64 @@
+import { NetworkError } from "@sync/client";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { openClient, type TestClient } from "../helpers/clients.js";
+import { startTestServer, type TestAccount, type TestServer } from "../helpers/testServer.js";
+
+let server: TestServer;
+let laptop: TestAccount;
+let phone: TestAccount;
+const opened: TestClient[] = [];
+
+function client(account: TestAccount): TestClient {
+  const c = openClient(server, account);
+  opened.push(c);
+  return c;
+}
+
+beforeEach(async () => {
+  server = await startTestServer();
+  laptop = await server.createUser("Ada");
+  phone = await server.addDevice(laptop);
+});
+
+afterEach(async () => {
+  for (const c of opened.splice(0)) await c.client.close();
+  await server.close();
+});
+
+describe("counter fields", () => {
+  it("count a local increment at once and queue it", () => {
+    const a = client(laptop);
+    a.client.set("tasks", "t1", { title: "Review" });
+    expect(a.client.increment("tasks", "t1", "timeSpentSec", 300)).toMatchObject({ op: "increment" });
+    a.client.increment("tasks", "t1", "timeSpentSec", 120);
+    expect(a.client.get("tasks", "t1")?.fields).toEqual({ title: "Review", timeSpentSec: 420 });
+    expect(() => a.client.increment("tasks", "t1", "priority", 1)).toThrow(/not a counter/);
+    expect(() => a.client.set("tasks", "t1", { timeSpentSec: 1 })).toThrow(/counter/);
+  });
+
+  it("add up concurrent increments of two devices on both", async () => {
+    const a = client(laptop);
+    const b = client(phone);
+    a.client.increment("tasks", "t1", "timeSpentSec", 600);
+    b.client.increment("tasks", "t1", "timeSpentSec", 45);
+    b.client.increment("tasks", "t1", "timeSpentSec", 15);
+
+    await a.client.sync();
+    expect(await b.client.sync()).toMatchObject({ pushed: 2, pulled: 3, applied: 1 });
+    expect(await a.client.sync()).toMatchObject({ pulled: 2, applied: 2 });
+    for (const c of [a, b]) expect(c.client.get("tasks", "t1")?.fields).toEqual({ timeSpentSec: 660 });
+  });
+
+  it("count an increment once when its push answer was lost", async () => {
+    const a = client(laptop);
+    a.client.increment("tasks", "t1", "timeSpentSec", 90);
+    a.transport.dropNextResponse();
+    await expect(a.client.sync()).rejects.toBeInstanceOf(NetworkError);
+    await a.client.sync();
+    expect(a.client.get("tasks", "t1")?.fields).toEqual({ timeSpentSec: 90 });
+
+    const fresh = client(phone);
+    await fresh.client.sync();
+    expect(fresh.client.get("tasks", "t1")?.fields).toEqual({ timeSpentSec: 90 });
+  });
+});
