+  return Buffer()
+    ..writeVarUint32Small7(typeId)
+    ..writeVarUint32Small14(marker)
+    ..writeInt64(header.value)
+    ..writeBytes(extraBytes)
+    ..writeUint8(0)
+    ..writeBytes(body);
+}
