diff --git a/packages/server/src/repositories/counters.ts b/packages/server/src/repositories/counters.ts
new file mode 100644
index 0000000..1cd9a3c
--- /dev/null
+++ b/packages/server/src/repositories/counters.ts
@@ -0,0 +1,84 @@
+import { docKey } from "@sync/shared";
+import type { Queryable } from "../db/pool.js";
+import { toSafeInteger } from "./mapping.js";
+
+/** What one increment adds to one counter field of a document. */
+export interface CounterDelta {
+  readonly mutationId: string;
+  readonly collection: string;
+  readonly docId: string;
+  readonly field: string;
+  readonly delta: number;
+  readonly hlc: string;
+}
+
+/**
+ * Apply counter deltas: each becomes an event whose value is the delta (devices add it to their
+ * own total), and is added to the field's total in the stored document, which is created when
+ * it does not exist yet. Returns the number of events written.
+ */
+export async function applyIncrements(
+  db: Queryable,
+  userId: string,
+  deviceId: string,
+  deltas: readonly CounterDelta[],
+  receivedAt: Date,
+): Promise<number> {
+  if (deltas.length === 0) return 0;
+  // An event is unique per mutation and field: one already stored is kept as it is.
+  const events = await db.query<{ seq: string; collection: string; doc_id: string }>(
+    `INSERT INTO events (user_id, device_id, mutation_id, collection, doc_id, field, value, hlc, server_received_at)
+     SELECT $1, $2, e.mutation_id, e.collection, e.doc_id, e.field, to_jsonb(e.delta), e.hlc, $3
+       FROM unnest($4::uuid[], $5::text[], $6::text[], $7::text[], $8::bigint[], $9::text[])
+            WITH ORDINALITY AS e(mutation_id, collection, doc_id, field, delta, hlc, ord)
+      ORDER BY e.ord
+     ON CONFLICT (user_id, mutation_id, field) DO NOTHING
+     RETURNING seq, collection, doc_id`,
+    [
+      userId,
+      deviceId,
+      receivedAt,
+      deltas.map((d) => d.mutationId),
+      deltas.map((d) => d.collection),
+      deltas.map((d) => d.docId),
+      deltas.map((d) => d.field),
+      deltas.map((d) => d.delta),
+      deltas.map((d) => d.hlc),
+    ],
+  );
+
+  // Per document: the sum of the deltas of each field, and the seq of its last new event.
+  const totals = new Map<string, { collection: string; docId: string; deltas: Record<string, number>; seq: number }>();
+  for (const d of deltas) {
+    const key = docKey(d.collection, d.docId);
+    const doc = totals.get(key) ?? { collection: d.collection, docId: d.docId, deltas: {}, seq: 0 };
+    doc.deltas[d.field] = (doc.deltas[d.field] ?? 0) + d.delta;
+    totals.set(key, doc);
+  }
+  for (const row of events.rows) {
+    const doc = totals.get(docKey(row.collection, row.doc_id));
+    if (doc) doc.seq = Math.max(doc.seq, toSafeInteger(row.seq, "events.seq"));
+  }
+
+  const docs = [...totals.values()];
+  await db.query(
+    `INSERT INTO documents (user_id, collection, doc_id, fields, field_hlcs, updated_seq, updated_at)
+     SELECT $1, d.collection, d.doc_id, d.deltas::jsonb, '{}'::jsonb, d.seq, $2
+       FROM unnest($3::text[], $4::text[], $5::text[], $6::bigint[]) AS d(collection, doc_id, deltas, seq)
+     ON CONFLICT (user_id, collection, doc_id) DO UPDATE
+       SET fields = documents.fields || (
+             SELECT jsonb_object_agg(c.key, coalesce((documents.fields ->> c.key)::bigint, 0) + c.value::bigint)
+               FROM jsonb_each_text(EXCLUDED.fields) AS c),
+           updated_seq = GREATEST(documents.updated_seq, EXCLUDED.updated_seq),
+           updated_at = EXCLUDED.updated_at`,
+    [
+      userId,
+      receivedAt,
+      docs.map((d) => d.collection),
+      docs.map((d) => d.docId),
+      docs.map((d) => JSON.stringify(d.deltas)),
+      docs.map((d) => d.seq),
+    ],
+  );
+  return events.rowCount ?? 0;
+}
