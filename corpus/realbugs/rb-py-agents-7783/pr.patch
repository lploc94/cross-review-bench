+        """The markup tags stripped so far, in document order."""
+        return self._tags
+
+    def expression_attribute(self) -> dict[str, str] | None:
+        """The ``lk.expression`` attribute for the tags stripped so far, if any."""
+        return expression_attribute(self._tags)
