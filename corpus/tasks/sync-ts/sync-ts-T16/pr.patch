+/**
+ * At most `limit` documents of the user with `updated_seq > after`, in updated_seq order. A
+ * document's updated_seq is the seq of the last event that changed it, so no two documents of a
+ * user share one.
+ */
+export async function listDocumentsUpdatedAfter(
+  db: Queryable,
+  userId: string,
+  after: number,
+  limit: number,
+): Promise<StoredDocument[]> {
+  const result = await db.query<DocumentRow>(
+    `SELECT ${COLUMNS}
+       FROM documents
+      WHERE user_id = $1 AND updated_seq > $2
+      ORDER BY updated_seq
+      LIMIT $3`,
+    [userId, after, limit],
+  );
+  return result.rows.map(toDocument);
+}
