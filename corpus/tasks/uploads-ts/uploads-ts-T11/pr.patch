+ * another transaction is deleting or replacing is skipped rather than waited for.
+ */
+export async function findAvailableBySha256(
+  db: Queryable,
+  content: { sha256: string; size: number; storageDriver: string },
+): Promise<FileRecord | null> {
+  const result = await db.query<FileRow>(
+    `SELECT ${COLUMNS} FROM files
+     WHERE sha256 = $1 AND size = $2 AND storage_driver = $3 AND status = 'available'
+     ORDER BY created_at, id
+     LIMIT 1
+     FOR SHARE SKIP LOCKED`,
+    [content.sha256, content.size, content.storageDriver],
+  );
+  const row = firstRow(result.rows);
+  return row ? mapFile(row) : null;
+}
