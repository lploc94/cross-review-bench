diff --git a/internal/worker/pool.go b/internal/worker/pool.go
index 4990e8b..37cc955 100644
--- a/internal/worker/pool.go
+++ b/internal/worker/pool.go
@@ -21,6 +21,9 @@ import (
 // settleTimeout bounds the store call that records a job's outcome.
 const settleTimeout = 10 * time.Second
 
+// cancelGrace is how long Shutdown waits for handlers to return after cancelling them.
+const cancelGrace = time.Second
+
 // Store is the part of the job store the pool needs.
 type Store interface {
 	Lease(ctx context.Context, queue, workerID string, n int, leaseFor time.Duration) ([]domain.Job, error)
@@ -187,6 +190,11 @@ func (p *Pool) Shutdown(ctx context.Context) error {
 	if cancelHandlers != nil {
 		cancelHandlers()
 	}
+	// Give the cancelled handlers a moment to return so that their outcomes are recorded.
+	select {
+	case <-drained:
+	case <-p.opts.Clock.After(cancelGrace):
+	}
 	return fmt.Errorf("worker: drain: %w", ctx.Err())
 }
 
