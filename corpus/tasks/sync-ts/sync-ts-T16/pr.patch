 export class DocumentService {
@@ -20,4 +29,17 @@ export class DocumentService {
     if (!doc) throw NotFoundError.resource("document", `${collection}/${docId}`);
     return doc;
   }
+
+  /**
+   * The current state of the documents changed after `after`, oldest change first. Paging with
+   * `nextAfter` until `hasMore` is false reaches every document; one that changes meanwhile
+   * comes again on a later page with its new state.
+   */
+  async changes(auth: AuthContext, after: number, limit: number): Promise<DocumentChanges> {
+    // One row more than the page tells whether another page follows.
+    const rows = await listDocumentsUpdatedAfter(this.pool, auth.userId, after, limit + 1);
+    const hasMore = rows.length > limit;
+    const documents = hasMore ? rows.slice(0, limit) : rows;
+    return { documents, nextAfter: documents.at(-1)?.updatedSeq ?? after, hasMore };
+  }
 }
diff --git a/packages/server/test/api/documentChanges.test.ts b/packages/server/test/api/documentChanges.test.ts
new file mode 100644
index 0000000..764a7a4
--- /dev/null
+++ b/packages/server/test/api/documentChanges.test.ts
@@ -0,0 +1,142 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { buildTestApp, type TestApp } from "../helpers/app.js";
+import { createUser, hlc, mutation, push, type TestDevice } from "../helpers/fixtures.js";
+
+let t: TestApp;
+let ada: TestDevice;
+
+beforeEach(async () => {
+  t = await buildTestApp({ env: { PULL_MAX_LIMIT: "50", PULL_DEFAULT_LIMIT: "3" } });
+  ada = await createUser(t);
+});
+
+afterEach(async () => {
+  await t.close();
+});
+
+interface ChangedDocument {
+  collection: string;
+  id: string;
+  fields: Record<string, unknown>;
+  fieldHlcs: Record<string, string>;
+  updatedSeq: number;
+}
+
+interface ChangesPage {
+  documents: ChangedDocument[];
+  nextAfter: number;
+  hasMore: boolean;
+}
+
+function changes(device: TestDevice, query = "") {
+  return t.app.inject({
+    method: "GET",
+    url: `/v1/documents/changes${query}`,
+    headers: { authorization: `Bearer ${device.token}` },
+  });
+}
+
+async function page(device: TestDevice, after: number, limit: number): Promise<ChangesPage> {
+  const res = await changes(device, `?after=${after}&limit=${limit}`);
+  expect(res.statusCode).toBe(200);
+  return res.json<ChangesPage>();
+}
+
+/** One push per document, so each gets its own updatedSeq. */
+async function setTitles(device: TestDevice, titles: Record<string, string>): Promise<void> {
+  for (const [docId, title] of Object.entries(titles)) {
+    t.clock.advance(1);
+    const res = await push(t, device, [mutation({ docId, hlc: hlc(t.clock.now()), fields: { title } })]);
+    expect(res.statusCode).toBe(200);
+  }
+}
+
+describe("GET /v1/documents/changes", () => {
+  it("lists the documents in the order they last changed, with their current state", async () => {
+    await setTitles(ada, { a: "A1", b: "B1", c: "C1" });
+    await setTitles(ada, { a: "A2" });
+    const res = await changes(ada);
+    expect(res.statusCode).toBe(200);
+    const body = res.json<ChangesPage>();
+    expect(body.documents.map((d) => [d.id, d.fields.title])).toEqual([
+      ["b", "B1"],
+      ["c", "C1"],
+      ["a", "A2"],
+    ]);
+    const docB = (await t.app.inject({
+      method: "GET",
+      url: "/v1/documents/notes/b",
+      headers: { authorization: `Bearer ${ada.token}` },
+    })).json<ChangedDocument>();
+    expect(body.documents[0]).toEqual(docB);
+    expect(body.nextAfter).toBe(body.documents.at(-1)?.updatedSeq);
+    expect(body.hasMore).toBe(false);
+  });
+
+  it("pages with nextAfter and tells when more documents follow", async () => {
+    await setTitles(ada, { a: "A", b: "B", c: "C", d: "D", e: "E" });
+    const first = await page(ada, 0, 2);
+    expect(first.documents.map((d) => d.id)).toEqual(["a", "b"]);
+    expect(first.hasMore).toBe(true);
+    expect(first.nextAfter).toBe(first.documents[1]?.updatedSeq);
+    const second = await page(ada, first.nextAfter, 2);
+    expect(second.documents.map((d) => d.id)).toEqual(["c", "d"]);
+    expect(second.hasMore).toBe(true);
+    const third = await page(ada, second.nextAfter, 2);
+    expect(third.documents.map((d) => d.id)).toEqual(["e"]);
+    expect(third.hasMore).toBe(false);
+    const empty = await page(ada, third.nextAfter, 2);
+    expect(empty).toEqual({ documents: [], nextAfter: third.nextAfter, hasMore: false });
+  });
+
+  it("lists a document again on a later page when it changes after being listed", async () => {
+    await setTitles(ada, { a: "A1", b: "B1", c: "C1" });
+    const first = await page(ada, 0, 2);
+    expect(first.documents.map((d) => d.id)).toEqual(["a", "b"]);
+    await setTitles(ada, { a: "A2" });
+    const second = await page(ada, first.nextAfter, 2);
+    expect(second.documents.map((d) => [d.id, d.fields.title])).toEqual([
+      ["c", "C1"],
+      ["a", "A2"],
+    ]);
+    expect(second.hasMore).toBe(false);
+  });
+
+  it("only returns documents changed after the given seq", async () => {
+    await setTitles(ada, { a: "A", b: "B" });
+    const all = await page(ada, 0, 10);
+    const since = await page(ada, all.documents[0]?.updatedSeq ?? 0, 10);
+    expect(since.documents.map((d) => d.id)).toEqual(["b"]);
+  });
+
+  it("uses the pull limits", async () => {
+    await setTitles(ada, { a: "A", b: "B", c: "C", d: "D" });
+    const res = await changes(ada);
+    expect(res.json<ChangesPage>().documents).toHaveLength(3);
+    expect(res.json<ChangesPage>().hasMore).toBe(true);
+    expect((await changes(ada, "?limit=51")).statusCode).toBe(400);
+    expect((await changes(ada, "?limit=50")).statusCode).toBe(200);
+  });
+
+  it("never returns another user's documents", async () => {
+    const grace = await createUser(t, "Grace");
+    await setTitles(grace, { g: "G" });
+    await setTitles(ada, { a: "A" });
+    expect((await page(ada, 0, 10)).documents.map((d) => d.id)).toEqual(["a"]);
+    expect((await page(grace, 0, 10)).documents.map((d) => d.id)).toEqual(["g"]);
+  });
+
+  it("rejects invalid paging parameters", async () => {
+    for (const query of ["?after=-1", "?after=abc", "?limit=0", "?limit=1.5", "?after=99999999999999999"]) {
+      const res = await changes(ada, query);
+      expect(res.statusCode, query).toBe(400);
+      expect(res.json()).toMatchObject({ error: { code: "validation_error" } });
+    }
+  });
+
+  it("needs a device token but no protocol header", async () => {
+    const res = await t.app.inject({ method: "GET", url: "/v1/documents/changes" });
+    expect(res.statusCode).toBe(401);
+    expect((await changes(ada)).statusCode).toBe(200);
+  });
+});
