@@ -0,0 +1,33 @@
+package com.innkeep.booking.api.dto;
+
+import com.innkeep.booking.domain.Hold;
+import com.innkeep.booking.domain.Money;
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+import java.util.UUID;
+
+/** A group and its holds in room type id order; the total is the sum of the holds' totals. */
+public record HoldGroupResponse(
+    UUID id,
+    String status,
+    String currency,
+    BigDecimal total,
+    Instant expiresAt,
+    List<HoldResponse> holds) {
+
+  public static HoldGroupResponse from(List<Hold> group) {
+    Hold first = group.get(0);
+    Money total = Money.zero(first.getTotal().currency());
+    for (Hold hold : group) {
+      total = total.plus(hold.getTotal());
+    }
+    return new HoldGroupResponse(
+        first.getGroupId(),
+        first.getStatus().name(),
+        total.currency().getCurrencyCode(),
+        total.amount(),
+        first.getExpiresAt(),
+        group.stream().map(HoldResponse::from).toList());
+  }
+}
