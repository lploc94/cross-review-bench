diff --git a/packages/client/src/cli/exportFile.ts b/packages/client/src/cli/exportFile.ts
new file mode 100644
index 0000000..4f76d4d
--- /dev/null
+++ b/packages/client/src/cli/exportFile.ts
@@ -0,0 +1,33 @@
+import { createWriteStream } from "node:fs";
+import { rename, rm } from "node:fs/promises";
+import { Readable } from "node:stream";
+import { pipeline } from "node:stream/promises";
+import { SyncError, type ExportedDocument } from "@sync/shared";
+
+/**
+ * Write an export to `file`, one document per line as the server sent it. The lines go to
+ * `<file>.partial`, which replaces `file` only once the export is complete, so an interrupted
+ * export never leaves a file that looks whole. Writing keeps pace with the disk: a slow disk
+ * slows the download instead of filling memory. Returns the number of documents.
+ */
+export async function exportToFile(documents: AsyncIterable<ExportedDocument>, file: string): Promise<number> {
+  const partial = `${file}.partial`;
+  let count = 0;
+  async function* lines(): AsyncGenerator<string> {
+    for await (const doc of documents) {
+      count += 1;
+      yield `${JSON.stringify(doc)}\n`;
+    }
+  }
+  try {
+    await pipeline(Readable.from(lines()), createWriteStream(partial));
+    await rename(partial, file);
+  } catch (err) {
+    await rm(partial, { force: true });
+    if (err instanceof SyncError) throw err;
+    throw new SyncError("export_failed", `cannot write ${file}: ${err instanceof Error ? err.message : String(err)}`, {
+      cause: err,
+    });
+  }
+  return count;
+}
