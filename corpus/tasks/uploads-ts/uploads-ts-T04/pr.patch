@@ -0,0 +1,43 @@
+import type { FastifyPluginAsync } from "fastify";
+import { authOf, requireScope } from "../plugins/auth.js";
+import { acceptRawBodies, contentLengthOf, requestBodyStream } from "../requestBody.js";
+import { presignedUploadQuerySchema, presignUploadBodySchema } from "../schemas/uploads.js";
+import { serializeFile } from "../serializers.js";
+import { parse } from "../validation.js";
+import type { RouteOptions } from "./types.js";
+
+/** `POST /uploads/presign`: the URL grants a write, so asking for one takes the upload scope. */
+export const presignRoutes: FastifyPluginAsync<RouteOptions> = async (app, { services, limits }) => {
+  const presignBody = presignUploadBodySchema(limits.signedUrlMaxTtlSeconds);
+
+  app.post("/uploads/presign", { preHandler: requireScope("files:write") }, async (request) => {
+    const { tenantId } = authOf(request);
+    const body = parse(presignBody, request.body, "body");
+    const presigned = services.presignedUploads.presign({
+      tenantId,
+      path: body.path,
+      size: body.size,
+      expiresIn: body.expiresIn,
+      ...(body.contentType === undefined ? {} : { contentType: body.contentType }),
+    });
+    return { url: presigned.url, headers: presigned.headers, expiresAt: presigned.expiresAt.toISOString() };
+  });
+};
+
+/** `PUT /public/uploads?tenant=&path=&size=&exp=&sig=`: no Authorization header, the signature is the authority. */
+export const publicUploadRoutes: FastifyPluginAsync<RouteOptions> = async (app, { services }) => {
+  acceptRawBodies(app);
+
+  app.put("/public/uploads", async (request, reply) => {
+    const query = parse(presignedUploadQuerySchema, request.query, "query");
+    const contentLength = contentLengthOf(request);
+    const contentType = request.headers["content-type"];
+    const outcome = await services.presignedUploads.upload({
+      query,
+      body: requestBodyStream(request),
+      ...(contentLength === undefined ? {} : { contentLength }),
+      ...(contentType === undefined ? {} : { declaredType: contentType }),
+    });
+    return reply.code(201).send(serializeFile(outcome.file));
+  });
+};
