+def _rows_counted(path: Path) -> dict[tuple[str, str], int]:
+    """The etl_rows_total values of the current metrics file, by (source, kind)."""
+    try:
+        lines = path.read_text(encoding="utf-8").splitlines()
+    except FileNotFoundError:
+        return {}
+    counted = {}
+    for line in lines:
+        if line.startswith("etl_rows_total{"):
+            labels, _, value = line.rpartition(" ")
+            source = labels.split('source="', 1)[1].split('"', 1)[0]
+            kind = labels.split('kind="', 1)[1].split('"', 1)[0]
+            counted[(source, kind)] = int(float(value))
+    return counted
+
