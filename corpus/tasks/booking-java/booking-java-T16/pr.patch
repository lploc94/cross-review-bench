+package com.innkeep.booking.api;
+
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.header;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.innkeep.booking.domain.Property;
+import com.innkeep.booking.domain.RoomType;
+import com.innkeep.booking.support.IntegrationTestBase;
+import java.time.LocalDate;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.MediaType;
+
+class HoldGroupApiTest extends IntegrationTestBase {
+
+  private static final String GROUP_BODY =
+      "{\"checkIn\":\"2027-06-01\",\"checkOut\":\"2027-06-03\",\"items\":["
+          + "{\"roomType\":\"suite\",\"rooms\":1,\"guests\":2},"
+          + "{\"roomType\":\"double\",\"rooms\":1,\"guests\":2}],"
+          + "\"guest\":{\"name\":\"Mara Quill\",\"email\":\"guest@example.com\"}}";
+
+  @BeforeEach
+  void setUp() {
+    Property property = data.harbourHouse();
+    RoomType doubleRoom = data.roomType(property, "double", 2, "100.00");
+    RoomType suite = data.roomType(property, "suite", 2, "200.00");
+    LocalDate from = LocalDate.parse("2027-06-01");
+    LocalDate to = LocalDate.parse("2027-06-03");
+    data.rooms(property, doubleRoom, from, to, 1);
+    data.rooms(property, suite, from, to, 1);
+  }
+
+  private String create() throws Exception {
+    return mvc.perform(
+            post("/api/v1/properties/harbour-house/hold-groups")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content(GROUP_BODY))
+        .andExpect(status().isCreated())
+        .andReturn()
+        .getResponse()
+        .getHeader("Location");
+  }
+
+  @Test
+  void aGroupIsCreatedWithItsLocationTotalAndHolds() throws Exception {
+    String location = create();
+
+    mvc.perform(get(location))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.status").value("ACTIVE"))
+        .andExpect(jsonPath("$.total").value(600.00))
+        .andExpect(jsonPath("$.holds.length()").value(2))
+        .andExpect(jsonPath("$.holds[0].roomType").value("double"))
+        .andExpect(jsonPath("$.holds[1].lines.length()").value(2));
+  }
+
+  @Test
+  void confirmingAGroupReturnsOneReservationPerRoomType() throws Exception {
+    String location = create();
+
+    mvc.perform(post(location + "/confirm"))
+        .andExpect(status().isCreated())
+        .andExpect(jsonPath("$.length()").value(2))
+        .andExpect(jsonPath("$[0].roomType").value("double"))
+        .andExpect(jsonPath("$[1].status").value("CONFIRMED"));
+    mvc.perform(post(location + "/release"))
+        .andExpect(status().isConflict())
+        .andExpect(header().doesNotExist("Location"));
+  }
+}
