diff --git a/src/services/webhooks.ts b/src/services/webhooks.ts
new file mode 100644
index 0000000..96f2cfc
--- /dev/null
+++ b/src/services/webhooks.ts
@@ -0,0 +1,115 @@
+import { createHmac, randomUUID } from "node:crypto";
+import { setTimeout as sleep } from "node:timers/promises";
+import type { Pool } from "../db/pool.js";
+import type { FileRecord } from "../domain/file.js";
+import type { TenantWebhook } from "../domain/tenant.js";
+import type { Clock } from "../infra/clock.js";
+import { discardResponse } from "../infra/http.js";
+import type { Logger } from "../infra/logger.js";
+import * as tenants from "../repositories/tenantRepo.js";
+import { unixNow } from "./urlSigner.js";
+
+/** Deliveries of one event: the first attempt and two retries. */
+export const WEBHOOK_ATTEMPTS = 3;
+
+/** `timeoutMs` per attempt; `retryDelayMs` before the first retry, doubled before the next. */
+export interface WebhookSettings {
+  readonly timeoutMs: number;
+  readonly retryDelayMs: number;
+}
+
+/** Tells tenants what happened to their files. */
+export interface FileEventNotifier {
+  /** The file passed its scan and can be downloaded from `at` on. */
+  fileAvailable(file: FileRecord, at: Date): Promise<void>;
+}
+
+/** The JSON body of a `file.available` delivery. */
+export interface FileAvailableEvent {
+  readonly id: string;
+  readonly type: "file.available";
+  readonly createdAt: string;
+  readonly data: { readonly file: Pick<FileRecord, "id" | "path" | "size" | "sha256" | "contentType" | "image"> };
+}
+
+/** Every attempt to deliver an event failed; `lastStatus` is null when the last one got no answer. */
+export class WebhookDeliveryError extends Error {
+  constructor(
+    readonly eventId: string,
+    readonly lastStatus: number | null,
+    options?: { cause?: unknown },
+  ) {
+    super(`webhook event ${eventId} was not delivered after ${WEBHOOK_ATTEMPTS} attempts`, options);
+    this.name = "WebhookDeliveryError";
+  }
+}
+
+/**
+ * Delivers file events to the tenant's webhook, if it has one: a JSON POST signed with
+ * `Webhook-Signature: t=<unix seconds>,v1=<hex HMAC-SHA256 of "<t>.<body>">`, retried after an
+ * error status, a network failure or a timeout. Retries keep the event's `Webhook-Id`, so receivers
+ * can drop duplicates. Nothing is stored: when every attempt fails, `fileAvailable` rejects with a
+ * WebhookDeliveryError and the event is gone.
+ */
+export class WebhookNotifier implements FileEventNotifier {
+  private readonly deps: { pool: Pool; clock: Clock; logger: Logger; settings: WebhookSettings };
+
+  constructor(deps: { pool: Pool; clock: Clock; logger: Logger; settings: WebhookSettings }) {
+    this.deps = deps;
+  }
+
+  async fileAvailable(file: FileRecord, at: Date): Promise<void> {
+    const webhook = await tenants.findWebhook(this.deps.pool, file.tenantId);
+    if (!webhook) return;
+    const { id, path, size, sha256, contentType, image } = file;
+    const event: FileAvailableEvent = {
+      id: randomUUID(),
+      type: "file.available",
+      createdAt: at.toISOString(),
+      data: { file: { id, path, size, sha256, contentType, image } },
+    };
+    const body = JSON.stringify(event);
+    let lastStatus: number | null = null;
+    let lastError: unknown = undefined;
+    for (let attempt = 1; attempt <= WEBHOOK_ATTEMPTS; attempt++) {
+      if (attempt > 1) await sleep(this.deps.settings.retryDelayMs * 2 ** (attempt - 2));
+      const context = { tenantId: file.tenantId, fileId: file.id, eventId: event.id, attempt };
+      try {
+        lastStatus = await this.post(webhook, event.id, body);
+        lastError = undefined;
+        if (lastStatus >= 200 && lastStatus < 300) return;
+        this.deps.logger.warn({ ...context, status: lastStatus }, "webhook receiver answered with an error status");
+      } catch (err) {
+        lastStatus = null;
+        lastError = err;
+        this.deps.logger.warn({ ...context, err }, "webhook request failed");
+      }
+    }
+    throw new WebhookDeliveryError(event.id, lastStatus, { cause: lastError });
+  }
+
+  /** One attempt: the receiver's status, or a rejection when it could not be reached in time. */
+  private async post(webhook: TenantWebhook, eventId: string, body: string): Promise<number> {
+    const timestamp = unixNow(this.deps.clock);
+    const signature = createHmac("sha256", webhook.secret).update(`${timestamp}.${body}`, "utf8").digest("hex");
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), this.deps.settings.timeoutMs);
+    try {
+      const response = await fetch(webhook.url, {
+        method: "POST",
+        headers: {
+          "content-type": "application/json",
+          "webhook-id": eventId,
+          "webhook-signature": `t=${timestamp},v1=${signature}`,
+        },
+        body,
+        signal: controller.signal,
+        redirect: "error",
+      });
+      await discardResponse(response);
+      return response.status;
+    } finally {
+      clearTimeout(timer);
+    }
+  }
+}
