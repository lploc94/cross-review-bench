+export interface DocumentChanges {
+  /** Documents with `updatedSeq > after`, at most `limit`, in updatedSeq order. */
+  readonly documents: StoredDocument[];
+  /** What to send as `after` next: the last document's updatedSeq, or `after`. */
+  readonly nextAfter: number;
