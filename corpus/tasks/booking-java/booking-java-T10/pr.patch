+package com.innkeep.booking.api;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.innkeep.booking.domain.RoomType;
+import com.innkeep.booking.service.CatalogService;
+import com.innkeep.booking.support.IntegrationTestBase;
+import com.jayway.jsonpath.JsonPath;
+import java.time.LocalDate;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.ResultActions;
+
+/** Non-refundable stays: 10 June 2027 is a Thursday, well before the full-refund deadline. */
+class RatePlanApiTest extends IntegrationTestBase {
+
+  @Autowired private CatalogService catalog;
+
+  private ResultActions createRoomType(String code, int discountPercent) throws Exception {
+    return mvc.perform(
+        post("/api/v1/admin/properties/harbour-house/room-types")
+            .header("Authorization", ADMIN_AUTH)
+            .contentType(MediaType.APPLICATION_JSON)
+            .content(
+                ("{\"code\":\"%s\",\"name\":\"Saver\",\"capacity\":2,"
+                        + "\"baseNightlyRate\":100.00,\"extraGuestFee\":15.00,"
+                        + "\"nonRefundableDiscountPercent\":%d}")
+                    .formatted(code, discountPercent)));
+  }
+
+  private RoomType roomType(String code, int discountPercent) throws Exception {
+    var property = data.harbourHouse();
+    createRoomType(code, discountPercent)
+        .andExpect(status().isCreated())
+        .andExpect(jsonPath("$.nonRefundableDiscountPercent").value(discountPercent));
+    RoomType type = catalog.roomType("harbour-house", code);
+    data.rooms(property, type, LocalDate.parse("2027-06-01"), LocalDate.parse("2027-06-20"), 2);
+    return type;
+  }
+
+  private static String stay(String roomType) {
+    return ("{\"roomType\":\"%s\",\"checkIn\":\"2027-06-10\",\"checkOut\":\"2027-06-12\","
+            + "\"rooms\":1,\"guests\":2,\"ratePlan\":\"NON_REFUNDABLE\"}")
+        .formatted(roomType);
+  }
+
+  @Test
+  void aNonRefundableQuoteEndsWithTheDiscountLine() throws Exception {
+    roomType("saver", 10);
+
+    mvc.perform(
+            post("/api/v1/properties/harbour-house/quotes")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content(stay("saver")))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.ratePlan").value("NON_REFUNDABLE"))
+        .andExpect(jsonPath("$.lines.length()").value(3))
+        .andExpect(jsonPath("$.lines[2].kind").value("RATE_PLAN_DISCOUNT"))
+        .andExpect(jsonPath("$.lines[2].amount").value(-21.00))
+        .andExpect(jsonPath("$.total").value(189.00));
+  }
+
+  @Test
+  void onlyRoomTypesWithADiscountAreSoldNonRefundable() throws Exception {
+    roomType("standard", 0);
+
+    mvc.perform(
+            post("/api/v1/properties/harbour-house/quotes")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content(stay("standard")))
+        .andExpect(status().isBadRequest())
+        .andExpect(jsonPath("$.type").value("urn:innkeep:problem:invalid-request"));
+    createRoomType("deluxe", 60).andExpect(status().isBadRequest());
+  }
+
+  @Test
+  void aNonRefundableReservationIsCancelledWithoutRefund() throws Exception {
+    RoomType type = roomType("saver", 10);
+    String hold =
+        mvc.perform(
+                post("/api/v1/properties/harbour-house/holds")
+                    .contentType(MediaType.APPLICATION_JSON)
+                    .content(
+                        "{\"stay\":"
+                            + stay("saver")
+                            + ",\"guest\":{\"name\":\"Ines Lark\","
+                            + "\"email\":\"guest@example.com\"}}"))
+            .andExpect(status().isCreated())
+            .andExpect(jsonPath("$.ratePlan").value("NON_REFUNDABLE"))
+            .andReturn()
+            .getResponse()
+            .getContentAsString();
+    String reservation =
+        mvc.perform(post("/api/v1/holds/" + JsonPath.read(hold, "$.id") + "/confirm"))
+            .andExpect(status().isCreated())
+            .andExpect(jsonPath("$.ratePlan").value("NON_REFUNDABLE"))
+            .andExpect(jsonPath("$.total").value(189.00))
+            .andReturn()
+            .getResponse()
+            .getContentAsString();
+    String path = "/api/v1/reservations/" + JsonPath.read(reservation, "$.reference");
+
+    mvc.perform(get(path + "/cancellation-quote"))
+        .andExpect(jsonPath("$.refundPercent").value(0))
+        .andExpect(jsonPath("$.refundAmount").value(0.00));
+    mvc.perform(post(path + "/cancel"))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.refundAmount").value(0.00))
+        .andExpect(jsonPath("$.reservation.status").value("CANCELLED"));
+    assertThat(payments.refundCount()).isZero();
+    assertThat(booked(type, LocalDate.parse("2027-06-10"))).isZero();
+    assertThat(booked(type, LocalDate.parse("2027-06-11"))).isZero();
+  }
+}
