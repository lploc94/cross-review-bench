+func TestPoolRenewsLeaseWhileHandlerRuns(t *testing.T) {
+	started := make(chan struct{})
+	release := make(chan struct{})
+	st := newFakeStore(domain.Job{ID: 4, Type: "long"})
+	h := newHarness(t, st, registry(map[string]worker.HandlerFunc{
+		"long": func(context.Context, domain.Job) error {
+			close(started)
+			<-release
+			return nil
+		},
+	}))
+	h.start(t, context.Background())
+	<-started
+
+	// The lease lasts a minute; it is renewed every 20s, each time for another minute.
+	for i := 1; i <= 3; i++ {
+		h.clock.BlockUntil(1)
+		h.clock.Advance(20 * time.Second)
+		h.clock.BlockUntil(1) // renewed and waiting for the next interval
+		ext := st.snapshot().extended
+		want := t0.Add(time.Duration(i)*20*time.Second + time.Minute)
+		if len(ext) != i || ext[i-1].id != 4 || ext[i-1].workerID != "test/default/0" || !ext[i-1].until.Equal(want) {
+			t.Fatalf("after %d intervals ExtendLease calls = %+v, want the last until %v", i, ext, want)
+		}
+	}
+	close(release)
+	if out := h.next(t); out.State != domain.StateSucceeded {
+		t.Fatalf("outcome = %+v", out)
+	}
+	var buf strings.Builder
+	_ = h.metrics.WriteText(&buf)
+	if !strings.Contains(buf.String(), `jobqueue_lease_renewals_total{queue="default",result="renewed"} 3`) {
+		t.Errorf("renewals not counted:\n%s", buf.String())
+	}
+}
