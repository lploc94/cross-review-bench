+import { Readable } from "node:stream";
+import type { Pool, PoolClient } from "../db/pool.js";
+import type { AuthContext } from "../domain/accounts.js";
+import { UnavailableError } from "../domain/errors.js";
+import { listDocumentsPage, type StoredDocument } from "../repositories/documents.js";
+
+/**
+ * Exports of a user's documents as newline-delimited JSON: one line per document in
+ * (collection, doc_id) order, then `{"type":"end","documents":<count>}`.
+ *
+ * An export reads the documents table page by page in one read-only REPEATABLE READ transaction,
+ * so it is one snapshot however long it streams, and reads a page only when the consumer has
+ * taken the previous one. Its connection stays checked out until the last page is read or the
+ * stream closes, so at most `maxConcurrent` exports run at once and one whose consumer takes
+ * nothing for `idleTimeoutMs` is cut off.
+ */
+export class ExportService {
+  private readonly pool: Pool;
+  private readonly pageSize: number;
+  private readonly maxConcurrent: number;
+  private readonly idleTimeoutMs: number;
+  private active = 0;
+
+  constructor(deps: { pool: Pool; maxConcurrent: number; idleTimeoutMs: number; pageSize?: number }) {
+    this.pool = deps.pool;
+    this.maxConcurrent = deps.maxConcurrent;
+    this.idleTimeoutMs = deps.idleTimeoutMs;
+    this.pageSize = deps.pageSize ?? 200;
+  }
+
+  /** Exports holding a connection now. */
+  get running(): number {
+    return this.active;
+  }
+
+  /**
+   * Start an export; `toLine` gives the JSON object written for a document. The first page is
+   * read before the stream is returned, so the snapshot is taken now, and too many exports or a
+   * database failure are an error answer rather than a response cut short.
+   */
+  async open(auth: AuthContext, toLine: (doc: StoredDocument) => object): Promise<Readable> {
+    if (this.active >= this.maxConcurrent) {
+      throw new UnavailableError(`at most ${this.maxConcurrent} exports run at once; try again later`);
+    }
+    this.active += 1;
+    let client: PoolClient | undefined;
+    let first: StoredDocument[];
+    const { pageSize, idleTimeoutMs } = this;
+    let broken: Error | undefined;
+    let streaming = false;
+    // While the connection is checked out the pool does not listen for its errors; one there (the
+    // session ended or the connection lost) comes to this listener instead of going unhandled. A
+    // query in flight also rejects with it; between pages it ends the stream.
+    const onConnectionError = (err: Error): void => {
+      broken = err;
+      if (streaming) stream.destroy(err);
+    };
+    try {
+      client = await this.pool.connect();
+      client.on("error", onConnectionError);
+      await client.query("BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY");
+      first = await listDocumentsPage(client, auth.userId, null, pageSize);
+    } catch (err) {
+      client?.removeListener("error", onConnectionError);
+      client?.release(asError(err));
+      this.active -= 1;
+      throw err;
+    }
+    const db = client;
+
+    let released = false;
+    // Runs after the last page and again when the stream closes; the first call releases.
+    const release = async (): Promise<void> => {
+      if (released) return;
+      released = true;
+      // The transaction only read, so ROLLBACK ends it as well as COMMIT would.
+      if (!broken) await db.query("ROLLBACK").catch((err: unknown) => (broken = asError(err)));
+      db.removeListener("error", onConnectionError);
+      db.release(broken);
+      this.active -= 1;
+    };
+
+    async function* lines(): AsyncGenerator<string> {
+      let page = first;
+      let documents = 0;
+      for (;;) {
+        for (const doc of page) {
+          yield `${JSON.stringify(toLine(doc))}\n`;
+          stall.refresh();
+        }
+        documents += page.length;
+        const last = page.at(-1);
+        if (!last || page.length < pageSize) break;
+        page = await listDocumentsPage(db, auth.userId, last, pageSize);
+      }
+      await release();
+      yield `${JSON.stringify({ type: "end", documents })}\n`;
+    }
+
+    const stream = Readable.from(lines(), { objectMode: false });
+    streaming = true;
+    const stall = setTimeout(() => {
+      stream.destroy(new Error(`export stalled: the client took nothing for ${idleTimeoutMs} ms`));
+    }, idleTimeoutMs);
+    // "close" comes once, after the generator has finished or been stopped (a query in flight
+    // completes first): the export ended, failed or its consumer went away.
+    stream.once("close", () => {
+      clearTimeout(stall);
+      void release();
+    });
+    return stream;
+  }
+}
+
+function asError(value: unknown): Error {
+  return value instanceof Error ? value : new Error(String(value));
+}
