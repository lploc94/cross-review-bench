+func TestSleepJobReportsProgressThroughStore(t *testing.T) {
+	db := testdb.Require(t, testPool)
+	clk := clock.NewManual(t0)
+	st := store.New(db, clk)
+	reg := worker.NewRegistry(time.Minute)
+	reg.Register(builtin.TypeSleep, builtin.Sleep(clk, time.Minute))
+	h := newHarnessWithClock(t, clk, st, reg)
+	ctx := context.Background()
+	job, err := st.Enqueue(ctx, domain.NewJob{Queue: "default", Type: builtin.TypeSleep, Payload: []byte(`{"duration":"150s"}`)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.start(t, ctx)
+
+	for _, want := range []domain.Progress{
+		{Percent: 40, Message: "slept 1m0s of 2m30s", UpdatedAt: t0.Add(time.Minute)},
+		{Percent: 80, Message: "slept 2m0s of 2m30s", UpdatedAt: t0.Add(2 * time.Minute)},
+	} {
+		h.clock.BlockUntil(1) // the handler waits for its next step
+		h.clock.Advance(time.Minute)
+		h.clock.BlockUntil(1) // it has reported and waits again
+		got, err := st.Get(ctx, job.ID)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got.Progress == nil || *got.Progress != want {
+			t.Fatalf("progress = %+v, want %+v", got.Progress, want)
+		}
+	}
+	h.clock.Advance(30 * time.Second)
+	if out := h.next(t); out.State != domain.StateSucceeded {
+		t.Fatalf("outcome = %+v, want succeeded", out)
+	}
+}
