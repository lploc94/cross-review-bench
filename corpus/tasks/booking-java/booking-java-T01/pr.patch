+++ b/src/test/java/com/innkeep/booking/api/PromoCodeApiTest.java
@@ -0,0 +1,145 @@
+package com.innkeep.booking.api;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.innkeep.booking.domain.DateRange;
+import com.innkeep.booking.domain.GuestDetails;
+import com.innkeep.booking.domain.Hold;
+import com.innkeep.booking.service.HoldService;
+import com.innkeep.booking.service.ReservationService;
+import com.innkeep.booking.support.IntegrationTestBase;
+import java.time.Instant;
+import java.time.LocalDate;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.RequestBuilder;
+
+class PromoCodeApiTest extends IntegrationTestBase {
+
+  private static final String PROMOS = "/api/v1/admin/properties/harbour-house/promo-codes";
+  private static final LocalDate IN = LocalDate.parse("2027-06-01");
+  private static final LocalDate OUT = LocalDate.parse("2027-06-03");
+
+  @Autowired private HoldService holds;
+  @Autowired private ReservationService reservations;
+
+  @BeforeEach
+  void setUp() {
+    var property = data.harbourHouse();
+    data.rooms(property, data.roomType(property, "double", 2, "100.00"), IN, OUT, 5);
+  }
+
+  @Test
+  void anAdminCreatesListsAndDisablesCodes() throws Exception {
+    createPromo("spring-10", "\"percent\": 10", "2027-04-01", "2027-05-31", 5);
+    mvc.perform(get(PROMOS).header("Authorization", ADMIN_AUTH))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$[0].code").value("SPRING-10"))
+        .andExpect(jsonPath("$[0].uses").value(0));
+
+    mvc.perform(post(PROMOS + "/Spring-10/disable").header("Authorization", ADMIN_AUTH))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.enabled").value(false));
+    mvc.perform(quote("spring-10")).andExpect(status().isBadRequest());
+  }
+
+  @Test
+  void aCodeHasEitherAPercentOrAnAmountAndIsUniqueWhateverTheCase() throws Exception {
+    mvc.perform(
+            promoRequest(
+                "both",
+                "\"percent\": 10, \"amount\": 5, \"maxUses\": 1",
+                "2027-05-01",
+                "2027-05-31"))
+        .andExpect(status().isBadRequest());
+    createPromo("SUMMER", "\"amount\": 20", "2027-05-01", "2027-05-31", 1);
+    mvc.perform(
+            promoRequest("summer", "\"percent\": 5, \"maxUses\": 1", "2027-05-01", "2027-05-31"))
+        .andExpect(status().isConflict());
+  }
+
+  @Test
+  void theDiscountIsTheLastLineAndNeverTakesTheTotalBelowZero() throws Exception {
+    createPromo("spring-10", "\"percent\": 10", "2027-04-01", "2027-05-31", 5);
+    createPromo("free-stay", "\"amount\": 500", "2027-04-01", "2027-05-31", 5);
+
+    mvc.perform(quote("spring-10"))
+        .andExpect(jsonPath("$.lines[2].kind").value("PROMO"))
+        .andExpect(jsonPath("$.lines[2].amount").value(-20.00))
+        .andExpect(jsonPath("$.total").value(180.00));
+    mvc.perform(quote("FREE-STAY"))
+        .andExpect(jsonPath("$.lines[2].amount").value(-200.00))
+        .andExpect(jsonPath("$.total").value(0));
+  }
+
+  @Test
+  void unknownAndOutOfDateCodesAreRefused() throws Exception {
+    createPromo("june", "\"percent\": 10", "2027-06-01", "2027-06-30", 5);
+
+    mvc.perform(quote("nothing")).andExpect(status().isBadRequest());
+    mvc.perform(quote("june"))
+        .andExpect(status().isBadRequest())
+        .andExpect(jsonPath("$.type").value("urn:innkeep:problem:invalid-request"));
+    clock.set(Instant.parse("2027-07-01T10:00:00Z"));
+    mvc.perform(quote("june")).andExpect(status().isBadRequest());
+  }
+
+  @Test
+  void aConfirmationTakesAUseAndACancellationGivesItBack() throws Exception {
+    createPromo("one-off", "\"percent\": 50", "2027-04-01", "2027-05-31", 1);
+    Hold first = hold("one-off");
+    Hold second = hold("one-off");
+
+    var reservation = holds.confirm(first.getId());
+    assertThat(reservation.getTotal().amount()).isEqualByComparingTo("100.00");
+    mvc.perform(post("/api/v1/holds/" + second.getId() + "/confirm"))
+        .andExpect(status().isConflict())
+        .andExpect(jsonPath("$.type").value("urn:innkeep:problem:promo-exhausted"));
+    assertThat(payments.movements()).hasSize(1);
+
+    reservations.cancel(reservation.getReference());
+    mvc.perform(post("/api/v1/holds/" + second.getId() + "/confirm"))
+        .andExpect(status().isCreated());
+  }
+
+  private Hold hold(String promoCode) {
+    return holds.create(
+        "harbour-house",
+        "double",
+        new DateRange(IN, OUT),
+        1,
+        2,
+        new GuestDetails("Ines Varo", "ines@example.com", null),
+        promoCode);
+  }
+
+  private void createPromo(String code, String discount, String from, String until, int maxUses)
+      throws Exception {
+    mvc.perform(promoRequest(code, discount + ", \"maxUses\": " + maxUses, from, until))
+        .andExpect(status().isCreated());
+  }
+
+  private RequestBuilder promoRequest(String code, String fields, String from, String until) {
+    return post(PROMOS)
+        .header("Authorization", ADMIN_AUTH)
+        .contentType(MediaType.APPLICATION_JSON)
+        .content(
+            "{\"code\": \"%s\", %s, \"validFrom\": \"%s\", \"validUntil\": \"%s\"}"
+                .formatted(code, fields, from, until));
+  }
+
+  private RequestBuilder quote(String promoCode) {
+    return post("/api/v1/properties/harbour-house/quotes")
+        .contentType(MediaType.APPLICATION_JSON)
+        .content(
+            ("{\"roomType\": \"double\", \"checkIn\": \"%s\", \"checkOut\": \"%s\", \"rooms\": 1,"
+                    + " \"guests\": 2, \"promoCode\": \"%s\"}")
+                .formatted(IN, OUT, promoCode));
+  }
+}
