+func (s *Store) queueStats(ctx context.Context, queue string) ([]QueueStats, error) {
+	rows, err := s.pool.Query(ctx, `
+		SELECT queue, state, count(*), min(run_at) FILTER (WHERE state = 'available' AND run_at <= $2)
