diff --git a/internal/core/canary.go b/internal/core/canary.go
new file mode 100644
index 0000000..932490e
--- /dev/null
+++ b/internal/core/canary.go
@@ -0,0 +1,37 @@
+package core
+
+import (
+	"hash/fnv"
+	"net/http"
+	"strings"
+)
+
+// Canary is a route's canary pool: its upstreams, their balancer and the rule that sends
+// requests to it.
+type Canary struct {
+	Percent   uint32 // 0 to 100
+	Header    string // canonical name of the header that selects a pool
+	Upstreams []*Upstream
+
+	balancer *Balancer
+}
+
+// Values of the canary header that select a pool regardless of the sticky choice.
+const (
+	canaryAlways = "always"
+	canaryNever  = "never"
+)
+
+// takes reports whether the canary serves the request. The header decides when it names a pool;
+// otherwise the key's bucket, out of 100, is compared with Percent.
+func (c *Canary) takes(r *http.Request, key string) bool {
+	switch strings.ToLower(strings.TrimSpace(r.Header.Get(c.Header))) {
+	case canaryAlways:
+		return true
+	case canaryNever:
+		return false
+	}
+	h := fnv.New32a()
+	_, _ = h.Write([]byte(key))
+	return h.Sum32()%100 <= c.Percent
+}
