+    version: 2,
+    description: "one row per document field",
+    // VACUUM, which gives the space of the dropped columns back, cannot run in a transaction.
+    transactional: false,
+    up: (db) => {
+      db.exec(V2_FIELDS);
+      copyFieldsToRows(db);
+      db.exec("ALTER TABLE docs DROP COLUMN fields; ALTER TABLE docs DROP COLUMN field_hlcs;");
+      db.exec("VACUUM");
+    },
+  },
