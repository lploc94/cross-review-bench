+@runs_app.command("prune")
+@guarded
+def prune_command(
+    ctx: typer.Context,
+    older_than: Annotated[
+        int,
+        typer.Option(
+            "--older-than",
+            metavar="DAYS",
+            help="Delete runs that finished more than DAYS days (of 24 hours) ago.",
+            min=1,
+            max=runs_api.MAX_RETENTION_DAYS,
+        ),
+    ],
+    dry_run: Annotated[
+        bool, typer.Option("--dry-run", help="Only count what would be deleted.")
+    ] = False,
+    yes: Annotated[bool, typer.Option("--yes", help="Do not ask for confirmation.")] = False,
+) -> None:
+    """Delete old runs with their rejects and check results.
+
+    Runs that warehouse rows still name, the latest succeeded run of each source and runs in
+    progress are kept.
+    """
+    question = (
+        f"Delete the runs that finished more than {older_than} days ago, with their rejects"
+        " and check results?"
+    )
+    if not dry_run and not yes and not typer.confirm(question):
+        raise typer.Abort()
+    view = runs_api.prune_runs(app_context(ctx), older_than_days=older_than, dry_run=dry_run)
+    verb = "would delete" if view.dry_run else "deleted"
+    typer.echo(
+        f"{verb} {view.runs} runs finished before {format_time(view.before)}"
+        f" ({view.rejects} rejects, {view.check_results} check results)"
+    )
