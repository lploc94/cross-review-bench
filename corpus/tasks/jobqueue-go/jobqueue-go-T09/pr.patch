+package api_test
+
+import (
+	"context"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/relaywork/jobqueue/internal/domain"
+	"github.com/relaywork/jobqueue/internal/metrics"
+)
+
+type queueBody struct {
+	Queue                     string           `json:"queue"`
+	Counts                    map[string]int64 `json:"counts"`
+	Total                     int64            `json:"total"`
+	OldestAvailableAgeSeconds *float64         `json:"oldest_available_age_seconds"`
+}
+
+// seedQueues leaves emails with two available jobs (one due since t0), one running and one
+// succeeded job, and reports with one job not due yet; then 90 seconds pass.
+func seedQueues(t *testing.T, e *env) {
+	t.Helper()
+	ctx := context.Background()
+	for _, nj := range []domain.NewJob{
+		{Queue: "emails", Type: "email.send"},
+		{Queue: "emails", Type: "email.send"},
+		{Queue: "emails", Type: "email.send"},
+		{Queue: "emails", Type: "email.send", RunAt: t0.Add(time.Hour)},
+		{Queue: "reports", Type: "report.build", RunAt: t0.Add(time.Hour)},
+	} {
+		if _, err := e.store.Enqueue(ctx, nj); err != nil {
+			t.Fatal(err)
+		}
+	}
+	jobs, err := e.store.Lease(ctx, "emails", "w1", 2, time.Minute)
+	if err != nil || len(jobs) != 2 {
+		t.Fatalf("Lease = %d jobs, %v", len(jobs), err)
+	}
+	if err := e.store.Complete(ctx, jobs[0].ID, "w1"); err != nil {
+		t.Fatal(err)
+	}
+	e.clock.Advance(90 * time.Second)
+}
+
+func TestQueueStatistics(t *testing.T) {
+	e := newEnv(t)
+	seedQueues(t, e)
+
+	list := decode[struct {
+		Queues []queueBody `json:"queues"`
+	}](t, call(t, e.handler, http.MethodGet, "/v1/queues", ""))
+	if len(list.Queues) != 2 || list.Queues[0].Queue != "emails" || list.Queues[1].Queue != "reports" {
+		t.Fatalf("queues = %+v", list.Queues)
+	}
+	emails := list.Queues[0]
+	if c := emails.Counts; c["available"] != 2 || c["running"] != 1 || c["succeeded"] != 1 || c["dead"] != 0 || len(c) != len(domain.States) ||
+		emails.Total != 4 || emails.OldestAvailableAgeSeconds == nil || *emails.OldestAvailableAgeSeconds != 90 {
+		t.Errorf("emails = %+v", emails)
+	}
+	if reports := list.Queues[1]; reports.OldestAvailableAgeSeconds != nil {
+		t.Errorf("a queue whose only job is not due yet has no waiting age: %+v", reports)
+	}
+
+	rec := call(t, e.handler, http.MethodGet, "/v1/queues/idle", "")
+	if q := decode[queueBody](t, rec); rec.Code != http.StatusOK || q.Total != 0 || len(q.Counts) != len(domain.States) {
+		t.Errorf("GET a queue without jobs: %d %s", rec.Code, rec.Body)
+	}
+	resp := expectError(t, call(t, e.handler, http.MethodGet, "/v1/queues/Not%20A%20Queue", ""), http.StatusUnprocessableEntity, "validation_failed")
+	if got := fieldNames(resp); len(got) != 1 || got[0] != "queue" {
+		t.Errorf("fields = %v", got)
+	}
+}
+
+func TestQueueGaugeOnScrape(t *testing.T) {
+	e := newEnv(t)
+	srv := newServer(t, e.store, e.clock, metrics.NewRegistry())
+	seedQueues(t, e)
+
+	body := call(t, srv, http.MethodGet, "/metrics", "", "Authorization: ").Body.String()
+	for _, want := range []string{
+		`jobqueue_queue_jobs{queue="emails",state="available"} 2`,
+		`jobqueue_queue_jobs{queue="emails",state="dead"} 0`,
+		`jobqueue_queue_jobs{queue="reports",state="available"} 1`,
+	} {
+		if !strings.Contains(body, want+"\n") {
+			t.Errorf("metrics lack %s:\n%s", want, body)
+		}
+	}
+}
