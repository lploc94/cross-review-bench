diff --git a/test/api/deduplication.test.ts b/test/api/deduplication.test.ts
new file mode 100644
index 0000000..2329429
--- /dev/null
+++ b/test/api/deduplication.test.ts
@@ -0,0 +1,170 @@
+import { readdir } from "node:fs/promises";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import type { UploadBody } from "../../src/api/serializers.js";
+import { buildTestApp, type TestApp } from "../helpers/app.js";
+import {
+  createTenant,
+  expectStatus,
+  markAvailable,
+  multipartBody,
+  putFile,
+  storeFile,
+  tenantUsage,
+  type FileBody,
+  type SessionBody,
+  type TestTenant,
+} from "../helpers/fixtures.js";
+
+describe("content deduplication", () => {
+  let t: TestApp;
+  let tenant: TestTenant;
+
+  beforeEach(async () => {
+    t = await buildTestApp({ env: { MAX_UPLOAD_BYTES: "8192" } });
+    tenant = await createTenant(t.pool, t.clock, { quotaBytes: 20_000 });
+  });
+
+  afterEach(async () => {
+    await t.close();
+  });
+
+  async function storedObjects(): Promise<string[]> {
+    const root = path.join(t.storageRoot ?? "", "objects", "t", tenant.tenantId);
+    return (await readdir(root).catch(() => [])).sort();
+  }
+
+  async function storageKeyOf(fileId: string): Promise<string | undefined> {
+    const result = await t.pool.query<{ storage_key: string }>(
+      "SELECT storage_key FROM files WHERE id = $1",
+      [fileId],
+    );
+    return result.rows[0]?.storage_key;
+  }
+
+  async function availableFile(filePath: string, body: string): Promise<FileBody> {
+    const file = await storeFile(t.app, tenant, filePath, body);
+    await markAvailable(t.pool, file.id);
+    return file;
+  }
+
+  it("records identical bytes against the object of an available file", async () => {
+    const first = await availableFile("reports/q1.csv", "region,total\nnorth,1200\n");
+    const response = await putFile(t.app, tenant, "archive/q1-copy.csv", "region,total\nnorth,1200\n");
+    expectStatus(response, 200);
+    const second = response.json<UploadBody>();
+    expect(second).toMatchObject({
+      path: "archive/q1-copy.csv",
+      sha256: first.sha256,
+      size: first.size,
+      status: "pending_scan",
+      deduplicated: true,
+    });
+    expect(second.id).not.toBe(first.id);
+    expect(await storageKeyOf(second.id)).toBe(await storageKeyOf(first.id));
+    expect(await storedObjects()).toEqual([first.id]);
+  });
+
+  it("still counts a deduplicated file against the quota", async () => {
+    const body = "identical content";
+    await availableFile("a.txt", body);
+    expectStatus(await putFile(t.app, tenant, "b.txt", body), 200);
+    expect(await tenantUsage(t.pool, tenant.tenantId)).toBe(2 * Buffer.byteLength(body));
+  });
+
+  it("serves a deduplicated file once it is scanned", async () => {
+    await availableFile("minutes/2030-01.txt", "board minutes");
+    const copy = (await putFile(t.app, tenant, "minutes/latest.txt", "board minutes")).json<UploadBody>();
+    await markAvailable(t.pool, copy.id);
+    const download = await t.app.inject({ url: "/v1/files/minutes/latest.txt", headers: tenant.headers });
+    expectStatus(download, 200);
+    expect(download.body).toBe("board minutes");
+  });
+
+  it("keeps its own object while the earlier file is not scanned", async () => {
+    const first = await storeFile(t.app, tenant, "draft.txt", "unscanned words");
+    const response = await putFile(t.app, tenant, "draft-2.txt", "unscanned words");
+    expectStatus(response, 201);
+    const second = response.json<UploadBody>();
+    expect(second.deduplicated).toBe(false);
+    expect(await storedObjects()).toEqual([first.id, second.id].sort());
+  });
+
+  it("does not share the object of other bytes of the same size", async () => {
+    const first = await availableFile("one.txt", "aaaa");
+    const second = (await putFile(t.app, tenant, "two.txt", "bbbb")).json<UploadBody>();
+    expect(second.deduplicated).toBe(false);
+    expect(await storedObjects()).toEqual([first.id, second.id].sort());
+  });
+
+  it("deduplicates multipart uploads", async () => {
+    const first = await availableFile("logo.svg", "<svg/>");
+    const form = multipartBody([
+      { name: "path", value: "brand/logo.svg" },
+      { name: "file", filename: "logo.svg", contentType: "image/svg+xml", content: Buffer.from("<svg/>") },
+    ]);
+    const response = await t.app.inject({
+      method: "POST",
+      url: "/v1/files",
+      headers: { ...tenant.headers, "content-type": form.contentType },
+      payload: form.payload,
+    });
+    expectStatus(response, 200);
+    expect(response.json<UploadBody>()).toMatchObject({ originalName: "logo.svg", deduplicated: true });
+    expect(await storedObjects()).toEqual([first.id]);
+  });
+
+  it("deduplicates a completed resumable upload", async () => {
+    const body = Buffer.from("chunked but identical content");
+    const first = await availableFile("big/original.bin", body.toString());
+    const created = await t.app.inject({
+      method: "POST",
+      url: "/v1/uploads",
+      headers: tenant.headers,
+      payload: { path: "big/copy.bin", size: body.length },
+    });
+    expectStatus(created, 201);
+    const session = created.json<SessionBody>();
+    for (const [offset, chunk] of [
+      [0, body.subarray(0, 10)],
+      [10, body.subarray(10)],
+    ] as const) {
+      const patched = await t.app.inject({
+        method: "PATCH",
+        url: `/v1/uploads/${session.id}`,
+        headers: { ...tenant.headers, "upload-offset": String(offset), "content-type": "application/offset+octet-stream" },
+        payload: chunk,
+      });
+      expectStatus(patched, 204);
+    }
+    const completed = await t.app.inject({
+      method: "POST",
+      url: `/v1/uploads/${session.id}/complete`,
+      headers: tenant.headers,
+    });
+    expectStatus(completed, 200);
+    const file = completed.json<UploadBody>();
+    expect(file.deduplicated).toBe(true);
+    expect(await storageKeyOf(file.id)).toBe(await storageKeyOf(first.id));
+    expect(await storedObjects()).toEqual([first.id]);
+    expect(await tenantUsage(t.pool, tenant.tenantId)).toBe(2 * body.length);
+  });
+
+  it("stores a new object when a file is overwritten with its own bytes", async () => {
+    await availableFile("notes.txt", "unchanged text");
+    const response = await putFile(t.app, tenant, "notes.txt", "unchanged text", { overwrite: true });
+    expectStatus(response, 200);
+    const replacement = response.json<UploadBody>();
+    expect(replacement.deduplicated).toBe(false);
+    expect(await storedObjects()).toEqual([replacement.id]);
+    expect(await tenantUsage(t.pool, tenant.tenantId)).toBe(replacement.size);
+  });
+
+  it("releases the bytes of a deleted copy", async () => {
+    const first = await availableFile("a/report.txt", "same report");
+    expectStatus(await putFile(t.app, tenant, "b/report.txt", "same report"), 200);
+    const deleted = await t.app.inject({ method: "DELETE", url: "/v1/files/b/report.txt", headers: tenant.headers });
+    expectStatus(deleted, 204);
+    expect(await tenantUsage(t.pool, tenant.tenantId)).toBe(first.size);
+  });
+});
