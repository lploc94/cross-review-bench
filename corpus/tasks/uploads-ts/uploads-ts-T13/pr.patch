+/**
+ * Either setting or both. `maxUploadBytes` is at most the service's MAX_UPLOAD_BYTES; null goes
+ * back to that setting.
+ */
+export function patchTenantBodySchema(serviceMaxUploadBytes: number) {
+  return z
+    .object({
+      quotaBytes: z.number().int().min(0).max(MAX_QUOTA_BYTES).optional(),
+      maxUploadBytes: z.number().int().min(1).max(serviceMaxUploadBytes).nullable().optional(),
+    })
+    .refine((body) => body.quotaBytes !== undefined || body.maxUploadBytes !== undefined, {
+      error: "give quotaBytes, maxUploadBytes or both",
+    });
+}
