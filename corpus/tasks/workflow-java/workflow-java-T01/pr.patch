+  /** A delegation of approval tasks; both dates are included. */
+  public record DelegationView(
+      long id, long delegatorId, long delegateId, LocalDate from, LocalDate until) {
+
+    public static DelegationView of(Delegation delegation) {
+      return new DelegationView(
+          delegation.getId(),
+          delegation.getDelegator().getId(),
+          delegation.getDelegate().getId(),
+          delegation.getStartsOn(),
+          delegation.getEndsOn());
+    }
+  }
+
   /** A due time worked out from a start instant and a working-time allowance. */
   public record DueView(Instant from, int minutes, Instant dueAt) {}
 
