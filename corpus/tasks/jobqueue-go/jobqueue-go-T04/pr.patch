+// renewInterval is how often the lease of a running job is renewed: two renewals in a row may
+// fail before the lease runs out.
+func (p *Pool) renewInterval() time.Duration { return p.opts.LeaseDuration / 3 }
+
+// renewLease extends the lease of a running job when tick fires and then every renewInterval.
+// When the store reports the lease as lost (the reaper gave the job to another worker after
+// renewals failed for too long), the handler's context is cancelled with the store's error as
+// its cause, so that the handler stops working on a job it no longer owns. A renewal that fails
+// for another reason, such as a database hiccup, is retried at the next tick.
+func (p *Pool) renewLease(queue string, jobID int64, workerID string, tick <-chan time.Time, cancel context.CancelCauseFunc, log *slog.Logger) {
+	for {
+		select {
+		case <-p.ctx.Done():
+			return
+		case <-tick:
+		}
+		err := p.store.ExtendLease(p.ctx, jobID, workerID, p.opts.Clock.Now().Add(p.opts.LeaseDuration))
+		switch {
+		case err == nil:
+			p.metrics.renewals.Inc(queue, "renewed")
+		case errors.Is(err, domain.ErrLeaseLost):
+			p.metrics.renewals.Inc(queue, "lost")
+			log.Warn("lease lost while the handler was running, cancelling it", "error", err)
+			cancel(err)
+		default:
+			p.metrics.renewals.Inc(queue, "error")
+			log.Error("renew lease", "error", err)
+		}
+		tick = p.opts.Clock.After(p.renewInterval())
+	}
+}
