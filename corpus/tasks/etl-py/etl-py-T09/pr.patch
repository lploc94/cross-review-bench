new file mode 100644
index 0000000..47dfb15
--- /dev/null
+++ b/tests/quality/test_daily_total_anomaly.py
@@ -0,0 +1,187 @@
+"""The anomaly check on daily order totals: yesterday against the mean of the 28 days before."""
+
+from __future__ import annotations
+
+from datetime import UTC, date, datetime, time, timedelta
+from decimal import Decimal
+from zoneinfo import ZoneInfo
+
+import pytest
+from sqlalchemy import Connection, insert
+
+from etl.config import Settings
+from etl.infra.tables import check_results, orders, runs
+from etl.quality.checks import Check, Severity
+from etl.quality.registry import build_checks, checks_for, find_check
+from tests.helpers.clock import FrozenClock
+from tests.helpers.db import rows
+from tests.helpers.factories import customer_obj, order_row, write_customers, write_orders
+
+BERLIN = ZoneInfo("Europe/Berlin")
+# The default FrozenClock reads 2026-04-01 10:00 in Berlin: yesterday is 2026-03-31.
+YESTERDAY = date(2026, 3, 31)
+NAME = "orders.daily_total.anomaly"
+
+
+class NoHistory:
+    def previous_observed(self, check_name: str) -> Decimal | None:
+        return None
+
+
+def anomaly_check(settings: Settings, clock: FrozenClock) -> Check:
+    check = find_check(NAME, build_checks(settings, clock))
+    assert check is not None
+    return check
+
+
+def seed_run(connection: Connection) -> None:
+    connection.execute(
+        insert(runs).values(
+            id=1,
+            source="orders",
+            path="-",
+            status="running",
+            started_at=datetime(2026, 4, 1, tzinfo=UTC),
+        )
+    )
+
+
+def add_order(
+    connection: Connection,
+    order_id: str,
+    ordered_at: datetime,
+    total: str,
+    *,
+    currency: str = "EUR",
+    status: str = "paid",
+) -> None:
+    connection.execute(
+        insert(orders).values(
+            order_id=order_id,
+            customer_id="C-1",
+            status=status,
+            country="DE",
+            currency=currency,
+            total_amount=Decimal(total),
+            ordered_at=ordered_at,
+            updated_at=ordered_at,
+            loaded_at=ordered_at,
+            run_id=1,
+        )
+    )
+
+
+def at_noon(day: date) -> datetime:
+    return datetime.combine(day, time(12), tzinfo=BERLIN)
+
+
+def add_history(connection: Connection, days: int, total: str, *, currency: str = "EUR") -> None:
+    """One order of `total` at noon on each of the `days` days before yesterday."""
+    for back in range(1, days + 1):
+        day = YESTERDAY - timedelta(days=back)
+        add_order(connection, f"H-{currency}-{back}", at_noon(day), total, currency=currency)
+
+
+def evaluate(db, settings, clock, fill):
+    with db.begin() as connection:
+        seed_run(connection)
+        fill(connection)
+        outcome = anomaly_check(settings, clock).evaluate(connection, NoHistory())
+        connection.rollback()
+    return outcome
+
+
+def test_the_check_is_declared_for_orders_as_a_warning(settings, clock):
+    check = anomaly_check(settings, clock)
+
+    assert check.severity is Severity.WARN
+    assert NAME in [c.name for c in checks_for([orders], build_checks(settings, clock))]
+    assert "within 3x" in check.description
+
+
+def test_without_a_week_of_history_there_is_no_baseline(db, settings, clock):
+    def fill(connection):
+        add_history(connection, 6, "100.00")
+        add_order(connection, "Y-1", at_noon(YESTERDAY), "5000.00")
+
+    outcome = evaluate(db, settings, clock, fill)
+
+    assert outcome.passed
+    assert outcome.details == "2026-03-31: fewer than 7 days of history"
+
+
+@pytest.mark.parametrize(
+    ("total", "passed", "details"),
+    [
+        ("300.00", True, "2026-03-31: EUR within 3x of the mean"),
+        ("34.00", True, "2026-03-31: EUR within 3x of the mean"),
+        ("300.01", False, "2026-03-31: outside 3x of the mean: EUR 3.00x"),
+        ("25.00", False, "2026-03-31: outside 3x of the mean: EUR 0.25x"),
+    ],
+)
+def test_a_total_beyond_the_factor_fails(db, settings, clock, total, passed, details):
+    def fill(connection):
+        add_history(connection, 10, "100.00")
+        add_order(connection, "Y-1", at_noon(YESTERDAY), total)
+
+    outcome = evaluate(db, settings, clock, fill)
+
+    assert (outcome.passed, outcome.details) == (passed, details)
+    assert outcome.observed == Decimal(0 if passed else 1)
+
+
+def test_a_day_without_orders_fails(db, settings, clock):
+    outcome = evaluate(db, settings, clock, lambda connection: add_history(connection, 7, "80"))
+
+    assert not outcome.passed
+    assert outcome.details == "2026-03-31: outside 3x of the mean: EUR 0.00x"
+
+
+def test_currencies_are_compared_separately(db, settings, clock):
+    def fill(connection):
+        add_history(connection, 8, "100.00")
+        add_history(connection, 8, "400.00", currency="PLN")
+        add_order(connection, "Y-EUR", at_noon(YESTERDAY), "120.00")
+        add_order(connection, "Y-PLN", at_noon(YESTERDAY), "1500.00", currency="PLN")
+
+    outcome = evaluate(db, settings, clock, fill)
+
+    assert not outcome.passed
+    assert outcome.observed == Decimal(1)
+    assert outcome.details == "2026-03-31: outside 3x of the mean: PLN 3.75x"
+
+
+def test_days_are_local_days_and_cancelled_orders_do_not_count(db, settings, clock):
+    def fill(connection):
+        add_history(connection, 7, "100.00")
+        # 23:30 UTC on March 30 is already March 31 in Berlin, and 00:30 Berlin on April 1
+        # (22:30 UTC on March 31) is today: only the first counts as yesterday.
+        add_order(connection, "Y-1", datetime(2026, 3, 30, 23, 30, tzinfo=UTC), "150.00")
+        add_order(connection, "T-1", datetime(2026, 3, 31, 22, 30, tzinfo=UTC), "900.00")
+        add_order(connection, "Y-2", at_noon(YESTERDAY), "900.00", status="cancelled")
+
+    outcome = evaluate(db, settings, clock, fill)
+
+    assert outcome.passed
+    assert outcome.details == "2026-03-31: EUR within 3x of the mean"
+
+
+def test_the_factor_comes_from_the_settings(db, settings, clock):
+    lenient = settings.model_copy(update={"anomaly_factor": Decimal(5)})
+
+    def fill(connection):
+        add_history(connection, 7, "100.00")
+        add_order(connection, "Y-1", at_noon(YESTERDAY), "450.00")
+
+    assert not evaluate(db, settings, clock, fill).passed
+    assert evaluate(db, lenient, clock, fill).passed
+
+
+def test_an_orders_run_records_the_check(pipeline, db, tmp_path):
+    pipeline.run("customers", write_customers(tmp_path, [customer_obj()]))
+
+    result = pipeline.run("orders", write_orders(tmp_path, [order_row()]))
+
+    recorded = {row["check_name"]: row for row in rows(db, check_results, run_id=result.run_id)}
+    assert recorded[NAME]["severity"] == "warn"
+    assert recorded[NAME]["passed"] is True
