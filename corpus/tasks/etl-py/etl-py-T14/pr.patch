+def prune_runs(
+    context: AppContext, *, older_than_days: int, dry_run: bool = False
+) -> RunsPruneView:
+    """Delete the runs that finished more than `older_than_days` times 24 hours ago and that
+    nothing needs any more (store.runs.prunable), with their rejects and check results. With
+    `dry_run`, only count them."""
+    if not 1 <= older_than_days <= MAX_RETENTION_DAYS:
+        raise InvalidRequest(f"--older-than must be between 1 and {MAX_RETENTION_DAYS} days")
