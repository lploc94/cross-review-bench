+func TestWorkerDrainTimeout(t *testing.T) {
+	cases := []struct {
+		value   string
+		want    time.Duration
+		wantErr string
+	}{
+		{"", 30 * time.Second, ""},
+		{"2m", 2 * time.Minute, ""},
+		{"0s", 0, "WORKER_DRAIN_TIMEOUT must be positive"},
+		{"-5s", 0, "WORKER_DRAIN_TIMEOUT must be positive"},
+		{"soon", 0, "WORKER_DRAIN_TIMEOUT must be a duration"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.value, func(t *testing.T) {
+			vars := base()
+			if tc.value != "" {
+				vars["WORKER_DRAIN_TIMEOUT"] = tc.value
+			}
+			cfg, err := LoadFrom(env(vars))
+			if tc.wantErr != "" {
+				if err == nil || !strings.Contains(err.Error(), tc.wantErr) {
+					t.Errorf("error = %v, want %q", err, tc.wantErr)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cfg.WorkerDrainTimeout != tc.want {
+				t.Errorf("WorkerDrainTimeout = %s, want %s", cfg.WorkerDrainTimeout, tc.want)
+			}
+		})
+	}
+}
