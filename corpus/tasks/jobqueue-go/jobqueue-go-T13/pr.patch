new file mode 100644
index 0000000..c3f7e65
--- /dev/null
+++ b/internal/store/progress.go
@@ -0,0 +1,50 @@
+package store
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"github.com/relaywork/jobqueue/internal/domain"
+)
+
+// progressDoc is the JSON stored in the progress column.
+type progressDoc struct {
+	Percent   int       `json:"percent"`
+	Message   string    `json:"message,omitempty"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+func decodeProgress(raw []byte) (*domain.Progress, error) {
+	var doc progressDoc
+	if err := json.Unmarshal(raw, &doc); err != nil {
+		return nil, fmt.Errorf("decode progress: %w", err)
+	}
+	return &domain.Progress{Percent: doc.Percent, Message: doc.Message, UpdatedAt: doc.UpdatedAt.UTC()}, nil
+}
+
+// ReportProgress replaces the progress of a running job owned by workerID. It returns
+// domain.ErrLeaseLost when workerID no longer holds the lease, so that a worker whose job was
+// reaped cannot overwrite what the new attempt reports.
+func (s *Store) ReportProgress(ctx context.Context, id int64, workerID string, percent int, message string) error {
+	if err := domain.ValidateProgress(percent, message); err != nil {
+		return err
+	}
+	now := s.now()
+	doc, err := json.Marshal(progressDoc{Percent: percent, Message: message, UpdatedAt: now})
+	if err != nil {
+		return fmt.Errorf("encode progress of job %d: %w", id, err)
+	}
+	tag, err := s.pool.Exec(ctx, `
+		UPDATE jobs SET progress = $3, updated_at = $4
+		WHERE id = $1 AND state = 'running' AND locked_by = $2`,
+		id, workerID, doc, now)
+	if err != nil {
+		return fmt.Errorf("report progress of job %d: %w", id, err)
+	}
+	if tag.RowsAffected() == 0 {
+		return fmt.Errorf("report progress of job %d as %s: %w", id, workerID, domain.ErrLeaseLost)
+	}
+	return nil
+}
