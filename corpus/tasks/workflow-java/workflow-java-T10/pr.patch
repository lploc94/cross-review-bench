+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.papertrail.workflow.domain.StepKind;
+import com.papertrail.workflow.service.DefinitionService;
+import com.papertrail.workflow.service.DocumentService;
+import com.papertrail.workflow.support.IntegrationTestBase;
+import com.papertrail.workflow.support.TestData;
+import java.util.List;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.ResultActions;
+
+class RejectionReasonApiTest extends IntegrationTestBase {
+
+  private static final String AUTH = "Authorization";
+  private static final String REASONS =
+      "{\"reasons\":[{\"code\":\"MISSING_RECEIPTS\",\"label\":\"Receipts are missing\"},"
+          + "{\"code\":\"OVER_BUDGET\",\"label\":\"Over the approved budget\"}]}";
+
+  @Autowired private DefinitionService definitions;
+  @Autowired private DocumentService documents;
+
+  private long owner;
+  private long approver;
+  private long definition;
+
+  @BeforeEach
+  void setUp() throws Exception {
+    owner = data.user("Ines Berg");
+    approver = data.user("Tomas Vale");
+    definition =
+        definitions.createDraft(
+            "Expenses", List.of(TestData.step(1, StepKind.SINGLE, approver, null, 0, 480)));
+  }
+
+  private ResultActions putReasons(long definitionId, String body) throws Exception {
+    return mvc.perform(
+        put("/api/v1/admin/definitions/" + definitionId + "/rejection-reasons")
+            .header(AUTH, ADMIN_AUTH)
+            .contentType(MediaType.APPLICATION_JSON)
+            .content(body));
+  }
+
+  private long submittedDocument() {
+    long id = data.draft(data.principal(owner), "Expenses", "Travel claim");
+    documents.submit(data.principal(owner), id);
+    return id;
+  }
+
+  private ResultActions decide(long taskId, String body) throws Exception {
+    return mvc.perform(
+        post("/api/v1/tasks/" + taskId + "/decision")
+            .header(AUTH, data.bearer(approver))
+            .contentType(MediaType.APPLICATION_JSON)
+            .content(body));
+  }
+
+  @Test
+  void aDraftTakesReasonsAndShowsThemInOrder() throws Exception {
+    putReasons(definition, REASONS)
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.rejectionReasons.length()").value(2))
+        .andExpect(jsonPath("$.rejectionReasons[0].code").value("MISSING_RECEIPTS"))
+        .andExpect(jsonPath("$.rejectionReasons[1].label").value("Over the approved budget"));
+
+    putReasons(definition, "{\"reasons\":[{\"code\":\"OVER_BUDGET\",\"label\":\"Too much\"}]}")
+        .andExpect(jsonPath("$.rejectionReasons.length()").value(1))
+        .andExpect(jsonPath("$.rejectionReasons[0].code").value("OVER_BUDGET"));
+  }
+
+  @Test
+  void reasonsAreCheckedAndFrozenOnPublish() throws Exception {
+    putReasons(
+            definition,
+            "{\"reasons\":[{\"code\":\"LATE\",\"label\":\"a\"},{\"code\":\"LATE\",\"label\":\"b\"}]}")
+        .andExpect(status().isBadRequest());
+    putReasons(definition, "{\"reasons\":[{\"code\":\"not upper\",\"label\":\"a\"}]}")
+        .andExpect(status().isBadRequest());
+    putReasons(definition, "{\"reasons\":[{\"code\":\"LATE\"}]}")
+        .andExpect(status().isBadRequest());
+
+    definitions.publish(definition);
+
+    putReasons(definition, REASONS)
+        .andExpect(status().isConflict())
+        .andExpect(jsonPath("$.type").value("urn:workflow:problem:conflict"));
+  }
+
+  @Test
+  void aRejectionRecordsItsReasonOnTheTaskAndInTheAudit() throws Exception {
+    putReasons(definition, REASONS).andExpect(status().isOk());
+    definitions.publish(definition);
+    long id = submittedDocument();
+
+    decide(taskOf(id, approver), "{\"decision\":\"REJECT\",\"reason\":\"over_budget\"}")
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.status").value("REJECTED"))
+        .andExpect(jsonPath("$.rejectionReason").value("OVER_BUDGET"));
+
+    mvc.perform(get("/api/v1/documents/" + id + "/rounds").header(AUTH, data.bearer(owner)))
+        .andExpect(jsonPath("$[0].tasks[0].rejectionReason").value("OVER_BUDGET"));
+    String details =
+        jdbc.queryForObject(
+            "select details from audit_event where document_id = ? and action = 'TASK_REJECT'",
+            String.class,
+            id);
+    assertThat(details).contains("\"reason\":\"OVER_BUDGET\"");
+  }
+
+  @Test
+  void anApprovalTakesNoReason() throws Exception {
+    putReasons(definition, REASONS).andExpect(status().isOk());
+    definitions.publish(definition);
+    long id = submittedDocument();
+
+    decide(taskOf(id, approver), "{\"decision\":\"APPROVE\",\"reason\":\"OVER_BUDGET\"}")
+        .andExpect(status().isBadRequest())
+        .andExpect(jsonPath("$.type").value("urn:workflow:problem:invalid-reason"));
+    decide(taskOf(id, approver), "{\"decision\":\"APPROVE\"}")
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.rejectionReason").isEmpty());
+  }
+
+  @Test
+  void aDefinitionWithoutReasonsRejectsAsBefore() throws Exception {
+    definitions.publish(definition);
+    long id = submittedDocument();
+
+    decide(taskOf(id, approver), "{\"decision\":\"REJECT\",\"reason\":\"OVER_BUDGET\"}")
+        .andExpect(status().isBadRequest())
+        .andExpect(jsonPath("$.type").value("urn:workflow:problem:invalid-reason"));
+    decide(taskOf(id, approver), "{\"decision\":\"REJECT\",\"comment\":\"Not this quarter\"}")
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.status").value("REJECTED"));
+  }
+
+  @Test
+  void aRevisionKeepsTheReasons() throws Exception {
+    putReasons(definition, REASONS).andExpect(status().isOk());
+    definitions.publish(definition);
+
+    long revised = definitions.revise(definition);
+
+    assertThat(definitions.view(revised).rejectionReasons())
+        .extracting(reason -> reason.code())
+        .containsExactly("MISSING_RECEIPTS", "OVER_BUDGET");
+  }
+}
