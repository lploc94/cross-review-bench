+package com.papertrail.workflow.integration;
+
+import com.papertrail.workflow.service.ArchiveService;
+import org.springframework.scheduling.annotation.Scheduled;
+import org.springframework.stereotype.Component;
+
+/** Archives finished documents on a timer. The timer exists only when scheduling is enabled. */
+@Component
+public class ArchiveJob {
+
+  private final ArchiveService archives;
+
+  public ArchiveJob(ArchiveService archives) {
+    this.archives = archives;
+  }
+
+  @Scheduled(fixedDelayString = "${workflow.job-interval}")
+  public void run() {
+    runOnce();
+  }
+
+  public int runOnce() {
+    return archives.archiveFinished();
+  }
+}
