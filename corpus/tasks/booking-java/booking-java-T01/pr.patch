new file mode 100644
index 0000000..08afaed
--- /dev/null
+++ b/src/main/java/com/innkeep/booking/domain/PromoCode.java
@@ -0,0 +1,163 @@
+package com.innkeep.booking.domain;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.FetchType;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.JoinColumn;
+import jakarta.persistence.ManyToOne;
+import jakarta.persistence.Table;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.util.ArrayList;
+import org.hibernate.annotations.DynamicUpdate;
+
+/**
+ * A discount code of one property: a percentage of the stay or a fixed amount in the property's
+ * currency, valid for bookings made from {@code validFrom} to {@code validUntil} (property-local
+ * dates) and for at most {@code maxUses} confirmed reservations.
+ */
+@Entity
+@DynamicUpdate
+@Table(name = "promo_code")
+public class PromoCode extends AbstractEntity<Long> {
+
+  @Id
+  @GeneratedValue(strategy = GenerationType.IDENTITY)
+  private Long id;
+
+  @ManyToOne(fetch = FetchType.LAZY, optional = false)
+  @JoinColumn(name = "property_id", nullable = false)
+  private Property property;
+
+  @Column(nullable = false, length = 40)
+  private String code;
+
+  private Integer percent;
+
+  @Column(precision = 12, scale = 2)
+  private BigDecimal amount;
+
+  @Column(name = "valid_from", nullable = false)
+  private LocalDate validFrom;
+
+  @Column(name = "valid_until", nullable = false)
+  private LocalDate validUntil;
+
+  @Column(name = "max_uses", nullable = false)
+  private int maxUses;
+
+  @Column(nullable = false)
+  private int uses;
+
+  @Column(nullable = false)
+  private boolean enabled;
+
+  protected PromoCode() {}
+
+  public PromoCode(
+      Property property,
+      String code,
+      Integer percent,
+      BigDecimal amount,
+      LocalDate validFrom,
+      LocalDate validUntil,
+      int maxUses) {
+    this.property = property;
+    this.code = code;
+    this.percent = percent;
+    this.amount = amount;
+    this.validFrom = validFrom;
+    this.validUntil = validUntil;
+    this.maxUses = maxUses;
+    this.enabled = true;
+  }
+
+  @Override
+  public Long getId() {
+    return id;
+  }
+
+  public String getCode() {
+    return code;
+  }
+
+  public Integer getPercent() {
+    return percent;
+  }
+
+  public BigDecimal getAmount() {
+    return amount;
+  }
+
+  public LocalDate getValidFrom() {
+    return validFrom;
+  }
+
+  public LocalDate getValidUntil() {
+    return validUntil;
+  }
+
+  public int getMaxUses() {
+    return maxUses;
+  }
+
+  public int getUses() {
+    return uses;
+  }
+
+  public boolean isEnabled() {
+    return enabled;
+  }
+
+  /** Whether a booking made on {@code today}, the property's local date, may use the code. */
+  public boolean isValidOn(LocalDate today) {
+    return !today.isBefore(validFrom) && today.isBefore(validUntil);
+  }
+
+  public boolean hasUsesLeft() {
+    return uses < maxUses;
+  }
+
+  public void recordUse() {
+    this.uses++;
+  }
+
+  public void releaseUse() {
+    if (uses > 0) {
+      this.uses--;
+    }
+  }
+
+  public void disable() {
+    this.enabled = false;
+  }
+
+  /**
+   * The quote with one more line, the promo discount, after every other rule. The discount is the
+   * percentage of the total, or the fixed amount, and never more than the total.
+   */
+  public Quote applyTo(Quote quote) {
+    Money total = quote.total();
+    Money discount = percent != null ? total.percent(percent) : Money.of(amount, total.currency());
+    if (discount.amount().compareTo(total.amount()) > 0) {
+      discount = total;
+    }
+    var lines = new ArrayList<>(quote.lines());
+    lines.add(
+        new PriceLine(
+            PriceKind.PROMO,
+            null,
+            "Promo code " + code,
+            Money.zero(total.currency()).minus(discount).amount()));
+    return new Quote(
+        quote.roomTypeCode(),
+        quote.stay(),
+        quote.rooms(),
+        quote.guests(),
+        lines,
+        total.minus(discount));
+  }
+}
