@@ -0,0 +1,46 @@
+package store
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/relaywork/jobqueue/internal/domain"
+)
+
+// MaxBatchSize is the most jobs one EnqueueBatch call accepts.
+const MaxBatchSize = 500
+
+// EnqueueBatch normalizes, validates and inserts jobs in the order given and returns them in
+// that order. Every job gets the same created_at.
+//
+// When a job is invalid, the returned ValidationError names it by its position: a missing type
+// on the third job is reported for the field "jobs[2].type".
+func (s *Store) EnqueueBatch(ctx context.Context, jobs []domain.NewJob) ([]domain.Job, error) {
+	if len(jobs) == 0 || len(jobs) > MaxBatchSize {
+		return nil, domain.Invalid("jobs", "must contain between 1 and %d jobs", MaxBatchSize)
+	}
+	now := s.now()
+	out := make([]domain.Job, 0, len(jobs))
+	for i, nj := range jobs {
+		job, err := enqueue(ctx, s.pool, now, nj)
+		if err != nil {
+			return nil, batchError(i, err)
+		}
+		out = append(out, job)
+	}
+	return out, nil
+}
+
+// batchError attributes err to the job at index i of a batch.
+func batchError(i int, err error) error {
+	var verr *domain.ValidationError
+	if !errors.As(err, &verr) {
+		return fmt.Errorf("job %d of the batch: %w", i, err)
+	}
+	prefixed := &domain.ValidationError{Fields: make([]domain.FieldError, len(verr.Fields))}
+	for k, f := range verr.Fields {
+		prefixed.Fields[k] = domain.FieldError{Field: fmt.Sprintf("jobs[%d].%s", i, f.Field), Message: f.Message}
+	}
+	return prefixed
+}
