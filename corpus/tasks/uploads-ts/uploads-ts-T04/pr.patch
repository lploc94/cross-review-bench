new file mode 100644
index 0000000..156919e
--- /dev/null
+++ b/src/services/presignedUploads.ts
@@ -0,0 +1,113 @@
+import type { Readable } from "node:stream";
+import { InvalidSignatureError, PayloadTooLargeError, SignedUrlExpiredError, ValidationError } from "../domain/errors.js";
+import { normalizePath } from "../domain/paths.js";
+import { normalizeDeclaredType } from "../domain/sniff.js";
+import type { Clock } from "../infra/clock.js";
+import type { UploadOutcome, UploadService } from "./uploadService.js";
+import { unixNow, type UploadGrant, type UrlSigner } from "./urlSigner.js";
+
+export interface PresignedUploadDeps {
+  readonly clock: Clock;
+  readonly signer: UrlSigner;
+  readonly uploads: UploadService;
+  readonly maxUploadBytes: number;
+}
+
+export interface PresignInput {
+  readonly tenantId: string;
+  readonly path: string;
+  readonly size: number;
+  readonly contentType?: string;
+  readonly expiresIn: number;
+}
+
+export interface PresignedUpload {
+  /** Path and query of the public upload route; prefix it with the service's base URL. */
+  readonly url: string;
+  /** Headers the upload request should carry. */
+  readonly headers: Record<string, string>;
+  readonly expiresAt: Date;
+}
+
+export interface PresignedPut {
+  /** The parameters of the URL, as the request carried them. */
+  readonly query: { tenant: string; path: string; size: number; exp: number; sig: string };
+  readonly body: Readable;
+  /** The request's Content-Length, undefined for a chunked body. */
+  readonly contentLength?: number;
+  readonly declaredType?: string;
+}
+
+/**
+ * Presigned upload URLs: a tenant's API key asks for a URL that lets whoever holds it store one
+ * file of a given size at a given path, without an API key, until the URL expires. The upload
+ * itself is an ordinary single-request upload (quota reserved from the Content-Length, sniffing,
+ * scanning) that never replaces an existing file.
+ */
+export class PresignedUploadService {
+  private readonly deps: PresignedUploadDeps;
+
+  constructor(deps: PresignedUploadDeps) {
+    this.deps = deps;
+  }
+
+  /** `size` and `expiresIn` arrive validated by the route's schema; the size limit is checked here. */
+  presign(input: PresignInput): PresignedUpload {
+    const path = normalizePath(input.path);
+    if (input.size > this.deps.maxUploadBytes) {
+      throw new PayloadTooLargeError(this.deps.maxUploadBytes);
+    }
+    let declaredType: string | null = null;
+    if (input.contentType !== undefined) {
+      declaredType = normalizeDeclaredType(input.contentType);
+      if (declaredType === null) throw new ValidationError("contentType must be a media type");
+    }
+
+    const expiresAt = this.deps.clock.now().getTime() + input.expiresIn * 1000;
+    const grant: UploadGrant = { tenantId: input.tenantId, path, size: input.size, expiresAt };
+    const query = new URLSearchParams({
+      tenant: grant.tenantId,
+      path: grant.path,
+      size: String(grant.size),
+      exp: String(grant.expiresAt),
+      sig: this.deps.signer.signUpload(grant),
+    });
+    return {
+      url: `/v1/public/uploads?${query.toString()}`,
+      headers: declaredType === null ? {} : { "content-type": declaredType },
+      expiresAt: new Date(expiresAt),
+    };
+  }
+
+  /** Store the body a presigned URL was used for. */
+  async upload(put: PresignedPut): Promise<UploadOutcome> {
+    let grant: UploadGrant;
+    try {
+      grant = this.authorize(put.query);
+      if (put.contentLength !== grant.size) {
+        throw new ValidationError(`the body must have the URL's size, ${grant.size} bytes`, { size: grant.size });
+      }
+    } catch (err) {
+      put.body.destroy();
+      throw err;
+    }
+    return this.deps.uploads.upload({
+      tenantId: grant.tenantId,
+      path: grant.path,
+      overwrite: false,
+      body: put.body,
+      size: grant.size,
+      ...(put.declaredType === undefined ? {} : { declaredType: put.declaredType }),
+    });
+  }
+
+  /** The signature is checked before the expiry, so a forged URL learns nothing. */
+  private authorize(query: PresignedPut["query"]): UploadGrant {
+    const grant: UploadGrant = { tenantId: query.tenant, path: query.path, size: query.size, expiresAt: query.exp };
+    if (!this.deps.signer.verifyUpload(grant, query.sig)) throw new InvalidSignatureError();
+    if (grant.expiresAt <= unixNow(this.deps.clock)) {
+      throw new SignedUrlExpiredError(new Date(grant.expiresAt));
+    }
+    return grant;
+  }
+}
