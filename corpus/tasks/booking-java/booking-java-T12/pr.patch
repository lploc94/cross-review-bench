+package com.innkeep.booking.api;
+
+import com.innkeep.booking.service.StayRestrictionDraft;
+import com.innkeep.booking.service.StayRestrictionService;
+import java.util.List;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+/** The minimum-stay and closed-to-arrival rules of a room type, read and replaced as a whole. */
+@RestController
+@RequestMapping("/api/v1/admin/properties/{code}/room-types/{roomType}/restrictions")
+public class AdminRestrictionController {
+
+  private final StayRestrictionService restrictions;
+
+  public AdminRestrictionController(StayRestrictionService restrictions) {
+    this.restrictions = restrictions;
+  }
+
+  @GetMapping
+  public List<StayRestrictionDraft> list(@PathVariable String code, @PathVariable String roomType) {
+    return restrictions.list(code, roomType).stream().map(StayRestrictionDraft::from).toList();
+  }
+
+  @PutMapping
+  public List<StayRestrictionDraft> replace(
+      @PathVariable String code,
+      @PathVariable String roomType,
+      @RequestBody List<StayRestrictionDraft> request) {
+    return restrictions.replace(code, roomType, request).stream()
+        .map(StayRestrictionDraft::from)
+        .toList();
+  }
+}
