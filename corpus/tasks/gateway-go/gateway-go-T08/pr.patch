+++ b/internal/proxy/quota_test.go
@@ -0,0 +1,78 @@
+package proxy
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/relaywork/gateway/internal/auth"
+	"github.com/relaywork/gateway/internal/config"
+	"github.com/relaywork/gateway/internal/core"
+	"github.com/relaywork/gateway/internal/model"
+)
+
+// fakeQuota answers every quota check with decision.
+type fakeQuota struct {
+	calls    int
+	decision core.QuotaDecision
+}
+
+func (q *fakeQuota) ConsumeQuota(_ context.Context, _ string, limit int64) (core.QuotaDecision, error) {
+	q.calls++
+	d := q.decision
+	d.Limit = limit
+	return d, nil
+}
+
+// consumerAuth authenticates every request as one consumer.
+type consumerAuth struct{ c model.Consumer }
+
+func (a consumerAuth) Authenticate(context.Context, *http.Request, []byte) (model.Consumer, error) {
+	return a.c, nil
+}
+func (a consumerAuth) NeedsBody() bool        { return false }
+func (a consumerAuth) StripHeaders() []string { return nil }
+
+func TestDailyQuotaHeadersAndRefusal(t *testing.T) {
+	routes := `{"routes":[{"id":"orders","path":"/orders","auth":"api_key","upstreams":[{"url":"http://up.internal"}]}]}`
+	c := model.Consumer{ID: "c_0123456789abcdef", Name: "billing", Enabled: true, DailyQuota: 5}
+	q := &fakeQuota{decision: core.QuotaDecision{Allowed: true, Remaining: 4}}
+	f := newFixture(t, routes, fixtureOptions{
+		transport: statusTransport(200),
+		auth:      auth.Modes{config.AuthAPIKey: consumerAuth{c}},
+		quota:     q,
+	})
+
+	w := f.get("/orders")
+	if w.Code != http.StatusOK || w.Header().Get("X-Quota-Limit") != "5" || w.Header().Get("X-Quota-Remaining") != "4" {
+		t.Errorf("allowed: status %d, headers %v", w.Code, w.Header())
+	}
+
+	q.decision = core.QuotaDecision{Allowed: false, RetryAfter: 90 * time.Second}
+	w = f.do(httptest.NewRequest(http.MethodGet, "/orders", nil))
+	if w.Code != http.StatusTooManyRequests || errorOf(t, w).Code != codeQuotaExceeded {
+		t.Errorf("refused: status %d, body %s", w.Code, w.Body)
+	}
+	if w.Header().Get("Retry-After") != "90" {
+		t.Errorf("Retry-After = %q, want 90", w.Header().Get("Retry-After"))
+	}
+}
+
+func TestUnlimitedConsumersSkipTheQuota(t *testing.T) {
+	routes := `{"routes":[{"id":"orders","path":"/orders","auth":"api_key","upstreams":[{"url":"http://up.internal"}]}]}`
+	c := model.Consumer{ID: "c_0123456789abcdef", Name: "billing", Enabled: true}
+	q := &fakeQuota{}
+	f := newFixture(t, routes, fixtureOptions{
+		transport: statusTransport(200),
+		auth:      auth.Modes{config.AuthAPIKey: consumerAuth{c}},
+		quota:     q,
+	})
+	if w := f.get("/orders"); w.Code != http.StatusOK {
+		t.Errorf("status %d", w.Code)
+	}
+	if q.calls != 0 {
+		t.Errorf("quota checked %d times for a consumer without a daily quota", q.calls)
+	}
+}
