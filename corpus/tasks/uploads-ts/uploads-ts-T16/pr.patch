index 0000000..d87f995
--- /dev/null
+++ b/test/api/folderDelete.test.ts
@@ -0,0 +1,139 @@
+import { access } from "node:fs/promises";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { buildTestApp, type TestApp } from "../helpers/app.js";
+import {
+  createTenant,
+  expectStatus,
+  issueKey,
+  storeFile,
+  tenantUsage,
+  type ErrorResponse,
+  type FileBody,
+  type TestTenant,
+} from "../helpers/fixtures.js";
+
+interface FolderDeletion {
+  prefix: string;
+  deleted: number;
+  bytes: number;
+  more: boolean;
+}
+
+describe("deleting a folder", () => {
+  let t: TestApp;
+  let tenant: TestTenant;
+
+  beforeEach(async () => {
+    t = await buildTestApp({ env: { LIST_MAX_LIMIT: "3" } });
+    tenant = await createTenant(t.pool, t.clock);
+  });
+
+  afterEach(async () => {
+    await t.close();
+  });
+
+  function deleteFolder(prefix: string, who: TestTenant = tenant) {
+    return t.app.inject({
+      method: "DELETE",
+      url: `/v1/files?prefix=${encodeURIComponent(prefix)}`,
+      headers: who.headers,
+    });
+  }
+
+  async function livePaths(who: TestTenant = tenant): Promise<string[]> {
+    const response = await t.app.inject({ url: "/v1/files", headers: who.headers });
+    expectStatus(response, 200);
+    return response.json<{ data: FileBody[] }>().data.map((file) => file.path);
+  }
+
+  function objectPath(file: FileBody): string {
+    return path.join(t.storageRoot ?? "", "objects", "t", tenant.tenantId, file.id);
+  }
+
+  it("deletes the files under the prefix, releases their bytes and removes their objects", async () => {
+    const a = await storeFile(t.app, tenant, "reports/2025/a.csv", "a".repeat(10));
+    const b = await storeFile(t.app, tenant, "reports/2025/q1/b.csv", "b".repeat(20));
+    await storeFile(t.app, tenant, "reports/2025-old/c.csv", "c".repeat(40));
+    await storeFile(t.app, tenant, "reports/2024/d.csv", "d".repeat(80));
+    expect(await tenantUsage(t.pool, tenant.tenantId)).toBe(150);
+
+    const response = await deleteFolder("reports/2025/");
+    expectStatus(response, 200);
+    expect(response.json<FolderDeletion>()).toEqual({
+      prefix: "reports/2025/",
+      deleted: 2,
+      bytes: 30,
+      more: false,
+    });
+    expect(await tenantUsage(t.pool, tenant.tenantId)).toBe(120);
+    expect(await livePaths()).toEqual(["reports/2024/d.csv", "reports/2025-old/c.csv"]);
+    await expect(access(objectPath(a))).rejects.toThrow();
+    await expect(access(objectPath(b))).rejects.toThrow();
+    const rows = await t.pool.query<{ object_deleted_at: Date | null }>(
+      "SELECT object_deleted_at FROM files WHERE id = ANY($1::uuid[])",
+      [[a.id, b.id]],
+    );
+    expect(rows.rows.every((row) => row.object_deleted_at !== null)).toBe(true);
+  });
+
+  it("deletes at most LIST_MAX_LIMIT files per request and says when more are left", async () => {
+    for (const name of ["1", "2", "3", "4"]) await storeFile(t.app, tenant, `tmp/${name}.txt`, name);
+
+    const first = await deleteFolder("tmp/");
+    expectStatus(first, 200);
+    expect(first.json<FolderDeletion>()).toMatchObject({ deleted: 3, bytes: 3, more: true });
+    expect(await livePaths()).toEqual(["tmp/4.txt"]);
+
+    const second = await deleteFolder("tmp/");
+    expect(second.json<FolderDeletion>()).toMatchObject({ deleted: 1, bytes: 1, more: false });
+    expect(await tenantUsage(t.pool, tenant.tenantId)).toBe(0);
+  });
+
+  it("treats % and _ in the prefix as plain characters", async () => {
+    await storeFile(t.app, tenant, "a_b/x.txt", "x");
+    await storeFile(t.app, tenant, "axb/y.txt", "y");
+    await storeFile(t.app, tenant, "100%/z.txt", "z");
+    await storeFile(t.app, tenant, "1000/w.txt", "w");
+
+    expect((await deleteFolder("a_b/")).json<FolderDeletion>().deleted).toBe(1);
+    expect((await deleteFolder("100%/")).json<FolderDeletion>().deleted).toBe(1);
+    expect(await livePaths()).toEqual(["1000/w.txt", "axb/y.txt"]);
+  });
+
+  it("answers deleted 0 for a folder without files", async () => {
+    await storeFile(t.app, tenant, "keep/a.txt", "a");
+    const response = await deleteFolder("empty/");
+    expectStatus(response, 200);
+    expect(response.json<FolderDeletion>()).toEqual({ prefix: "empty/", deleted: 0, bytes: 0, more: false });
+    expect(await tenantUsage(t.pool, tenant.tenantId)).toBe(1);
+  });
+
+  it("leaves other tenants' files alone", async () => {
+    const other = await createTenant(t.pool, t.clock, { name: "Harbor Logistics" });
+    await storeFile(t.app, other, "shared/theirs.txt", "theirs");
+    await storeFile(t.app, tenant, "shared/mine.txt", "mine");
+
+    expect((await deleteFolder("shared/")).json<FolderDeletion>().deleted).toBe(1);
+    expect(await livePaths(other)).toEqual(["shared/theirs.txt"]);
+    expect(await tenantUsage(t.pool, other.tenantId)).toBe(6);
+  });
+
+  it("rejects prefixes that are not folders", async () => {
+    for (const prefix of ["reports", "/reports/", "../reports/", "a//", "a/./"]) {
+      const response = await deleteFolder(prefix);
+      expectStatus(response, 400);
+      expect(response.json<ErrorResponse>().error.code).toBe("validation_error");
+    }
+    const missing = await t.app.inject({ method: "DELETE", url: "/v1/files", headers: tenant.headers });
+    expectStatus(missing, 400);
+  });
+
+  it("needs the files:delete scope", async () => {
+    await storeFile(t.app, tenant, "docs/a.txt", "a");
+    const reader = await issueKey(t.pool, t.clock, tenant.tenantId, ["files:read", "files:write"]);
+    const response = await deleteFolder("docs/", reader);
+    expectStatus(response, 403);
+    expect(await livePaths()).toEqual(["docs/a.txt"]);
+  });
+});
