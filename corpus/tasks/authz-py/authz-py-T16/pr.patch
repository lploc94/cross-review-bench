+async def test_revoking_the_other_sessions_keeps_the_current_one(client, container):
+    me = await signed_in(client, container, "omar@example.com")
+    phone = (await login(client, me.email, device_label="Phone")).json()
+    tablet = (await login(client, me.email, device_label="Tablet")).json()
+
+    response = await client.post("/v1/sessions/revoke-others", headers=me.headers)
+
+    assert response.status_code == 200
+    assert set(response.json()["revoked"]) == {phone["session_id"], tablet["session_id"]}
+    listed = await client.get("/v1/sessions", headers=me.headers)
+    assert [item["id"] for item in listed.json()["data"]] == [me.session_id]
+    for other in (phone, tablet):
+        probe = await client.get("/v1/me", headers=bearer(other["access_token"]))
+        assert probe.status_code == 401
+        refreshed = await client.post(
+            "/v1/auth/refresh", json={"refresh_token": other["refresh_token"]}
+        )
+        assert refreshed.status_code == 401
+    kept = await client.post("/v1/auth/refresh", json={"refresh_token": me.refresh_token})
+    assert kept.status_code == 200
+
+
+async def test_revoking_the_other_sessions_leaves_other_users_alone(client, container):
+    me = await signed_in(client, container)
+    someone = await signed_in(client, container)
+
+    response = await client.post("/v1/sessions/revoke-others", headers=me.headers)
+
+    assert response.json()["revoked"] == []
+    assert (await client.get("/v1/me", headers=someone.headers)).status_code == 200
+
+
+async def test_ended_sessions_are_left_as_they_are(client, container, clock: FrozenClock):
+    me = await signed_in(client, container)
+    phone = (await login(client, me.email, device_label="Phone")).json()
+    await client.delete(f"/v1/sessions/{phone['session_id']}", headers=me.headers)
+    laptop = (await login(client, me.email, device_label="Laptop")).json()
+    async with container.db.transaction() as session:
+        await session.execute(
+            update(Session)
+            .where(Session.id == uuid.UUID(laptop["session_id"]))
+            .values(expires_at=clock.now())
+        )
+
+    response = await client.post("/v1/sessions/revoke-others", headers=me.headers)
+
+    assert response.json()["revoked"] == []
+    async with container.db.read() as session:
+        revoked = await session.get(Session, uuid.UUID(phone["session_id"]))
+        expired = await session.get(Session, uuid.UUID(laptop["session_id"]))
+    assert revoked is not None
+    assert revoked.revoked_reason == "revoked_by_user"
+    assert expired is not None
+    assert expired.revoked_at is None
+
+
+async def test_revoking_the_other_sessions_needs_a_token(client):
+    response = await client.post("/v1/sessions/revoke-others")
+
+    assert response.status_code == 401
