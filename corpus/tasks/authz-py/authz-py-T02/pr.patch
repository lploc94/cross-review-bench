diff --git a/tests/api/test_api_keys.py b/tests/api/test_api_keys.py
new file mode 100644
index 0000000..62c6c7b
--- /dev/null
+++ b/tests/api/test_api_keys.py
@@ -0,0 +1,82 @@
+from __future__ import annotations
+
+from tests.helpers.factories import bearer, make_org, org_with_member, role_id, signed_in
+
+
+async def _key(client, container, org, creator, role="member"):
+    rid = await role_id(container, org["id"], role)
+    return await client.post(
+        f"/v1/orgs/{org['id']}/api-keys",
+        json={"name": "CI deploys", "role_id": str(rid)},
+        headers=creator.headers,
+    )
+
+
+async def test_key_is_shown_once_and_acts_for_its_creator(client, container, clock):
+    owner = await signed_in(client, container)
+    org = await make_org(client, owner)
+    projects = f"/v1/orgs/{org['id']}/projects"
+    await client.post(projects, json={"name": "Apollo"}, headers=owner.headers)
+
+    created = await _key(client, container, org, owner)
+    key = created.json()
+    listed = await client.get(projects, headers=bearer(key["key"]))
+    written = await client.post(projects, json={"name": "Gemini"}, headers=bearer(key["key"]))
+
+    assert created.status_code == 201
+    assert created.headers["cache-control"] == "no-store"
+    assert key["key"].startswith(f"azk_{key['prefix']}_")
+    assert [p["name"] for p in listed.json()["data"]] == ["Apollo"]
+    assert written.status_code == 201
+    assert written.json()["created_by"] == str(owner.id)
+    keys = (await client.get(f"/v1/orgs/{org['id']}/api-keys", headers=owner.headers)).json()
+    assert "key" not in keys["data"][0]
+    assert keys["data"][0]["last_used_at"] == clock.now().isoformat().replace("+00:00", "Z")
+
+
+async def test_keys_only_open_organisation_routes(client, container):
+    owner = await signed_in(client, container)
+    org = await make_org(client, owner)
+    key = (await _key(client, container, org, owner)).json()["key"]
+
+    assert (await client.get("/v1/me", headers=bearer(key))).status_code == 401
+    assert (await client.get("/v1/orgs", headers=bearer(key))).status_code == 401
+    forged = bearer(key[:-4] + "abcd")
+    assert (await client.get(f"/v1/orgs/{org['id']}", headers=forged)).status_code == 401
+
+
+async def test_revoked_key_is_refused_and_audited(client, container):
+    owner = await signed_in(client, container)
+    org = await make_org(client, owner)
+    key = (await _key(client, container, org, owner)).json()
+    path = f"/v1/orgs/{org['id']}"
+
+    revoked = await client.delete(f"{path}/api-keys/{key['id']}", headers=owner.headers)
+    again = await client.delete(f"{path}/api-keys/{key['id']}", headers=owner.headers)
+
+    assert (revoked.status_code, again.status_code) == (204, 404)
+    assert (await client.get(path, headers=bearer(key["key"]))).status_code == 401
+    audit = (await client.get(f"{path}/audit", headers=owner.headers)).json()["data"]
+    assert [event["action"] for event in audit[:2]] == ["api_key.revoked", "api_key.created"]
+
+
+async def test_keys_cannot_administer_the_organisation(client, container):
+    owner = await signed_in(client, container)
+    org = await make_org(client, owner)
+
+    response = await _key(client, container, org, owner, role="admin")
+
+    assert response.status_code == 422
+    assert "members:manage" in response.json()["error"]["details"]["permissions"]
+
+
+async def test_key_stops_working_when_its_creator_leaves(client, container):
+    org, _, admin = await org_with_member(client, container, "admin")
+    key = bearer((await _key(client, container, org, admin)).json()["key"])
+    path = f"/v1/orgs/{org['id']}"
+    assert (await client.get(path, headers=key)).status_code == 200
+    assert (await client.delete(f"{path}/members/{admin.id}", headers=key)).status_code == 403
+
+    await client.delete(f"{path}/members/{admin.id}", headers=admin.headers)
+
+    assert (await client.get(path, headers=key)).status_code == 404
