@@ -0,0 +1,100 @@
+package store_test
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/relaywork/jobqueue/internal/domain"
+	"github.com/relaywork/jobqueue/internal/store"
+)
+
+// finishJobs creates one job in each terminal state of queue, finished at the clock's time.
+func finishJobs(t *testing.T, s *store.Store, queue string) map[int64]domain.State {
+	t.Helper()
+	ctx := context.Background()
+	cancelled := mustEnqueue(t, s, domain.NewJob{Queue: queue})
+	if _, err := s.Cancel(ctx, cancelled.ID); err != nil {
+		t.Fatal(err)
+	}
+	out := map[int64]domain.State{cancelled.ID: domain.StateCancelled}
+	for _, st := range []domain.State{domain.StateSucceeded, domain.StateFailed, domain.StateDead} {
+		job := mustEnqueue(t, s, domain.NewJob{Queue: queue, MaxAttempts: 1})
+		mustLease(t, s, queue, "w1", 1)
+		var err error
+		switch st {
+		case domain.StateSucceeded:
+			err = s.Complete(ctx, job.ID, "w1")
+		case domain.StateFailed:
+			_, err = s.Discard(ctx, job.ID, "w1", "malformed payload")
+		case domain.StateDead:
+			_, err = s.Fail(ctx, job.ID, "w1", "upstream unavailable", t0)
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		out[job.ID] = st
+	}
+	return out
+}
+
+func TestPurgeFinishedDeletesOldTerminalJobs(t *testing.T) {
+	s, clk := newStore(t)
+	ctx := context.Background()
+	old := finishJobs(t, s, "default")
+	clk.Advance(time.Hour)
+	recent := finishJobs(t, s, "reports")
+	waiting := mustEnqueue(t, s, domain.NewJob{Queue: "default"})
+	mustEnqueue(t, s, domain.NewJob{Queue: "other"})
+	running := mustLease(t, s, "other", "w2", 1)[0]
+
+	purged, err := s.PurgeFinished(ctx, t0.Add(time.Minute))
+	if err != nil || len(purged) != len(old) {
+		t.Fatalf("purged %v, %v; want the %d old jobs", purged, err, len(old))
+	}
+	for _, p := range purged {
+		if old[p.ID] != p.State || p.Queue != "default" {
+			t.Errorf("purged %+v, want one of %v", p, old)
+		}
+		if _, err := s.Get(ctx, p.ID); err == nil {
+			t.Errorf("job %d still exists", p.ID)
+		}
+	}
+	for id := range recent {
+		mustGet(t, s, id)
+	}
+	mustGet(t, s, waiting.ID)
+	mustGet(t, s, running.ID)
+
+	// finished_at must be before the cutoff, not at it.
+	if purged, err := s.PurgeFinished(ctx, clk.Now()); err != nil || len(purged) != 0 {
+		t.Errorf("cutoff equal to finished_at purged %v, %v", purged, err)
+	}
+}
+
+func TestPurgeFinishedWorksInBatches(t *testing.T) {
+	if testing.Short() {
+		t.Skip("creates more than one purge batch")
+	}
+	s, clk := newStore(t)
+	ctx := context.Background()
+	// Finished one second apart, so that the oldest ones go first.
+	if _, err := testPool.Exec(ctx, `
+		INSERT INTO jobs (queue, type, state, run_at, created_at, updated_at, finished_at)
+		SELECT 'default', 'noop', 'succeeded', $1, $1, $1, $1::timestamptz + n * interval '1 second'
+		FROM generate_series(1, $2) AS n`,
+		clk.Now(), store.PurgeBatchSize+5); err != nil {
+		t.Fatal(err)
+	}
+	cutoff := clk.Now().Add(24 * time.Hour)
+
+	first, err := s.PurgeFinished(ctx, cutoff)
+	if err != nil || len(first) != store.PurgeBatchSize {
+		t.Fatalf("first batch: %d jobs, %v; want %d", len(first), err, store.PurgeBatchSize)
+	}
+	mustGet(t, s, int64(store.PurgeBatchSize+1)) // younger than the whole first batch
+	second, err := s.PurgeFinished(ctx, cutoff)
+	if err != nil || len(second) != 5 {
+		t.Fatalf("second batch: %d jobs, %v; want 5", len(second), err)
+	}
+}
