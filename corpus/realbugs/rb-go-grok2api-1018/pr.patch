+// PurgeOutdated 清理超过指定保留天数的历史审计记录。
+func (s *Service) PurgeOutdated(ctx context.Context, retentionDays int) (int64, error) {
+	if retentionDays <= 0 {
+		return 0, nil
+	}
+	cutoff := time.Now().UTC().AddDate(0, 0, -retentionDays)
+	return s.audits.PurgeOlderThan(ctx, cutoff)
+}
