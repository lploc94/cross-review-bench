diff --git a/src/services/currencyService.ts b/src/services/currencyService.ts
new file mode 100644
index 0000000..65d79aa
--- /dev/null
+++ b/src/services/currencyService.ts
@@ -0,0 +1,23 @@
+import type { Pool } from "../db/pool.js";
+import { isCurrencyCode, type Currency } from "../domain/currency.js";
+import { NotFoundError } from "../domain/errors.js";
+import * as currencies from "../repositories/currencies.js";
+
+/** The currencies accounts can be opened in, as the `currencies` table lists them. */
+export class CurrencyService {
+  private readonly pool: Pool;
+
+  constructor(deps: { pool: Pool }) {
+    this.pool = deps.pool;
+  }
+
+  async listCurrencies(): Promise<Currency[]> {
+    return currencies.listCurrencies(this.pool);
+  }
+
+  async getCurrency(code: string): Promise<Currency> {
+    const currency = isCurrencyCode(code) ? await currencies.findCurrency(this.pool, code) : null;
+    if (!currency) throw NotFoundError.resource("currency", code);
+    return currency;
+  }
+}
