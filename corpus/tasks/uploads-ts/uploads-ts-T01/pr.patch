diff --git a/test/api/range.test.ts b/test/api/range.test.ts
new file mode 100644
index 0000000..9797ddb
--- /dev/null
+++ b/test/api/range.test.ts
@@ -0,0 +1,65 @@
+import { describe, expect, it } from "vitest";
+import { ifRangeHolds, parseRange } from "../../src/api/range.js";
+
+describe("parseRange", () => {
+  it("reads a closed range with an inclusive end", () => {
+    expect(parseRange("bytes=0-9", 100)).toEqual({ kind: "partial", range: { start: 0, end: 9 } });
+    expect(parseRange("bytes=10-10", 100)).toEqual({ kind: "partial", range: { start: 10, end: 10 } });
+  });
+
+  it("reads an open range to the end of the file", () => {
+    expect(parseRange("bytes=90-", 100)).toEqual({ kind: "partial", range: { start: 90, end: 99 } });
+  });
+
+  it("cuts a last position past the end of the file", () => {
+    expect(parseRange("bytes=95-500", 100)).toEqual({ kind: "partial", range: { start: 95, end: 99 } });
+  });
+
+  it("serves a suffix longer than the file as the whole file", () => {
+    expect(parseRange("bytes=-200", 100)).toEqual({ kind: "partial", range: { start: 0, end: 99 } });
+  });
+
+  it("accepts the unit in any case and surrounding spaces", () => {
+    expect(parseRange(" Bytes=1-2 ", 100)).toEqual({ kind: "partial", range: { start: 1, end: 2 } });
+  });
+
+  it("is unsatisfiable when the range starts at or after the end", () => {
+    expect(parseRange("bytes=100-", 100)).toEqual({ kind: "unsatisfiable" });
+    expect(parseRange("bytes=150-200", 100)).toEqual({ kind: "unsatisfiable" });
+  });
+
+  it("ignores headers it does not serve", () => {
+    for (const header of [
+      undefined,
+      "",
+      "bytes=",
+      "bytes=-",
+      "bytes=5-3",
+      "bytes=0-1,5-6",
+      "items=0-9",
+      "bytes=a-b",
+      "bytes=1.5-2",
+    ]) {
+      expect(parseRange(header, 100), String(header)).toEqual({ kind: "full" });
+    }
+  });
+
+  it("always sends an empty file whole", () => {
+    expect(parseRange("bytes=0-0", 0)).toEqual({ kind: "full" });
+  });
+});
+
+describe("ifRangeHolds", () => {
+  const etag = '"abc"';
+
+  it("holds without the header and for the same strong tag", () => {
+    expect(ifRangeHolds(undefined, etag)).toBe(true);
+    expect(ifRangeHolds('"abc"', etag)).toBe(true);
+  });
+
+  it("fails for another tag, a weak tag or a date", () => {
+    expect(ifRangeHolds('"other"', etag)).toBe(false);
+    expect(ifRangeHolds('W/"abc"', etag)).toBe(false);
+    expect(ifRangeHolds("Tue, 15 Jan 2030 10:00:00 GMT", etag)).toBe(false);
+  });
+});
