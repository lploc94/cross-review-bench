diff --git a/src/test/java/com/innkeep/booking/service/DepositServiceTest.java b/src/test/java/com/innkeep/booking/service/DepositServiceTest.java
new file mode 100644
index 0000000..69c68c7
--- /dev/null
+++ b/src/test/java/com/innkeep/booking/service/DepositServiceTest.java
@@ -0,0 +1,126 @@
+package com.innkeep.booking.service;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import com.innkeep.booking.domain.BalanceDeclinedException;
+import com.innkeep.booking.domain.DateRange;
+import com.innkeep.booking.domain.LedgerEntry;
+import com.innkeep.booking.domain.LedgerKind;
+import com.innkeep.booking.domain.Property;
+import com.innkeep.booking.domain.Reservation;
+import com.innkeep.booking.domain.ReservationStatus;
+import com.innkeep.booking.domain.RoomType;
+import com.innkeep.booking.support.IntegrationTestBase;
+import com.innkeep.booking.support.RecordingPaymentGateway.Movement;
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.util.List;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+
+class DepositServiceTest extends IntegrationTestBase {
+
+  private static final LocalDate IN = LocalDate.parse("2027-06-07");
+  private static final LocalDate OUT = LocalDate.parse("2027-06-10");
+  private static final Instant ARRIVAL = Instant.parse("2027-06-07T15:00:00Z");
+
+  @Autowired private CatalogService catalog;
+  @Autowired private ReservationService reservations;
+  @Autowired private OperationsService operations;
+
+  private Property property;
+  private RoomType room;
+
+  @BeforeEach
+  void setUp() {
+    property = data.harbourHouse();
+    room = data.roomType(property, "double", 2, "100.00");
+    data.rooms(property, room, IN, OUT, 2);
+  }
+
+  @Test
+  void withoutADepositTheWholePriceIsChargedAtConfirmationAndNothingAtCheckIn() {
+    Reservation reservation = data.book(property, room, IN, OUT, 1);
+    clock.set(ARRIVAL);
+    reservations.checkIn(reservation.getReference());
+
+    assertThat(payments.movements())
+        .extracting(m -> m.amount().amount().toPlainString())
+        .containsExactly("300.00");
+    assertThat(ledgerKinds(reservation)).containsExactly(LedgerKind.CHARGE);
+  }
+
+  @Test
+  void aDepositIsChargedAtConfirmationAndTheBalanceAtCheckIn() {
+    depositOf(30);
+    Reservation reservation = data.book(property, room, IN, OUT, 1);
+
+    Movement deposit = payments.movements().get(0);
+    assertThat(deposit.key()).isEqualTo("charge-" + reservation.getHoldId());
+    assertThat(deposit.amount().amount().toPlainString()).isEqualTo("90.00");
+    assertThat(ledgerKinds(reservation)).containsExactly(LedgerKind.DEPOSIT);
+
+    clock.set(ARRIVAL);
+    Reservation checkedIn = reservations.checkIn(reservation.getReference());
+
+    assertThat(checkedIn.getStatus()).isEqualTo(ReservationStatus.CHECKED_IN);
+    Movement balance = payments.movements().get(1);
+    assertThat(balance.key()).isEqualTo("balance-" + reservation.getId());
+    assertThat(balance.amount().amount().toPlainString()).isEqualTo("210.00");
+    assertThat(ledgerKinds(reservation)).containsExactly(LedgerKind.DEPOSIT, LedgerKind.BALANCE);
+  }
+
+  @Test
+  void theDepositIsRoundedHalfEvenToCents() {
+    catalog.reprice(
+        property.getCode(), room.getCode(), new BigDecimal("33.25"), new BigDecimal("15.00"));
+    depositOf(50);
+    data.book(property, room, IN, LocalDate.parse("2027-06-08"), 1);
+
+    // 50 % of 33.25 is 16.625, which rounds to the even cent
+    assertThat(payments.movements().get(0).amount().amount().toPlainString()).isEqualTo("16.62");
+  }
+
+  @Test
+  void aDeclinedBalanceLeavesTheGuestNotCheckedIn() {
+    depositOf(30);
+    Reservation reservation = data.book(property, room, IN, OUT, 1);
+    clock.set(ARRIVAL);
+    payments.failNextCharge();
+
+    assertThatThrownBy(() -> reservations.checkIn(reservation.getReference()))
+        .isInstanceOf(BalanceDeclinedException.class);
+    assertThat(reservations.get(reservation.getReference()).getStatus())
+        .isEqualTo(ReservationStatus.CONFIRMED);
+    assertThat(ledgerKinds(reservation)).containsExactly(LedgerKind.DEPOSIT);
+  }
+
+  @Test
+  void revenueCountsDepositsAndBalances() {
+    depositOf(30);
+    Reservation reservation = data.book(property, room, IN, OUT, 1);
+    clock.set(ARRIVAL);
+    reservations.checkIn(reservation.getReference());
+
+    NetRevenue revenue =
+        operations.netRevenue(
+            property.getCode(),
+            new DateRange(LocalDate.parse("2027-05-01"), LocalDate.parse("2027-06-30")));
+
+    assertThat(revenue.charged().toPlainString()).isEqualTo("300.00");
+    assertThat(revenue.net().toPlainString()).isEqualTo("300.00");
+  }
+
+  private void depositOf(int percent) {
+    catalog.changePolicy(property.getCode(), new PolicyDraft(7, 50, 10, 7, 0, percent));
+  }
+
+  private List<LedgerKind> ledgerKinds(Reservation reservation) {
+    return reservations.ledger(reservation.getReference()).entries().stream()
+        .map(LedgerEntry::getKind)
+        .toList();
+  }
+}
