+package core
+
+import (
+	"context"
+	"time"
+)
+
+// QuotaDecision is the outcome of one daily quota check.
+type QuotaDecision struct {
+	Allowed    bool
+	Limit      int64
+	Remaining  int64         // requests left today, when allowed
+	RetryAfter time.Duration // until the next day starts, when refused
+}
+
+// QuotaLimiter counts a consumer's requests against its daily quota of limit requests.
+type QuotaLimiter interface {
+	ConsumeQuota(ctx context.Context, consumerID string, limit int64) (QuotaDecision, error)
+}
