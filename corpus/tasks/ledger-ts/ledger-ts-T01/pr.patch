@@ -0,0 +1,10 @@
+-- A reversal is an ordinary transfer in the opposite direction that points at the transfer it
+-- undoes. Reversals are looked up by the transfer they reverse.
+ALTER TABLE transfers ADD COLUMN reversal_of uuid;
+
+ALTER TABLE transfers
+    ADD CONSTRAINT transfers_reversal_of_fkey FOREIGN KEY (tenant_id, reversal_of)
+        REFERENCES transfers (tenant_id, id);
+
+CREATE INDEX transfers_reversal_of_idx ON transfers (tenant_id, reversal_of)
+    WHERE reversal_of IS NOT NULL;
