+/** Whether a file that is not deleted still uses this storage key (deduplicated files share keys). */
+export async function isStorageKeyInUse(db: Queryable, storageKey: string): Promise<boolean> {
+  const result = await db.query(
+    "SELECT 1 FROM files WHERE storage_key = $1 AND status <> 'deleted' LIMIT 1",
+    [storageKey],
+  );
+  return result.rows.length > 0;
+}
