@@ -0,0 +1,45 @@
+"""Rejected rows read back from `etl.rejects`, to go through their source's normaliser again."""
+
+from __future__ import annotations
+
+from collections.abc import Iterator
+from contextlib import contextmanager
+
+from sqlalchemy import Connection
+
+from etl.pipeline.sink import kept_as_read
+from etl.sources.base import MalformedRow, SourceItem, SourceRow
+from etl.store import rejects
+
+CHANGED_WHEN_STORED = "the stored row may have been changed to make it storable; not read again"
+
+
+@contextmanager
+def replay_rejects(
+    connection: Connection, run_id: int, *, page: int
+) -> Iterator[Iterator[SourceItem]]:
+    """The rejected rows of run `run_id` as source rows, in file order, read `page` at a time.
+
+    Only rejects whose payload is the row's fields are rows again; those holding what a
+    reader could not split (a list of fields, a raw line) are left out. A payload that
+    safe_payload may have changed to make it storable (sink.kept_as_read) may not be the row
+    the source sent: it comes back as a malformed row, so that it is rejected again with the
+    reason why.
+    """
+    yield _rows(connection, run_id, page)
+
+
+def _rows(connection: Connection, run_id: int, page: int) -> Iterator[SourceItem]:
+    after = None
+    while True:
+        stored = rejects.payloads(connection, run_id, after=after, limit=page)
+        for item in stored:
+            if not isinstance(item.payload, dict):
+                continue
+            if not kept_as_read(item.payload):
+                yield MalformedRow(item.line_no, CHANGED_WHEN_STORED, item.payload)
+                continue
+            yield SourceRow(item.line_no, item.payload)
+        if len(stored) < page:
+            return
+        after = stored[-1]
