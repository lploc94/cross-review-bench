+func TestIsFinalAttempt(t *testing.T) {
+	cases := []struct {
+		name        string
+		attempts    int // attempts made before this lease
+		maxAttempts int
+		want        bool
+	}{
+		{"first of three", 0, 3, false},
+		{"second of three", 1, 3, false},
+		{"third of three", 2, 3, true},
+		{"only attempt", 0, 1, true},
+		{"requeued dead job", 0, 5, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			st := newFakeStore(domain.Job{ID: 1, Type: "probe", Attempts: tc.attempts, MaxAttempts: tc.maxAttempts})
+			var final bool
+			h := newHarness(t, st, registry(map[string]worker.HandlerFunc{
+				"probe": func(ctx context.Context, _ domain.Job) error {
+					final = worker.IsFinalAttempt(ctx)
+					return nil
+				},
+			}))
+			h.start(t, context.Background())
+
+			out := h.next(t)
+			if final != tc.want {
+				t.Errorf("IsFinalAttempt on attempt %d/%d = %v, want %v", out.Job.Attempts, out.Job.MaxAttempts, final, tc.want)
+			}
+		})
+	}
+	if worker.IsFinalAttempt(context.Background()) {
+		t.Error("IsFinalAttempt outside a job = true")
+	}
+}
