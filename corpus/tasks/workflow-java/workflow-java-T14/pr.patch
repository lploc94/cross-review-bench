@@ -0,0 +1,79 @@
+package com.papertrail.workflow.api;
+
+import com.papertrail.workflow.domain.DocumentAttachment;
+import com.papertrail.workflow.service.AttachmentService;
+import com.papertrail.workflow.service.Views.AttachmentView;
+import java.io.IOException;
+import java.net.URI;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import org.springframework.http.ContentDisposition;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.MediaType;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestPart;
+import org.springframework.web.bind.annotation.RestController;
+import org.springframework.web.multipart.MultipartFile;
+
+/** Files attached to a document: upload as multipart, list, download and remove. */
+@RestController
+@RequestMapping("/api/v1/documents/{id}/attachments")
+public class AttachmentController {
+
+  private final AttachmentService attachments;
+  private final CurrentPrincipal current;
+
+  public AttachmentController(AttachmentService attachments, CurrentPrincipal current) {
+    this.attachments = attachments;
+    this.current = current;
+  }
+
+  @PostMapping(consumes = MediaType.MULTIPART_FORM_DATA_VALUE)
+  public ResponseEntity<AttachmentView> upload(
+      @PathVariable long id, @RequestPart("file") MultipartFile file) throws IOException {
+    AttachmentView view =
+        attachments.add(
+            current.require(),
+            id,
+            file.getOriginalFilename(),
+            file.getContentType(),
+            file.getBytes());
+    return ResponseEntity.created(
+            URI.create("/api/v1/documents/" + id + "/attachments/" + view.id()))
+        .body(view);
+  }
+
+  @GetMapping
+  public List<AttachmentView> list(@PathVariable long id) {
+    return attachments.list(current.require(), id);
+  }
+
+  /**
+   * The file as it was uploaded. It is always sent as a download with {@code nosniff}, so a browser
+   * neither renders it in place nor guesses another type.
+   */
+  @GetMapping("/{attachmentId}")
+  public ResponseEntity<byte[]> download(@PathVariable long id, @PathVariable long attachmentId) {
+    DocumentAttachment file = attachments.download(current.require(), id, attachmentId);
+    ContentDisposition disposition =
+        ContentDisposition.attachment()
+            .filename(file.getFileName(), StandardCharsets.UTF_8)
+            .build();
+    return ResponseEntity.ok()
+        .contentType(MediaType.parseMediaType(file.getContentType()))
+        .header(HttpHeaders.CONTENT_DISPOSITION, disposition.toString())
+        .header("X-Content-Type-Options", "nosniff")
+        .body(file.getContent());
+  }
+
+  @DeleteMapping("/{attachmentId}")
+  public ResponseEntity<Void> remove(@PathVariable long id, @PathVariable long attachmentId) {
+    attachments.remove(current.require(), id, attachmentId);
+    return ResponseEntity.noContent().build();
+  }
+}
