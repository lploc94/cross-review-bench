@@ -0,0 +1,46 @@
+package com.innkeep.booking.api;
+
+import com.innkeep.booking.api.dto.PromoCodeRequest;
+import com.innkeep.booking.api.dto.PromoCodeResponse;
+import com.innkeep.booking.domain.PromoCode;
+import com.innkeep.booking.service.PromoService;
+import jakarta.validation.Valid;
+import java.net.URI;
+import java.util.List;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+/** Admin routes for a property's promo codes: create, list, disable. */
+@RestController
+@RequestMapping("/api/v1/admin/properties/{code}/promo-codes")
+public class AdminPromoCodeController {
+
+  private final PromoService promos;
+
+  public AdminPromoCodeController(PromoService promos) {
+    this.promos = promos;
+  }
+
+  @PostMapping
+  public ResponseEntity<PromoCodeResponse> create(
+      @PathVariable String code, @Valid @RequestBody PromoCodeRequest request) {
+    PromoCode promo = promos.create(code, request.toDraft());
+    return ResponseEntity.created(URI.create("/api/v1/admin/properties/" + code + "/promo-codes"))
+        .body(PromoCodeResponse.from(promo));
+  }
+
+  @GetMapping
+  public List<PromoCodeResponse> list(@PathVariable String code) {
+    return promos.list(code).stream().map(PromoCodeResponse::from).toList();
+  }
+
+  @PostMapping("/{promoCode}/disable")
+  public PromoCodeResponse disable(@PathVariable String code, @PathVariable String promoCode) {
+    return PromoCodeResponse.from(promos.disable(code, promoCode));
+  }
+}
