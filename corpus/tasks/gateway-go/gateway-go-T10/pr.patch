@@ -0,0 +1,163 @@
+package proxy
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/relaywork/gateway/internal/auth"
+	"github.com/relaywork/gateway/internal/config"
+	"github.com/relaywork/gateway/internal/model"
+)
+
+const corsRoutes = `{"routes":[{"id":"api","path_prefix":"/api","methods":["GET","PUT"],
+	"upstreams":[{"url":"http://up.test"}],"auth":"api_key",
+	"cors":{"allow_origins":["https://app.example.com"],"allow_methods":["GET","PUT"],
+		"allow_headers":["Authorization","Content-Type"],"expose_headers":["X-Total"],"max_age":"10m"}}]}`
+
+// corsFixture serves corsRoutes; the upstream is not expected to be called by preflights.
+func corsFixture(t *testing.T, tr *fakeTransport) *fixture {
+	t.Helper()
+	modes := auth.Modes{config.AuthAPIKey: &fakeAuth{consumer: model.Consumer{ID: "c1"}}}
+	return newFixture(t, corsRoutes, fixtureOptions{transport: tr, auth: modes})
+}
+
+func preflightRequest(origin, method string) *http.Request {
+	r := httptest.NewRequest(http.MethodOptions, "/api/orders", nil)
+	r.Header.Set("Origin", origin)
+	r.Header.Set("Access-Control-Request-Method", method)
+	return r
+}
+
+func TestPreflightIsAnsweredByTheGateway(t *testing.T) {
+	f := corsFixture(t, &fakeTransport{respond: func(n int, r *http.Request) (*http.Response, error) {
+		t.Error("a preflight reached the upstream")
+		return reply(r, 200, "x"), nil
+	}})
+
+	w := f.do(preflightRequest("https://app.example.com", "PUT"))
+	h := w.Header()
+	if w.Code != http.StatusNoContent {
+		t.Fatalf("preflight status = %d, want 204 without credentials", w.Code)
+	}
+	if got := h.Get("Access-Control-Allow-Origin"); got != "https://app.example.com" {
+		t.Errorf("Access-Control-Allow-Origin = %q", got)
+	}
+	if got := h.Get("Access-Control-Allow-Methods"); got != "GET, PUT" {
+		t.Errorf("Access-Control-Allow-Methods = %q", got)
+	}
+	if got := h.Get("Access-Control-Allow-Headers"); got != "Authorization, Content-Type" {
+		t.Errorf("Access-Control-Allow-Headers = %q", got)
+	}
+	if got := h.Get("Access-Control-Max-Age"); got != "600" {
+		t.Errorf("Access-Control-Max-Age = %q, want 600", got)
+	}
+	if h.Get("X-Request-Id") == "" {
+		t.Error("preflight lacks the gateway's request id")
+	}
+}
+
+func TestPreflightFromOtherOriginGetsNoAllowFields(t *testing.T) {
+	f := corsFixture(t, &fakeTransport{respond: func(n int, r *http.Request) (*http.Response, error) {
+		t.Error("a preflight reached the upstream")
+		return reply(r, 200, "x"), nil
+	}})
+
+	w := f.do(preflightRequest("https://evil.example.net", "GET"))
+	if w.Code != http.StatusNoContent {
+		t.Fatalf("status = %d, want 204", w.Code)
+	}
+	for _, name := range []string{"Access-Control-Allow-Origin", "Access-Control-Allow-Methods", "Access-Control-Max-Age"} {
+		if v := w.Header().Get(name); v != "" {
+			t.Errorf("%s = %q for a disallowed origin", name, v)
+		}
+	}
+}
+
+func TestActualResponseGetsCORSFieldsAndDropsTheUpstreams(t *testing.T) {
+	tr := &fakeTransport{respond: func(n int, r *http.Request) (*http.Response, error) {
+		return reply(r, 200, "[]", "Access-Control-Allow-Origin", "*", "Access-Control-Allow-Credentials", "true"), nil
+	}}
+	f := corsFixture(t, tr)
+
+	r := httptest.NewRequest(http.MethodGet, "/api/orders", nil)
+	r.Header.Set("Origin", "https://app.example.com")
+	r.Header.Set("Authorization", "Bearer k")
+	w := f.do(r)
+	if w.Code != http.StatusOK {
+		t.Fatalf("status = %d", w.Code)
+	}
+	if got := w.Header().Get("Access-Control-Allow-Origin"); got != "https://app.example.com" {
+		t.Errorf("Access-Control-Allow-Origin = %q; the route's policy must replace the upstream's", got)
+	}
+	if got := w.Header().Get("Access-Control-Expose-Headers"); got != "X-Total" {
+		t.Errorf("Access-Control-Expose-Headers = %q", got)
+	}
+	if got := w.Header().Get("Access-Control-Allow-Credentials"); got != "" {
+		t.Errorf("Access-Control-Allow-Credentials = %q without allow_credentials", got)
+	}
+}
+
+func TestDisallowedOriginGetsNoAllowOriginFromTheUpstream(t *testing.T) {
+	tr := &fakeTransport{respond: func(n int, r *http.Request) (*http.Response, error) {
+		return reply(r, 200, "[]", "Access-Control-Allow-Origin", "*"), nil
+	}}
+	f := corsFixture(t, tr)
+
+	r := httptest.NewRequest(http.MethodGet, "/api/orders", nil)
+	r.Header.Set("Origin", "https://evil.example.net")
+	r.Header.Set("Authorization", "Bearer k")
+	if w := f.do(r); w.Header().Get("Access-Control-Allow-Origin") != "" {
+		t.Errorf("Access-Control-Allow-Origin = %q for a disallowed origin", w.Header().Get("Access-Control-Allow-Origin"))
+	}
+}
+
+func TestGatewayErrorsCarryCORSFields(t *testing.T) {
+	f := corsFixture(t, &fakeTransport{respond: func(n int, r *http.Request) (*http.Response, error) {
+		t.Error("an unauthenticated request reached the upstream")
+		return reply(r, 200, "x"), nil
+	}})
+	r := httptest.NewRequest(http.MethodGet, "/api/orders", nil)
+	r.Header.Set("Origin", "https://app.example.com")
+	w := f.do(r)
+	if w.Code != http.StatusUnauthorized {
+		t.Fatalf("status = %d, want 401", w.Code)
+	}
+	if got := w.Header().Get("Access-Control-Allow-Origin"); got != "https://app.example.com" {
+		t.Errorf("Access-Control-Allow-Origin on a 401 = %q; the browser must be able to read the error", got)
+	}
+}
+
+func TestWildcardOriginWithCredentialsEchoesTheOrigin(t *testing.T) {
+	const routes = `{"routes":[{"id":"open","path_prefix":"/","upstreams":[{"url":"http://up.test"}],
+		"cors":{"allow_origins":["*"],"allow_methods":["GET"],"allow_credentials":true}}]}`
+	tr := &fakeTransport{respond: func(n int, r *http.Request) (*http.Response, error) {
+		return reply(r, 200, "ok"), nil
+	}}
+	f := newFixture(t, routes, fixtureOptions{transport: tr})
+
+	r := httptest.NewRequest(http.MethodGet, "/x", nil)
+	r.Header.Set("Origin", "https://any.example.org")
+	w := f.do(r)
+	if got := w.Header().Get("Access-Control-Allow-Origin"); got != "https://any.example.org" {
+		t.Errorf("Access-Control-Allow-Origin = %q, want the origin echoed (a wildcard is not sent with credentials)", got)
+	}
+	if got := w.Header().Get("Access-Control-Allow-Credentials"); got != "true" {
+		t.Errorf("Access-Control-Allow-Credentials = %q", got)
+	}
+}
+
+func TestWildcardOriginWithoutCredentialsSendsStar(t *testing.T) {
+	const routes = `{"routes":[{"id":"open","path_prefix":"/","upstreams":[{"url":"http://up.test"}],
+		"cors":{"allow_origins":["*"],"allow_methods":["GET"]}}]}`
+	tr := &fakeTransport{respond: func(n int, r *http.Request) (*http.Response, error) {
+		return reply(r, 200, "ok"), nil
+	}}
+	f := newFixture(t, routes, fixtureOptions{transport: tr})
+
+	r := httptest.NewRequest(http.MethodGet, "/x", nil)
+	r.Header.Set("Origin", "https://any.example.org")
+	if got := f.do(r).Header().Get("Access-Control-Allow-Origin"); got != "*" {
+		t.Errorf("Access-Control-Allow-Origin = %q, want *", got)
+	}
+}
