 /**
- * HMAC-SHA256 signatures for download links. The payload of a download link is
- * `<file id>.<expiry in unix seconds>`; the signature is its lowercase hex HMAC.
+ * HMAC-SHA256 signatures for download and upload links. The payload of a download link is
+ * `<file id>.<expiry in unix seconds>`, that of an upload link `uploadPayload(grant)`; the
+ * signature is its lowercase hex HMAC.
  */
 export class UrlSigner {
   private readonly secret: string;
@@ -37,8 +38,35 @@ export class UrlSigner {
     const presented = Buffer.from(signature, "hex");
     return expected.length === presented.length && timingSafeEqual(expected, presented);
   }
+
+  signUpload(grant: UploadGrant): string {
+    return this.sign(uploadPayload(grant));
+  }
+
+  /** Whether `signature` is the one signUpload gives for exactly this grant. */
+  verifyUpload(grant: UploadGrant, signature: string): boolean {
+    const expected = this.signUpload(grant);
+    return signature === expected;
+  }
 }
 
 export function downloadPayload(fileId: string, expiresAt: number): string {
   return `${fileId}.${expiresAt}`;
 }
+
+/** What a presigned upload URL allows: one upload of `size` bytes to `path` until `expiresAt`. */
+export interface UploadGrant {
+  readonly tenantId: string;
+  readonly path: string;
+  readonly size: number;
+  readonly expiresAt: number;
+}
+
+/**
+ * The signed payload of an upload link. The `upload` prefix keeps it apart from download
+ * payloads, and the path goes last as the only free-form field; paths never contain control
+ * characters, so newline separators cannot be forged from inside one.
+ */
+export function uploadPayload(grant: UploadGrant): string {
+  return ["upload", grant.tenantId, String(grant.size), String(grant.expiresAt), grant.path].join("\n");
+}
