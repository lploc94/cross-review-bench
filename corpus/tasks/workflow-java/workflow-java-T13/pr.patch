+package com.papertrail.workflow.api;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.fasterxml.jackson.databind.node.ObjectNode;
+import com.papertrail.workflow.domain.StepKind;
+import com.papertrail.workflow.support.IntegrationTestBase;
+import com.papertrail.workflow.support.TestData;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.MvcResult;
+
+class DefinitionTransferApiTest extends IntegrationTestBase {
+
+  @Autowired private ObjectMapper json;
+
+  private long publishExpenses() {
+    long approver = data.user("Tomas Vale");
+    long a = data.user("Ines Berg");
+    long b = data.user("Marta Quill");
+    long finance = data.group("finance", a, b);
+    return data.publish(
+        "Expenses",
+        TestData.step(1, StepKind.SINGLE, approver, null, 0, 480),
+        TestData.step(2, StepKind.QUORUM, null, finance, 2, 90));
+  }
+
+  private JsonNode export(long id) throws Exception {
+    String body =
+        mvc.perform(
+                get("/api/v1/admin/definitions/" + id + "/export")
+                    .header("Authorization", ADMIN_AUTH))
+            .andExpect(status().isOk())
+            .andReturn()
+            .getResponse()
+            .getContentAsString();
+    return json.readTree(body);
+  }
+
+  private MvcResult importDefinition(String body) throws Exception {
+    return mvc.perform(
+            post("/api/v1/admin/definitions/import")
+                .header("Authorization", ADMIN_AUTH)
+                .contentType(MediaType.APPLICATION_JSON)
+                .content(body))
+        .andReturn();
+  }
+
+  @Test
+  void anExportNamesGroupsAndApproversAndWritesSlasAsDurations() throws Exception {
+    long id = publishExpenses();
+
+    JsonNode exported = export(id);
+
+    assertThat(exported.get("name").asText()).isEqualTo("Expenses");
+    assertThat(exported.get("version").asInt()).isEqualTo(1);
+    assertThat(exported.has("id")).isFalse();
+    JsonNode first = exported.get("steps").get(0);
+    assertThat(first.get("assignee").asText()).isEqualTo("tomas.vale@example.com");
+    assertThat(first.get("sla").asText()).isEqualTo("PT8H");
+    JsonNode second = exported.get("steps").get(1);
+    assertThat(second.get("group").asText()).isEqualTo("finance");
+    assertThat(second.get("quorum").asInt()).isEqualTo(2);
+    assertThat(second.get("sla").asText()).isEqualTo("PT1H30M");
+  }
+
+  @Test
+  void anImportWithoutVersionIsTheNextDraftWithTheSameSteps() throws Exception {
+    JsonNode exported = export(publishExpenses());
+    ObjectNode again = exported.deepCopy();
+    again.remove("version");
+
+    MvcResult created = importDefinition(again.toString());
+
+    assertThat(created.getResponse().getStatus()).isEqualTo(201);
+    long draft = idFrom(created);
+    mvc.perform(get("/api/v1/admin/definitions/" + draft).header("Authorization", ADMIN_AUTH))
+        .andExpect(jsonPath("$.version").value(2))
+        .andExpect(jsonPath("$.published").value(false));
+    assertThat(export(draft).get("steps")).isEqualTo(exported.get("steps"));
+  }
+
+  @Test
+  void aVersionThatAlreadyExistsIsAConflict() throws Exception {
+    JsonNode exported = export(publishExpenses());
+
+    MvcResult result = importDefinition(exported.toString());
+
+    assertThat(result.getResponse().getStatus()).isEqualTo(409);
+    assertThat(jdbc.queryForObject("select count(*) from workflow_definition", Integer.class))
+        .isEqualTo(1);
+  }
+
+  @Test
+  void aHigherVersionIsKept() throws Exception {
+    ObjectNode exported = export(publishExpenses()).deepCopy();
+    exported.put("version", 7);
+
+    long draft = idFrom(importDefinition(exported.toString()));
+
+    mvc.perform(get("/api/v1/admin/definitions/" + draft).header("Authorization", ADMIN_AUTH))
+        .andExpect(jsonPath("$.version").value(7));
+  }
+
+  @Test
+  void anUnknownGroupIsNamedAndNothingIsCreated() throws Exception {
+    String body =
+        """
+        {"name":"Contracts","steps":[
+          {"order":1,"kind":"ANY_OF","group":"legal","quorum":0,"sla":"PT4H"}]}""";
+
+    mvc.perform(
+            post("/api/v1/admin/definitions/import")
+                .header("Authorization", ADMIN_AUTH)
+                .contentType(MediaType.APPLICATION_JSON)
+                .content(body))
+        .andExpect(status().isBadRequest())
+        .andExpect(jsonPath("$.type").value("urn:workflow:problem:invalid-request"))
+        .andExpect(jsonPath("$.detail").value("unknown group legal"));
+    assertThat(jdbc.queryForObject("select count(*) from workflow_definition", Integer.class))
+        .isZero();
+  }
+
+  @Test
+  void anUnknownApproverIsRefusedWithoutEchoingTheAddress() throws Exception {
+    String body =
+        """
+        {"name":"Contracts","steps":[
+          {"order":1,"kind":"SINGLE","assignee":"nobody@example.com","quorum":0,"sla":"PT4H"}]}""";
+
+    MvcResult result = importDefinition(body);
+
+    assertThat(result.getResponse().getStatus()).isEqualTo(400);
+    assertThat(result.getResponse().getContentAsString()).doesNotContain("nobody@example.com");
+  }
+
+  @Test
+  void aNullStepIsAValidationError() throws Exception {
+    mvc.perform(
+            post("/api/v1/admin/definitions/import")
+                .header("Authorization", ADMIN_AUTH)
+                .contentType(MediaType.APPLICATION_JSON)
+                .content("{\"name\":\"Contracts\",\"steps\":[null]}"))
+        .andExpect(status().isBadRequest())
+        .andExpect(jsonPath("$.type").value("urn:workflow:problem:validation-failed"));
+    assertThat(jdbc.queryForObject("select count(*) from workflow_definition", Integer.class))
+        .isZero();
+  }
+
+  @Test
+  void anSlaMustBeWholeMinutesInRange() throws Exception {
+    data.user("Tomas Vale");
+    String template =
+        """
+        {"name":"Contracts","steps":[
+          {"order":1,"kind":"SINGLE","assignee":"tomas.vale@example.com","quorum":0,"sla":"%s"}]}""";
+
+    for (String sla : new String[] {"PT90S", "480", "PT-8H", "PT721H"}) {
+      assertThat(importDefinition(template.formatted(sla)).getResponse().getStatus())
+          .as(sla)
+          .isEqualTo(400);
+    }
+    long draft = idFrom(importDefinition(template.formatted("P1D")));
+    assertThat(export(draft).get("steps").get(0).get("sla").asText()).isEqualTo("PT24H");
+  }
+
+  @Test
+  void userTokensCannotExportOrImport() throws Exception {
+    long id = publishExpenses();
+    String user = data.bearer(data.user("Lena Hart"));
+
+    mvc.perform(get("/api/v1/admin/definitions/" + id + "/export").header("Authorization", user))
+        .andExpect(status().isUnauthorized());
+    mvc.perform(
+            post("/api/v1/admin/definitions/import")
+                .header("Authorization", user)
+                .contentType(MediaType.APPLICATION_JSON)
+                .content("{}"))
+        .andExpect(status().isUnauthorized());
+  }
+}
