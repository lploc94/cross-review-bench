+"""warehouse: indexes on run_id of the dimensions, for run history pruning
+
+Revision ID: 0005
+Revises: 0004
+Create Date: 2026-10-12 09:00:00+00:00
+"""
+
+from collections.abc import Sequence
+
+from alembic import op
+
+revision: str = "0005"
+down_revision: str | None = "0004"
+branch_labels: str | Sequence[str] | None = None
+depends_on: str | Sequence[str] | None = None
+
+
+def upgrade() -> None:
+    # `etl runs prune` looks for rows that still name a run, and deleting a run makes the
+    # server check every foreign key to it; orders already have ix_orders_run_id.
+    op.create_index("ix_products_run_id", "products", ["run_id"], schema="warehouse")
+    op.create_index("ix_customers_run_id", "customers", ["run_id"], schema="warehouse")
+
+
+def downgrade() -> None:
+    op.drop_index("ix_customers_run_id", table_name="customers", schema="warehouse")
+    op.drop_index("ix_products_run_id", table_name="products", schema="warehouse")
