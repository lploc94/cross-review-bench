+"""Reference exchange rates: load a daily rates file into `etl.fx_rates`.
+
+The file is CSV with the header `day,currency,rate_to_eur`: the ISO date, the ISO 4217 code and
+how many EUR one unit of the currency is worth that day, with a decimal point. EUR itself is
+the base and is never listed. A file is loaded whole or not at all; a rate already stored for
+a day and currency is replaced.
+"""
+
+from __future__ import annotations
+
+import csv
+import itertools
+from datetime import date
+from decimal import Context, Decimal
+from pathlib import Path
+
+from etl.api.context import AppContext
+from etl.domain.money import currency, parse_amount
+from etl.errors import SourceFileNotFound, SourceFormatError
+from etl.infra.fs import open_text
+from etl.logging import get_logger
+from etl.schemas.views import FxLoadView
+from etl.sources.base import normalise_header
+from etl.store import fx_rates
+from etl.store.fx_rates import FxRate
+
+BASE_CURRENCY = "EUR"
+# What etl.fx_rates.rate_to_eur holds: NUMERIC(20, 12).
+RATE_DECIMALS = 12
+RATE_QUANTUM = Decimal(1).scaleb(-RATE_DECIMALS)
+MAX_RATE = Decimal(10) ** 8
+RATE_CONTEXT = Context(prec=30)
+HEADER = ["day", "currency", "rate_to_eur"]
+WRITE_BATCH = 1000
+
+log = get_logger(__name__)
+
+
+def load_rates(context: AppContext, path: Path) -> FxLoadView:
+    if not path.is_file():
+        raise SourceFileNotFound(str(path))
+    rates: dict[tuple[date, str], FxRate] = {}
+    with open_text(path, "utf-8-sig") as handle:
+        reader = csv.reader(handle, strict=True)
+        try:
+            header = normalise_header(next(reader, []))
+            if header != HEADER:
+                raise SourceFormatError(f"the header must be {','.join(HEADER)}", line_no=1)
+            for values in reader:
+                if not values:
+                    continue
+                rate = _parse(values, reader.line_num)
+                key = (rate.day, rate.currency)
+                if key in rates:
+                    raise SourceFormatError(
+                        f"{rate.currency} on {rate.day} is listed twice", line_no=reader.line_num
+                    )
+                rates[key] = rate
+        except (csv.Error, UnicodeDecodeError, OSError, EOFError) as error:
+            raise SourceFormatError(f"unreadable rates file: {error}") from None
+    with context.engine.begin() as connection:
+        for batch in itertools.batched(rates.values(), WRITE_BATCH, strict=False):
+            fx_rates.upsert_many(connection, batch, loaded_at=context.clock.now())
+    days = sorted({day for day, _ in rates})
+    log.info("fx.rates_loaded", path=str(path), rates=len(rates))
+    return FxLoadView(
+        rates=len(rates),
+        first_day=days[0] if days else None,
+        last_day=days[-1] if days else None,
+        currencies=sorted({code for _, code in rates}),
+    )
+
+
+def _parse(values: list[str], line_no: int) -> FxRate:
+    if len(values) != len(HEADER):
+        raise SourceFormatError(f"expected {len(HEADER)} fields", line_no=line_no)
+    day_text, code_text, rate_text = (value.strip() for value in values)
+    try:
+        day = date.fromisoformat(day_text)
+        code = currency(code_text).code
+        rate = parse_amount(rate_text, ".")
+    except ValueError as error:
+        raise SourceFormatError(str(error), line_no=line_no) from None
+    if code == BASE_CURRENCY:
+        raise SourceFormatError("EUR is the base currency, not a rate", line_no=line_no)
+    if rate <= 0:
+        raise SourceFormatError("a rate must be positive", line_no=line_no)
+    if rate >= MAX_RATE or rate != rate.quantize(RATE_QUANTUM, context=RATE_CONTEXT):
+        raise SourceFormatError(
+            f"a rate must be below {MAX_RATE} with at most {RATE_DECIMALS} decimals",
+            line_no=line_no,
+        )
+    return FxRate(day, code, rate)
