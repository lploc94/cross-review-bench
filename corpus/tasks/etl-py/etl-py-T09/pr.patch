 class Severity(StrEnum):
@@ -211,3 +227,85 @@ class RowCountDelta:
             observed=observed,
             details=f"{_plural(current, 'row')}, {delta:.1%} change from {previous}",
         )
+
+
+@dataclass(frozen=True, slots=True, eq=False)
+class DailyTotalAnomaly:
+    """The total of `amount` over the last complete local day stays within `factor` times the
+    mean daily total of the `history_days` days before it, per value of `by` (a currency).
+
+    Days are calendar days in `zone`, like the reports. Only days that have rows count as
+    history; with fewer than `min_history_days` of them there is no baseline yet.
+    """
+
+    table: Table
+    timestamp: str
+    amount: str
+    by: str
+    zone: ZoneInfo
+    factor: Decimal
+    clock: Clock
+    severity: Severity = Severity.WARN
+    where: ColumnElement[bool] | None = None
+    history_days: int = 28
+    min_history_days: int = 7
+
+    @property
+    def name(self) -> str:
+        return f"{self.table.name}.daily_total.anomaly"
+
+    @property
+    def description(self) -> str:
+        return (
+            f"yesterday's {self.amount} per {self.by} within {self.factor}x of the mean of "
+            f"the previous {self.history_days} days"
+        )
+
+    def _daily_totals(
+        self, connection: Connection, first: date, last: date
+    ) -> dict[str, dict[date, Decimal]]:
+        """Per `by` value, the total of each local day in first..last that has rows."""
+        local_day = cast(func.timezone(self.zone.key, self.table.c[self.timestamp]), Date)
+        group = self.table.c[self.by]
+        statement = (
+            select(group, local_day.label("day"), func.sum(self.table.c[self.amount]))
+            .where(local_day.between(first, last))
+            .group_by(group, local_day)
+        )
+        if self.where is not None:
+            statement = statement.where(self.where)
+        totals: dict[str, dict[date, Decimal]] = {}
+        for key, day, total in connection.execute(statement):
+            totals.setdefault(key, {})[day] = total
+        return totals
+
+    def evaluate(self, connection: Connection, history: CheckHistory) -> CheckOutcome:
+        day = local_date(self.clock.now(), self.zone) - timedelta(days=1)
+        first = day - timedelta(days=self.history_days)
+        totals = self._daily_totals(connection, first, day)
+
+        compared: list[str] = []
+        anomalies: list[str] = []
+        for key in sorted(totals):
+            by_day = totals[key]
+            total = by_day.pop(day, Decimal(0))
+            if len(by_day) < self.min_history_days:
+                continue
+            mean = sum(by_day.values(), Decimal(0)) / len(by_day)
+            if mean <= 0:
+                continue
+            compared.append(key)
+            if total > mean * self.factor or total * self.factor < mean:
+                anomalies.append(f"{key} {total / mean:.2f}x")
+
+        if not compared:
+            details = f"{day}: fewer than {self.min_history_days} days of history"
+        elif anomalies:
+            details = f"{day}: outside {self.factor}x of the mean: {', '.join(anomalies)}"
+        else:
+            details = f"{day}: {', '.join(compared)} within {self.factor}x of the mean"
+        return CheckOutcome(
+            passed=not anomalies,
+            observed=Decimal(len(anomalies)),
+            details=details,
+        )
