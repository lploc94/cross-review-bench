diff --git a/packages/client/test/e2e/revocation.test.ts b/packages/client/test/e2e/revocation.test.ts
new file mode 100644
index 0000000..7d016b4
--- /dev/null
+++ b/packages/client/test/e2e/revocation.test.ts
@@ -0,0 +1,60 @@
+import { DeviceRevokedError, PUSH_PATH } from "@sync/client";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { openClient, type TestClient } from "../helpers/clients.js";
+import { startTestServer, type TestAccount, type TestServer } from "../helpers/testServer.js";
+
+let server: TestServer;
+let laptop: TestAccount;
+let phone: TestAccount;
+const opened: TestClient[] = [];
+
+function client(account: TestAccount): TestClient {
+  const c = openClient(server, account);
+  opened.push(c);
+  return c;
+}
+
+beforeEach(async () => {
+  server = await startTestServer();
+  laptop = await server.createUser("Ada");
+  phone = await server.addDevice(laptop);
+});
+
+afterEach(async () => {
+  for (const c of opened.splice(0)) await c.client.close();
+  await server.close();
+});
+
+describe("a revoked device", () => {
+  it("stops syncing and reports the local changes that never reached the server", async () => {
+    const lost = client(phone);
+    lost.client.set("notes", "n1", { title: "draft" });
+    lost.client.set("tasks", "t1", { title: "call back" });
+    await client(laptop).transport.revokeDevice(phone.deviceId);
+
+    const err = await lost.client.sync().catch((e: unknown) => e);
+    expect(err).toBeInstanceOf(DeviceRevokedError);
+    expect(err).toMatchObject({ code: "device_revoked", retryable: false, unsynced: 2 });
+    expect(lost.client.pendingCount()).toBe(0);
+    expect(lost.client.get("notes", "n1")?.fields).toEqual({ title: "draft" });
+    expect(await server.countEvents(laptop.userId)).toBe(0);
+    expect(lost.client.syncState().lastError).toMatchObject({ code: "device_revoked" });
+
+    const requests = lost.transport.log.length;
+    lost.client.set("notes", "n2", { title: "after" });
+    await expect(lost.client.sync()).rejects.toMatchObject({ code: "device_revoked", unsynced: 1 });
+    expect(lost.transport.log).toHaveLength(requests);
+    expect(lost.transport.count(PUSH_PATH)).toBe(1);
+  });
+
+  it("does not affect the other devices of the user", async () => {
+    const own = client(laptop);
+    const revoked = await own.transport.revokeDevice(phone.deviceId);
+    expect(revoked.device).toMatchObject({ id: phone.deviceId, revokedAt: expect.any(String) as string });
+
+    own.client.set("notes", "n1", { title: "still syncing" });
+    expect(await own.client.sync()).toMatchObject({ pushed: 1 });
+    expect((await own.transport.me()).device.revokedAt).toBeNull();
+    expect((await client(phone).transport.me()).device.revokedAt).toBe(revoked.device.revokedAt);
+  });
+});
