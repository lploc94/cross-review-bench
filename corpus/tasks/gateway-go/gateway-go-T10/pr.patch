diff --git a/internal/proxy/cors.go b/internal/proxy/cors.go
new file mode 100644
index 0000000..c7aac2b
--- /dev/null
+++ b/internal/proxy/cors.go
@@ -0,0 +1,74 @@
+package proxy
+
+import (
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/relaywork/gateway/internal/core"
+	"github.com/relaywork/gateway/internal/header"
+)
+
+// isPreflight reports whether r is a CORS preflight request: an OPTIONS request that names an
+// origin and the method of the request it precedes.
+func isPreflight(r *http.Request) bool {
+	return r.Method == http.MethodOptions &&
+		r.Header.Get("Origin") != "" &&
+		r.Header.Get("Access-Control-Request-Method") != ""
+}
+
+// preflight answers a preflight request of a route with a CORS policy. The gateway answers it
+// itself: no authentication, rate limit or upstream call stands in front of it. The allow
+// fields are sent only to an allowed origin.
+func (h *Handler) preflight(w *statusRecorder, ex *exchange) {
+	c := ex.route.CORS
+	hdr := w.Header()
+	hdr.Set(header.RequestID, ex.id)
+	hdr.Set("Vary", "Access-Control-Request-Method, Access-Control-Request-Headers")
+	if setCORS(hdr, c, ex.req.Header.Get("Origin")) {
+		if c.Methods != "" {
+			hdr.Set("Access-Control-Allow-Methods", c.Methods)
+		}
+		if c.Headers != "" {
+			hdr.Set("Access-Control-Allow-Headers", c.Headers)
+		}
+		if c.MaxAge > 0 {
+			hdr.Set("Access-Control-Max-Age", strconv.Itoa(c.MaxAge))
+		}
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// applyCORS sets the CORS fields of an actual response on h. The route's policy replaces any
+// Access-Control field the upstream sent, so an origin that is not allowed gets none.
+func applyCORS(h http.Header, ex *exchange) {
+	if ex.route == nil || ex.route.CORS == nil {
+		return
+	}
+	for name := range h {
+		if strings.HasPrefix(name, "Access-Control-") {
+			delete(h, name)
+		}
+	}
+	setCORS(h, ex.route.CORS, ex.req.Header.Get("Origin"))
+}
+
+// setCORS sets the allow-origin, credentials and expose fields for a request from origin. It
+// reports whether the origin is allowed; a request without an origin is not a CORS request.
+func setCORS(h http.Header, c *core.CORSPolicy, origin string) bool {
+	if origin == "" {
+		return false
+	}
+	value, ok := c.Allow(origin)
+	if !ok {
+		return false
+	}
+	h.Set("Access-Control-Allow-Origin", value)
+	if c.Credentials {
+		h.Set("Access-Control-Allow-Credentials", "true")
+	}
+	if c.Expose != "" {
+		h.Set("Access-Control-Expose-Headers", c.Expose)
+	}
+	return true
+}
