+package com.innkeep.booking.api.dto;
+
+import com.innkeep.booking.domain.DisplayRate;
+import com.innkeep.booking.domain.Money;
+import com.innkeep.booking.domain.PriceLine;
+import java.math.BigDecimal;
+import java.util.List;
+
+/** A price shown in another currency at an indicative rate, each amount converted on its own. */
+public record DisplayPriceResponse(
+    String currency,
+    BigDecimal rate,
+    boolean indicative,
+    BigDecimal total,
+    List<PriceLineResponse> lines) {
+
+  public static DisplayPriceResponse of(DisplayRate rate, Money total, List<PriceLine> lines) {
+    return new DisplayPriceResponse(
+        rate.to().getCurrencyCode(),
+        rate.rate(),
+        true,
+        rate.convert(total.amount()),
+        lines.stream()
+            .map(
+                line ->
+                    new PriceLineResponse(
+                        line.getKind().name(),
+                        line.getNight(),
+                        line.getDescription(),
+                        rate.convert(line.getAmount())))
+            .toList());
+  }
+}
