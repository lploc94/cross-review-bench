+package com.innkeep.booking.domain;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.FetchType;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.JoinColumn;
+import jakarta.persistence.ManyToOne;
+import jakarta.persistence.Table;
+import jakarta.persistence.Version;
+import java.time.LocalDate;
+
+/**
+ * Rooms of one type kept for a sales channel on one night. Until the release day ({@code
+ * releaseDays} before the night, property-local) the rooms are out of public sale; from that day on
+ * they are sold like any other room. The release day is stored so queries can compare it.
+ */
+@Entity
+@Table(name = "allotment")
+public class Allotment extends AbstractEntity<Long> {
+
+  @Id
+  @GeneratedValue(strategy = GenerationType.IDENTITY)
+  private Long id;
+
+  @ManyToOne(fetch = FetchType.LAZY, optional = false)
+  @JoinColumn(name = "room_type_id", nullable = false)
+  private RoomType roomType;
+
+  @Column(nullable = false, length = 32)
+  private String channel;
+
+  @Column(nullable = false)
+  private LocalDate night;
+
+  @Column(nullable = false)
+  private int rooms;
+
+  @Column(name = "release_on", nullable = false)
+  private LocalDate releaseOn;
+
+  @Version private Long version;
+
+  protected Allotment() {}
+
+  public Allotment(RoomType roomType, String channel, LocalDate night, int rooms, int releaseDays) {
+    this.roomType = roomType;
+    this.channel = channel;
+    this.night = night;
+    set(rooms, releaseDays);
+  }
+
+  @Override
+  public Long getId() {
+    return id;
+  }
+
+  public void set(int rooms, int releaseDays) {
+    if (rooms < 0 || releaseDays < 0) {
+      throw new ValidationException("rooms and release days cannot be negative");
+    }
+    this.rooms = rooms;
+    this.releaseOn = night.minusDays(releaseDays);
+  }
+
+  /** Released from the release day on: the rooms are then for public sale. */
+  public boolean isReleased(LocalDate today) {
+    return !today.isBefore(releaseOn);
+  }
+
+  /** Takes up to {@code wanted} of the kept rooms and returns how many it took. */
+  public int take(int wanted) {
+    int taken = Math.min(wanted, rooms);
+    rooms -= taken;
+    return taken;
+  }
+}
