diff --git a/internal/proxy/tls_test.go b/internal/proxy/tls_test.go
new file mode 100644
index 0000000..7c6ffe6
--- /dev/null
+++ b/internal/proxy/tls_test.go
@@ -0,0 +1,309 @@
+package proxy
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"math/big"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/relaywork/gateway/internal/config"
+)
+
+// tlsCA is a certificate authority that signs the upstream and client certificates of a test.
+type tlsCA struct {
+	cert *x509.Certificate
+	key  *ecdsa.PrivateKey
+	pem  []byte
+}
+
+// tlsFiles are a certificate and its key in PEM, as the routes file names them.
+type tlsFiles struct{ cert, key []byte }
+
+// certValid is the validity of every certificate a test makes; it is fixed, so the tests do not
+// depend on the date.
+var certValid = []time.Time{time.Date(2000, 1, 1, 0, 0, 0, 0, time.UTC), time.Date(2100, 1, 1, 0, 0, 0, 0, time.UTC)}
+
+func newTLSCA(t *testing.T, name string) *tlsCA {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tmpl := &x509.Certificate{
+		SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: name},
+		NotBefore: certValid[0], NotAfter: certValid[1],
+		IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cert, err := x509.ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &tlsCA{cert: cert, key: key, pem: pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})}
+}
+
+// issue signs a certificate for name, usable as a server (127.0.0.1) or as a client.
+func (ca *tlsCA) issue(t *testing.T, name string, usage x509.ExtKeyUsage) tlsFiles {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tmpl := &x509.Certificate{
+		SerialNumber: big.NewInt(2), Subject: pkix.Name{CommonName: name},
+		NotBefore: certValid[0], NotAfter: certValid[1],
+		KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{usage},
+		IPAddresses: []net.IP{net.IPv4(127, 0, 0, 1)},
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, ca.cert, &key.PublicKey, ca.key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keyDER, err := x509.MarshalECPrivateKey(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return tlsFiles{
+		cert: pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}),
+		key:  pem.EncodeToMemory(&pem.Block{Type: "EC PRIVATE KEY", Bytes: keyDER}),
+	}
+}
+
+// write stores the files in a new directory and returns the paths of the certificate and key.
+func (f tlsFiles) write(t *testing.T, name string) (certPath, keyPath string) {
+	t.Helper()
+	return writeFile(t, name+".crt", f.cert), writeFile(t, name+".key", f.key)
+}
+
+// writeFile stores data in a new temporary directory and returns the path.
+func writeFile(t *testing.T, name string, data []byte) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), name)
+	if err := os.WriteFile(path, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+// mtlsUpstream serves https with h and requires a client certificate signed by ca.
+func mtlsUpstream(t *testing.T, ca *tlsCA, h http.Handler) *httptest.Server {
+	t.Helper()
+	srv := httptest.NewUnstartedServer(h)
+	pair := ca.issue(t, "upstream", x509.ExtKeyUsageServerAuth)
+	cert, err := tls.X509KeyPair(pair.cert, pair.key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pool := x509.NewCertPool()
+	pool.AddCert(ca.cert)
+	srv.TLS = &tls.Config{Certificates: []tls.Certificate{cert}, ClientCAs: pool, ClientAuth: tls.RequireAndVerifyClientCert}
+	srv.StartTLS()
+	t.Cleanup(srv.Close)
+	return srv
+}
+
+// greeter answers with the name of the client certificate the gateway presented.
+var greeter = http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+	w.Write([]byte("hello " + r.TLS.PeerCertificates[0].Subject.CommonName))
+})
+
+func TestUpstreamTLSPresentsTheClientCertificate(t *testing.T) {
+	ca := newTLSCA(t, "gateway test CA")
+	srv := mtlsUpstream(t, ca, greeter)
+	client := ca.issue(t, "gateway", x509.ExtKeyUsageClientAuth)
+	certPath, keyPath := client.write(t, "client")
+	caPath := writeFile(t, "ca.pem", ca.pem)
+
+	routes := `{"routes":[{"id":"secure","path_prefix":"/","upstreams":[{"url":"` + srv.URL + `"}],
+		"tls":{"ca_file":"` + caPath + `","cert_file":"` + certPath + `","key_file":"` + keyPath + `"}}]}`
+	f := newFixture(t, routes, fixtureOptions{transport: &http.Transport{}})
+	if w := f.get("/x"); w.Code != http.StatusOK || w.Body.String() != "hello gateway" {
+		t.Fatalf("status %d, body %q; the gateway must present its client certificate", w.Code, w.Body.String())
+	}
+}
+
+// TestUpstreamTLSAcceptsAKeyAfterECParameters: openssl ecparam -genkey writes an EC PARAMETERS
+// block before the key, and the key file is still a valid one.
+func TestUpstreamTLSAcceptsAKeyAfterECParameters(t *testing.T) {
+	ca := newTLSCA(t, "gateway test CA")
+	srv := mtlsUpstream(t, ca, greeter)
+	client := ca.issue(t, "gateway", x509.ExtKeyUsageClientAuth)
+	params := pem.EncodeToMemory(&pem.Block{Type: "EC PARAMETERS", Bytes: []byte{0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07}})
+	client.key = append(params, client.key...)
+	certPath, keyPath := client.write(t, "client")
+	caPath := writeFile(t, "ca.pem", ca.pem)
+
+	routes := `{"routes":[{"id":"secure","path_prefix":"/","upstreams":[{"url":"` + srv.URL + `"}],
+		"tls":{"ca_file":"` + caPath + `","cert_file":"` + certPath + `","key_file":"` + keyPath + `"}}]}`
+	f := newFixture(t, routes, fixtureOptions{transport: &http.Transport{}})
+	if w := f.get("/x"); w.Code != http.StatusOK || w.Body.String() != "hello gateway" {
+		t.Fatalf("status %d, body %q; want the client certificate presented", w.Code, w.Body.String())
+	}
+}
+
+// TestUpstreamTLSTransportsKeepTheirOwnConfig: a transport that sets up HTTP/2 writes to its TLS
+// configuration, so the route's compiled settings, which the health checks share, must not be
+// the one it writes to. The URL's scheme is upper case, which is still https.
+func TestUpstreamTLSTransportsKeepTheirOwnConfig(t *testing.T) {
+	ca := newTLSCA(t, "gateway test CA")
+	srv := mtlsUpstream(t, ca, greeter)
+	client := ca.issue(t, "gateway", x509.ExtKeyUsageClientAuth)
+	certPath, keyPath := client.write(t, "client")
+	caPath := writeFile(t, "ca.pem", ca.pem)
+
+	upstream := "HTTPS" + strings.TrimPrefix(srv.URL, "https")
+	routes := `{"routes":[{"id":"secure","path_prefix":"/","upstreams":[{"url":"` + upstream + `"}],
+		"tls":{"ca_file":"` + caPath + `","cert_file":"` + certPath + `","key_file":"` + keyPath + `"},
+		"health_check":{"path":"/healthz","interval":"5s"}}]}`
+	f := newFixture(t, routes, fixtureOptions{transport: &http.Transport{ForceAttemptHTTP2: true}})
+	if w := f.get("/x"); w.Code != http.StatusOK || w.Body.String() != "hello gateway" {
+		t.Fatalf("status %d, body %q", w.Code, w.Body.String())
+	}
+	if protos := f.rt.Table().Routes()[0].TLS.Config.NextProtos; len(protos) != 0 {
+		t.Fatalf("the route's TLS settings were changed by a transport: NextProtos %q", protos)
+	}
+}
+
+func TestUpstreamTLSRejectsAnUnknownCA(t *testing.T) {
+	ca := newTLSCA(t, "upstream CA")
+	srv := mtlsUpstream(t, ca, greeter)
+	other := newTLSCA(t, "other CA")
+	client := ca.issue(t, "gateway", x509.ExtKeyUsageClientAuth)
+	certPath, keyPath := client.write(t, "client")
+	otherCA := writeFile(t, "other.pem", other.pem)
+
+	routes := `{"routes":[{"id":"secure","path_prefix":"/","upstreams":[{"url":"` + srv.URL + `"}],
+		"tls":{"ca_file":"` + otherCA + `","cert_file":"` + certPath + `","key_file":"` + keyPath + `"}}]}`
+	f := newFixture(t, routes, fixtureOptions{transport: &http.Transport{}})
+	if w := f.get("/x"); w.Code != http.StatusBadGateway {
+		t.Fatalf("status %d, want 502 for a server certificate the route's CA does not sign", w.Code)
+	}
+}
+
+func TestUpstreamTLSFilesAreCheckedAtLoad(t *testing.T) {
+	routes := `{"routes":[{"id":"secure","path_prefix":"/","upstreams":[{"url":"https://127.0.0.1:1"}],
+		"tls":{"ca_file":"/does/not/exist.pem"}}]}`
+	_, err := tryFixture(t, routes, fixtureOptions{transport: &http.Transport{}})
+	if err == nil || !strings.Contains(err.Error(), `route "secure": tls.ca_file:`) {
+		t.Fatalf("error = %v, want the route and field named", err)
+	}
+}
+
+func TestUpstreamTLSRotatesTheClientCertificateOnReload(t *testing.T) {
+	ca := newTLSCA(t, "gateway test CA")
+	srv := mtlsUpstream(t, ca, greeter)
+	first := ca.issue(t, "gateway", x509.ExtKeyUsageClientAuth)
+	certPath, keyPath := first.write(t, "client")
+	caPath := writeFile(t, "ca.pem", ca.pem)
+
+	routes := `{"routes":[{"id":"secure","path_prefix":"/","upstreams":[{"url":"` + srv.URL + `"}],
+		"tls":{"ca_file":"` + caPath + `","cert_file":"` + certPath + `","key_file":"` + keyPath + `"}}]}`
+	f := newFixture(t, routes, fixtureOptions{transport: &http.Transport{}})
+	if w := f.get("/x"); w.Body.String() != "hello gateway" {
+		t.Fatalf("before reload: %d %q", w.Code, w.Body.String())
+	}
+
+	// Rotate the client certificate on the same paths, then reload the unchanged routes file.
+	rotated := ca.issue(t, "gateway-rotated", x509.ExtKeyUsageClientAuth)
+	if err := os.WriteFile(certPath, rotated.cert, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(keyPath, rotated.key, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	parsed, err := config.ParseRoutes([]byte(routes))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := f.rt.Apply(parsed); err != nil {
+		t.Fatal(err)
+	}
+	if w := f.get("/x"); w.Code != http.StatusOK || w.Body.String() != "hello gateway-rotated" {
+		t.Fatalf("after reload: %d %q; the rotated certificate must be presented", w.Code, w.Body.String())
+	}
+}
+
+func TestUpstreamTLSKeyFileErrorsNameTheField(t *testing.T) {
+	ca := newTLSCA(t, "gateway test CA")
+	client := ca.issue(t, "gateway", x509.ExtKeyUsageClientAuth)
+	certPath, _ := client.write(t, "client")
+	caPath := writeFile(t, "ca.pem", ca.pem)
+	garbage := writeFile(t, "garbage.key", []byte("not a key"))
+
+	routes := `{"routes":[{"id":"secure","path_prefix":"/","upstreams":[{"url":"https://127.0.0.1:1"}],
+		"tls":{"ca_file":"` + caPath + `","cert_file":"` + certPath + `","key_file":"` + garbage + `"}}]}`
+	_, err := tryFixture(t, routes, fixtureOptions{transport: &http.Transport{}})
+	if err == nil || !strings.Contains(err.Error(), `route "secure": tls.key_file: no PEM private key`) {
+		t.Fatalf("error = %v, want the key file named", err)
+	}
+}
+
+// TestUpstreamTLSHealthChecksUseTheRouteSettings checks that the checks of an mTLS upstream
+// present the client certificate and do not follow redirects: a /healthz that redirects to a
+// failing page is a failed check, and a healthy upstream stays healthy.
+func TestUpstreamTLSHealthChecksUseTheRouteSettings(t *testing.T) {
+	ca := newTLSCA(t, "gateway test CA")
+	probes := make(chan string, 8)
+	srv := mtlsUpstream(t, ca, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		probes <- r.URL.Path
+		switch r.URL.Path {
+		case "/healthz":
+			http.Redirect(w, r, "/boom", http.StatusFound)
+		case "/boom":
+			http.Error(w, "boom", http.StatusInternalServerError)
+		default:
+			w.Write([]byte("ok"))
+		}
+	}))
+	client := ca.issue(t, "gateway", x509.ExtKeyUsageClientAuth)
+	certPath, keyPath := client.write(t, "client")
+	caPath := writeFile(t, "ca.pem", ca.pem)
+
+	routes := `{"routes":[{"id":"secure","path_prefix":"/","upstreams":[{"url":"` + srv.URL + `"}],
+		"tls":{"ca_file":"` + caPath + `","cert_file":"` + certPath + `","key_file":"` + keyPath + `"},
+		"health_check":{"path":"/healthz","interval":"5s"}}]}`
+	f := newFixture(t, routes, fixtureOptions{transport: &http.Transport{}})
+	select {
+	case got := <-probes:
+		if got != "/healthz" {
+			t.Fatalf("first probe = %q, want /healthz", got)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("no health probe reached the upstream")
+	}
+	// The verdict is recorded once the checker waits on the clock for its next probe.
+	waiting := make(chan struct{})
+	go func() {
+		f.rtClock.BlockUntil(1)
+		close(waiting)
+	}()
+	select {
+	case <-waiting:
+	case <-time.After(10 * time.Second):
+		t.Fatal("the checker did not record its probe")
+	}
+	select {
+	case p := <-probes:
+		t.Fatalf("the redirect was followed to %q", p)
+	default:
+	}
+	u := f.rt.Table().Routes()[0].Upstreams[0]
+	if !u.Healthy() {
+		t.Fatal("an upstream answering its health path with a redirect was marked unhealthy")
+	}
+}
diff --git a/internal/proxy/transports.go b/internal/proxy/transports.go
new file mode 100644
index 0000000..8f6259d
--- /dev/null
+++ b/internal/proxy/transports.go
@@ -0,0 +1,83 @@
+package proxy
+
+import (
+	"errors"
+	"net/http"
+	"sync"
+
+	"github.com/relaywork/gateway/internal/core"
+)
+
+// errNoTLSBase is the failure of a route with TLS settings when the gateway's transport is not an
+// *http.Transport, which the TLS transports are cloned from.
+var errNoTLSBase = errors.New("upstream TLS needs an *http.Transport to clone")
+
+// upstreamTransports chooses the transport of each attempt. A route without TLS settings uses the
+// gateway's transport. A route with settings uses a clone of it with those settings, shared by
+// the routes whose settings are equal.
+type upstreamTransports struct {
+	plain http.RoundTripper
+	base  *http.Transport // plain, when it is an *http.Transport
+
+	mu    sync.Mutex
+	byKey map[string]*http.Transport
+	seen  *core.Table // the table the transports were last swept against
+}
+
+func newUpstreamTransports(plain http.RoundTripper) *upstreamTransports {
+	base, _ := plain.(*http.Transport)
+	return &upstreamTransports{plain: plain, base: base, byKey: make(map[string]*http.Transport)}
+}
+
+// forRoute returns the transport for an attempt on route. table is the live route table: when it
+// has changed since the last call, the transports no route of it uses close their idle connections
+// and are forgotten.
+func (u *upstreamTransports) forRoute(route *core.Route, table *core.Table) http.RoundTripper {
+	if route.TLS == nil {
+		return u.plain
+	}
+	if u.base == nil {
+		return failingTransport{errNoTLSBase}
+	}
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	if table != u.seen {
+		u.sweep(table)
+	}
+	t := u.byKey[route.TLS.Key]
+	if t == nil {
+		t = u.base.Clone()
+		// Each transport gets its own copy: a transport writes to its TLS configuration when it
+		// sets up HTTP/2, and health checks of the route use the same settings.
+		t.TLSClientConfig = route.TLS.Config.Clone()
+		u.byKey[route.TLS.Key] = t
+	}
+	return t
+}
+
+// sweep forgets the transports of settings that no route of table uses. The caller holds mu.
+func (u *upstreamTransports) sweep(table *core.Table) {
+	u.seen = table
+	inUse := make(map[string]bool)
+	for _, r := range table.Routes() {
+		if r.TLS != nil {
+			inUse[r.TLS.Key] = true
+		}
+	}
+	for key, t := range u.byKey {
+		if !inUse[key] {
+			t.CloseIdleConnections()
+			delete(u.byKey, key)
+		}
+	}
+}
+
+// failingTransport fails every request with err, as a transport that cannot be built does.
+type failingTransport struct{ err error }
+
+func (f failingTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	if r.Body != nil {
+		r.Body.Close()
+	}
+	return nil, f.err
+}
