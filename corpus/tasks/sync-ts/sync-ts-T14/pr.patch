@@ -0,0 +1,19 @@
+import { EXPORT_CONTENT_TYPE } from "@sync/shared";
+import type { FastifyInstance } from "fastify";
+import { authOf } from "../plugins/auth.js";
+import { serializeDocument } from "../serializers.js";
+import type { RouteOptions } from "./types.js";
+
+/** `/v1/export`: every document of the caller's user, streamed as newline-delimited JSON. */
+export async function exportRoutes(app: FastifyInstance, options: RouteOptions): Promise<void> {
+  const { documentExport } = options.services;
+
+  // No HEAD twin: it would read the whole export only to discard it.
+  app.get("/export", { exposeHeadRoute: false }, async (request, reply) => {
+    const stream = await documentExport.open(
+      authOf(request),
+      (doc) => ({ type: "document", ...serializeDocument(doc) }),
+    );
+    return reply.type(EXPORT_CONTENT_TYPE).header("cache-control", "no-store").send(stream);
+  });
+}
