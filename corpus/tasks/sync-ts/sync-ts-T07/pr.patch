+const V2_FIELDS = `
+  -- One row per field of a document: its value as JSON and the HLC of the write that set it.
+  CREATE TABLE doc_fields (
+    collection TEXT NOT NULL,
+    doc_id     TEXT NOT NULL,
+    field      TEXT NOT NULL,
+    value      TEXT NOT NULL,
+    hlc        TEXT NOT NULL,
+    PRIMARY KEY (collection, doc_id, field)
+  ) WITHOUT ROWID;
+`;
+
+interface V1DocRow {
+  collection: string;
+  id: string;
+  fields: string;
+  field_hlcs: string;
+}
+
+/** Copy every field of the version 1 JSON columns of `docs` into `doc_fields`. */
+function copyFieldsToRows(db: SqliteDatabase): void {
+  const rows = db.prepare<[], V1DocRow>("SELECT collection, id, fields, field_hlcs FROM docs ORDER BY collection, id").all();
+  const insert = db.prepare<[string, string, string, string, string]>(
+    "INSERT INTO doc_fields (collection, doc_id, field, value, hlc) VALUES (?, ?, ?, ?, ?)",
+  );
+  for (const row of rows) {
+    const where = `document ${row.collection}/${row.id}`;
+    const fields = parseJsonObject<unknown>(row.fields, `fields of ${where}`);
+    const hlcs = parseJsonObject<unknown>(row.field_hlcs, `field timestamps of ${where}`);
+    for (const [field, value] of Object.entries(fields)) {
+      const hlc = Object.hasOwn(hlcs, field) ? hlcs[field] : undefined;
+      if (typeof hlc !== "string") throw new CorruptStoreError(`${where} has no timestamp for field ${field}`);
+      insert.run(row.collection, row.id, field, JSON.stringify(value), hlc);
+    }
+  }
+}
