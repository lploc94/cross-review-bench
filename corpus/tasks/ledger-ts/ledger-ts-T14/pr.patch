+++ b/src/repositories/currencies.ts
@@ -0,0 +1,30 @@
+import type { Queryable } from "../db/pool.js";
+import { toCurrencyCode, type Currency, type CurrencyCode } from "../domain/currency.js";
+import { firstRow } from "./mapping.js";
+
+interface CurrencyRow {
+  code: string;
+  exponent: number;
+  name: string;
+}
+
+const COLUMNS = "code, exponent, name";
+
+function mapCurrency(row: CurrencyRow): Currency {
+  return { code: toCurrencyCode(row.code), exponent: row.exponent, name: row.name };
+}
+
+/** Every currency of the reference table, by code. */
+export async function listCurrencies(db: Queryable): Promise<Currency[]> {
+  const result = await db.query<CurrencyRow>(`SELECT ${COLUMNS} FROM currencies ORDER BY code`);
+  return result.rows.map(mapCurrency);
+}
+
+export async function findCurrency(db: Queryable, code: CurrencyCode): Promise<Currency | null> {
+  const result = await db.query<CurrencyRow>(
+    `SELECT ${COLUMNS} FROM currencies WHERE code = $1`,
+    [code],
+  );
+  const row = firstRow(result.rows);
+  return row ? mapCurrency(row) : null;
+}
