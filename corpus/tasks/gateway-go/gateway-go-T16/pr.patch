@@ -0,0 +1,64 @@
+package proxy
+
+import (
+	"net/http"
+	"testing"
+
+	"github.com/relaywork/gateway/internal/core"
+)
+
+// TestFailingUpstreamIsEjectedByForwarding sends requests through the handler: the upstream that
+// answers 502 is tried until its consecutive failures eject it, and then sees no more traffic.
+func TestFailingUpstreamIsEjectedByForwarding(t *testing.T) {
+	calls := map[string]int{}
+	tr := &fakeTransport{respond: func(_ int, r *http.Request) (*http.Response, error) {
+		calls[r.URL.Host]++
+		if r.URL.Host == "a.test" {
+			return reply(r, http.StatusBadGateway, "down"), nil
+		}
+		return reply(r, http.StatusOK, "up"), nil
+	}}
+	f := newFixture(t, `{"routes":[{"id":"p","path_prefix":"/p",
+	  "upstreams":[{"url":"http://a.test"},{"url":"http://b.test"}],
+	  "passive_health":{"consecutive_failures":2,"ejection":"1m","max_ejected_percent":50}}]}`,
+		fixtureOptions{transport: tr})
+	for range 6 {
+		f.get("/p/x")
+	}
+	if calls["a.test"] != 2 {
+		t.Fatalf("a.test saw %d requests; want 2, then ejected", calls["a.test"])
+	}
+	if w := f.get("/p/x"); w.Code != http.StatusOK {
+		t.Fatalf("status %d while a.test is ejected; want 200", w.Code)
+	}
+}
+
+// TestRetryPrefersHealthyUpstreamOverEjected: on a retry the healthy upstream already tried is
+// used again before an ejected one is picked; panic routing only applies when nothing healthy is
+// left.
+func TestRetryPrefersHealthyUpstreamOverEjected(t *testing.T) {
+	calls := map[string]int{}
+	tr := &fakeTransport{respond: func(n int, r *http.Request) (*http.Response, error) {
+		calls[r.URL.Host]++
+		switch {
+		case r.URL.Host == "b.test":
+			return reply(r, http.StatusInternalServerError, "down"), nil
+		case calls["a.test"] == 1:
+			return reply(r, http.StatusBadGateway, "retry me"), nil
+		}
+		return reply(r, http.StatusOK, "up"), nil
+	}}
+	f := newFixture(t, `{"routes":[{"id":"p","path_prefix":"/p",
+	  "upstreams":[{"url":"http://a.test"},{"url":"http://b.test"}],
+	  "retry":{"attempts":3},
+	  "passive_health":{"consecutive_failures":2,"ejection":"1m","max_ejected_percent":50}}]}`,
+		fixtureOptions{transport: tr})
+	route, _ := f.rt.Table().Route("p")
+	b := route.Upstreams[1]
+	b.Report(core.Failure)
+	b.Report(core.Failure)
+	w := f.get("/p/x")
+	if w.Code != http.StatusOK || calls["b.test"] != 0 {
+		t.Fatalf("status %d, calls %v; want 200 from a.test and no call to the ejected b.test", w.Code, calls)
+	}
+}
