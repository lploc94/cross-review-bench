index 0000000..a83e9e3
--- /dev/null
+++ b/packages/client/test/e2e/export.test.ts
@@ -0,0 +1,82 @@
+import { existsSync, readFileSync } from "node:fs";
+import type { AddressInfo } from "node:net";
+import { HttpError, HttpTransport, InvalidResponseError, NetworkError } from "@sync/client";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { exportToFile } from "../../src/cli/exportFile.js";
+import { main } from "../../src/cli/main.js";
+import { openClient } from "../helpers/clients.js";
+import { tempDbPath } from "../helpers/tempFiles.js";
+import { startTestServer, type TestAccount, type TestServer } from "../helpers/testServer.js";
+
+let server: TestServer;
+let ada: TestAccount;
+let baseUrl: string;
+
+beforeEach(async () => {
+  server = await startTestServer();
+  ada = await server.createUser("Ada");
+  await server.app.listen({ port: 0, host: "127.0.0.1" });
+  baseUrl = `http://127.0.0.1:${(server.app.server.address() as AddressInfo).port}`;
+});
+
+afterEach(async () => {
+  await server.close();
+});
+
+const DOC_HLC = "001894701600000:00000:laptop-1";
+
+function line(value: unknown): string {
+  return `${JSON.stringify(value)}\n`;
+}
+
+function doc(id: string) {
+  return { type: "document", collection: "notes", id, fields: { title: id }, fieldHlcs: { title: DOC_HLC }, updatedSeq: 1, updatedAt: "2026-10-19T08:00:00.000Z" };
+}
+
+/** A transport whose export answer is `parts`, then `ending` (a clean end or an error). */
+function transportAnswering(parts: string[], ending: Error | null = null): HttpTransport {
+  const body = new ReadableStream<Uint8Array>({
+    start(controller) {
+      for (const part of parts) controller.enqueue(new TextEncoder().encode(part));
+      if (ending) controller.error(ending);
+      else controller.close();
+    },
+  });
+  return new HttpTransport({ baseUrl: "http://sync.example.test", token: "sd_x", fetch: async () => new Response(body) });
+}
+
+describe("syncctl export", () => {
+  it("writes the user's documents to the file, one per line", async () => {
+    const laptop = openClient(server, ada);
+    laptop.client.set("tasks", "t1", { title: "Book train", priority: 2 });
+    laptop.client.set("notes", "n1", { title: "Trip", tags: ["travel"] });
+    laptop.client.set("notes", "n2", { title: "Packing" });
+    await laptop.client.sync();
+    await laptop.client.close();
+
+    const file = tempDbPath("export.ndjson");
+    const out: string[] = [];
+    const env = { SYNC_DB: tempDbPath(), SYNC_SERVER_URL: baseUrl, SYNC_TOKEN: ada.token };
+    const code = await main(["export", file], env, { out: (l) => out.push(l), err: (l) => out.push(l) });
+    expect({ code, out }).toEqual({ code: 0, out: [`exported 3 documents to ${file}`] });
+    const docs = readFileSync(file, "utf8").trimEnd().split("\n").map((l) => JSON.parse(l) as Record<string, unknown>);
+    expect(docs.map((d) => `${String(d.collection)}/${String(d.id)}`)).toEqual(["notes/n1", "notes/n2", "tasks/t1"]);
+    expect(docs[0]).toMatchObject({ type: "document", fields: { title: "Trip", tags: ["travel"] } });
+    expect(existsSync(`${file}.partial`)).toBe(false);
+  });
+
+  it("reports a rejected token", async () => {
+    const transport = new HttpTransport({ baseUrl, token: `${ada.token}x` });
+    await expect(exportToFile(transport.exportDocuments(), tempDbPath("export.ndjson"))).rejects.toBeInstanceOf(HttpError);
+  });
+
+  it.each([
+    ["cut off in transfer", [line(doc("n1"))], new TypeError("terminated"), NetworkError],
+    ["without its end line", [line(doc("n1")), line(doc("n2"))], null, InvalidResponseError],
+    ["with another count than it sent", [line(doc("n1")), line({ type: "end", documents: 2 })], null, InvalidResponseError],
+  ])("leaves no file for an export %s", async (_case, parts, ending, error) => {
+    const file = tempDbPath("export.ndjson");
+    await expect(exportToFile(transportAnswering(parts, ending).exportDocuments(), file)).rejects.toBeInstanceOf(error);
+    expect(existsSync(file) || existsSync(`${file}.partial`)).toBe(false);
+  });
+});
