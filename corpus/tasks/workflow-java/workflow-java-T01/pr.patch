+-- A user hands their approval tasks to another user for a period of days (both inclusive, in the
+-- business calendar's zone).
+CREATE TABLE delegation (
+    id           BIGSERIAL PRIMARY KEY,
+    delegator_id BIGINT      NOT NULL REFERENCES app_user (id),
+    delegate_id  BIGINT      NOT NULL REFERENCES app_user (id),
+    starts_on    DATE        NOT NULL,
+    ends_on      DATE        NOT NULL,
+    created_at   TIMESTAMPTZ NOT NULL,
+    CHECK (delegator_id <> delegate_id),
+    CHECK (ends_on >= starts_on)
+);
+CREATE INDEX delegation_delegator ON delegation (delegator_id, ends_on);
+CREATE INDEX delegation_delegate ON delegation (delegate_id, ends_on);
+
+-- Who recorded a decision, and for whom when it was a delegate.
+ALTER TABLE approval_task ADD COLUMN decided_by BIGINT REFERENCES app_user (id);
+ALTER TABLE approval_task ADD COLUMN on_behalf_of BIGINT REFERENCES app_user (id);
diff --git a/src/test/java/com/papertrail/workflow/api/DelegationApiTest.java b/src/test/java/com/papertrail/workflow/api/DelegationApiTest.java
new file mode 100644
index 0000000..70c4002
--- /dev/null
+++ b/src/test/java/com/papertrail/workflow/api/DelegationApiTest.java
@@ -0,0 +1,132 @@
+package com.papertrail.workflow.api;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.delete;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.papertrail.workflow.domain.StepKind;
+import com.papertrail.workflow.service.DocumentService;
+import com.papertrail.workflow.support.IntegrationTestBase;
+import com.papertrail.workflow.support.TestData;
+import java.time.Instant;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.ResultActions;
+
+/** Delegations: who may create them, what the delegate may do, and when. The clock is Monday. */
+class DelegationApiTest extends IntegrationTestBase {
+
+  private static final String AUTH = "Authorization";
+
+  @Autowired private DocumentService documents;
+
+  private long owner;
+  private long approver;
+  private long delegate;
+  private long document;
+
+  @BeforeEach
+  void setUp() {
+    owner = data.user("Ines Berg");
+    approver = data.user("Tomas Vale");
+    delegate = data.user("Lena Hart");
+    data.publish("Contract", TestData.step(1, StepKind.SINGLE, approver, null, 0, 480));
+    document = data.draft(data.principal(owner), "Contract", "Supplier contract");
+    documents.submit(data.principal(owner), document);
+  }
+
+  private ResultActions delegate(long actor, String body) throws Exception {
+    return mvc.perform(
+        post("/api/v1/delegations")
+            .header(AUTH, data.bearer(actor))
+            .contentType(MediaType.APPLICATION_JSON)
+            .content(body));
+  }
+
+  private String period(String from, String until) {
+    return "{\"delegateId\":%d,\"from\":\"%s\",\"until\":\"%s\"}".formatted(delegate, from, until);
+  }
+
+  private ResultActions decideAsDelegate() throws Exception {
+    return mvc.perform(
+        post("/api/v1/tasks/" + taskOf(document, approver) + "/decision")
+            .header(AUTH, data.bearer(delegate))
+            .contentType(MediaType.APPLICATION_JSON)
+            .content("{\"decision\":\"APPROVE\"}"));
+  }
+
+  @Test
+  void aDelegateDecidesTheDelegatorsTaskOnTheirBehalf() throws Exception {
+    delegate(approver, period("2027-05-03", "2027-05-07"))
+        .andExpect(status().isCreated())
+        .andExpect(jsonPath("$.delegatorId").value(approver));
+
+    mvc.perform(get("/api/v1/documents/" + document).header(AUTH, data.bearer(delegate)))
+        .andExpect(status().isOk());
+    decideAsDelegate()
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.status").value("APPROVED"))
+        .andExpect(jsonPath("$.decidedBy").value(delegate))
+        .andExpect(jsonPath("$.onBehalfOf").value(approver));
+    assertThat(
+            jdbc.queryForObject(
+                "select details from audit_event where action = 'TASK_APPROVE'", String.class))
+        .contains("\"onBehalfOf\":" + approver);
+  }
+
+  @Test
+  void withoutADelegationAnotherUserCannotDecide() throws Exception {
+    decideAsDelegate().andExpect(status().isNotFound());
+  }
+
+  @Test
+  void aDelegationThatHasNotStartedOrHasEndedGivesNothing() throws Exception {
+    delegate(approver, period("2027-05-04", "2027-05-05")).andExpect(status().isCreated());
+
+    decideAsDelegate().andExpect(status().isNotFound());
+    clock.set(Instant.parse("2027-05-06T09:00:00Z"));
+    decideAsDelegate().andExpect(status().isNotFound());
+  }
+
+  @Test
+  void anAdminSetsUpADelegationForSomeoneElse() throws Exception {
+    long admin = data.admin("Omar Lind");
+
+    delegate(
+            admin,
+            "{\"delegatorId\":%d,\"delegateId\":%d,\"from\":\"2027-05-03\",\"until\":\"2027-05-04\"}"
+                .formatted(approver, delegate))
+        .andExpect(status().isCreated())
+        .andExpect(jsonPath("$.delegatorId").value(approver));
+    decideAsDelegate().andExpect(status().isOk());
+  }
+
+  @Test
+  void overlappingAndSelfDelegationsAreRefused() throws Exception {
+    delegate(approver, period("2027-05-03", "2027-05-07")).andExpect(status().isCreated());
+
+    delegate(approver, period("2027-05-07", "2027-05-10")).andExpect(status().isConflict());
+    delegate(approver, period("2027-05-10", "2027-05-07")).andExpect(status().isBadRequest());
+    delegate(delegate, period("2027-05-03", "2027-05-04")).andExpect(status().isBadRequest());
+  }
+
+  @Test
+  void theDelegatorEndsTheDelegation() throws Exception {
+    long id =
+        idFrom(
+            delegate(approver, period("2027-05-03", "2027-05-07"))
+                .andExpect(status().isCreated())
+                .andReturn());
+
+    mvc.perform(delete("/api/v1/delegations/" + id).header(AUTH, data.bearer(owner)))
+        .andExpect(status().isNotFound());
+    mvc.perform(delete("/api/v1/delegations/" + id).header(AUTH, data.bearer(approver)))
+        .andExpect(status().isNoContent());
+    decideAsDelegate().andExpect(status().isNotFound());
+  }
+}
