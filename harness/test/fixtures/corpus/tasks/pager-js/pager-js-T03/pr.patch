@@ -4,3 +4,11 @@
 export function paginate(items, page, size) {
   return items.slice((page - 1) * size, page * size);
 }
+
+/** Inclusive index range { first, last } shown on page `page`; null when the page is empty. */
+export function pageRange(items, page, size) {
+  const first = (page - 1) * size;
+  if (first >= items.length) return null;
+  const last = Math.min(first + size, items.length) - 1;
+  return { first, last };
+}
