@@ -0,0 +1,53 @@
+/** The per-session `trace.md` a hosted attempt writes at close, through the run report's renderer. */
+
+import { readFileSync } from 'node:fs';
+import path from 'node:path';
+import type { ResolvedConfig, ResolvedTarget } from '../config/resolve.ts';
+import { buildReport } from '../report/build.ts';
+import { renderTracePage } from '../report/failure-text.ts';
+import { outcome } from '../report/outcome.ts';
+import { toPosixPath, writeTextReport } from '../report/write.ts';
+import type { AttemptRecord, ResultRecord } from './records.ts';
+
+export interface HostTraceOptions {
+  readonly config: ResolvedConfig;
+  readonly target: ResolvedTarget;
+  readonly runId: string;
+  readonly testId: string;
+  /** The session name, already redacted. */
+  readonly title: string;
+  readonly agent: string;
+  readonly attempt: AttemptRecord;
+  /** The results directory the page's artifact links resolve against. */
+  readonly resultsDir: string;
+  /** Path segments of the attempt's directory under `resultsDir`. */
+  readonly segments: readonly string[];
+  readonly tracePath: string;
+  readonly redact: (text: string) => string;
+}
+
+/** Writes one session's trace page as a single-result run, so it reads like `e2e run`'s. */
+export async function writeHostTrace(options: HostTraceOptions): Promise<void> {
+  const { config, attempt, title } = options;
+  const status = attempt.status;
+  const result: ResultRecord = {
+    test: { id: options.testId, kind: 'test', title, titlePath: [title], file: 'host', declarationIndex: 0, sessions: [], tags: [], source: undefined, serialId: undefined },
+    target: options.target, agent: options.agent, repeat: 0, selected: true, status, attempts: [attempt],
+  };
+  const report = buildReport({
+    config, runId: options.runId, startedAt: attempt.startedAt,
+    status: status === 'interrupted' ? 'interrupted' : status === 'passed' ? 'passed' : 'failed',
+    exitCode: status === 'interrupted' ? 130 : status === 'passed' ? 0 : 1,
+    results: [result], serialGroups: [], runErrors: [], targetProvenance: new Map(),
+  });
+  const reported = report.run.results[0]!;
+  const page = renderTracePage(report, reported, outcome(reported, new Map()), {
+    standalone: true,
+    artifactsDir: toPosixPath(path.relative(config.projectRoot, options.resultsDir)),
+    pageDir: toPosixPath(path.join(...options.segments)),
+    readArtifact: (reportPath) => {
+      try { return readFileSync(path.join(options.resultsDir, reportPath), 'utf8'); } catch { return undefined; }
+    },
+  });
+  await writeTextReport(options.tracePath, options.redact(page));
+}
diff --git a/packages/e2e/src/run/open-session.ts b/packages/e2e/src/run/open-session.ts
new file mode 100644
index 0000000..9f49586
--- /dev/null
+++ b/packages/e2e/src/run/open-session.ts
@@ -0,0 +1,140 @@
+/** Hosted test runners keep a worker alive while opening isolated per-test attempts. */
+
+import { discoverConfig, loadConfigModule, missingConfigError } from '../config/load.ts';
+import { resolveConfig, type ResolvedConfig } from '../config/resolve.ts';
+import { classifyError, ConfigurationError, E2EError, serializeError, type SerializedError } from '../internal/errors.ts';
+import type { E2EConfig, TestFixtures } from '../types.ts';
+import { allocateTargetPorts } from './app-ports.ts';
+import { processSecrets, registerStaticSecrets } from './secrecy.ts';
+import { selectTarget } from './select-target.ts';
+import { openStandaloneHost } from './standalone.ts';
+import type { StepProgress, StepRecord } from './steps.ts';
+
+export interface OpenHostOptions {
+  /** Config search directory, or project root of a config value; default `process.cwd()`. */
+  readonly cwd?: string | undefined;
+  /** Path relative to `cwd`, or a config value; default nearest `e2e.config.ts`. Files load fresh per host. */
+  readonly config?: string | E2EConfig | undefined;
+  /** May be omitted only when the config declares one target. */
+  readonly target?: string | undefined;
+  readonly env?: NodeJS.ProcessEnv | undefined;
+  /** Cancels provisioning, initialization, and every session's operations. Close still releases resources. */
+  readonly signal?: AbortSignal | undefined;
+  readonly headed?: boolean | undefined;
+  /** Progress outside steps: provisioning, leases, and app processes. Must not throw. */
+  readonly onNotice?: ((target: string, message: string) => void) | undefined;
+}
+
+export interface OpenSessionOptions {
+  /** Test title, treated as untrusted text, never a raw path component. */
+  readonly name: string;
+  /**
+   * Deadline for the session's operations in milliseconds, counted from when
+   * it opens; default the config's `timeout`. Positive and finite. Expiry cuts
+   * running operations and fails the session as timed out; it does not bound
+   * opening (use `signal`) and does not close the session.
+   */
+  readonly timeout?: number | undefined;
+  readonly signal?: AbortSignal | undefined;
+  readonly agent?: string | undefined;
+  /** The same step progress feed reporters receive. Must not block or throw. */
+  readonly onStep?: ((progress: StepProgress) => void) | undefined;
+}
+
+export interface E2EHost<Fixtures extends object = Record<string, unknown>> extends AsyncDisposable {
+  readonly runId: string;
+  readonly target: string;
+  /** One opening, live, or closing hosted session per process; open sequentially. */
+  openSession(options: OpenSessionOptions): Promise<E2ESession<Fixtures>>;
+  /** Cancels/ends a pending or active session, then disposes the worker and releases resources once. */
+  close(): Promise<readonly SerializedError[]>;
+}
+
+export interface E2ESession<Fixtures extends object = Record<string, unknown>> extends AsyncDisposable {
+  readonly runId: string;
+  readonly attemptId: string;
+  readonly target: string;
+  readonly fixtures: TestFixtures & Fixtures;
+  readonly artifactsDir: string;
+  /** Absolute per-session trace path. Written before close settles successfully. */
+  readonly tracePath: string;
+  steps(): readonly StepRecord[];
+  /** Idempotent. Returns soft assertion, abandoned-operation, and cleanup failures. Disposal throws them as AggregateError. */
+  close(): Promise<readonly SerializedError[]>;
+}
+
+/** Opens the worker-scoped owner of preparation, app processes, and engine initialization. */
+export async function openHost<Fixtures extends object = Record<string, unknown>>(
+  options: OpenHostOptions = {},
+): Promise<E2EHost<Fixtures>> {
+  return redactOpening(() => openHostWorker<Fixtures>(options));
+}
+
+/** Loads the selected target and opens its worker behind the redacted public boundary. */
+async function openHostWorker<Fixtures extends object>(options: OpenHostOptions): Promise<E2EHost<Fixtures>> {
+  const cwd = options.cwd ?? process.cwd();
+  const env = options.env ?? process.env;
+  const loaded = await loadHostConfig(cwd, options.config, env);
+  registerStaticSecrets(loaded.allSecrets);
+  const { config, target } = await allocateTargetPorts(loaded, selectTarget(loaded, options.target, 'pass `target` to openHost'));
+  const host = await openStandaloneHost({
+    config, target, headed: options.headed ?? false, env,
+    signal: options.signal ?? new AbortController().signal,
+    ...(options.onNotice === undefined ? {} : { notice: options.onNotice }),
+  });
+  return {
+    runId: host.runId, target: target.name, close: host.close,
+    [Symbol.asyncDispose]: () => dispose(host.close, 'host'),
+    openSession: (sessionOptions) => redactOpening(async () => {
+      if (typeof sessionOptions.name !== 'string') throw new ConfigurationError('INVALID_CONFIG', 'a hosted session requires a string name');
+      const attempt = await host.openAttempt({
+        name: sessionOptions.name,
+        signal: sessionOptions.signal ?? new AbortController().signal,
+        timeoutMs: sessionOptions.timeout ?? config.timeout,
+        agent: sessionOptions.agent,
+        ...(sessionOptions.onStep === undefined ? {} : { onProgress: sessionOptions.onStep }),
+      });
+      return {
+        runId: attempt.runId, attemptId: attempt.attemptId, target: target.name,
+        fixtures: attempt.fixtures as TestFixtures & Fixtures,
+        artifactsDir: attempt.artifactsDir, tracePath: attempt.tracePath,
+        steps: () => attempt.steps.all(), close: attempt.close,
+        [Symbol.asyncDispose]: () => dispose(attempt.close, 'session'),
+      };
+    }),
+  };
+}
+
+/** Opening errors go straight to the external runner, never through a report writer. */
+async function redactOpening<T>(open: () => Promise<T>): Promise<T> {
+  try {
+    return await open();
+  } catch (cause) {
+    const classified = classifyError(cause);
+    const safe = serializeError(classified, { redact: processSecrets.redact });
+    // Arbitrary engine causes can carry non-text secret data; only the sanitized record crosses out.
+    const error = safe.category === 'configuration'
+      ? new ConfigurationError(safe.code, safe.message, safe.details === undefined ? {} : { details: safe.details })
+      : new E2EError(safe.category, safe.code, safe.message, {
+        retryable: safe.retryable, ...(safe.details === undefined ? {} : { details: safe.details }),
+      });
+    error.name = processSecrets.redact(classified.name);
+    if (safe.stack !== undefined) error.stack = safe.stack;
+    throw error;
+  }
+}
+
+/** `await using` has no result to return; it throws failures rather than dropping them. */
+async function dispose(close: () => Promise<readonly SerializedError[]>, owner: string): Promise<void> {
+  const failures = await close();
+  if (failures.length > 0) throw new AggregateError(failures, `closing the e2e ${owner} failed: ${failures.map((failure) => failure.message).join('; ')}`);
+}
+
+/** Each host gets fresh file-config engine instances; a value resolves against cwd. */
+async function loadHostConfig(cwd: string, config: string | E2EConfig | undefined, env: NodeJS.ProcessEnv): Promise<ResolvedConfig> {
+  if (typeof config === 'object') return resolveConfig(config, { projectRoot: cwd, env });
+  const discovered = discoverConfig(cwd, config);
+  if (discovered.configPath === undefined) throw missingConfigError(cwd);
+  const raw = await loadConfigModule(discovered.configPath, { graph: true });
+  return resolveConfig(raw, { projectRoot: discovered.projectRoot, configPath: discovered.configPath, env });
+}
diff --git a/packages/e2e/src/run/select-target.ts b/packages/e2e/src/run/select-target.ts
new file mode 100644
index 0000000..eec38d8
--- /dev/null
+++ b/packages/e2e/src/run/select-target.ts
@@ -0,0 +1,21 @@
+/** The target a session opens: named, or the only one the config declares. */
+
+import type { ResolvedConfig, ResolvedTarget } from '../config/resolve.ts';
+import { ConfigurationError } from '../internal/errors.ts';
+
+/**
+ * `name` must be a declared target; without one, the config must declare
+ * exactly one. `howToName` tells the caller how to name it when several exist.
+ */
+export function selectTarget(config: ResolvedConfig, name: string | undefined, howToName: string): ResolvedTarget {
+  const names = config.targets.map((target) => `"${target.name}"`).join(', ');
+  if (name !== undefined) {
+    const target = config.targets.find((candidate) => candidate.name === name);
+    if (target === undefined) throw new ConfigurationError('UNKNOWN_TARGET', `unknown target "${name}"; the config declares ${names}`);
+    return target;
+  }
+  const [only] = config.targets;
+  if (only === undefined) throw new ConfigurationError('INVALID_CONFIG', 'the config declares no targets');
+  if (config.targets.length > 1) throw new ConfigurationError('TARGET_REQUIRED', `the config declares several targets (${names}); ${howToName}`);
+  return only;
+}
diff --git a/packages/e2e/src/run/standalone-attempt.ts b/packages/e2e/src/run/standalone-attempt.ts
new file mode 100644
index 0000000..c64c7d4
--- /dev/null
+++ b/packages/e2e/src/run/standalone-attempt.ts
@@ -0,0 +1,268 @@
+/** One attempt on a prepared standalone worker: reservation, launch, fixtures, deadline, and close. */
+
+import path from 'node:path';
+import type { ExecutorAttempt } from '../agent/executor.ts';
+import type { AgentContext } from '../agent/invocation.ts';
+import type { ResolvedConfig, ResolvedTarget } from '../config/resolve.ts';
+import type { TargetSession } from '../engine/surface.ts';
+import { publishAttempt } from '../expect/attempt.ts';
+import { PollScope } from '../expect/poll-scope.ts';
+import { SoftFailures } from '../expect/soft.ts';
+import type { DebugTrace } from '../internal/debug.ts';
+import { classifyError, ConfigurationError, InfrastructureError, serializeError, TestTimeoutError, type SerializedError } from '../internal/errors.ts';
+import { resultId, timestamp, uuidv7 } from '../internal/ids.ts';
+import { Deadline, withTimeout } from '../internal/time.ts';
+import { attemptVideo } from '../internal/recording-modes.ts';
+import type { TestFixtures } from '../types.ts';
+import { createAttemptArtifacts, resultSegment } from './artifacts.ts';
+import { AttemptBudget } from './budget.ts';
+import { classifyAttemptStatus, type ClosingRecord, type TargetExecutor } from './execute.ts';
+import { createFixtures } from './fixtures.ts';
+import { writeHostTrace } from './host-trace.ts';
+import type { AttemptRecord } from './records.ts';
+import { holdSecretRegistry } from '../secrets.ts';
+import { processSecrets, redactForSession, sessionSecrecy } from './secrecy.ts';
+import { StepRecorder, type StepProgress } from './steps.ts';
+import { WorkerModels } from './worker-models.ts';
+
+/**
+ * Who drives the attempt. A hosted attempt is a test in another runner: it
+ * publishes itself for `expect.soft` and `expect.poll`, enforces its deadline,
+ * and writes a trace under `results/host/`. A one-shot attempt is `e2e mcp`'s
+ * live session: no test body, no publication, artifacts under `results/mcp/`.
+ */
+export type AttemptKind = 'hosted' | 'one-shot';
+
+export interface StandaloneSessionOptions {
+  readonly signal: AbortSignal;
+  /** Operation deadline from launch, positive and finite. */
+  readonly timeoutMs: number;
+  readonly agent?: string | undefined;
+  readonly onProgress?: (progress: StepProgress) => void;
+  /** The test title of a hosted attempt; ignored by a one-shot attempt. */
+  readonly name?: string;
+}
+
+export interface StandaloneAttempt {
+  readonly runId: string;
+  readonly attemptId: string;
+  readonly fixtures: TestFixtures;
+  readonly agentRuntime: AgentContext;
+  readonly session: TargetSession;
+  readonly steps: StepRecorder;
+  readonly budget: AttemptBudget;
+  readonly artifactsDir: string;
+  readonly tracePath: string;
+  close(): Promise<readonly SerializedError[]>;
+}
+
+/** The prepared worker an attempt runs on. */
+export interface AttemptWorker {
+  readonly kind: AttemptKind;
+  readonly config: ResolvedConfig;
+  readonly target: ResolvedTarget;
+  readonly runId: string;
+  readonly executor: TargetExecutor;
+  readonly resultsDir: string;
+  readonly debug: DebugTrace;
+  /** Aborts when the host closes or its caller cancels it. */
+  readonly signal: AbortSignal;
+}
+
+/** What `reserveAttempt` holds before any engine work: ids, budget, and the published expectations. */
+export interface AttemptReservation {
+  readonly attemptId: string;
+  readonly options: StandaloneSessionOptions;
+  /** Aborts the attempt's own operations; the attempt ends it at close. */
+  readonly end: AbortController;
+  /** The worker's, the caller's, and the attempt's own cancellation together. */
+  readonly signal: AbortSignal;
+  readonly budget: AttemptBudget;
+  readonly soft: SoftFailures;
+  readonly polls: PollScope;
+  /** Withdraws the publication and the registry hold once cleanup has settled. */
+  readonly release: () => void;
+}
+
+/** What the host learns when an attempt's close settles. */
+export interface AttemptClosed {
+  readonly cleanup: AttemptRecord['cleanup'];
+}
+
+/** Longest delay `setTimeout` honors; a longer deadline needs no timer the attempt could outlive. */
+const MAX_TIMER_MS = 2 ** 31 - 1;
+
+/**
+ * Validates the options and publishes a hosted attempt, synchronously, so
+ * `expect` finds it before launch and no second attempt can publish over it.
+ */
+export function reserveAttempt(worker: AttemptWorker, options: StandaloneSessionOptions): AttemptReservation {
+  if (worker.signal.aborted || options.signal.aborted) throw new InfrastructureError('CANCELLED', 'opening the e2e session was cancelled');
+  if (!Number.isFinite(options.timeoutMs) || options.timeoutMs <= 0) {
+    throw new ConfigurationError('INVALID_CONFIG', 'session timeout must be a positive, finite number of milliseconds');
+  }
+  const attemptId = uuidv7();
+  const end = new AbortController();
+  const signal = AbortSignal.any([worker.signal, options.signal, end.signal]);
+  const budget = new AttemptBudget(signal, new Deadline(options.timeoutMs));
+  const soft = new SoftFailures();
+  const polls = new PollScope('the hosted session');
+  if (worker.kind === 'one-shot') return { attemptId, options, end, signal, budget, soft, polls, release: () => undefined };
+  const { config } = worker;
+  const publication = new AbortController();
+  publishAttempt({ attemptId, testKind: 'test', assertionTimeout: config.assertionTimeout, budget, soft, polls }, publication.signal);
+  // The live attempt's secrets resolve against its own config while other hosts hold theirs.
+  const releaseRegistry = holdSecretRegistry(config, { live: true });
+  return { attemptId, options, end, signal, budget, soft, polls, release: () => { publication.abort(); releaseRegistry(); } };
+}
+
+/**
+ * Launches the reserved attempt and hands back its fixtures. A launch that
+ * fails has already ended what it opened, the same as a run's retry relies
+ * on; the worker stays usable. `onClosed` runs once when `close` settles,
+ * before `close` returns, so the host can retire a worker whose cleanup failed.
+ */
+export async function launchAttempt(
+  worker: AttemptWorker,
+  reservation: AttemptReservation,
+  onClosed: (closed: AttemptClosed) => Promise<void>,
+): Promise<StandaloneAttempt> {
+  const { config, target, executor, runId } = worker;
+  const { attemptId, options, budget, soft, polls, end } = reservation;
+  const attemptSignal = reservation.signal;
+  let session: TargetSession | undefined;
+  const redact = (text: string): string => redactForSession(session, config.allSecrets, text);
+  const agent = options.agent ?? config.agentNames[0] ?? '';
+  const identity = attemptIdentity(worker, attemptId, agent, redact(options.name ?? target.name));
+  const steps = new StepRecorder(attemptId, {
+    maxEventsPerStep: config.limits.maxEventsPerStep, projectRoot: config.projectRoot, redact, signal: attemptSignal,
+    ...(options.onProgress === undefined ? {} : { onProgress: options.onProgress }),
+  });
+  const artifacts = createAttemptArtifacts({
+    artifactsRoot: worker.resultsDir, segments: identity.segments, attemptId, currentStepId: () => steps.currentStepId,
+    ...(config.artifactStore === undefined ? {} : { store: config.artifactStore }),
+    secrecy: () => session === undefined ? undefined : sessionSecrecy(session, config.allSecrets),
+    identity: { runId, testId: identity.testId, attemptId },
+  });
+  const attemptErrors: SerializedError[] = [];
+  const recordFailure = (cause: unknown, phase: 'body' | 'cleanup'): void => {
+    attemptErrors.push(serializeError(classifyError(cause), { phase, projectRoot: config.projectRoot, redact }));
+  };
+  /** One outcome drives recording retention and the trace. */
+  const verdict = (): { status: AttemptRecord['status']; error: SerializedError | undefined } => {
+    const step = steps.all().find((candidate) => candidate.status !== 'passed');
+    const error = attemptErrors[0] ?? step?.error;
+    if (error === undefined) return { status: 'passed', error };
+    return { status: classifyAttemptStatus(error, step?.status === 'timed-out', error.code === 'CANCELLED'), error };
+  };
+  const video = attemptVideo(target.video, 0);
+  session = await executor.launchSession({ session: undefined, recordings: { trace: undefined, video } }, attemptId, artifacts.dir, attemptSignal);
+  const opened = session;
+  const closeOpened = (record: ClosingRecord): Promise<void> =>
+    executor.closeSession(opened, { attemptId, video }, record, artifacts.sink, attemptErrors);
+  if (attemptSignal.aborted) {
+    await closeOpened({ status: 'interrupted', cleanup: 'complete' });
+    throw new InfrastructureError('CANCELLED', 'opening the e2e session was cancelled');
+  }
+  opened.appLog.route((event, at) => steps.recordAppEvent(event, at));
+  // Launch was the worker's work; the test's deadline starts once its fixtures exist.
+  budget.enter(attemptSignal, options.timeoutMs);
+  const attempt: ExecutorAttempt = { testId: identity.testId, attemptId, index: 0, signal: end.signal, memory: new Map<string, unknown>() };
+  let acquired: ReturnType<typeof createFixtures>;
+  try {
+    acquired = createFixtures({
