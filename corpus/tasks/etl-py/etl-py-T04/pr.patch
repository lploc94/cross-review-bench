+"""Reference rates and daily sales converted to EUR."""
+
+from __future__ import annotations
+
+import json
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from etl.api.fx import load_rates
+from etl.api.reports import daily_sales_report
+from etl.errors import FxRateMissing, InvalidRequest, SourceFormatError
+from etl.infra.tables import fx_rates
+from tests.helpers.db import rows
+from tests.helpers.factories import customer_obj, order_row, write_customers, write_orders
+from tests.helpers.files import write_text
+
+
+def write_rates(tmp_path, lines, name="rates.csv"):
+    return write_text(
+        tmp_path / name, "day,currency,rate_to_eur\n" + "".join(f"{line}\n" for line in lines)
+    )
+
+
+def load_orders(pipeline, tmp_path, lines):
+    pipeline.run("customers", write_customers(tmp_path, [customer_obj()]))
+    pipeline.run("orders", write_orders(tmp_path, lines))
+
+
+def test_rates_are_loaded_and_replaced(context, db, tmp_path):
+    load_rates(context, write_rates(tmp_path, ["2026-03-02,USD,0.92", "2026-03-02,sek,0.0875"]))
+    view = load_rates(context, write_rates(tmp_path, ["2026-03-02,USD,0.9175"], name="fix.csv"))
+
+    assert (view.rates, view.currencies, view.first_day) == (1, ["USD"], date(2026, 3, 2))
+    stored = {(row["currency"], row["rate_to_eur"]) for row in rows(db, fx_rates)}
+    assert stored == {("USD", Decimal("0.917500000000")), ("SEK", Decimal("0.087500000000"))}
+
+
+@pytest.mark.parametrize(
+    ("line", "reason"),
+    [
+        ("2026-03-02,EUR,1", "base currency"),
+        ("2026-03-02,USD,-0.9", "positive"),
+        ("2026-03-02,USD,9e-1", "not an amount"),
+        ("2026-03-02,USD,0", "positive"),
+        ("2026-03-02,USD,0.1234567890123", "at most 12 decimals"),
+        ("2026-02-30,USD,0.9", "day is out of range"),
+        ("2026-03-02,ABC,0.9", "unknown currency"),
+    ],
+)
+def test_a_bad_rate_refuses_the_whole_file(context, db, tmp_path, line, reason):
+    path = write_rates(tmp_path, ["2026-03-01,USD,0.91", line])
+
+    with pytest.raises(SourceFormatError, match=reason):
+        load_rates(context, path)
+
+    assert rows(db, fx_rates) == []
+
+
+def test_daily_sales_in_eur_add_up_the_currencies_of_a_day(pipeline, context, tmp_path):
+    load_orders(
+        pipeline,
+        tmp_path,
+        [
+            order_row(
+                order_id="A", ordered_at="02.03.2026 10:00:00", updated_at="02.03.2026 10:00:00"
+            ),
+            order_row(
+                order_id="B",
+                currency="USD",
+                ordered_at="02.03.2026 11:00:00",
+                updated_at="02.03.2026 11:00:00",
+            ),
+            # 00:30 in Berlin on 3 March: converted at the rate of 3 March
+            order_row(
+                order_id="C",
+                currency="USD",
+                ordered_at="03.03.2026 00:30:00",
+                updated_at="03.03.2026 00:30:00",
+            ),
+            order_row(
+                order_id="D",
+                currency="USD",
+                status="cancelled",
+                ordered_at="03.03.2026 09:00:00",
+                updated_at="03.03.2026 09:00:00",
+            ),
+        ],
+    )
+    load_rates(context, write_rates(tmp_path, ["2026-03-02,USD,0.92", "2026-03-03,USD,0.9"]))
+
+    report = daily_sales_report(
+        context, first=date(2026, 3, 2), last=date(2026, 3, 3), convert_to="eur"
+    )
+
+    assert report.converted_to == "EUR"
+    assert [
+        (r.day.isoformat(), r.country, r.currency, r.orders, r.revenue) for r in report.rows
+    ] == [
+        ("2026-03-02", "DE", "EUR", 2, Decimal("48.00")),
+        ("2026-03-03", "DE", "EUR", 1, Decimal("22.50")),
+    ]
+    assert report.path.name == "daily_sales_2026-03-02_2026-03-03_EUR.csv"
+
+
+def test_a_missing_rate_fails_the_report(pipeline, context, tmp_path):
+    load_orders(pipeline, tmp_path, [order_row(currency="USD")])
+
+    with pytest.raises(FxRateMissing, match="no EUR reference rate for USD on 2026-03-02"):
+        daily_sales_report(context, first=date(2026, 3, 2), last=date(2026, 3, 2), convert_to="EUR")
+    with pytest.raises(InvalidRequest, match="EUR only"):
+        daily_sales_report(context, first=date(2026, 3, 2), last=date(2026, 3, 2), convert_to="USD")
+
+
+def test_the_fx_and_report_commands(cli, pipeline, tmp_path):
+    load_orders(pipeline, tmp_path, [order_row(currency="USD")])
+    missing = cli(
+        "report", "daily-sales", "--from", "2026-03-02", "--to", "2026-03-02", "--in", "EUR"
+    )
+    loaded = cli("fx", "load", write_rates(tmp_path, ["2026-03-02,USD,0.92"]))
+    report = cli(
+        "report",
+        "daily-sales",
+        "--from",
+        "2026-03-02",
+        "--to",
+        "2026-03-02",
+        "--in",
+        "EUR",
+        "--json",
+    )
+
+    assert missing.exit_code == 4
+    assert "etl fx load" in missing.stderr
+    assert loaded.exit_code == 0, loaded.output
+    assert "loaded 1 rates for USD, 2026-03-02 to 2026-03-02" in loaded.stdout
+    assert json.loads(report.stdout)["rows"][0]["revenue"] == "23.00"
