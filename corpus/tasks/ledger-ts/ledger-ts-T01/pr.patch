+  /**
+   * Undo a posted transfer by posting the same amount back from its destination to its source,
+   * as a new transfer that points at the original (`reversal_of`). A transfer is reversed at most
+   * once and a reversal cannot itself be reversed. The destination must still be able to pay:
+   * a wallet that has spent the funds cannot be reversed below zero.
+   */
+  async reverseTransfer(
+    tenantId: string,
+    id: string,
+    request: ReverseTransferRequest = {},
+  ): Promise<PostingResult> {
+    const now = this.clock.now();
+    return withTransaction(this.pool, async (client) => {
+      const original = await transfers.findTransfer(client, tenantId, id);
+      if (!original) throw NotFoundError.resource("transfer", id);
+      if (original.reversalOf !== null) {
+        throw new ConflictError(`transfer ${original.id} is a reversal and cannot be reversed`, {
+          transfer_id: original.id,
+          reversal_of: original.reversalOf,
+        });
+      }
+      const existing = await transfers.findReversal(client, tenantId, original.id);
+      if (existing) {
+        throw new ConflictError(`transfer ${original.id} was already reversed`, {
+          transfer_id: original.id,
+          reversal_id: existing.id,
+        });
+      }
+
+      const locked = await accounts.lockAccounts(client, tenantId, [
+        original.fromAccountId,
+        original.toAccountId,
+      ]);
+      const from = locked.get(original.toAccountId);
+      if (!from) throw NotFoundError.resource("account", original.toAccountId);
+      const to = locked.get(original.fromAccountId);
+      if (!to) throw NotFoundError.resource("account", original.fromAccountId);
+
+      const result = await postTransfer(client, {
+        tenantId,
+        from,
+        to,
+        amountMinor: original.amountMinor,
+        currency: original.currency,
+        description: request.description ?? `Reversal of transfer ${original.id}`,
+        metadata: { reversal_of: original.id },
+        reversalOf: original.id,
+        now,
+      });
+      await outbox.insertEvent(client, transferReversed(original, result.transfer), now);
+      return result;
+    });
+  }
