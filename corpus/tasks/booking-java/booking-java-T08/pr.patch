+package com.innkeep.booking.api;
+
+import com.innkeep.booking.api.dto.AllotmentRequest;
+import com.innkeep.booking.api.dto.HoldRequest;
+import com.innkeep.booking.api.dto.HoldResponse;
+import com.innkeep.booking.domain.DateRange;
+import com.innkeep.booking.domain.GuestDetails;
+import com.innkeep.booking.domain.Hold;
+import com.innkeep.booking.service.AllotmentService;
+import com.innkeep.booking.service.HoldService;
+import jakarta.validation.Valid;
+import java.net.URI;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+/** Channel allotments and the holds channels make against them. */
+@RestController
+@RequestMapping("/api/v1/admin/properties/{code}")
+public class AdminAllotmentController {
+
+  private final AllotmentService allotments;
+  private final HoldService holds;
+
+  public AdminAllotmentController(AllotmentService allotments, HoldService holds) {
+    this.allotments = allotments;
+    this.holds = holds;
+  }
+
+  @PutMapping("/room-types/{roomType}/allotments/{channel}")
+  public ResponseEntity<Void> set(
+      @PathVariable String code,
+      @PathVariable String roomType,
+      @PathVariable String channel,
+      @Valid @RequestBody AllotmentRequest request) {
+    allotments.set(
+        code, roomType, channel, request.range(), request.rooms(), request.releaseDays());
+    return ResponseEntity.noContent().build();
+  }
+
+  @PostMapping("/channels/{channel}/holds")
+  public ResponseEntity<HoldResponse> hold(
+      @PathVariable String code,
+      @PathVariable String channel,
+      @Valid @RequestBody HoldRequest request) {
+    var stay = new DateRange(request.stay().checkIn(), request.stay().checkOut());
+    var guest =
+        new GuestDetails(request.guest().name(), request.guest().email(), request.guest().phone());
+    Hold hold =
+        holds.createForChannel(
+            channel,
+            code,
+            request.stay().roomType(),
+            stay,
+            request.stay().rooms(),
+            request.stay().guests(),
+            guest);
+    return ResponseEntity.created(URI.create("/api/v1/holds/" + hold.getId()))
+        .body(HoldResponse.from(hold));
+  }
+}
