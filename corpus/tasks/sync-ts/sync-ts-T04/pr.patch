+
+/** The ids among `mutationIds` that are already recorded for the user. */
+export async function findRecordedMutations(
+  db: Queryable,
+  userId: string,
+  mutationIds: readonly string[],
+): Promise<Set<string>> {
+  if (mutationIds.length === 0) return new Set();
+  const result = await db.query<{ mutation_id: string }>(
+    "SELECT mutation_id FROM mutations WHERE user_id = $1 AND mutation_id = ANY($2::uuid[])",
+    [userId, mutationIds],
+  );
+  return new Set(result.rows.map((row) => row.mutation_id));
+}
