+def daily_sales_in(
+    connection: Connection, *, first: date, last: date, zone: ZoneInfo
+) -> list[DailySalesRow]:
+    """Daily sales per day and country in EUR, every order converted at the reference rate of
+    its day (the day in the reporting zone the order belongs to).
+
+    The orders of one day in one currency share a rate, so converting their total is
+    converting each order. Each cell is rounded half-even to cents once, after adding up the
+    currencies of the day and country. Raises FxRateMissing when a rate is not loaded.
+    """
+    groups = daily_sales(connection, first=first, last=last, zone=zone)
+    foreign = {(row.day, row.currency) for row in groups if row.currency != BASE_CURRENCY}
+    rates = fx_rates.between(
+        connection, first=first, last=last, currencies={code for _, code in foreign}
+    )
+    missing = sorted(foreign - rates.keys())
+    if missing:
+        raise FxRateMissing(missing)
+
+    orders_per_cell: dict[tuple[date, str], int] = defaultdict(int)
+    amounts_per_cell: dict[tuple[date, str], list[float]] = defaultdict(list)
+    for row in groups:
+        rate = rates.get((row.day, row.currency), Decimal(1))
+        cell = (row.day, row.country)
+        orders_per_cell[cell] += row.orders
+        amounts_per_cell[cell].append(float(row.revenue) * float(rate))
+    unit = currency(BASE_CURRENCY)
+    return [
+        DailySalesRow(
+            day=day,
+            country=country,
+            currency=unit.code,
+            orders=orders_per_cell[(day, country)],
+            revenue=Decimal(str(math.fsum(amounts))).quantize(
+                unit.quantum, rounding=ROUND_HALF_EVEN
+            ),
+        )
+        for (day, country), amounts in sorted(amounts_per_cell.items())
+    ]
