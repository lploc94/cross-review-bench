+-- Holds taken together for several room types of one stay share a group id. A group has at most
+-- one hold per room type.
+ALTER TABLE hold ADD COLUMN group_id UUID;
+CREATE UNIQUE INDEX hold_group_room_type ON hold (group_id, room_type_id) WHERE group_id IS NOT NULL;
