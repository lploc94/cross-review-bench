+-- Retention rules: a tenant's live files under `prefix` (a folder, ending with '/') are deleted by
+-- the cleanup job once they are `days` days old. When several of the tenant's rules match a file,
+-- the one with the longest prefix applies.
+CREATE TABLE retention_rules (
+  tenant_id  uuid NOT NULL REFERENCES tenants (id) ON DELETE CASCADE,
+  prefix     text COLLATE "C" NOT NULL CHECK (right(prefix, 1) = '/'),
+  days       integer NOT NULL CHECK (days BETWEEN 1 AND 36500),
+  created_at timestamptz NOT NULL,
+  updated_at timestamptz NOT NULL,
+  PRIMARY KEY (tenant_id, prefix)
+);
