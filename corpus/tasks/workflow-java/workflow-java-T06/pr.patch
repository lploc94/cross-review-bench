index 0000000..ef9577f
--- /dev/null
+++ b/src/main/java/com/papertrail/workflow/service/ReassignmentService.java
@@ -0,0 +1,119 @@
+package com.papertrail.workflow.service;
+
+import com.papertrail.workflow.domain.AppUser;
+import com.papertrail.workflow.domain.ApprovalTask;
+import com.papertrail.workflow.domain.ConflictException;
+import com.papertrail.workflow.domain.Document;
+import com.papertrail.workflow.domain.DocumentStatus;
+import com.papertrail.workflow.domain.ForbiddenException;
+import com.papertrail.workflow.domain.NotFoundException;
+import com.papertrail.workflow.domain.ValidationException;
+import com.papertrail.workflow.persistence.AppUserRepository;
+import com.papertrail.workflow.persistence.ApprovalTaskRepository;
+import com.papertrail.workflow.persistence.DocumentRepository;
+import com.papertrail.workflow.service.Views.TaskView;
+import java.time.Clock;
+import java.time.Instant;
+import java.util.Map;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Moves open tasks between approvers for operators, for example when an approver is on leave. The
+ * old task is closed as {@code REASSIGNED} and a new task with the same due time is opened for the
+ * new approver. It runs under the document row lock that decisions take, so a reassignment and a
+ * decision on the same review happen one after the other.
+ */
+@Service
+public class ReassignmentService {
+
+  private final ApprovalTaskRepository tasks;
+  private final DocumentRepository documents;
+  private final AppUserRepository users;
+  private final EventLog events;
+  private final Clock clock;
+
+  public ReassignmentService(
+      ApprovalTaskRepository tasks,
+      DocumentRepository documents,
+      AppUserRepository users,
+      EventLog events,
+      Clock clock) {
+    this.tasks = tasks;
+    this.documents = documents;
+    this.users = users;
+    this.events = events;
+    this.clock = clock;
+  }
+
+  @Transactional
+  public TaskView reassign(long taskId, long userId, String reason) {
+    long documentId =
+        tasks
+            .findDocumentId(taskId)
+            .orElseThrow(() -> new NotFoundException("task " + taskId + " not found"));
+    Document document =
+        documents.lockById(documentId).orElseThrow(() -> new NotFoundException("task not found"));
+    ApprovalTask task =
+        tasks.findById(taskId).orElseThrow(() -> new NotFoundException("task not found"));
+    if (document.getStatus() != DocumentStatus.IN_REVIEW
+        || !task.isOpen()
+        || task.getRound() != document.getRound()
+        || task.getStepOrder() != document.getCurrentOrder()) {
+      throw new ConflictException("task " + taskId + " is no longer open");
+    }
+    AppUser target =
+        users.findById(userId).orElseThrow(() -> new NotFoundException("user not found"));
+    if (!target.isActive()) {
+      throw new ValidationException("the new approver is inactive");
+    }
+    if (document.isOwnedBy(userId)) {
+      throw new ForbiddenException("the owner of a document cannot approve it");
+    }
+    AppUser previous = task.getAssignee();
+    if (previous.getId() == userId) {
+      throw new ConflictException("the task is already assigned to this user");
+    }
+
+    Instant now = clock.instant();
+    task.reassign();
+    ApprovalTask moved =
+        tasks.save(
+            new ApprovalTask(document, task.getRound(), task.getStep(), target, task.getDueAt()));
+    events.audit(
+        document,
+        previous.getId(),
+        "TASK_REASSIGNED",
+        Map.of(
+            "taskId",
+            taskId,
+            "newTaskId",
+            moved.getId(),
+            "to",
+            userId,
+            "by",
+            "admin",
+            "reason",
+            reason.trim()),
+        now);
+    events.notify(
+        "reassigned:" + taskId,
+        "TASK_REASSIGNED",
+        previous,
+        Map.of("taskId", taskId, "documentId", documentId),
+        now);
+    events.notify(
+        "assigned:" + moved.getId(),
+        "TASK_ASSIGNED",
+        target,
+        Map.of(
+            "taskId",
+            moved.getId(),
+            "documentId",
+            documentId,
+            "dueAt",
+            moved.getDueAt().toString()),
+        now);
+    return TaskView.of(moved);
+  }
+}
diff --git a/src/main/resources/db/migration/V3__task_reassignment.sql b/src/main/resources/db/migration/V3__task_reassignment.sql
new file mode 100644
index 0000000..c8b6b0d
--- /dev/null
+++ b/src/main/resources/db/migration/V3__task_reassignment.sql
@@ -0,0 +1,10 @@
+-- A task an admin moves to another approver is closed as REASSIGNED and stays on record.
+ALTER TABLE approval_task DROP CONSTRAINT approval_task_status_check;
+ALTER TABLE approval_task ADD CONSTRAINT approval_task_status_check
+    CHECK (status IN ('OPEN', 'APPROVED', 'REJECTED', 'CANCELLED', 'REASSIGNED'));
+
+-- A task can move away from an approver and back to them within one round, so a person holds at
+-- most one open task per step instead of one task of any status.
+ALTER TABLE approval_task DROP CONSTRAINT approval_task_document_id_round_step_id_assignee_id_key;
+CREATE UNIQUE INDEX approval_task_open_assignee
+    ON approval_task (document_id, round, step_id, assignee_id) WHERE status = 'OPEN';
diff --git a/src/test/java/com/papertrail/workflow/api/TaskReassignmentApiTest.java b/src/test/java/com/papertrail/workflow/api/TaskReassignmentApiTest.java
new file mode 100644
index 0000000..b7bdd66
--- /dev/null
+++ b/src/test/java/com/papertrail/workflow/api/TaskReassignmentApiTest.java
@@ -0,0 +1,162 @@
+package com.papertrail.workflow.api;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.papertrail.workflow.domain.Decision;
+import com.papertrail.workflow.domain.StepKind;
+import com.papertrail.workflow.service.ApprovalService;
+import com.papertrail.workflow.service.DocumentService;
+import com.papertrail.workflow.support.IntegrationTestBase;
+import com.papertrail.workflow.support.TestData;
+import java.time.Instant;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.ResultActions;
+
+class TaskReassignmentApiTest extends IntegrationTestBase {
+
+  @Autowired private DocumentService documents;
+  @Autowired private ApprovalService approvals;
+
+  private long owner;
+  private long approver;
+  private long deputy;
+
+  @BeforeEach
+  void setUp() {
+    owner = data.user("Ines Berg");
+    approver = data.user("Tomas Vale");
+    deputy = data.user("Lena Hart");
+  }
+
+  private long submitted(String definitionName) {
+    long id = data.draft(data.principal(owner), definitionName, "Supplier contract");
+    documents.submit(data.principal(owner), id);
+    return id;
+  }
+
+  private ResultActions reassign(long taskId, long userId) throws Exception {
+    return mvc.perform(
+        post("/api/v1/admin/tasks/" + taskId + "/reassign")
+            .header("Authorization", ADMIN_AUTH)
+            .contentType(MediaType.APPLICATION_JSON)
+            .content("{\"userId\":" + userId + ",\"reason\":\"Approver on leave\"}"));
+  }
+
+  private String taskStatus(long taskId) {
+    return jdbc.queryForObject(
+        "select status from approval_task where id = ?", String.class, taskId);
+  }
+
+  @Test
+  void anOpenTaskMovesToTheNewApproverWithTheSameDueTime() throws Exception {
+    data.publish("Contract", TestData.step(1, StepKind.SINGLE, approver, null, 0, 480));
+    long document = submitted("Contract");
+    long old = taskOf(document, approver);
+
+    reassign(old, deputy)
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.assigneeId").value(deputy))
+        .andExpect(jsonPath("$.status").value("OPEN"));
+
+    long moved = taskOf(document, deputy);
+    assertThat(taskStatus(old)).isEqualTo("REASSIGNED");
+    assertThat(
+            jdbc.queryForObject(
+                "select due_at from approval_task where id = ?", Instant.class, moved))
+        .isEqualTo(
+            jdbc.queryForObject(
+                "select due_at from approval_task where id = ?", Instant.class, old));
+    assertThat(
+            jdbc.queryForList(
+                "select event_type from outbox_event where recipient_user_id = ? order by id",
+                String.class,
+                approver))
+        .containsExactly("TASK_ASSIGNED", "TASK_REASSIGNED");
+    assertThat(
+            jdbc.queryForObject(
+                "select count(*) from audit_event where document_id = ? and action = 'TASK_REASSIGNED'",
+                Integer.class,
+                document))
+        .isEqualTo(1);
+
+    approvals.decide(data.principal(deputy), moved, Decision.APPROVE, null);
+    mvc.perform(get("/api/v1/documents/" + document).header("Authorization", data.bearer(owner)))
+        .andExpect(jsonPath("$.summary.status").value("APPROVED"));
+  }
+
+  @Test
+  void anAllOfStepCompletesWithTheReplacementInsteadOfTheMovedTask() throws Exception {
+    long second = data.user("Omar Lind");
+    long legal = data.group("legal", approver, second);
+    data.publish("Contract", TestData.step(1, StepKind.ALL_OF, null, legal, 0, 480));
+    long document = submitted("Contract");
+
+    reassign(taskOf(document, second), deputy).andExpect(status().isOk());
+    approvals.decide(data.principal(approver), taskOf(document, approver), Decision.APPROVE, null);
+    assertThat(
+            jdbc.queryForObject("select status from document where id = ?", String.class, document))
+        .isEqualTo("IN_REVIEW");
+
+    approvals.decide(data.principal(deputy), taskOf(document, deputy), Decision.APPROVE, null);
+    assertThat(
+            jdbc.queryForObject("select status from document where id = ?", String.class, document))
+        .isEqualTo("APPROVED");
+  }
+
+  @Test
+  void theMovedTaskCanNoLongerBeDecided() throws Exception {
+    data.publish("Contract", TestData.step(1, StepKind.SINGLE, approver, null, 0, 480));
+    long document = submitted("Contract");
+    long old = taskOf(document, approver);
+    reassign(old, deputy).andExpect(status().isOk());
+
+    mvc.perform(
+            post("/api/v1/tasks/" + old + "/decision")
+                .header("Authorization", data.bearer(approver))
+                .contentType(MediaType.APPLICATION_JSON)
+                .content("{\"decision\":\"APPROVE\"}"))
+        .andExpect(status().isConflict());
+  }
+
+  @Test
+  void closedTasksTheOwnerAndInactiveUsersAreRefused() throws Exception {
+    data.publish("Contract", TestData.step(1, StepKind.SINGLE, approver, null, 0, 480));
+    long document = submitted("Contract");
+    long task = taskOf(document, approver);
+    long away = data.user("Kai Moss");
+    jdbc.update("update app_user set active = false where id = ?", away);
+
+    reassign(task, owner)
+        .andExpect(status().isForbidden())
+        .andExpect(jsonPath("$.type").value("urn:workflow:problem:forbidden"));
+    reassign(task, away).andExpect(status().isBadRequest());
+    reassign(task, approver).andExpect(status().isConflict());
+    reassign(task + 100, deputy).andExpect(status().isNotFound());
+
+    approvals.decide(data.principal(approver), task, Decision.APPROVE, null);
+    reassign(task, deputy)
+        .andExpect(status().isConflict())
+        .andExpect(jsonPath("$.type").value("urn:workflow:problem:conflict"));
+  }
+
+  @Test
+  void theRouteNeedsTheAdminToken() throws Exception {
+    data.publish("Contract", TestData.step(1, StepKind.SINGLE, approver, null, 0, 480));
+    long task = taskOf(submitted("Contract"), approver);
+
+    mvc.perform(
+            post("/api/v1/admin/tasks/" + task + "/reassign")
+                .header("Authorization", data.bearer(owner))
+                .contentType(MediaType.APPLICATION_JSON)
+                .content("{\"userId\":" + deputy + ",\"reason\":\"Approver on leave\"}"))
+        .andExpect(status().isUnauthorized());
+    assertThat(taskStatus(task)).isEqualTo("OPEN");
+  }
+}
