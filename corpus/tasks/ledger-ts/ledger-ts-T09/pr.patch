+/** The sum of an account's entries created at or before `asOf`: its balance at that instant. */
+export async function balanceAsOf(
+  db: Queryable,
+  tenantId: string,
+  accountId: string,
+  asOf: Date,
+): Promise<bigint> {
+  const result = await db.query<{ balance: string }>(
+    `SELECT COALESCE(sum(amount_minor), 0)::text AS balance FROM entries
+     WHERE tenant_id = $1 AND account_id = $2 AND created_at <= $3`,
+    [tenantId, accountId, asOf],
+  );
+  return toBigInt(requireRow(result.rows, "balanceAsOf").balance);
+}
