+/** A tenant's retention rule: live files under `prefix` are deleted once `days` days old. */
+export interface RetentionRule {
+  readonly tenantId: string;
+  /** A folder prefix, ending with `/`. */
+  readonly prefix: string;
+  readonly days: number;
+  readonly createdAt: Date;
+  readonly updatedAt: Date;
+}
+
+/** About a hundred years: the longest retention a rule can set. */
+export const MAX_RETENTION_DAYS = 36_500;
+
+/** Rules a tenant may have; the cleanup job evaluates all of them for each of its files. */
+export const MAX_RETENTION_RULES = 100;
