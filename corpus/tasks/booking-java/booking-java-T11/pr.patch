+  private static Map<String, Map<String, BigDecimal>> checkedDisplayRates(
+      Map<String, Map<String, BigDecimal>> rates) {
+    var checked = new TreeMap<String, Map<String, BigDecimal>>();
+    if (rates != null) {
+      rates.forEach(
+          (from, targets) -> {
+            requireCurrencyCode(from);
+            var byTarget = new TreeMap<>(targets);
+            byTarget.forEach(
+                (to, rate) -> {
+                  requireCurrencyCode(to);
+                  if (rate == null || rate.signum() <= 0) {
+                    throw new IllegalArgumentException(
+                        "booking.display-rates." + from + "." + to + " must be positive");
+                  }
+                });
+            checked.put(from, Collections.unmodifiableMap(byTarget));
+          });
+    }
+    return Collections.unmodifiableMap(checked);
+  }
+
+  /** An ISO 4217 code with minor units, so converted amounts can be rounded to them. */
+  private static void requireCurrencyCode(String code) {
+    try {
+      if (Currency.getInstance(code).getDefaultFractionDigits() >= 0) {
+        return;
+      }
+    } catch (IllegalArgumentException e) {
+      // reported below
+    }
+    throw new IllegalArgumentException(
+        "booking.display-rates: " + code + " is not an ISO 4217 currency with minor units");
   }
 
