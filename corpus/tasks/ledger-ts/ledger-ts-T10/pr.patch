@@ -0,0 +1,120 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import type { CurrencyCode } from "../../src/domain/currency.js";
+import { ApiKeyService } from "../../src/services/apiKeyService.js";
+import { buildTestApp, type TestApp } from "../helpers/app.js";
+import {
+  createTenant,
+  fundedWallet,
+  issueKey,
+  openAccount,
+  transferRequest,
+  type AccountBody,
+  type ErrorResponse,
+  type TestTenant,
+} from "../helpers/fixtures.js";
+
+describe("daily transfer limits", () => {
+  let t: TestApp;
+  let tenant: TestTenant;
+  let limited: TestTenant;
+  let wallet: AccountBody;
+  let merchant: AccountBody;
+
+  beforeAll(async () => {
+    t = await buildTestApp();
+  });
+
+  afterAll(async () => {
+    await t.close();
+  });
+
+  beforeEach(async () => {
+    tenant = await createTenant(t.pool, t.clock);
+    wallet = await fundedWallet(t.app, tenant, "100000");
+    merchant = await openAccount(t.app, tenant);
+    limited = await issueKey(t.pool, t.clock, tenant.tenantId, ["transfers:write"]);
+  });
+
+  async function limitKey(key: TestTenant, amount: bigint, currency: CurrencyCode = "USD") {
+    await new ApiKeyService({ pool: t.pool, clock: t.clock }).setDailyTransferLimit(
+      key.tenantId,
+      key.apiKeyId,
+      { amountMinor: amount, currency },
+    );
+  }
+
+  function send(key: TestTenant, amount: string, from = wallet, to = merchant) {
+    return transferRequest(t.app, key, {
+      from_account_id: from.id,
+      to_account_id: to.id,
+      amount,
+      currency: from.currency,
+    });
+  }
+
+  it("refuses a transfer that would exceed the key's limit and reports what is left", async () => {
+    await limitKey(limited, 1000n);
+    expect((await send(limited, "600")).statusCode).toBe(201);
+
+    const refused = await send(limited, "500");
+    expect(refused.statusCode).toBe(422);
+    const error = refused.json<ErrorResponse>().error;
+    expect(error.code).toBe("limit_exceeded");
+    expect(error.details).toMatchObject({
+      limit: "1000",
+      currency: "USD",
+      used: "600",
+      remaining: "400",
+      requested: "500",
+    });
+
+    expect((await send(limited, "400")).statusCode).toBe(201);
+    expect((await send(limited, "1")).statusCode).toBe(422);
+  });
+
+  it("counts only the key's own transfers in the limit's currency", async () => {
+    await limitKey(limited, 1000n);
+    const other = await issueKey(t.pool, t.clock, tenant.tenantId, ["transfers:write"]);
+    expect((await send(other, "5000")).statusCode).toBe(201);
