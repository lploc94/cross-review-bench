index 0000000..c0a8bbc
--- /dev/null
+++ b/src/api/statementCsv.ts
@@ -0,0 +1,38 @@
+import type { Statement } from "../services/statementService.js";
+
+const HEADER = ["type", "created_at", "entry_id", "transfer_id", "amount", "balance", "currency"];
+
+/**
+ * A statement as CSV (CRLF line ends, header row first): an `opening` row at the start of the
+ * period, one `entry` row per entry, oldest first, and a `closing` row at the end of the period.
+ * Amounts and balances are decimal numbers of major units, which spreadsheets read as numbers;
+ * every field is an id, a timestamp, a number or a currency code, so none needs quoting.
+ */
+export function statementCsv(statement: Statement): string {
+  const { account, period } = statement;
+  const decimal = (amountMinor: bigint) => (Number(amountMinor) / 100).toFixed(2);
+  const balanceRow = (type: string, at: Date, balance: bigint) => [
+    type,
+    at.toISOString(),
+    "",
+    "",
+    "",
+    decimal(balance),
+    account.currency,
+  ];
+  const rows = [
+    HEADER,
+    balanceRow("opening", period.start, statement.openingBalance),
+    ...statement.entries.map((entry) => [
+      "entry",
+      entry.createdAt.toISOString(),
+      entry.id,
+      entry.transferId,
+      decimal(entry.amountMinor),
+      decimal(entry.balanceAfter),
+      entry.currency,
+    ]),
+    balanceRow("closing", period.end, statement.closingBalance),
+  ];
+  return rows.map((row) => `${row.join(",")}\r\n`).join("");
+}
