+++ b/test/api/statements.test.ts
@@ -0,0 +1,151 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { buildTestApp, type TestApp } from "../helpers/app.js";
+import { DEFAULT_TEST_TIME } from "../helpers/clock.js";
+import {
+  createTenant,
+  fundedWallet,
+  issueKey,
+  openAccount,
+  transfer,
+  type EntryBody,
+  type ErrorResponse,
+  type TestTenant,
+} from "../helpers/fixtures.js";
+
+interface StatementBody {
+  account_id: string;
+  currency: string;
+  from: string;
+  to: string;
+  opening_balance: string;
+  closing_balance: string;
+  entries: EntryBody[];
+}
+
+describe("account statements", () => {
+  let t: TestApp;
+  let tenant: TestTenant;
+
+  beforeAll(async () => {
+    t = await buildTestApp();
+  });
+
+  afterAll(async () => {
+    await t.close();
+  });
+
+  beforeEach(async () => {
+    t.clock.set(DEFAULT_TEST_TIME);
+    tenant = await createTenant(t.pool, t.clock);
+  });
+
+  function statement(accountId: string, query: string, as: TestTenant = tenant) {
+    return t.app.inject({
+      method: "GET",
+      url: `/accounts/${accountId}/statement?${query}`,
+      headers: as.headers,
+    });
+  }
+
+  it("reports the opening balance, the period's entries and the closing balance", async () => {
+    t.clock.set("2030-01-20T08:00:00.000Z");
+    const wallet = await fundedWallet(t.app, tenant, "1000");
+    const merchant = await openAccount(t.app, tenant);
+    t.clock.set("2030-02-03T12:00:00.000Z");
+    const first = await transfer(t.app, tenant, wallet.id, merchant.id, "275");
+    t.clock.set("2030-02-17T18:30:00.000Z");
+    const second = await transfer(t.app, tenant, merchant.id, wallet.id, "75");
+
+    const response = await statement(wallet.id, "from=2030-02-01&to=2030-02-28");
+    expect(response.statusCode).toBe(200);
+    const body = response.json<StatementBody>();
+    expect(body).toMatchObject({
+      account_id: wallet.id,
+      currency: "USD",
+      from: "2030-02-01",
+      to: "2030-02-28",
+      opening_balance: "1000",
+      closing_balance: "800",
+    });
+    expect(body.entries.map((e) => [e.transfer_id, e.amount, e.balance_after])).toEqual([
+      [first.id, "-275", "725"],
+      [second.id, "75", "800"],
+    ]);
+  });
+
+  it("covers the whole of the to day and nothing after it", async () => {
+    const wallet = await fundedWallet(t.app, tenant, "1000");
+    const merchant = await openAccount(t.app, tenant);
+    t.clock.set("2030-02-01T00:00:00.000Z");
+    const startOfFrom = await transfer(t.app, tenant, wallet.id, merchant.id, "1");
+    t.clock.set("2030-02-02T23:59:59.999Z");
+    const endOfTo = await transfer(t.app, tenant, wallet.id, merchant.id, "2");
+    t.clock.set("2030-02-03T00:00:00.000Z");
+    await transfer(t.app, tenant, wallet.id, merchant.id, "3");
+
+    const response = await statement(wallet.id, "from=2030-02-01&to=2030-02-02");
+    expect(response.json<StatementBody>().entries.map((e) => e.transfer_id)).toEqual([
+      startOfFrom.id,
+      endOfTo.id,
+    ]);
+  });
+
+  it("reports an unchanged balance for a period without entries", async () => {
+    t.clock.set("2030-01-05T09:00:00.000Z");
+    const wallet = await fundedWallet(t.app, tenant, "640");
+    const body = (await statement(wallet.id, "from=2030-03-01&to=2030-03-31")).json<StatementBody>();
+    expect(body).toMatchObject({ opening_balance: "640", closing_balance: "640", entries: [] });
+  });
+
+  it("exports CSV with a header row and amounts in major units", async () => {
+    t.clock.set("2030-01-20T08:00:00.000Z");
+    const wallet = await fundedWallet(t.app, tenant, "5000");
+    const merchant = await openAccount(t.app, tenant);
+    t.clock.set("2030-02-03T12:00:00.000Z");
+    const paid = await transfer(t.app, tenant, wallet.id, merchant.id, "1250");
+    t.clock.set("2030-02-04T09:15:00.000Z");
+    const back = await transfer(t.app, tenant, merchant.id, wallet.id, "5");
+
+    const response = await statement(merchant.id, "from=2030-02-01&to=2030-02-28&format=csv");
+    expect(response.statusCode).toBe(200);
+    expect(response.headers["content-type"]).toBe("text/csv; charset=utf-8");
+    expect(response.headers["content-disposition"]).toBe(
+      `attachment; filename="statement-${merchant.id}-2030-02-01-2030-02-28.csv"`,
+    );
+    const [header, ...rows] = response.body.trimEnd().split("\r\n");
+    expect(header).toBe("type,created_at,entry_id,transfer_id,amount,balance,currency");
+    expect(rows.map((row) => row.split(","))).toEqual([
+      ["opening", "2030-02-01T00:00:00.000Z", "", "", "", "0.00", "USD"],
+      ["entry", "2030-02-03T12:00:00.000Z", expect.any(String), paid.id, "12.50", "12.50", "USD"],
+      ["entry", "2030-02-04T09:15:00.000Z", expect.any(String), back.id, "-0.05", "12.45", "USD"],
+      ["closing", "2030-03-01T00:00:00.000Z", "", "", "", "12.45", "USD"],
+    ]);
+  });
+
+  it("validates the period and the format", async () => {
+    const wallet = await openAccount(t.app, tenant);
+    for (const query of [
+      "",
+      "from=2030-02-01",
+      "from=2030-02-10&to=2030-02-09",
+      "from=2030-02-30&to=2030-03-01",
+      "from=2030-02-01T00:00:00Z&to=2030-02-02",
+      "from=2030-01-01&to=2031-01-02",
+      "from=2030-02-01&to=2030-02-02&format=xml",
+    ]) {
+      const response = await statement(wallet.id, query);
+      expect(response.statusCode, query).toBe(400);
+      expect(response.json<ErrorResponse>().error.code, query).toBe("validation_error");
+    }
+    expect((await statement(wallet.id, "from=2032-01-01&to=2032-12-31")).statusCode).toBe(200);
+  });
+
+  it("answers 404 for another tenant's account and needs transfers:read", async () => {
+    const wallet = await fundedWallet(t.app, tenant, "100");
+    const other = await createTenant(t.pool, t.clock, { name: "Other" });
+    expect((await statement(wallet.id, "from=2030-01-01&to=2030-01-31", other)).statusCode).toBe(404);
+
+    const accountsOnly = await issueKey(t.pool, t.clock, tenant.tenantId, ["accounts:read"]);
+    expect((await statement(wallet.id, "from=2030-01-01&to=2030-01-31", accountsOnly)).statusCode).toBe(403);
+  });
+});
