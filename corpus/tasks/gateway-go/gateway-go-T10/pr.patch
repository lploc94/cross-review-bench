+// CORSPolicy is a compiled config.CORS.
+type CORSPolicy struct {
+	AnyOrigin   bool     // allow_origins is "*"
+	Origins     []string // the exact origins allowed otherwise
+	Methods     string   // Access-Control-Allow-Methods, "" when none
+	Headers     string   // Access-Control-Allow-Headers, "" when none
+	Expose      string   // Access-Control-Expose-Headers, "" when none
+	Credentials bool
+	MaxAge      int // seconds; 0 leaves the field out
+}
+
+// Allow returns the Access-Control-Allow-Origin value for a request from origin, and false when
+// the origin is not allowed. A wildcard is sent only without credentials; otherwise the origin is
+// echoed back.
+func (c *CORSPolicy) Allow(origin string) (string, bool) {
+	switch {
+	case c.AnyOrigin && !c.Credentials:
+		return "*", true
+	case c.AnyOrigin || slices.Contains(c.Origins, origin):
+		return origin, true
+	}
+	return "", false
+}
+
+func compileCORS(c *config.CORS) *CORSPolicy {
+	p := &CORSPolicy{
+		Methods:     strings.Join(c.AllowMethods, ", "),
+		Headers:     strings.Join(c.AllowHeaders, ", "),
+		Expose:      strings.Join(c.ExposeHeaders, ", "),
+		Credentials: c.AllowCredentials,
+		MaxAge:      int(c.MaxAge.D() / time.Second),
+	}
+	for _, o := range c.AllowOrigins {
+		if o == "*" {
+			p.AnyOrigin = true
+		} else {
+			p.Origins = append(p.Origins, o)
+		}
+	}
+	return p
+}
