+++ b/migrations/0003_index_jobs_finished_at.sql
@@ -0,0 +1,2 @@
+-- Retention: finished jobs, oldest first. Only terminal jobs have finished_at set.
+CREATE INDEX jobs_finished_at_idx ON jobs (finished_at, id) WHERE finished_at IS NOT NULL;
