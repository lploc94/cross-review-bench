diff --git a/internal/retention/purger.go b/internal/retention/purger.go
new file mode 100644
index 0000000..afc456a
--- /dev/null
+++ b/internal/retention/purger.go
@@ -0,0 +1,97 @@
+// Package retention deletes finished jobs once they are older than the retention period, so
+// that the jobs table does not grow without bound.
+package retention
+
+import (
+	"context"
+	"errors"
+	"log/slog"
+	"time"
+
+	"github.com/relaywork/jobqueue/internal/clock"
+	"github.com/relaywork/jobqueue/internal/metrics"
+	"github.com/relaywork/jobqueue/internal/store"
+)
+
+// Store is the part of the job store the purger needs.
+type Store interface {
+	// PurgeFinished deletes one batch of jobs that finished before cutoff.
+	PurgeFinished(ctx context.Context, cutoff time.Time) ([]store.PurgedJob, error)
+}
+
+// Purger periodically deletes jobs that finished more than the retention period ago.
+type Purger struct {
+	store     Store
+	retention time.Duration
+	interval  time.Duration
+	batchSize int
+	clock     clock.Clock
+	log       *slog.Logger
+	purged    *metrics.Counter
+}
+
+// New returns a purger that runs every interval and deletes jobs that finished more than
+// retention ago. batchSize must match the most jobs one PurgeFinished call deletes, so that the
+// purger knows when to call again.
+func New(st Store, retention, interval time.Duration, batchSize int, clk clock.Clock, logger *slog.Logger, reg *metrics.Registry) (*Purger, error) {
+	if retention <= 0 {
+		return nil, errors.New("retention: retention period must be positive")
+	}
+	if interval <= 0 {
+		return nil, errors.New("retention: interval must be positive")
+	}
+	if batchSize < 1 {
+		return nil, errors.New("retention: batch size must be positive")
+	}
+	if reg == nil {
+		reg = metrics.NewRegistry()
+	}
+	return &Purger{
+		store:     st,
+		retention: retention,
+		interval:  interval,
+		batchSize: batchSize,
+		clock:     clk,
+		log:       logger.With("component", "purger"),
+		purged: reg.NewCounter("jobqueue_jobs_purged_total",
+			"Finished jobs deleted after the retention period, by the state they ended in.", "queue", "state"),
+	}, nil
+}
+
+// Run purges once immediately and then every interval until ctx is done. It returns nil when ctx
+// is cancelled; errors of individual passes are logged and retried at the next interval.
+func (p *Purger) Run(ctx context.Context) error {
+	for {
+		if _, err := p.PurgeOnce(ctx); err != nil && ctx.Err() == nil {
+			p.log.Error("purge finished jobs", "error", err)
+		}
+		select {
+		case <-ctx.Done():
+			return nil
+		case <-p.clock.After(p.interval):
+		}
+	}
+}
+
+// PurgeOnce deletes every job that finished before now minus the retention period, in batches,
+// and returns how many it deleted.
+func (p *Purger) PurgeOnce(ctx context.Context) (int, error) {
+	cutoff := p.clock.Now().Add(-p.retention)
+	total := 0
+	for {
+		jobs, err := p.store.PurgeFinished(ctx, cutoff)
+		if err != nil {
+			return total, err
+		}
+		for _, j := range jobs {
+			p.purged.Inc(j.Queue, string(j.State))
+		}
+		total += len(jobs)
+		if len(jobs) < p.batchSize {
+			if total > 0 {
+				p.log.Info("purged finished jobs", "count", total, "finished_before", cutoff)
+			}
+			return total, nil
+		}
+	}
+}
diff --git a/internal/retention/purger_test.go b/internal/retention/purger_test.go
new file mode 100644
index 0000000..e2b295b
--- /dev/null
+++ b/internal/retention/purger_test.go
@@ -0,0 +1,125 @@
+package retention_test
+
+import (
+	"context"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/relaywork/jobqueue/internal/clock"
+	"github.com/relaywork/jobqueue/internal/domain"
+	"github.com/relaywork/jobqueue/internal/logging"
+	"github.com/relaywork/jobqueue/internal/metrics"
+	"github.com/relaywork/jobqueue/internal/retention"
+	"github.com/relaywork/jobqueue/internal/store"
+)
+
+var t0 = time.Date(2025, time.March, 10, 9, 0, 0, 0, time.UTC)
+
+const retentionPeriod = 14 * 24 * time.Hour
+
+// fakeStore hands out the given batches, one per call, then empty ones.
+type fakeStore struct {
+	mu      sync.Mutex
+	batches [][]store.PurgedJob
+	cutoffs []time.Time
+}
+
+func (f *fakeStore) PurgeFinished(_ context.Context, cutoff time.Time) ([]store.PurgedJob, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.cutoffs = append(f.cutoffs, cutoff)
+	if len(f.batches) == 0 {
+		return nil, nil
+	}
+	b := f.batches[0]
+	f.batches = f.batches[1:]
+	return b, nil
+}
+
+func (f *fakeStore) calls() []time.Time {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return append([]time.Time(nil), f.cutoffs...)
+}
+
+func batch(n int, queue string, st domain.State) []store.PurgedJob {
+	out := make([]store.PurgedJob, n)
+	for i := range out {
+		out[i] = store.PurgedJob{ID: int64(i + 1), Queue: queue, State: st}
+	}
+	return out
+}
+
+func newPurger(t *testing.T, st retention.Store, clk clock.Clock, reg *metrics.Registry) *retention.Purger {
+	t.Helper()
+	p, err := retention.New(st, retentionPeriod, 10*time.Minute, 3, clk, logging.Discard(), reg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+func TestPurgeOnceDrainsFullBatches(t *testing.T) {
+	st := &fakeStore{batches: [][]store.PurgedJob{
+		batch(3, "emails", domain.StateSucceeded),
+		batch(3, "emails", domain.StateDead),
+		batch(2, "reports", domain.StateCancelled),
+	}}
+	reg := metrics.NewRegistry()
+	n, err := newPurger(t, st, clock.NewManual(t0), reg).PurgeOnce(context.Background())
+	if err != nil || n != 8 {
+		t.Fatalf("PurgeOnce = %d, %v; want 8", n, err)
+	}
+	calls := st.calls()
+	if len(calls) != 3 || !calls[0].Equal(t0.Add(-retentionPeriod)) {
+		t.Errorf("cutoffs = %v, want 3 calls at %s (stop after the partial batch)", calls, t0.Add(-retentionPeriod))
+	}
+
+	var buf strings.Builder
+	if err := reg.WriteText(&buf); err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{
+		`jobqueue_jobs_purged_total{queue="emails",state="succeeded"} 3`,
+		`jobqueue_jobs_purged_total{queue="emails",state="dead"} 3`,
+		`jobqueue_jobs_purged_total{queue="reports",state="cancelled"} 2`,
+	} {
+		if !strings.Contains(buf.String(), want) {
+			t.Errorf("metrics lack %s:\n%s", want, buf.String())
+		}
+	}
+}
+
+func TestPurgerRunsEveryInterval(t *testing.T) {
+	st := &fakeStore{}
+	clk := clock.NewManual(t0)
+	p := newPurger(t, st, clk, nil)
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- p.Run(ctx) }()
+
+	clk.BlockUntil(1)
+	clk.Advance(10 * time.Minute)
+	clk.BlockUntil(1)
+	calls := st.calls()
+	if len(calls) != 2 || !calls[1].Equal(t0.Add(10*time.Minute-retentionPeriod)) {
+		t.Fatalf("cutoffs = %v, want a second pass at %s", calls, t0.Add(10*time.Minute-retentionPeriod))
+	}
+	cancel()
+	if err := <-done; err != nil {
+		t.Errorf("Run returned %v after cancel, want nil", err)
+	}
+}
+
+func TestNewValidates(t *testing.T) {
+	for _, tc := range []struct {
+		retention, interval time.Duration
+		batch               int
+	}{{0, time.Minute, 10}, {time.Hour, 0, 10}, {time.Hour, time.Minute, 0}} {
+		if _, err := retention.New(&fakeStore{}, tc.retention, tc.interval, tc.batch, clock.Real{}, logging.Discard(), nil); err == nil {
+			t.Errorf("%+v accepted", tc)
+		}
+	}
+}
diff --git a/internal/store/purge.go b/internal/store/purge.go
new file mode 100644
index 0000000..34558eb
--- /dev/null
+++ b/internal/store/purge.go
@@ -0,0 +1,61 @@
+package store
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+
+	"github.com/relaywork/jobqueue/internal/domain"
+)
+
+// PurgeBatchSize is the most jobs one PurgeFinished call deletes. Callers that get a full batch
+// call again.
+const PurgeBatchSize = 1000
+
+// PurgedJob describes a job that PurgeFinished deleted.
+type PurgedJob struct {
+	ID    int64
+	Queue string
+	State domain.State
+}
+
+// PurgeFinished deletes up to PurgeBatchSize jobs that reached a terminal state (succeeded,
+// failed, cancelled or dead) before cutoff, oldest first, and returns what it deleted.
+func (s *Store) PurgeFinished(ctx context.Context, cutoff time.Time) ([]PurgedJob, error) {
+	rows, err := s.pool.Query(ctx, `
+		SELECT id FROM jobs
+		WHERE state IN ('succeeded', 'failed', 'cancelled', 'dead') AND finished_at < $1
+		ORDER BY finished_at, id
+		LIMIT $2`,
+		dbTime(cutoff), PurgeBatchSize)
+	if err != nil {
+		return nil, fmt.Errorf("find finished jobs: %w", err)
+	}
+	ids, err := pgx.CollectRows(rows, pgx.RowTo[int64])
+	if err != nil {
+		return nil, fmt.Errorf("find finished jobs: %w", err)
+	}
+	if len(ids) == 0 {
+		return nil, nil
+	}
+
+	rows, err = s.pool.Query(ctx, `DELETE FROM jobs WHERE id = ANY($1) RETURNING id, queue, state`, ids)
+	if err != nil {
+		return nil, fmt.Errorf("delete finished jobs: %w", err)
+	}
+	purged, err := pgx.CollectRows(rows, func(row pgx.CollectableRow) (PurgedJob, error) {
+		var (
+			p     PurgedJob
+			state string
+		)
+		err := row.Scan(&p.ID, &p.Queue, &state)
+		p.State = domain.State(state)
+		return p, err
+	})
+	if err != nil {
+		return nil, fmt.Errorf("delete finished jobs: %w", err)
+	}
+	return purged, nil
+}
