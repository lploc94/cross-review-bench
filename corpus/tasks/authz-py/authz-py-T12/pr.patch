+    async def transfer_ownership(
+        self,
+        principal: Principal,
+        org_id: uuid.UUID,
+        user_id: uuid.UUID,
+        *,
+        stay_owner: bool = False,
+    ) -> OwnershipTransfer:
+        """Make another member an owner and, unless `stay_owner`, demote the caller to admin.
+
+        Only a member whose membership role is `owner` may do this; holding `org:manage` through
+        a role assignment is not enough. Role assignments of both members are left as they are.
+        """
+        if user_id == principal.user_id:
+            raise InvalidInputError(
+                "you cannot transfer ownership to yourself", details={"field": "user_id"}
+            )
+        async with self._db.transaction() as session:
+            await self._lock_org(session, org_id)
+            memberships = MembershipRepository(session)
+            roles = RoleRepository(session)
+            owner_role = await roles.get_by_name(org_id, BuiltinRole.OWNER.value)
+            admin_role = await roles.get_by_name(org_id, BuiltinRole.ADMIN.value)
+            if owner_role is None or admin_role is None:
+                raise NotFoundError("role")
+            caller = await memberships.get(org_id, principal.user_id)
+            if caller is None or caller.role_id != owner_role.id:
+                raise PermissionDenied("only an owner can transfer ownership")
+            target = await memberships.get_member(org_id, user_id)
+            if target is None:
+                raise NotFoundError("member")
+            if target.user.disabled_at is not None:
+                raise ConflictError("ownership cannot go to a disabled account")
+            if target.membership.role_id == owner_role.id:
+                raise ConflictError("the member is already an owner")
+
+            now = self._clock.now()
+            actor = Actor.of(principal)
+            target_old_role_id = target.membership.role_id
+            await memberships.set_role(target.membership, owner_role.id, now)
+            await self._audit.record(
+                session,
+                actor,
+                org_id=org_id,
+                action=AuditAction.MEMBER_ROLE_CHANGED,
+                target_type="user",
+                target_id=user_id,
+                data={"from_role_id": target_old_role_id, "to_role_id": owner_role.id},
+            )
+            if not stay_owner:
+                await self._ensure_owner_remains(session, org_id, owner_role.id, admin_role)
+                await memberships.set_role(caller, admin_role.id, now)
+                await self._audit.record(
+                    session,
+                    actor,
+                    org_id=org_id,
+                    action=AuditAction.MEMBER_ROLE_CHANGED,
+                    target_type="user",
+                    target_id=principal.user_id,
+                    data={"from_role_id": owner_role.id, "to_role_id": admin_role.id},
+                )
+            await self._audit.record(
+                session,
+                actor,
+                org_id=org_id,
+                action=AuditAction.OWNERSHIP_TRANSFERRED,
+                target_type="user",
+                target_id=user_id,
+                data={
+                    "from_user_id": principal.user_id,
+                    "previous_role_id": target_old_role_id,
+                    "stayed_owner": stay_owner,
+                },
+            )
+            new_owner = await memberships.get_member(org_id, user_id)
+            previous_owner = await memberships.get_member(org_id, principal.user_id)
+        if new_owner is None or previous_owner is None:
+            raise NotFoundError("member")
+        return OwnershipTransfer(new_owner=new_owner, previous_owner=previous_owner)
+
