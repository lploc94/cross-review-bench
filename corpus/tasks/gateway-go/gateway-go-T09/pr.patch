diff --git a/internal/proxy/mirror.go b/internal/proxy/mirror.go
new file mode 100644
index 0000000..af777ce
--- /dev/null
+++ b/internal/proxy/mirror.go
@@ -0,0 +1,69 @@
+package proxy
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net/http"
+)
+
+// maxMirrorsInFlight bounds the mirrored requests that run at once. A request that would exceed
+// it is dropped and counted, so a slow shadow upstream cannot grow the gateway's memory.
+const maxMirrorsInFlight = 64
+
+// mirror starts a copy of the request for the route's shadow upstream, when the route samples
+// it and its body is held in memory. The copy runs in its own goroutine: the client's response
+// neither waits for it nor depends on it.
+func (h *Handler) mirror(ex *exchange, body *requestBody) {
+	m := ex.route.Mirror
+	if m == nil || !body.replayable || int(h.rand.Int64N(100)) >= m.Percent {
+		return
+	}
+	select {
+	case h.mirrorSlots <- struct{}{}:
+	default:
+		h.metrics.mirrors.Inc("dropped")
+		return
+	}
+
+	r := ex.req
+	target := *m.URL
+	path, rawPath := ex.route.ForwardPath(r.URL)
+	target.Path, target.RawPath = joinPath(m.URL, path, rawPath)
+	target.RawQuery = r.URL.RawQuery
+	target.ForceQuery = false
+	target.Fragment, target.RawFragment = "", ""
+
+	buf := body.content()
+	out := (&http.Request{
+		Method:     r.Method,
+		URL:        &target,
+		Proto:      "HTTP/1.1",
+		ProtoMajor: 1,
+		ProtoMinor: 1,
+		Header:     outboundHeader(r.Header, ex.route, ex.strip, ex.client, ex.id, ex.consumer.ID),
+		Host:       target.Host,
+	})
+	if len(buf) > 0 {
+		out.Body = io.NopCloser(bytes.NewReader(buf))
+		out.ContentLength = int64(len(buf))
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), ex.route.Timeout)
+	out = out.WithContext(ctx)
+
+	go func() {
+		defer cancel()
+		defer func() { <-h.mirrorSlots }()
+		resp, err := h.transport.RoundTrip(out)
+		if err != nil {
+			h.metrics.mirrors.Inc("failed")
+			h.log.Debug("mirror request failed", "route", ex.route.ID, "error", err, "request_id", ex.id)
+			return
+		}
+		if resp.StatusCode >= 500 {
+			h.metrics.mirrors.Inc("failed")
+			return
+		}
+		h.metrics.mirrors.Inc("ok")
+	}()
+}
diff --git a/internal/proxy/mirror_test.go b/internal/proxy/mirror_test.go
new file mode 100644
index 0000000..47243ca
--- /dev/null
+++ b/internal/proxy/mirror_test.go
@@ -0,0 +1,111 @@
+package proxy
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// mirrorRoutes mirrors every request of the orders route, which retries non-idempotent
+// methods, so its bodies are buffered.
+const mirrorRoutes = `{"routes":[{"id":"orders","path_prefix":"/orders","upstreams":[{"url":"http://up.test"}],
+	"retry":{"attempts":2,"non_idempotent":true},
+	"mirror":{"url":"http://shadow.test/base","percent":100}}]}`
+
+// waitShadow waits until the shadow upstream has answered, or fails the test.
+func waitShadow(t *testing.T, done <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		t.Fatal("the mirror request never reached the shadow upstream")
+	}
+}
+
+func TestMirrorSendsBufferedCopy(t *testing.T) {
+	done := make(chan struct{})
+	var once sync.Once
+	tr := &fakeTransport{respond: func(n int, r *http.Request) (*http.Response, error) {
+		if r.URL.Host == "shadow.test" {
+			defer once.Do(func() { close(done) })
+			return reply(r, 202, "shadow"), nil
+		}
+		return reply(r, 200, "from "+r.URL.Host), nil
+	}}
+	f := newFixture(t, mirrorRoutes, fixtureOptions{transport: tr})
+
+	w := f.do(httptest.NewRequest(http.MethodPost, "/orders/9?x=1", strings.NewReader(`{"id":9}`)))
+	if w.Code != http.StatusOK || w.Body.String() != "from up.test" {
+		t.Fatalf("client got %d %q; the upstream's answer must be relayed", w.Code, w.Body.String())
+	}
+	waitShadow(t, done)
+
+	var shadow *sent
+	for _, c := range tr.sent() {
+		if strings.Contains(c.url, "shadow.test") {
+			shadow = &c
+		}
+	}
+	if shadow == nil {
+		t.Fatal("no request reached the shadow upstream")
+	}
+	if shadow.method != http.MethodPost || shadow.url != "http://shadow.test/base/orders/9?x=1" {
+		t.Errorf("shadow request = %s %s, want POST to the shadow base with the same path and query", shadow.method, shadow.url)
+	}
+	if shadow.body != `{"id":9}` || shadow.length != 8 {
+		t.Errorf("shadow body = %q (length %d), want the buffered body", shadow.body, shadow.length)
+	}
+	if shadow.header.Get("X-Request-Id") == "" {
+		t.Error("shadow request lacks the gateway's request id")
+	}
+	if !f.has(`gateway_mirror_requests_total{result="ok"} 1`) {
+		t.Error("a shadow answer below 500 is not counted as ok")
+	}
+}
+
+func TestMirrorFailureDoesNotChangeTheResponse(t *testing.T) {
+	done := make(chan struct{})
+	var once sync.Once
+	tr := &fakeTransport{respond: func(n int, r *http.Request) (*http.Response, error) {
+		if r.URL.Host == "shadow.test" {
+			defer once.Do(func() { close(done) })
+			return reply(r, 503, "busy"), nil
+		}
+		return reply(r, 200, "fine"), nil
+	}}
+	f := newFixture(t, mirrorRoutes, fixtureOptions{transport: tr})
+
+	w := f.get("/orders/1")
+	if w.Code != http.StatusOK || w.Body.String() != "fine" {
+		t.Fatalf("client got %d %q while the shadow failed", w.Code, w.Body.String())
+	}
+	waitShadow(t, done)
+	if !f.has(`gateway_mirror_requests_total{result="failed"} 1`) {
+		t.Error("a shadow 5xx is not counted as failed")
+	}
+}
+
+func TestMirrorDropsCopiesBeyondTheLimit(t *testing.T) {
+	release := make(chan struct{})
+	defer close(release)
+	tr := &fakeTransport{respond: func(n int, r *http.Request) (*http.Response, error) {
+		if r.URL.Host == "shadow.test" {
+			<-release // the shadow never answers while the test runs
+		}
+		return reply(r, 200, "ok"), nil
+	}}
+	f := newFixture(t, `{"routes":[{"id":"a","path_prefix":"/","upstreams":[{"url":"http://up.test"}],
+		"mirror":{"url":"http://shadow.test","percent":100}}]}`, fixtureOptions{transport: tr})
+
+	for i := range maxMirrorsInFlight + 1 {
+		if w := f.get("/x"); w.Code != http.StatusOK {
+			t.Fatalf("request %d: client got %d", i, w.Code)
+		}
+	}
+	if !f.has(`gateway_mirror_requests_total{result="dropped"} 1`) {
+		t.Errorf("the copy beyond %d in flight was not dropped and counted", maxMirrorsInFlight)
+	}
+}
