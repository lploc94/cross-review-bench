+describe("revoking a device", () => {
+  function revoke(by: TestDevice, deviceId: string) {
+    return request(by, "POST", `/v1/devices/${deviceId}/revoke`);
+  }
+
+  it("refuses the revoked device's pushes and shows when it was revoked", async () => {
+    const phone = await addDevice(t, ada, "phone");
+    const res = await revoke(ada, phone.deviceId);
+    expect(res.statusCode).toBe(200);
+    const revokedAt = new Date(t.clock.now()).toISOString();
+    expect(res.json()).toMatchObject({ device: { id: phone.deviceId, name: "phone", revokedAt } });
+
+    const pushed = await push(t, phone, [mutation({ hlc: hlc(t.clock.now()) })]);
+    expect(pushed.statusCode).toBe(401);
+    expect(pushed.json()).toMatchObject({ error: { code: "device_revoked" } });
+
+    const me = await request(phone, "GET", "/v1/me");
+    expect(me.statusCode).toBe(200);
+    expect(me.json()).toMatchObject({ device: { id: phone.deviceId, revokedAt } });
+    expect((await push(t, ada, [mutation({ hlc: hlc(t.clock.now()) })])).statusCode).toBe(200);
+  });
+
+  it("keeps the first revocation time", async () => {
+    const phone = await addDevice(t, ada, "phone");
+    const first = (await revoke(ada, phone.deviceId)).json<{ device: { revokedAt: string } }>().device.revokedAt;
+    t.clock.advance(60_000);
+    const again = await revoke(ada, phone.deviceId);
+    expect(again.statusCode).toBe(200);
+    expect(again.json()).toMatchObject({ device: { revokedAt: first } });
+  });
+
+  it("lets a device revoke itself, after which it cannot register or revoke devices", async () => {
+    const phone = await addDevice(t, ada, "phone");
+    expect((await revoke(phone, phone.deviceId)).statusCode).toBe(200);
+    expect((await request(phone, "POST", "/v1/devices", { name: "tablet" })).statusCode).toBe(401);
+    expect((await revoke(phone, ada.deviceId)).statusCode).toBe(401);
+    expect((await request(ada, "GET", "/v1/me")).json()).toMatchObject({ device: { revokedAt: null } });
+  });
+
+  it("does not revoke other users' devices or unknown ones", async () => {
+    const grace = await createUser(t, "Grace");
+    expect((await revoke(ada, grace.deviceId)).statusCode).toBe(404);
+    expect((await revoke(ada, "00000000-0000-4000-8000-00000000abcd")).statusCode).toBe(404);
+    expect((await revoke(ada, "not-a-uuid")).statusCode).toBe(400);
+    expect((await request(grace, "GET", "/v1/me")).json()).toMatchObject({ device: { revokedAt: null } });
+  });
+});
