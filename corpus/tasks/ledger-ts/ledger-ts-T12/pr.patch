 const accountNameSchema = z
@@ -17,3 +28,65 @@ export const createAccountBodySchema = z.strictObject({
 });
 
 export type CreateAccountBody = z.infer<typeof createAccountBodySchema>;
+
+const labelKeySchema = z
+  .string()
+  .min(1)
+  .max(MAX_LABEL_KEY_LENGTH)
+  .regex(LABEL_KEY_PATTERN, { error: "label keys may only use letters, digits, '_', '.' and '-'" });
+
+/** Label values: at most 100 characters, storable in Postgres. Filters use the same rules. */
+const labelValueSchema = z
+  .string()
+  .max(MAX_LABEL_VALUE_LENGTH)
+  .refine(storableText, { error: STORABLE_TEXT_MESSAGE });
+
+/** Account labels: up to 20 keys, each mapped to a string of at most 100 characters. */
+export const labelsSchema = z
+  .record(labelKeySchema, labelValueSchema)
+  .refine((labels) => Object.keys(labels).length <= MAX_LABELS, {
+    error: `must have at most ${MAX_LABELS} labels`,
+  });
+
+/** `PATCH /accounts/:id`: a new name, a new set of labels (replacing the old ones), or both. */
+export const updateAccountBodySchema = z
+  .strictObject({
+    name: accountNameSchema.optional(),
+    labels: labelsSchema.optional(),
+  })
+  .refine((body) => body.name !== undefined || body.labels !== undefined, {
+    error: "name or labels is required",
+  });
+
+export type UpdateAccountBody = z.infer<typeof updateAccountBodySchema>;
+
+/**
+ * One `label=key:value` filter. Keys cannot contain ':', so the first ':' separates the key from
+ * the value, and the value may contain more of them ("region:eu:west").
+ */
+const labelFilterSchema = z.string().transform((value, ctx) => {
+  const colon = value.indexOf(":");
+  const key = value.slice(0, colon);
+  if (colon < 0 || !labelKeySchema.safeParse(key).success) {
+    ctx.issues.push({ code: "custom", message: "must be a label key:value", input: value });
+    return z.NEVER;
+  }
+  const labelValue = labelValueSchema.safeParse(value.slice(colon + 1));
+  if (!labelValue.success) {
+    for (const issue of labelValue.error.issues) {
+      ctx.issues.push({ code: "custom", message: issue.message, input: value });
+    }
+    return z.NEVER;
+  }
+  return [key, labelValue.data] as const;
+});
+
+/** `GET /accounts`: pagination plus any number of `label` filters, all of which must match. */
+export const listAccountsQuerySchema = paginationQuerySchema.extend({
+  label: z
+    .union([
+      labelFilterSchema.transform((filter) => [filter]),
+      z.array(labelFilterSchema).max(MAX_LABELS),
+    ])
+    .optional(),
+});
