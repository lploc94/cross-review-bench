@@ -0,0 +1,83 @@
+package com.papertrail.workflow.domain;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.FetchType;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.JoinColumn;
+import jakarta.persistence.ManyToOne;
+import jakarta.persistence.Table;
+import java.time.Instant;
+import java.time.LocalDate;
+
+/** A user's approval tasks handed to another user for a period of days. */
+@Entity
+@Table(name = "delegation")
+public class Delegation extends AbstractEntity<Long> {
+
+  @Id
+  @GeneratedValue(strategy = GenerationType.IDENTITY)
+  private Long id;
+
+  @ManyToOne(fetch = FetchType.LAZY, optional = false)
+  @JoinColumn(name = "delegator_id", nullable = false)
+  private AppUser delegator;
+
+  @ManyToOne(fetch = FetchType.LAZY, optional = false)
+  @JoinColumn(name = "delegate_id", nullable = false)
+  private AppUser delegate;
+
+  @Column(name = "starts_on", nullable = false)
+  private LocalDate startsOn;
+
+  @Column(name = "ends_on", nullable = false)
+  private LocalDate endsOn;
+
+  @Column(name = "created_at", nullable = false)
+  private Instant createdAt;
+
+  protected Delegation() {}
+
+  public Delegation(
+      AppUser delegator, AppUser delegate, LocalDate startsOn, LocalDate endsOn, Instant now) {
+    if (delegator.getId().equals(delegate.getId())) {
+      throw new ValidationException("a user cannot delegate to themself");
+    }
+    if (endsOn.isBefore(startsOn)) {
+      throw new ValidationException("until must not be before from");
+    }
+    this.delegator = delegator;
+    this.delegate = delegate;
+    this.startsOn = startsOn;
+    this.endsOn = endsOn;
+    this.createdAt = now;
+  }
+
+  /** Whether the delegation is in force on {@code day}, a date in the business calendar's zone. */
+  public boolean coversDay(LocalDate day) {
+    return !day.isBefore(startsOn) && day.isBefore(endsOn);
+  }
+
+  @Override
+  public Long getId() {
+    return id;
+  }
+
+  public AppUser getDelegator() {
+    return delegator;
+  }
+
+  public AppUser getDelegate() {
+    return delegate;
+  }
+
+  public LocalDate getStartsOn() {
+    return startsOn;
+  }
+
+  public LocalDate getEndsOn() {
+    return endsOn;
+  }
+}
