+def _format_age(age: timedelta | None) -> str:
+    if age is None:
+        return "never"
+    return str(timedelta(seconds=int(age.total_seconds())))
+
+
+@sources_app.command("stale")
+@guarded
+def stale_command(
+    ctx: typer.Context,
+    as_json: Annotated[bool, typer.Option("--json", help="Print JSON.")] = False,
+) -> None:
+    """Show how long ago each source last loaded successfully.
+
+    Exits with the stale-sources code when a source has had no successful run within its max
+    age.
+    """
+    views = sources_api.source_freshness(app_context(ctx))
+    if as_json:
+        echo_json(views)
+    else:
+        rows = [
+            [
+                view.source,
+                "STALE" if view.stale else "fresh",
+                str(view.max_age),
+                str(view.last_succeeded_run_id) if view.last_succeeded_run_id is not None else "-",
+                format_time(view.last_succeeded_at),
+                _format_age(view.age),
+            ]
+            for view in views
+        ]
+        header = ["source", "state", "max age", "last good", "succeeded at", "age"]
+        typer.echo(render_table(header, rows))
+    stale = [view.source for view in views if view.stale]
+    if stale:
+        raise SourcesStale(stale)
+
+
