diff --git a/internal/store/stats.go b/internal/store/stats.go
new file mode 100644
index 0000000..ef28e58
--- /dev/null
+++ b/internal/store/stats.go
@@ -0,0 +1,69 @@
+package store
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+
+	"github.com/relaywork/jobqueue/internal/domain"
+)
+
+// QueueStats summarizes the jobs of one queue.
+type QueueStats struct {
+	Queue           string
+	Counts          map[domain.State]int64 // jobs per state; every state is present
+	OldestAvailable *time.Time             // run_at of the oldest due available job, if any
+}
+
+// Total returns the number of jobs in the queue, in any state.
+func (q QueueStats) Total() int64 {
+	var n int64
+	for _, c := range q.Counts {
+		n += c
+	}
+	return n
+}
+
+// QueueStats returns the statistics of every queue that has jobs, ordered by queue name.
+func (s *Store) QueueStats(ctx context.Context) ([]QueueStats, error) {
+	rows, err := s.pool.Query(ctx, `SELECT DISTINCT queue FROM jobs ORDER BY queue`)
+	if err != nil {
+		return nil, fmt.Errorf("list queues: %w", err)
+	}
+	queues, err := pgx.CollectRows(rows, pgx.RowTo[string])
+	if err != nil {
+		return nil, fmt.Errorf("list queues: %w", err)
+	}
+	out := make([]QueueStats, 0, len(queues))
+	for _, q := range queues {
+		st, err := s.QueueStatsOf(ctx, q)
+		if err != nil {
+			return nil, err
+		}
+		out = append(out, st)
+	}
+	return out, nil
+}
+
+// QueueStatsOf returns the statistics of one queue. A queue without jobs has zero counts.
+func (s *Store) QueueStatsOf(ctx context.Context, queue string) (QueueStats, error) {
+	st := QueueStats{Queue: queue, Counts: make(map[domain.State]int64, len(domain.States))}
+	for _, state := range domain.States {
+		var n int64
+		err := s.pool.QueryRow(ctx, `SELECT count(*) FROM jobs WHERE queue = $1 AND state = $2`,
+			queue, string(state)).Scan(&n)
+		if err != nil {
+			return QueueStats{}, fmt.Errorf("count %s jobs of queue %q: %w", state, queue, err)
+		}
+		st.Counts[state] = n
+	}
+	err := s.pool.QueryRow(ctx, `SELECT min(run_at) FROM jobs WHERE queue = $1 AND state = 'available' AND run_at <= $2`,
+		queue, s.now()).Scan(&st.OldestAvailable)
+	if err != nil {
+		return QueueStats{}, fmt.Errorf("oldest available job of queue %q: %w", queue, err)
+	}
+	st.OldestAvailable = utcPtr(st.OldestAvailable)
+	return st, nil
+}
