+import type { FastifyPluginAsync } from "fastify";
+import { authOf, requireScope } from "../plugins/auth.js";
+import { wildcardParamsSchema } from "../schemas/common.js";
+import { putRetentionBodySchema } from "../schemas/retention.js";
+import { serializeRetentionRule } from "../serializers.js";
+import { parse } from "../validation.js";
+import type { RouteOptions } from "./types.js";
+
+/** The caller's retention rules: `/v1/retention/<folder prefix>/`. */
+export const retentionRoutes: FastifyPluginAsync<RouteOptions> = async (app, { services }) => {
+  app.get("/retention", { preHandler: requireScope("tenant:read") }, async (request) => {
+    const { tenantId } = authOf(request);
+    const rules = await services.retention.listRules(tenantId);
+    return { data: rules.map(serializeRetentionRule) };
+  });
+
+  app.put("/retention/*", { preHandler: requireScope("tenant:admin") }, async (request) => {
+    const { tenantId } = authOf(request);
+    const params = parse(wildcardParamsSchema, request.params, "params");
+    const body = parse(putRetentionBodySchema, request.body, "body");
+    return serializeRetentionRule(await services.retention.setRule(tenantId, params["*"], body.days));
+  });
+
+  app.delete("/retention/*", { preHandler: requireScope("tenant:admin") }, async (request, reply) => {
+    const { tenantId } = authOf(request);
+    const params = parse(wildcardParamsSchema, request.params, "params");
+    await services.retention.removeRule(tenantId, params["*"]);
+    return reply.code(204).send();
+  });
+};
