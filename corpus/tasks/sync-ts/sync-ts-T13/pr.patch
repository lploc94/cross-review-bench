new file mode 100644
index 0000000..06bd73d
--- /dev/null
+++ b/packages/client/src/sync/collections.ts
@@ -0,0 +1,134 @@
+import { COLLECTION_NAMES, SyncError, isCollectionName, type CollectionName, type Hlc } from "@sync/shared";
+import type { SqliteDatabase } from "../store/database.js";
+import type { DocsStore } from "../store/docsStore.js";
+import type { MetaStore } from "../store/metaStore.js";
+import type { SyncTransport } from "../transport/transport.js";
+import { applyRemoteEvents } from "./applyRemote.js";
+import { checkPage } from "./pullPhase.js";
+
+/** A read or write of a collection the replica does not keep, or has not re-pulled yet. */
+export class CollectionNotKeptError extends SyncError {
+  readonly collection: string;
+
+  constructor(collection: string, pending: boolean) {
+    super(
+      "collection_not_kept",
+      pending
+        ? `${collection} was added to this replica but its history is not pulled yet; call resync() first`
+        : `this replica does not keep ${collection}; open it with collections that include it`,
+      { details: { collection, pending } },
+    );
+    this.collection = collection;
+  }
+}
+
+/** The collections a replica keeps, and those added to it that wait for `resync()`. */
+export interface CollectionSet {
+  readonly kept: readonly CollectionName[];
+  readonly pending: readonly CollectionName[];
+}
+
+/** Check the `collections` option: known names, each once, at least one; in canonical order. */
+export function checkCollectionsOption(collections: readonly string[]): CollectionName[] {
+  if (collections.length === 0) throw new RangeError("collections must name at least one collection");
+  const seen = new Set<string>();
+  for (const name of collections) {
+    if (!isCollectionName(name)) throw new RangeError(`unknown collection ${JSON.stringify(name)}`);
+    if (seen.has(name)) throw new RangeError(`collection ${name} is listed twice`);
+    seen.add(name);
+  }
+  return COLLECTION_NAMES.filter((name) => seen.has(name));
+}
+
+/**
+ * Apply the `collections` option to the stored set; run inside the transaction of `open`. A new
+ * database keeps what is requested. An existing replica keeps the requested collections it
+ * already holds and deletes the documents of those left out; the others become pending: their
+ * events before the pull cursor were skipped, so they wait until `resync()` pulls them again.
+ * Without the option nothing changes.
+ */
+export function applyCollectionsOption(
+  meta: MetaStore,
+  docs: DocsStore,
+  requested: readonly CollectionName[] | undefined,
+  isNew: boolean,
+): void {
+  if (requested === undefined) return;
+  if (isNew) {
+    meta.setCollections(requested);
+    return;
+  }
+  const stored: CollectionSet = { kept: meta.collections() ?? COLLECTION_NAMES, pending: meta.pendingCollections() };
+  const kept = stored.kept.filter((name) => requested.includes(name));
+  const pending = requested.filter((name) => !stored.kept.includes(name));
+  for (const name of [...stored.kept, ...stored.pending]) {
+    if (!requested.includes(name)) docs.deleteCollection(name);
+  }
+  // A different pending set starts its re-pull over from the beginning of the feed.
+  if (pending.join() !== stored.pending.join()) meta.setResyncAfter(0);
+  meta.setCollections(kept);
+  meta.setPendingCollections(pending);
+}
+
+export interface RepullContext {
+  readonly db: SqliteDatabase;
+  readonly docs: DocsStore;
+  readonly meta: MetaStore;
+  readonly hlc: Hlc;
+  readonly transport: SyncTransport;
+  readonly limit: number;
+}
+
+/**
+ * Pull the feed again from its start up to the pull cursor, applying only the events of the
+ * pending collections, then keep those collections. The stored state drives every step, so other
+ * connections may sync, resync or reopen the replica meanwhile:
+ * - each page starts at the stored re-pull cursor, and is applied (in one transaction with the
+ *   cursor) only if that cursor and the pending set are still what they were when it was asked
+ *   for; otherwise it is dropped and the loop reads the stored state again;
+ * - every event of the pending collections in a page is applied, also past the pull cursor:
+ *   another connection's sync skips them, and applying them again later changes nothing;
+ * - the collections are kept in the transaction that reaches the pull cursor as it is then.
+ * A failure is resumed by the next call; it returns when nothing is pending any more. Document
+ * changes of the re-pull are not reported to change listeners.
+ */
+export async function repullPending(ctx: RepullContext): Promise<{ pulled: number; applied: number }> {
+  let pulled = 0;
+  let applied = 0;
+  for (;;) {
+    const pending = ctx.meta.pendingCollections();
+    if (pending.length === 0) return { pulled, applied };
+    const after = ctx.meta.resyncAfter();
+    const unchanged = (): boolean =>
+      ctx.meta.resyncAfter() === after && ctx.meta.pendingCollections().join() === pending.join();
+    if (after >= ctx.meta.pullAfter()) {
+      ctx.db.transaction(() => {
+        if (unchanged() && after >= ctx.meta.pullAfter()) keepPending(ctx.meta, pending);
+      }).immediate();
+      continue;
+    }
+    const page = await ctx.transport.pull({ after, limit: ctx.limit });
+    checkPage(page, after, ctx.limit);
+    const names: ReadonlySet<string> = new Set(pending);
+    const events = page.events.filter((event) => names.has(event.collection));
+    const result = ctx.db.transaction(() => {
+      if (!unchanged()) return null;
+      const outcome = applyRemoteEvents(ctx.docs, ctx.hlc, events);
+      ctx.meta.setResyncAfter(page.nextAfter);
+      ctx.meta.setLastHlc(ctx.hlc.last);
+      if (!page.hasMore || page.nextAfter >= ctx.meta.pullAfter()) keepPending(ctx.meta, pending);
+      return outcome;
+    }).immediate();
+    if (result) {
+      pulled += events.length;
+      applied += result.applied;
+    }
+  }
+}
+
+function keepPending(meta: MetaStore, pending: readonly CollectionName[]): void {
+  const kept = meta.collections() ?? COLLECTION_NAMES;
+  meta.setCollections(COLLECTION_NAMES.filter((name) => kept.includes(name) || pending.includes(name)));
+  meta.setPendingCollections([]);
+  meta.setResyncAfter(0);
+}
