+/** Tags label files: lower-case letters, digits and `-`, 1 to 64 characters, at most 20 per file. */
+export const MAX_TAGS_PER_FILE = 20;
+export const MAX_TAG_LENGTH = 64;
+
+const TAG_PATTERN = new RegExp(`^[a-z0-9-]{1,${MAX_TAG_LENGTH}}$`);
+
+export function isValidTag(value: string): boolean {
+  return TAG_PATTERN.test(value);
+}
+
+export const TAG_RULE = `a tag is 1 to ${MAX_TAG_LENGTH} characters of a-z, 0-9 and -`;
