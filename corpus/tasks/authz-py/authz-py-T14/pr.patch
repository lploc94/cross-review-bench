+async def test_taken_address_is_only_refused_on_confirmation(client, container, mailer):
+    await make_user(container, "taken@example.com")
+    me = await signed_in(client, container)
+
+    requested = await _request(client, me, "TAKEN@example.com")
+    token = mailer.last_email_change_token("taken@example.com")
+    confirmed = await _confirm(client, me.headers, token)
