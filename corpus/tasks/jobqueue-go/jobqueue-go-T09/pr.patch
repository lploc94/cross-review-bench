+// queuesCmd prints the statistics of every queue that has jobs.
+func queuesCmd(ctx context.Context, c *client.Client, args []string, stdout, stderr io.Writer) error {
+	if len(args) > 0 {
+		fmt.Fprintln(stderr, "jobctl queues: no arguments are accepted")
+		return errUsage
+	}
+	queues, err := c.ListQueues(ctx)
+	if err != nil {
+		return err
+	}
+	tw := tabwriter.NewWriter(stdout, 0, 0, 2, ' ', 0)
+	fmt.Fprintln(tw, "QUEUE\tAVAILABLE\tRUNNING\tSUCCEEDED\tFAILED\tCANCELLED\tDEAD\tOLDEST WAITING")
+	for _, q := range queues {
+		oldest := "-"
+		if q.OldestAvailableAgeSeconds != nil {
+			oldest = (time.Duration(*q.OldestAvailableAgeSeconds) * time.Second).String()
+		}
+		fmt.Fprintf(tw, "%s\t%d\t%d\t%d\t%d\t%d\t%d\t%s\n", q.Queue, q.Counts["available"], q.Counts["running"],
+			q.Counts["succeeded"], q.Counts["failed"], q.Counts["cancelled"], q.Counts["dead"], oldest)
+	}
+	return tw.Flush()
+}
