diff --git a/test/api/reversals.test.ts b/test/api/reversals.test.ts
new file mode 100644
index 0000000..c590814
--- /dev/null
+++ b/test/api/reversals.test.ts
@@ -0,0 +1,146 @@
+import { randomUUID } from "node:crypto";
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { buildTestApp, type TestApp } from "../helpers/app.js";
+import {
+  createTenant,
+  fundedWallet,
+  getAccount,
+  issueKey,
+  openAccount,
+  transfer,
+  type AccountBody,
+  type ErrorResponse,
+  type TestTenant,
+  type TransferBody,
+} from "../helpers/fixtures.js";
+
+describe("transfer reversals", () => {
+  let t: TestApp;
+  let tenant: TestTenant;
+  let wallet: AccountBody;
+  let merchant: AccountBody;
+
+  beforeAll(async () => {
+    t = await buildTestApp();
+  });
+
+  afterAll(async () => {
+    await t.close();
+  });
+
+  beforeEach(async () => {
+    tenant = await createTenant(t.pool, t.clock);
+    wallet = await fundedWallet(t.app, tenant, "1000");
+    merchant = await openAccount(t.app, tenant);
+  });
+
+  function reverse(id: string, payload?: Record<string, unknown>, headers = tenant.headers) {
+    return t.app.inject({
+      method: "POST",
+      url: `/transfers/${id}/reverse`,
+      headers,
+      ...(payload ? { payload } : {}),
+    });
+  }
+
+  it("posts the same amount back and restores both balances", async () => {
+    const original = await transfer(t.app, tenant, wallet.id, merchant.id, "300");
+    t.clock.advanceSeconds(60);
+
+    const response = await reverse(original.id);
+    expect(response.statusCode).toBe(201);
+    const reversal = response.json<TransferBody>();
+    expect(reversal).toMatchObject({
+      from_account_id: merchant.id,
+      to_account_id: wallet.id,
+      amount: "300",
+      currency: "USD",
+      description: `Reversal of transfer ${original.id}`,
+      metadata: { reversal_of: original.id },
+      reversal_of: original.id,
+      created_at: t.clock.now().toISOString(),
+    });
+    expect(reversal.entries).toEqual([
+      expect.objectContaining({ account_id: merchant.id, amount: "-300", balance_after: "0" }),
+      expect.objectContaining({ account_id: wallet.id, amount: "300", balance_after: "1000" }),
+    ]);
+    expect((await getAccount(t.app, tenant, wallet.id)).balance).toBe("1000");
+    expect((await getAccount(t.app, tenant, merchant.id)).balance).toBe("0");
+
+    const reread = await t.app.inject({ method: "GET", url: `/transfers/${original.id}`, headers: tenant.headers });
+    expect(reread.json<TransferBody>().reversal_of).toBeNull();
+  });
+
+  it("takes an optional description", async () => {
+    const original = await transfer(t.app, tenant, wallet.id, merchant.id, "100");
+    const response = await reverse(original.id, { description: "Refund for order 1001" });
+    expect(response.statusCode).toBe(201);
+    expect(response.json<TransferBody>().description).toBe("Refund for order 1001");
+
+    const other = await transfer(t.app, tenant, wallet.id, merchant.id, "100");
+    expect((await reverse(other.id, { description: "" })).statusCode).toBe(400);
+    expect((await reverse(other.id, { amount: "50" })).statusCode).toBe(400);
+  });
+
+  it("reverses a transfer only once", async () => {
+    const original = await transfer(t.app, tenant, wallet.id, merchant.id, "300");
+    const first = await reverse(original.id);
+    expect(first.statusCode).toBe(201);
+
+    const again = await reverse(original.id);
+    expect(again.statusCode).toBe(409);
+    expect(again.json<ErrorResponse>().error).toMatchObject({
+      code: "conflict",
+      details: { transfer_id: original.id, reversal_id: first.json<TransferBody>().id },
+    });
+    expect((await getAccount(t.app, tenant, wallet.id)).balance).toBe("1000");
+    expect((await getAccount(t.app, tenant, merchant.id)).balance).toBe("0");
+  });
+
+  it("does not reverse a reversal", async () => {
+    const original = await transfer(t.app, tenant, wallet.id, merchant.id, "300");
+    const reversal = (await reverse(original.id)).json<TransferBody>();
+    const response = await reverse(reversal.id);
+    expect(response.statusCode).toBe(409);
+    expect(response.json<ErrorResponse>().error.details).toMatchObject({ reversal_of: original.id });
+  });
+
+  it("needs the destination to still hold the funds", async () => {
+    const original = await transfer(t.app, tenant, wallet.id, merchant.id, "300");
+    const supplier = await openAccount(t.app, tenant);
+    await transfer(t.app, tenant, merchant.id, supplier.id, "200");
+
+    const refused = await reverse(original.id);
+    expect(refused.statusCode).toBe(422);
+    expect(refused.json<ErrorResponse>().error.code).toBe("insufficient_funds");
+
+    await transfer(t.app, tenant, supplier.id, merchant.id, "200");
+    expect((await reverse(original.id)).statusCode).toBe(201);
+    expect((await getAccount(t.app, tenant, wallet.id)).balance).toBe("1000");
+  });
+
+  it("writes the reversal's transfer.posted and transfer.reversed on the original", async () => {
+    const original = await transfer(t.app, tenant, wallet.id, merchant.id, "300");
+    const reversal = (await reverse(original.id)).json<TransferBody>();
+    const events = await t.pool.query<{ aggregate_id: string; event_type: string }>(
+      "SELECT aggregate_id, event_type FROM outbox WHERE aggregate_id = ANY($1) ORDER BY id",
+      [[original.id, reversal.id]],
+    );
+    expect(events.rows).toEqual([
+      { aggregate_id: original.id, event_type: "transfer.posted" },
+      { aggregate_id: reversal.id, event_type: "transfer.posted" },
+      { aggregate_id: original.id, event_type: "transfer.reversed" },
+    ]);
+  });
+
+  it("requires transfers:write and hides other tenants' transfers", async () => {
+    const original = await transfer(t.app, tenant, wallet.id, merchant.id, "300");
+    const reader = await issueKey(t.pool, t.clock, tenant.tenantId, ["transfers:read"]);
+    expect((await reverse(original.id, undefined, reader.headers)).statusCode).toBe(403);
+
+    const other = await createTenant(t.pool, t.clock, { name: "Other" });
+    expect((await reverse(original.id, undefined, other.headers)).statusCode).toBe(404);
+    expect((await reverse(randomUUID())).statusCode).toBe(404);
+    expect((await getAccount(t.app, tenant, merchant.id)).balance).toBe("300");
+  });
+});
