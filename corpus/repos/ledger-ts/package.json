{
  "name": "ledger-ts",
  "version": "1.0.0",
  "private": true,
  "description": "Double-entry ledger and wallet HTTP API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "migrate": "node dist/scripts/migrate.js",
    "create-tenant": "node dist/scripts/createTenant.js",
    "seed-fx-rates": "node dist/scripts/seedFxRates.js",
    "api-keys": "node dist/scripts/apiKeys.js",
    "verify-ledger": "node dist/scripts/verifyLedger.js",
    "show-transfer": "node dist/scripts/showTransfer.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "fastify": "5.12.7",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
