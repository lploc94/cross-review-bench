     return value
 
 
+# What safe_payload writes in place of a value jsonb cannot hold.
+_NON_FINITE = frozenset({str(math.inf), str(-math.inf), str(math.nan)})
+
+
+def kept_as_read(value: Any) -> bool:
+    """Whether a stored payload can be trusted to be what the reader produced: it holds no
+    U+FFFD (in a key or a value) and no text that names a non-finite number, the marks
+    safe_payload leaves where it changed something."""
+    if isinstance(value, str):
+        return _REPLACEMENT not in value and value not in _NON_FINITE
+    if isinstance(value, dict):
+        return all(kept_as_read(key) and kept_as_read(item) for key, item in value.items())
+    if isinstance(value, list):
+        return all(kept_as_read(item) for item in value)
+    return True
+
+
