+
+  /** Approvals by distinct people: one approver holding two tasks of a step counts once. */
+  private static int approvers(List<ApprovalTask> tasks) {
+    return (int)
+        tasks.stream()
+            .filter(task -> task.getStatus() == TaskStatus.APPROVED)
+            .map(task -> task.getAssignee().getId())
+            .distinct()
+            .count();
