+package com.papertrail.workflow.service;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+
+import com.papertrail.workflow.domain.Decision;
+import com.papertrail.workflow.domain.Document;
+import com.papertrail.workflow.domain.InvalidTransitionException;
+import com.papertrail.workflow.domain.StepKind;
+import com.papertrail.workflow.integration.ArchiveJob;
+import com.papertrail.workflow.support.IntegrationTestBase;
+import com.papertrail.workflow.support.TestData;
+import java.time.Duration;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+
+class ArchiveServiceTest extends IntegrationTestBase {
+
+  private static final Duration YEAR = Duration.ofDays(365);
+
+  @Autowired private DocumentService documents;
+  @Autowired private ApprovalService approvals;
+  @Autowired private ArchiveJob job;
+
+  private long owner;
+  private long approver;
+
+  @BeforeEach
+  void setUp() {
+    owner = data.user("Ines Berg");
+    approver = data.user("Tomas Vale");
+    data.publish("Contract", TestData.step(1, StepKind.SINGLE, approver, null, 0, 480));
+  }
+
+  private long submitted(String title) {
+    long id = data.draft(data.principal(owner), "Contract", title);
+    documents.submit(data.principal(owner), id);
+    return id;
+  }
+
+  private long decided(String title, Decision decision) {
+    long id = submitted(title);
+    approvals.decide(data.principal(approver), taskOf(id, approver), decision, null);
+    return id;
+  }
+
+  private String body(long id) {
+    return jdbc.queryForObject("select body from document where id = ?", String.class, id);
+  }
+
+  @Test
+  void finishedDocumentsAreArchivedOnceTheRetentionPeriodHasPassed() {
+    long approved = decided("Supplier contract", Decision.APPROVE);
+    long withdrawn = submitted("Office lease");
+    documents.withdraw(data.principal(owner), withdrawn);
+    long underReview = submitted("Travel policy");
+    long draft = data.draft(data.principal(owner), "Contract", "Draft memo");
+
+    clock.advance(YEAR.minusMinutes(1));
+    assertThat(job.runOnce()).isZero();
+
+    clock.advance(Duration.ofMinutes(1));
+    assertThat(job.runOnce()).isEqualTo(2);
+
+    assertThat(body(approved)).isEqualTo(Document.ARCHIVED_BODY);
+    assertThat(body(withdrawn)).isEqualTo(Document.ARCHIVED_BODY);
+    assertThat(body(underReview)).isEqualTo("Invented body text for Travel policy");
+    assertThat(body(draft)).isEqualTo("Invented body text for Draft memo");
+    assertThat(job.runOnce()).isZero();
+  }
+
+  @Test
+  void anArchivedDocumentKeepsItsRecordButNotItsText() throws Exception {
+    long approved = decided("Supplier contract", Decision.APPROVE);
+    int auditRows =
+        jdbc.queryForObject(
+            "select count(*) from audit_event where document_id = ?", Integer.class, approved);
+
+    clock.advance(YEAR.plusDays(1));
+    job.runOnce();
+
+    mvc.perform(get("/api/v1/documents/" + approved).header("Authorization", data.bearer(owner)))
+        .andExpect(jsonPath("$.archived").value(true))
+        .andExpect(jsonPath("$.body").doesNotExist())
+        .andExpect(jsonPath("$.summary.title").value("Supplier contract"))
+        .andExpect(jsonPath("$.tasks[0].status").value("APPROVED"));
+    assertThat(
+            jdbc.queryForObject(
+                "select count(*) from audit_event where document_id = ?", Integer.class, approved))
+        .isEqualTo(auditRows);
+  }
+
+  @Test
+  void aRejectedDocumentCanBeResubmittedOnlyWithinTheWindow() {
+    long early = decided("Supplier contract", Decision.REJECT);
+    long late = decided("Office lease", Decision.REJECT);
+
+    clock.advance(Duration.ofDays(29));
+    documents.resubmit(data.principal(owner), early);
+
+    clock.advance(Duration.ofDays(1));
+    assertThatThrownBy(() -> documents.resubmit(data.principal(owner), late))
+        .isInstanceOf(InvalidTransitionException.class);
+  }
+
+  @Test
+  void aFinalRejectionIsArchivedAfterTheRetentionPeriod() {
+    long rejected = decided("Supplier contract", Decision.REJECT);
+
+    clock.advance(YEAR.plusDays(1));
+    assertThat(job.runOnce()).isEqualTo(1);
+
+    assertThat(body(rejected)).isEqualTo(Document.ARCHIVED_BODY);
+    assertThat(
+            jdbc.queryForObject("select status from document where id = ?", String.class, rejected))
+        .isEqualTo("REJECTED");
+  }
