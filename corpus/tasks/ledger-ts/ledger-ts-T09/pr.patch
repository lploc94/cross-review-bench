+  });
+
+  async function balanceAsOf(accountId: string, asOf: string) {
+    return t.app.inject({
+      method: "GET",
+      url: `/accounts/${accountId}/balance?as_of=${encodeURIComponent(asOf)}`,
+      headers: tenant.headers,
+    });
+  }
+
+  it("serves repeated reads of an account from Redis for BALANCE_CACHE_TTL_S", async () => {
+    const account = await openAccount(t.app, tenant, { name: "Before" });
+    await getAccount(t.app, tenant, account.id);
+    await t.pool.query("UPDATE accounts SET name = 'After' WHERE id = $1", [account.id]);
+
+    expect((await getAccount(t.app, tenant, account.id)).name).toBe("Before");
+    const ttl = await t.redis.pttl(`balance:${tenant.tenantId}:${account.id}`);
+    expect(ttl).toBeGreaterThan(0);
+    expect(ttl).toBeLessThanOrEqual(30_000);
+  });
+
+  it("drops both accounts' cached reads after a transfer", async () => {
+    const wallet = await fundedWallet(t.app, tenant, "1000");
+    const merchant = await openAccount(t.app, tenant);
+    await getAccount(t.app, tenant, merchant.id);
+
+    await transfer(t.app, tenant, wallet.id, merchant.id, "250");
+    expect((await getAccount(t.app, tenant, wallet.id)).balance).toBe("750");
+    expect((await getAccount(t.app, tenant, merchant.id)).balance).toBe("250");
+  });
+
+  it("drops the cached reads after a hold capture", async () => {
+    const wallet = await fundedWallet(t.app, tenant, "1000");
+    const merchant = await openAccount(t.app, tenant);
+    await getAccount(t.app, tenant, merchant.id);
+
+    const created = await createHold(t.app, tenant, { account_id: wallet.id, amount: "400" });
+    const hold = created.json<HoldBody>();
+    const captured = await t.app.inject({
+      method: "POST",
+      url: `/holds/${hold.id}/capture`,
+      headers: tenant.headers,
+      payload: { to_account_id: merchant.id },
+    });
+    expect(captured.statusCode).toBe(200);
+    expect(await getAccount(t.app, tenant, wallet.id)).toMatchObject({ balance: "600", held: "0" });
+    expect((await getAccount(t.app, tenant, merchant.id)).balance).toBe("400");
+  });
+
+  it("computes the balance as of an instant from the account's entries", async () => {
+    const start = t.clock.now();
+    const wallet = await fundedWallet(t.app, tenant, "1000");
+    const merchant = await openAccount(t.app, tenant);
+    t.clock.advanceSeconds(60);
+    const second = t.clock.now();
+    await transfer(t.app, tenant, wallet.id, merchant.id, "300");
+    t.clock.advanceSeconds(3600);
+
+    const at = async (instant: Date) => {
+      const response = await balanceAsOf(wallet.id, instant.toISOString());
+      expect(response.statusCode, response.body).toBe(200);
+      return response.json<BalanceBody>();
+    };
+    expect(await at(new Date(start.getTime() - 1))).toMatchObject({ balance: "0", currency: "USD" });
+    expect((await at(start)).balance).toBe("1000");
+    expect((await at(new Date(second.getTime() - 1))).balance).toBe("1000");
+    expect(await at(second)).toEqual({ account_id: wallet.id, currency: "USD", as_of: second.toISOString(), balance: "700" });
+    expect((await at(t.clock.now())).balance).toBe("700");
+  });
+
+  it("caches a balance once the instant is a minute old, and not before", async () => {
+    const wallet = await fundedWallet(t.app, tenant, "1000");
+    const recent = t.clock.now();
+    t.clock.advanceSeconds(30);
+    expect((await balanceAsOf(wallet.id, recent.toISOString())).json<BalanceBody>().balance).toBe("1000");
+    expect(await t.redis.keys("balance:*:as_of:*")).toEqual([]);
+
+    t.clock.advanceSeconds(30);
+    expect((await balanceAsOf(wallet.id, recent.toISOString())).json<BalanceBody>().balance).toBe("1000");
+    expect(await t.redis.keys("balance:*:as_of:*")).toHaveLength(1);
+  });
+
+  it("validates as_of and hides other tenants' accounts", async () => {
+    const wallet = await fundedWallet(t.app, tenant, "1000");
+    const future = new Date(t.clock.now().getTime() + 1000).toISOString();
+    for (const asOf of [future, "yesterday", "2030-01-15T10:00:00"]) {
+      const response = await balanceAsOf(wallet.id, asOf);
+      expect(response.statusCode, asOf).toBe(400);
+      expect(response.json<ErrorResponse>().error.code).toBe("validation_error");
+    }
+    const other = await createTenant(t.pool, t.clock, { name: "Other" });
+    tenant = other;
+    expect((await balanceAsOf(wallet.id, t.clock.now().toISOString())).statusCode).toBe(404);
+  });
+});
