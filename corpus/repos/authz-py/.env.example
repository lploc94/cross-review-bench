# Copy to .env and adjust; the service reads plain environment variables.
ENVIRONMENT=development
DATABASE_URL=postgres://authz:authz@localhost:5432/authz
REDIS_URL=redis://localhost:6379/0
# Comma-separated, at least 32 characters each; the first one signs new tokens.
JWT_SECRETS=change-me-to-a-long-random-value-0000
LOG_LEVEL=info
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_TTL_SECONDS=7776000
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
REFRESH_RATE_LIMIT=60
REFRESH_RATE_WINDOW_SECONDS=60
INVITATION_TTL_SECONDS=604800
PUBLIC_BASE_URL=http://localhost:8000
TRUST_PROXY_HEADERS=false
MAIL_BACKEND=log
MAIL_FROM=no-reply@example.com
