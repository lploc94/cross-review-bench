+package com.innkeep.booking.persistence;
+
+import com.innkeep.booking.domain.StayRestriction;
+import java.time.LocalDate;
+import java.util.List;
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Modifying;
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.query.Param;
+
+public interface StayRestrictionRepository extends JpaRepository<StayRestriction, Long> {
+
+  List<StayRestriction> findByRoomTypeIdOrderByStartDateAscIdAsc(long roomTypeId);
+
+  /** Restrictions of the room type that cover the night, used to check an arrival. */
+  @Query(
+      """
+      select r from StayRestriction r
+      where r.roomType.id = :roomTypeId and r.startDate <= :night and r.endDate >= :night""")
+  List<StayRestriction> findCovering(
+      @Param("roomTypeId") long roomTypeId, @Param("night") LocalDate night);
+
+  @Modifying
+  @Query("delete from StayRestriction r where r.roomType.id = :roomTypeId")
+  int deleteByRoomType(@Param("roomTypeId") long roomTypeId);
+}
