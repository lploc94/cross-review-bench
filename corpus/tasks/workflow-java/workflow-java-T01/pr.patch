+package com.papertrail.workflow.api;
+
+import com.papertrail.workflow.api.dto.Requests.CreateDelegationRequest;
+import com.papertrail.workflow.service.DelegationService;
+import com.papertrail.workflow.service.Views.DelegationView;
+import jakarta.validation.Valid;
+import java.net.URI;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+/** Delegations of approval tasks: a user's own, or anyone's for an admin. */
+@RestController
+@RequestMapping("/api/v1/delegations")
+public class DelegationController {
+
+  private final DelegationService delegations;
+  private final CurrentPrincipal current;
+
+  public DelegationController(DelegationService delegations, CurrentPrincipal current) {
+    this.delegations = delegations;
+    this.current = current;
+  }
+
+  @PostMapping
+  public ResponseEntity<DelegationView> create(
+      @Valid @RequestBody CreateDelegationRequest request) {
+    DelegationView created =
+        delegations.create(
+            current.require(),
+            request.delegatorId(),
+            request.delegateId(),
+            request.from(),
+            request.until());
+    return ResponseEntity.created(URI.create("/api/v1/delegations/" + created.id())).body(created);
+  }
+
+  @DeleteMapping("/{id}")
+  public ResponseEntity<Void> delete(@PathVariable long id) {
+    delegations.delete(current.require(), id);
+    return ResponseEntity.noContent().build();
+  }
+}
