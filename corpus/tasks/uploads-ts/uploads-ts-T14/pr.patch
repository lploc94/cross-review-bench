diff --git a/migrations/0004_file_tags.sql b/migrations/0004_file_tags.sql
new file mode 100644
index 0000000..fc43598
--- /dev/null
+++ b/migrations/0004_file_tags.sql
@@ -0,0 +1,13 @@
+-- Tags on files: 1 to 64 characters of a-z, 0-9 and '-', at most 20 per file (counted by the insert
+-- in fileTagRepo.ts while the caller holds the file's row lock). A file's tags are removed in the
+-- transaction that deletes or replaces it, so only live files have tags.
+CREATE TABLE file_tags (
+  file_id    uuid NOT NULL REFERENCES files (id) ON DELETE CASCADE,
+  tenant_id  uuid NOT NULL REFERENCES tenants (id) ON DELETE CASCADE,
+  tag        text COLLATE "C" NOT NULL CHECK (tag ~ '^[a-z0-9-]{1,64}$'),
+  created_at timestamptz NOT NULL,
+  CONSTRAINT file_tags_unique UNIQUE (file_id, tag)
+);
+
+-- Finds a tenant's files with a tag.
+CREATE INDEX file_tags_tenant_tag ON file_tags (tenant_id, tag);
