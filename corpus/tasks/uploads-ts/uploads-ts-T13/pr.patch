+/**
+ * The largest file the tenant may upload: its own limit, but never more than the service's
+ * (`MAX_UPLOAD_BYTES` may have been lowered since the tenant's limit was set).
+ */
+export function uploadLimitOf(tenant: Pick<Tenant, "maxUploadBytes">, serviceLimit: number): number {
