+package com.innkeep.booking.service;
+
+import com.innkeep.booking.domain.Allotment;
+import com.innkeep.booking.domain.ConflictException;
+import com.innkeep.booking.domain.DateRange;
+import com.innkeep.booking.domain.InsufficientAvailabilityException;
+import com.innkeep.booking.domain.Inventory;
+import com.innkeep.booking.domain.Property;
+import com.innkeep.booking.domain.RoomType;
+import com.innkeep.booking.domain.ValidationException;
+import com.innkeep.booking.persistence.AllotmentRepository;
+import com.innkeep.booking.persistence.InventoryRepository;
+import com.innkeep.booking.persistence.KeptRooms;
+import java.time.Clock;
+import java.time.LocalDate;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.regex.Pattern;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.support.TransactionTemplate;
+
+/**
+ * Rooms kept for sales channels. An allotment takes its rooms out of public sale until its release
+ * day; a hold made for the channel uses them first.
+ */
+@Service
+public class AllotmentService {
+
+  static final int MAX_NIGHTS = 366;
+  static final int MAX_RELEASE_DAYS = 365;
+  private static final Pattern CHANNEL = Pattern.compile("[a-z0-9][a-z0-9-]{0,31}");
+
+  private final CatalogService catalog;
+  private final AllotmentRepository allotments;
+  private final InventoryRepository inventory;
+  private final Clock clock;
+  private final TransactionTemplate tx;
+  private final OptimisticRetry retry;
+
+  public AllotmentService(
+      CatalogService catalog,
+      AllotmentRepository allotments,
+      InventoryRepository inventory,
+      Clock clock,
+      TransactionTemplate tx,
+      OptimisticRetry retry) {
+    this.catalog = catalog;
+    this.allotments = allotments;
+    this.inventory = inventory;
+    this.clock = clock;
+    this.tx = tx;
+    this.retry = retry;
+  }
+
+  /**
+   * Keeps {@code rooms} rooms for the channel on every night of the range, replacing what it kept
+   * before. Each night needs inventory with at least that many rooms in total.
+   */
+  public long set(
+      String propertyCode,
+      String roomTypeCode,
+      String channel,
+      DateRange range,
+      int rooms,
+      int releaseDays) {
+    requireChannel(channel);
+    if (range.nights() > MAX_NIGHTS) {
+      throw new ValidationException("at most " + MAX_NIGHTS + " nights at a time");
+    }
+    if (releaseDays > MAX_RELEASE_DAYS) {
+      throw new ValidationException("release days must be at most " + MAX_RELEASE_DAYS);
+    }
+    return retry.run(
+        () ->
+            tx.execute(
+                status -> {
+                  RoomType type = catalog.roomType(propertyCode, roomTypeCode);
+                  for (LocalDate night : range.nightDates()) {
+                    Inventory row =
+                        inventory
+                            .findByRoomTypeIdAndNight(type.getId(), night)
+                            .orElseThrow(() -> new ConflictException("no inventory on " + night));
+                    if (rooms > row.getTotal()) {
+                      throw new ConflictException(
+                          "only " + row.getTotal() + " rooms in total on " + night);
+                    }
+                    Allotment existing =
+                        allotments
+                            .findByRoomTypeIdAndChannelAndNight(type.getId(), channel, night)
+                            .orElse(null);
+                    if (existing == null) {
+                      allotments.save(new Allotment(type, channel, night, rooms, releaseDays));
+                    } else {
+                      existing.set(rooms, releaseDays);
+                    }
+                  }
+                  return range.nights();
+                }));
+  }
+
+  /**
+   * Holds the rooms on every night of the stay, in ascending night order, inside the caller's
+   * transaction. With a channel, the hold first takes what is left of that channel's unreleased
+   * allotment; the rest, like a public hold, must fit in the rooms no allotment keeps.
+   */
+  void holdNights(RoomType type, DateRange stay, int rooms, String channel) {
+    LocalDate today = today();
+    for (LocalDate night : stay.nightDates()) {
+      if (channel != null) {
+        allotments
+            .findLocked(type.getId(), channel, night)
+            .filter(allotment -> !allotment.isReleased(today))
+            .ifPresent(allotment -> allotment.take(rooms));
+      }
+      if (inventory.holdRoomsForSale(type.getId(), night, rooms, today) == 0) {
+        throw new InsufficientAvailabilityException(type.getCode(), night);
+      }
+    }
+  }
+
+  /**
+   * Rooms kept out of public sale, by room type id and night, from {@code first} to {@code last}.
+   */
+  Map<Long, Map<LocalDate, Integer>> kept(Property property, LocalDate first, LocalDate last) {
+    var kept = new HashMap<Long, Map<LocalDate, Integer>>();
+    for (KeptRooms row : allotments.keptForProperty(property.getCode(), first, last, today())) {
+      kept.computeIfAbsent(row.roomTypeId(), id -> new HashMap<>())
+          .put(row.night(), (int) row.rooms());
+    }
+    return kept;
+  }
+
+  static void requireChannel(String channel) {
+    if (channel == null || !CHANNEL.matcher(channel).matches()) {
+      throw new ValidationException(
+          "channel must be 1 to 32 lowercase letters, digits or dashes, starting with a letter or"
+              + " digit");
+    }
+  }
+
+  private LocalDate today() {
+    return LocalDate.now(clock);
+  }
+}
