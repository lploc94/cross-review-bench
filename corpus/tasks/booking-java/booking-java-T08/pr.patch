+package com.innkeep.booking.persistence;
+
+import com.innkeep.booking.domain.Allotment;
+import jakarta.persistence.LockModeType;
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Optional;
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Lock;
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.query.Param;
+
+public interface AllotmentRepository extends JpaRepository<Allotment, Long> {
+
+  Optional<Allotment> findByRoomTypeIdAndChannelAndNight(
+      long roomTypeId, String channel, LocalDate night);
+
+  /** The channel's allotment for the night under a row lock, for a hold that takes from it. */
+  @Lock(LockModeType.PESSIMISTIC_WRITE)
+  @Query(
+      """
+      select a from Allotment a
+       where a.roomType.id = :roomTypeId and a.channel = :channel and a.night = :night""")
+  Optional<Allotment> findLocked(
+      @Param("roomTypeId") long roomTypeId,
+      @Param("channel") String channel,
+      @Param("night") LocalDate night);
+
+  /** Rooms kept per room type and night by allotments whose release day is after {@code today}. */
+  @Query(
+      """
+      select new com.innkeep.booking.persistence.KeptRooms(a.roomType.id, a.night, sum(a.rooms))
+        from Allotment a
+       where a.roomType.property.code = :code
+         and a.night between :first and :last
+         and a.releaseOn > :today
+       group by a.roomType.id, a.night""")
+  List<KeptRooms> keptForProperty(
+      @Param("code") String code,
+      @Param("first") LocalDate first,
+      @Param("last") LocalDate last,
+      @Param("today") LocalDate today);
+}
