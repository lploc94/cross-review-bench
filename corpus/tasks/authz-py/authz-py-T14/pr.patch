+async def test_only_the_newest_link_works_once_for_its_account(client, container, mailer):
+    me = await signed_in(client, container)
+    other = await signed_in(client, container)
+    await _request(client, me, "first@example.com")
+    first = mailer.last_email_change_token("first@example.com")
+    await _request(client, me, "second@example.com")
+    second = mailer.last_email_change_token("second@example.com")
+
+    assert (await _confirm(client, me.headers, first)).status_code == 404
+    assert (await _confirm(client, other.headers, second)).status_code == 404
+    assert (await _confirm(client, me.headers, second)).status_code == 200
+    assert (await _confirm(client, me.headers, second)).status_code == 409
+
+
+async def test_links_expire(client, container, mailer, clock):
+    me = await signed_in(client, container)
+    await _request(client, me, "late@example.com")
+    clock.advance(seconds=container.settings.email_change_ttl_seconds)
+    fresh = (await login(client, me.email)).json()["access_token"]
+
+    response = await _confirm(
+        client, bearer(fresh), mailer.last_email_change_token("late@example.com")
+    )
+
+    assert response.status_code == 410
+
+
+async def test_requests_are_rate_limited_per_user(client, container, mailer):
+    me = await signed_in(client, container)
+    for _ in range(container.settings.email_change_rate_limit):
+        refused = await _request(client, me, "x@example.com", password="a wrong password")
+        assert refused.status_code == 403
+
+    blocked = await _request(client, me, "x@example.com")
+
+    assert blocked.status_code == 429
+    assert mailer.sent == []
