+import http from "node:http";
+import net, { type AddressInfo } from "node:net";
+import { exportLineSchema } from "@sync/shared";
+import pg from "pg";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { UnavailableError } from "../../src/domain/errors.js";
+import { ExportService } from "../../src/services/exportService.js";
+import { buildTestApp, type TestApp } from "../helpers/app.js";
+import { testDatabaseUrl } from "../helpers/env.js";
+import { createUser, hlc, mutation, push, type TestDevice } from "../helpers/fixtures.js";
+
+const database = new URL(testDatabaseUrl());
+let t: TestApp;
+let ada: TestDevice;
+
+beforeEach(async () => {
+  t = await buildTestApp();
+  ada = await createUser(t);
+});
+
+afterEach(async () => {
+  await t.close();
+});
+
+/** `count` notes written straight into the documents table: note-0001, note-0002, … */
+async function seedNotes(count: number, bodyLength: number): Promise<void> {
+  await t.pool.query(
+    `INSERT INTO documents (user_id, collection, doc_id, fields, field_hlcs, updated_seq, updated_at)
+     SELECT $1, 'notes', 'note-' || lpad(i::text, 4, '0'),
+            jsonb_build_object('title', 'Note ' || i, 'body', repeat('x', $3::int)),
+            jsonb_build_object('title', $4::text, 'body', $4::text), i, now()
+       FROM generate_series(1, $2::int) AS i`,
+    [ada.userId, count, bodyLength, hlc(t.clock.now() - 1_000)],
+  );
+}
+
+/** Connections of the test pool still checked out, after up to 5 s for them to come back. */
+async function checkedOut(): Promise<number> {
+  for (let i = 0; i < 100 && t.pool.totalCount > t.pool.idleCount; i++) {
+    await new Promise((resolve) => setTimeout(resolve, 50));
+  }
+  return t.pool.totalCount - t.pool.idleCount;
+}
+
+const toLine = (doc: { collection: string; docId: string; fields: object }) => ({ id: `${doc.collection}/${doc.docId}`, ...doc.fields });
+
+describe("GET /v1/export", () => {
+  it("streams the caller's documents by collection and id, then the count", async () => {
+    const bob = await createUser(t, "Bob");
+    const now = t.clock.now();
+    await push(t, ada, [
+      mutation({ collection: "tasks", docId: "t1", fields: { title: "Call", done: false }, hlc: hlc(now) }),
+      mutation({ docId: "n2", fields: { title: "Ideas" }, hlc: hlc(now) }),
+      mutation({ docId: "n1", fields: { title: "Groceries", tags: ["home"] }, hlc: hlc(now) }),
+    ]);
+    await push(t, bob, [mutation({ docId: "n3", fields: { title: "Bob's" }, hlc: hlc(now) })]);
+
+    const res = await t.app.inject({ method: "GET", url: "/v1/export", headers: { authorization: `Bearer ${ada.token}` } });
+    expect(res.statusCode).toBe(200);
+    expect(res.headers["content-type"]).toMatch(/^application\/x-ndjson/);
+    const lines = res.body.trimEnd().split("\n").map((line) => exportLineSchema.parse(JSON.parse(line)));
+    expect(lines.map((l) => (l.type === "document" ? `${l.collection}/${l.id}` : `end ${l.documents}`))).toEqual([
+      "notes/n1",
+      "notes/n2",
+      "tasks/t1",
+      "end 3",
+    ]);
+    expect(lines[0]).toMatchObject({ fields: { title: "Groceries", tags: ["home"] }, fieldHlcs: { title: hlc(now) } });
+    expect((await t.app.inject({ method: "GET", url: "/v1/export" })).statusCode).toBe(401);
+  });
+
+  it("releases the connection when the client goes away mid-export", async () => {
+    await seedNotes(3_000, 8_000);
+    await t.app.listen({ port: 0, host: "127.0.0.1" });
+    const { port } = t.app.server.address() as AddressInfo;
+    await new Promise<void>((resolve, reject) => {
+      const req = http.get({ port, path: "/v1/export", headers: { authorization: `Bearer ${ada.token}` } }, (res) => {
+        res.once("data", () => {
+          req.destroy();
+          resolve();
+        });
+      });
+      req.on("error", reject);
+      req.setTimeout(5_000, () => reject(new Error("no answer from the export")));
+    });
+    expect(await checkedOut()).toBe(0);
+  });
+});
+
+describe("ExportService", () => {
+  it("reads one snapshot, a page at a time as the consumer asks", async () => {
+    await seedNotes(400, 1_000);
+    const service = new ExportService({ pool: t.pool, maxConcurrent: 1, idleTimeoutMs: 10_000, pageSize: 50 });
+    const stream = await service.open(ada, toLine);
+    stream.setEncoding("utf8");
+    const reader = stream[Symbol.asyncIterator]();
+    let text = String((await reader.next()).value);
+
+    // Pushed while the last pages are still unread.
+    await push(t, ada, [
+      mutation({ docId: "note-0400", fields: { title: "Changed" }, hlc: hlc(t.clock.now()) }),
+      mutation({ docId: "note-9999", fields: { title: "New" }, hlc: hlc(t.clock.now()) }),
+    ]);
+    for (let next = await reader.next(); !next.done; next = await reader.next()) text += String(next.value);
+
+    const lines = text.trimEnd().split("\n").map((line) => JSON.parse(line) as Record<string, unknown>);
+    expect(lines).toHaveLength(401);
+    expect(lines.at(-2)).toMatchObject({ id: "notes/note-0400", title: "Note 400" });
+    expect(lines.at(-1)).toEqual({ type: "end", documents: 400 });
+    expect(service.running).toBe(0);
+    expect(await checkedOut()).toBe(0);
+  });
+
+  it("fails to open, and nothing goes unhandled, when the connection drops during the first page", async () => {
+    // A TCP proxy in front of the database, so the connection can be cut as a network would cut it.
+    const sockets: net.Socket[] = [];
+    const proxy = net.createServer((socket) => {
+      const upstream = net.connect(Number(database.port), database.hostname);
+      socket.pipe(upstream).pipe(socket);
+      socket.on("error", () => undefined).on("close", () => upstream.destroy());
+      upstream.on("error", () => undefined).on("close", () => socket.destroy());
+      sockets.push(socket);
+    });
+    await new Promise<void>((resolve) => proxy.listen(0, "127.0.0.1", resolve));
+    const proxied = new URL(database);
+    proxied.hostname = "127.0.0.1";
+    proxied.port = String((proxy.address() as AddressInfo).port);
+    const pool = new pg.Pool({ connectionString: proxied.toString(), max: 1 });
+    pool.on("error", () => undefined);
+    const service = new ExportService({ pool, maxConcurrent: 1, idleTimeoutMs: 10_000 });
+    const locker = await t.pool.connect();
+    try {
+      await locker.query("BEGIN");
+      await locker.query("LOCK TABLE documents IN ACCESS EXCLUSIVE MODE");
+      const opening = service.open(ada, toLine);
+      opening.catch(() => undefined);
+      // The first page waits for the lock; the connection is reset while it waits.
+      await expect
+        .poll(async () => {
+          const waiting = await t.pool.query(
+            "SELECT 1 FROM pg_stat_activity WHERE datname = current_database() AND wait_event_type = 'Lock'",
+          );
+          return waiting.rowCount;
+        })
+        .toBe(1);
+      for (const socket of sockets) socket.resetAndDestroy();
+      await expect(opening).rejects.toThrow();
+    } finally {
+      await locker.query("ROLLBACK");
+      locker.release();
+      await pool.end();
+      await new Promise((resolve) => proxy.close(resolve));
+    }
+    expect(service.running).toBe(0);
+  });
+
+  it("refuses an export beyond maxConcurrent until one closes", async () => {
+    const service = new ExportService({ pool: t.pool, maxConcurrent: 1, idleTimeoutMs: 10_000 });
+    const first = await service.open(ada, toLine);
+    await expect(service.open(ada, toLine)).rejects.toBeInstanceOf(UnavailableError);
+    first.destroy();
+    await expect.poll(() => service.running).toBe(0);
+    (await service.open(ada, toLine)).destroy();
+    await expect.poll(() => service.running).toBe(0);
+  });
+});
