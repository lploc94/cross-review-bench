+import com.papertrail.workflow.service.DocumentService;
+import com.papertrail.workflow.service.IdentityService;
+import com.papertrail.workflow.support.IntegrationTestBase;
+import com.papertrail.workflow.support.TestData;
+import java.time.Duration;
+import java.time.Instant;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.ResultActions;
+
+/** The clock starts on Monday 3 May 2027, 11:00 in London. */
+class OutOfOfficeApiTest extends IntegrationTestBase {
+
+  private static final String AUTH = "Authorization";
+
+  @Autowired private DocumentService documents;
+  @Autowired private IdentityService identity;
+
+  private long owner;
+  private long alma;
+  private long bruno;
+
+  @BeforeEach
+  void setUp() {
+    owner = data.user("Ines Berg");
+    alma = data.user("Alma Reyes");
+    bruno = data.user("Bruno Kask");
+    data.publish("Expenses", TestData.step(1, StepKind.SINGLE, alma, null, 0, 480));
+  }
+
+  private ResultActions away(long userId, String from, String until, long substituteId)
+      throws Exception {
+    return mvc.perform(
+        put("/api/v1/users/me/out-of-office")
+            .header(AUTH, data.bearer(userId))
+            .contentType(MediaType.APPLICATION_JSON)
+            .content(
+                "{\"from\":\"%s\",\"until\":\"%s\",\"substituteId\":%d}"
+                    .formatted(from, until, substituteId)));
+  }
+
+  private long submit(String definition) {
+    long document = data.draft(data.principal(owner), definition, "Travel claim");
+    documents.submit(data.principal(owner), document);
+    return document;
+  }
+
+  private Long assigneeOf(long document) {
+    return jdbc.queryForObject(
+        "select assignee_id from approval_task where document_id = ?", Long.class, document);
+  }
+
+  @Test
+  void theSubstituteTakesATaskActivatedDuringThePeriod() throws Exception {
+    away(alma, "2027-05-03", "2027-05-07", bruno)
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.outOfOffice.until").value("2027-05-07"))
+        .andExpect(jsonPath("$.outOfOffice.substituteId").value(bruno));
+
+    long document = submit("Expenses");
+    long task = taskOf(document, bruno);
+    mvc.perform(get("/api/v1/tasks/" + task).header(AUTH, data.bearer(bruno)))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.assigneeId").value(bruno))
+        .andExpect(jsonPath("$.onBehalfOfId").value(alma));
+    mvc.perform(get("/api/v1/documents/" + document).header(AUTH, data.bearer(alma)))
+        .andExpect(status().isNotFound());
+
+    mvc.perform(
+            post("/api/v1/tasks/" + task + "/decision")
+                .header(AUTH, data.bearer(bruno))
+                .contentType(MediaType.APPLICATION_JSON)
+                .content("{\"decision\":\"APPROVE\"}"))
+        .andExpect(status().isOk());
+    assertThat(notifier.delivered()).isEmpty();
+    assertThat(
+            jdbc.queryForObject(
+                "select recipient_user_id from outbox_event where event_type = 'TASK_ASSIGNED'",
+                Long.class))
+        .isEqualTo(bruno);
+  }
+
+  @Test
+  void theDayIsTheBusinessZonesDay() throws Exception {
+    away(alma, "2027-05-04", "2027-05-04", bruno).andExpect(status().isOk());
+
+    clock.set(Instant.parse("2027-05-03T22:30:00Z")); // Monday 23:30 in London
+    long monday = submit("Expenses");
+    clock.set(Instant.parse("2027-05-03T23:30:00Z")); // Tuesday 00:30 in London
+    long tuesday = submit("Expenses");
+    clock.advance(Duration.ofDays(1)); // Wednesday
+    long wednesday = submit("Expenses");
+
+    assertThat(assigneeOf(monday)).isEqualTo(alma);
+    assertThat(assigneeOf(tuesday)).isEqualTo(bruno);
+    assertThat(assigneeOf(wednesday)).isEqualTo(alma);
+  }
+
+  @Test
+  void theAssigneeKeepsTheTaskWhenTheSubstituteCannotTakeIt() throws Exception {
+    long carla = data.user("Carla Moss");
+    away(alma, "2027-05-03", "2027-05-07", bruno).andExpect(status().isOk());
+    away(bruno, "2027-05-03", "2027-05-03", carla).andExpect(status().isOk());
+    assertThat(assigneeOf(submit("Expenses"))).isEqualTo(alma);
+
+    away(alma, "2027-05-03", "2027-05-07", carla).andExpect(status().isOk());
+    identity.updateUser(carla, null, null, false);
+    assertThat(assigneeOf(submit("Expenses"))).isEqualTo(alma);
+  }
+
+  @Test
+  void aGroupStepNeverGivesOnePersonTwoTasks() throws Exception {
+    long team = data.group("Finance", alma, bruno);
+    data.publish("Purchases", TestData.step(1, StepKind.ALL_OF, null, team, 0, 480));
+    away(alma, "2027-05-03", "2027-05-07", bruno).andExpect(status().isOk());
+
+    long document = submit("Purchases");
+
+    assertThat(
+            jdbc.queryForList(
+                "select assignee_id from approval_task where document_id = ? order by assignee_id",
+                Long.class,
+                document))
+        .containsExactly(alma, bruno);
+  }
+
+  @Test
+  void thePeriodIsValidatedAndCanBeCleared() throws Exception {
+    away(alma, "2027-05-07", "2027-05-03", bruno).andExpect(status().isBadRequest());
+    away(alma, "2027-04-26", "2027-04-30", bruno).andExpect(status().isBadRequest());
+    away(alma, "2027-05-03", "2028-05-03", bruno).andExpect(status().isBadRequest());
+    away(alma, "2027-05-03", "2027-05-07", alma).andExpect(status().isBadRequest());
+    away(alma, "2027-05-03", "2027-05-07", 9_999).andExpect(status().isBadRequest());
+    away(alma, "2027-05-03", "+1000000-01-01", bruno).andExpect(status().isBadRequest());
+
+    away(alma, "2027-04-26", "2027-05-03", bruno).andExpect(status().isOk());
+    mvc.perform(delete("/api/v1/users/me/out-of-office").header(AUTH, data.bearer(alma)))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.outOfOffice").doesNotExist());
+    assertThat(assigneeOf(submit("Expenses"))).isEqualTo(alma);
+  }
+}
