+	"math/big"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/relaywork/gateway/internal/config"
+)
+
+// writeKeyPair returns a self-signed certificate and its key in PEM.
+func writeKeyPair(t *testing.T) (certPEM, keyPEM []byte) {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tmpl := &x509.Certificate{
+		SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "client"},
+		NotBefore: time.Date(2020, 1, 1, 0, 0, 0, 0, time.UTC), NotAfter: time.Date(2099, 1, 1, 0, 0, 0, 0, time.UTC),
+		IsCA: true, BasicConstraintsValid: true,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keyDER, err := x509.MarshalPKCS8PrivateKey(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}),
+		pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: keyDER})
+}
+
+// The key follows the effective settings: spellings of the same setting share a transport, and
+// different settings never do, whichever files hold the bytes.
+func TestCompileTLSKeyFollowsTheEffectiveSettings(t *testing.T) {
+	key := func(u config.UpstreamTLS) string {
+		t.Helper()
+		ts, err := compileTLS(&u)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return ts.Key
+	}
+	if key(config.UpstreamTLS{ServerName: "api"}) != key(config.UpstreamTLS{ServerName: "api", MinVersion: "1.2"}) {
+		t.Error(`min_version "" and "1.2" got different keys`)
+	}
+	if key(config.UpstreamTLS{ServerName: "api", MinVersion: "1.2"}) == key(config.UpstreamTLS{ServerName: "api", MinVersion: "1.3"}) {
+		t.Error(`min_version "1.2" and "1.3" got the same key`)
+	}
+	if key(config.UpstreamTLS{ServerName: "a"}) == key(config.UpstreamTLS{ServerName: "b"}) {
+		t.Error("different server names got the same key")
+	}
+
+	dir := t.TempDir()
+	certPEM, keyPEM := writeKeyPair(t)
+	write := func(name string, data []byte) string {
+		path := filepath.Join(dir, name)
+		if err := os.WriteFile(path, data, 0o600); err != nil {
+			t.Fatal(err)
+		}
+		return path
+	}
+	cert, priv := write("c.pem", certPEM), write("k.pem", keyPEM)
+	both := write("both.pem", append(append([]byte{}, certPEM...), keyPEM...))
+	if key(config.UpstreamTLS{CAFile: both}) == key(config.UpstreamTLS{CertFile: cert, KeyFile: priv}) {
+		t.Error("a CA file holding a certificate and its key got the key of that client certificate")
+	}
+}
