diff --git a/src/services/balanceCache.ts b/src/services/balanceCache.ts
new file mode 100644
index 0000000..0b30ab7
--- /dev/null
+++ b/src/services/balanceCache.ts
@@ -0,0 +1,123 @@
+import type { Account } from "../domain/account.js";
+import type { Logger } from "../infra/logger.js";
+import type { Redis } from "../infra/redis.js";
+
+/** An account as stored in Redis: JSON, with amounts as strings and dates as ISO strings. */
+type CachedAccount = Omit<Account, "balanceMinor" | "heldMinor" | "createdAt" | "updatedAt"> & {
+  readonly balanceMinor: string;
+  readonly heldMinor: string;
+  readonly createdAt: string;
+  readonly updatedAt: string;
+};
+
+/**
+ * Redis copies of account reads, so clients that poll `GET /accounts/:id` do not each cost a
+ * Postgres query. Two kinds of entries:
+ *
+ * - `balance:<tenant>:<account>`: the account as last read, kept for `ttlSeconds`. The
+ *   services drop it after every posting that moves money on the account (transfers, hold
+ *   captures) and when the account is closed. A read that raced a posting can put back a copy
+ *   from before it; the TTL bounds how long such a copy is served.
+ * - `balance:<tenant>:<account>:as_of:<ms>`: the balance at a past instant, computed from
+ *   entries. Once no transaction can still write an entry before that instant the value never
+ *   changes, so it is written once and kept.
+ *
+ * Redis problems never fail a request: a failed read falls back to Postgres and a failed write
+ * or delete is logged.
+ */
+export class BalanceCache {
+  private readonly redis: Redis;
+  private readonly logger: Logger;
+  private readonly ttlSeconds: number;
+
+  /** `ttlSeconds` is the lifetime of a cached account read; 0 turns the cache off. */
+  constructor(options: { redis: Redis; logger: Logger; ttlSeconds: number }) {
+    this.redis = options.redis;
+    this.logger = options.logger;
+    this.ttlSeconds = options.ttlSeconds;
+  }
+
+  get enabled(): boolean {
+    return this.ttlSeconds > 0;
+  }
+
+  async getAccount(tenantId: string, accountId: string): Promise<Account | null> {
+    if (!this.enabled) return null;
+    const raw = await this.read(this.accountKey(tenantId, accountId));
+    return raw === null ? null : fromCached(raw);
+  }
+
+  async putAccount(account: Account): Promise<void> {
+    if (!this.enabled) return;
+    const key = this.accountKey(account.tenantId, account.id);
+    await this.write("put", () => this.redis.set(key, toCached(account), "EX", this.ttlSeconds));
+  }
+
+  /** Drop the cached reads of accounts whose balance, held amount or status just changed. */
+  async invalidate(tenantId: string, accountIds: readonly string[]): Promise<void> {
+    if (!this.enabled || accountIds.length === 0) return;
+    const keys = accountIds.map((id) => this.accountKey(tenantId, id));
+    await this.write("invalidate", () => this.redis.del(...keys));
+  }
+
+  async getBalanceAsOf(tenantId: string, accountId: string, asOf: Date): Promise<bigint | null> {
+    if (!this.enabled) return null;
+    const raw = await this.read(this.asOfKey(tenantId, accountId, asOf));
+    return raw === null ? null : BigInt(raw);
+  }
+
+  async putBalanceAsOf(
+    tenantId: string,
+    accountId: string,
+    asOf: Date,
+    balanceMinor: bigint,
+  ): Promise<void> {
+    if (!this.enabled) return;
+    const key = this.asOfKey(tenantId, accountId, asOf);
+    await this.write("put as_of", () => this.redis.set(key, balanceMinor.toString()));
+  }
+
+  private accountKey(tenantId: string, accountId: string): string {
+    return `balance:${tenantId}:${accountId.toLowerCase()}`;
+  }
+
+  private asOfKey(tenantId: string, accountId: string, asOf: Date): string {
+    return `${this.accountKey(tenantId, accountId)}:as_of:${asOf.getTime()}`;
+  }
+
+  private async read(key: string): Promise<string | null> {
+    try {
+      return await this.redis.get(key);
+    } catch (err) {
+      this.logger.warn({ err, key }, "balance cache read failed");
+      return null;
+    }
+  }
+
+  private async write(operation: string, run: () => Promise<unknown>): Promise<void> {
+    try {
+      await run();
+    } catch (err) {
+      this.logger.warn({ err, operation }, "balance cache write failed");
+    }
+  }
+}
+
+function toCached(account: Account): string {
+  return JSON.stringify({
+    ...account,
+    balanceMinor: account.balanceMinor.toString(),
+    heldMinor: account.heldMinor.toString(),
+  });
+}
+
+function fromCached(raw: string): Account {
+  const cached = JSON.parse(raw) as CachedAccount;
+  return {
+    ...cached,
+    balanceMinor: BigInt(cached.balanceMinor),
+    heldMinor: BigInt(cached.heldMinor),
+    createdAt: new Date(cached.createdAt),
+    updatedAt: new Date(cached.updatedAt),
+  };
+}
