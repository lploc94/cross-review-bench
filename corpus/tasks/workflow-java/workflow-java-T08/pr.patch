diff --git a/src/main/java/com/papertrail/workflow/service/ArchiveService.java b/src/main/java/com/papertrail/workflow/service/ArchiveService.java
new file mode 100644
index 0000000..2d09fc4
--- /dev/null
+++ b/src/main/java/com/papertrail/workflow/service/ArchiveService.java
@@ -0,0 +1,58 @@
+package com.papertrail.workflow.service;
+
+import com.papertrail.workflow.config.WorkflowConfig;
+import com.papertrail.workflow.domain.Document;
+import com.papertrail.workflow.domain.DocumentStateMachine;
+import com.papertrail.workflow.domain.DocumentStatus;
+import com.papertrail.workflow.persistence.DocumentRepository;
+import java.time.Clock;
+import java.time.Instant;
+import java.util.List;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Applies the retention rule: a finished document whose last change is older than {@code
+ * workflow.retention.finished-after} keeps its record, tasks and audit trail, but its text is
+ * replaced by {@link Document#ARCHIVED_BODY}. Each pass locks its batch with {@code FOR UPDATE SKIP
+ * LOCKED}, so several instances share the work without archiving a document twice.
+ */
+@Service
+public class ArchiveService {
+
+  private static final Logger LOG = LoggerFactory.getLogger(ArchiveService.class);
+
+  /** The statuses a review ends in. */
+  private static final List<String> FINISHED =
+      List.of(
+          DocumentStatus.APPROVED.name(),
+          DocumentStatus.WITHDRAWN.name(),
+          DocumentStatus.REJECTED.name());
+
+  private final DocumentRepository documents;
+  private final WorkflowConfig config;
+  private final Clock clock;
+
+  public ArchiveService(DocumentRepository documents, WorkflowConfig config, Clock clock) {
+    this.documents = documents;
+    this.config = config;
+    this.clock = clock;
+  }
+
+  /** Archives up to one batch of finished documents; returns how many this call archived. */
+  @Transactional
+  public int archiveFinished() {
+    WorkflowConfig.Retention retention = config.retention();
+    Instant cutoff = clock.instant().minus(retention.finishedAfter());
+    List<Document> due = documents.lockArchivable(FINISHED, cutoff, retention.batchSize());
+    for (Document document : due) {
+      DocumentStateMachine.archive(document);
+    }
+    if (!due.isEmpty()) {
+      LOG.info("archived {} finished documents", due.size());
+    }
+    return due.size();
+  }
+}
