+    mvc.perform(get(ADMIN + "summary").header("Authorization", ADMIN_AUTH))
+        .andExpect(jsonPath("$.NO_SHOW").value(1));
+  }
+
+  @Test
+  void markingTooEarlyOrTwiceIsAConflict() throws Exception {
+    String url = ADMIN + reservation.getReference() + "/no-show";
+    clock.set(Instant.parse("2027-06-10T20:00:00Z"));
+    mvc.perform(post(url).header("Authorization", ADMIN_AUTH))
+        .andExpect(status().isConflict())
