-from etl.infra.tables import runs
+from etl.infra.tables import check_results, metadata, rejects, runs
 
 
 class RunStatus(StrEnum):
@@ -157,3 +172,94 @@ def last_succeeded(connection: Connection, source: str) -> RunRecord | None:
         .first()
     )
     return RunRecord.from_row(row) if row is not None else None
+
+
+@dataclass(frozen=True, slots=True)
+class PruneCounts:
+    runs: int = 0
+    rejects: int = 0
+    check_results: int = 0
+
+
+def _keeping_columns() -> list[Column[Any]]:
+    """Columns whose rows keep the run they name: the foreign keys to etl.runs that do not
+    cascade (`run_id` of the warehouse tables). Rejects and check results go with their run."""
+    return [
+        fk.parent
+        for table in metadata.sorted_tables
+        for fk in table.foreign_keys
+        if fk.column is runs.c.id and (fk.ondelete or "").upper() != "CASCADE"
+    ]
+
+
+def prunable(connection: Connection, *, finished_before: datetime, lock: bool) -> list[int]:
+    """Ids of the runs that finished before `finished_before` and that nothing needs any more:
+    no warehouse row names them, and none is the latest succeeded run of its source (row-count
+    delta checks compare with what that run observed). Runs in progress are never included.
+
+    With `lock`, the rows stay locked until the transaction ends.
+    """
+    latest_succeeded = (
+        select(func.max(runs.c.id))
+        .where(runs.c.status == RunStatus.SUCCEEDED)
+        .group_by(runs.c.source)
+    )
+    statement = (
+        select(runs.c.id)
+        .where(
+            runs.c.status != RunStatus.RUNNING,
+            runs.c.finished_at < finished_before,
+            runs.c.id.not_in(latest_succeeded),
+            *(~exists().where(column == runs.c.id) for column in _keeping_columns()),
+        )
+        .order_by(runs.c.id)
+    )
+    if lock:
+        statement = statement.with_for_update()
+    return [int(run_id) for run_id in connection.execute(statement).scalars()]
+
+
+def _among(run_ids: Sequence[int]) -> Any:
+    # One array parameter, however many runs there are.
+    return select(func.unnest(bindparam("run_ids", list(run_ids), ARRAY(BigInteger))))
+
+
+def dependants(connection: Connection, run_ids: Sequence[int]) -> PruneCounts:
+    """How many runs, rejects and check results deleting `run_ids` would remove."""
+    if not run_ids:
+        return PruneCounts()
+    among = _among(run_ids)
+    counted = connection.execute(
+        select(
+            select(func.count())
+            .select_from(rejects)
+            .where(rejects.c.run_id.in_(among))
+            .scalar_subquery(),
+            select(func.count())
+            .select_from(check_results)
+            .where(check_results.c.run_id.in_(among))
+            .scalar_subquery(),
+        )
+    ).one()
+    return PruneCounts(runs=len(run_ids), rejects=int(counted[0]), check_results=int(counted[1]))
+
+
+def delete_runs(connection: Connection, run_ids: Sequence[int]) -> PruneCounts:
+    """Delete the runs `run_ids` with their rejects and check results.
+
+    The foreign keys of rejects and check results cascade; they are deleted first anyway, so
+    that they can be counted.
+    """
+    if not run_ids:
+        return PruneCounts()
+    among = _among(run_ids)
+    deleted_rejects = connection.execute(delete(rejects).where(rejects.c.run_id.in_(among)))
+    deleted_checks = connection.execute(
+        delete(check_results).where(check_results.c.run_id.in_(among))
+    )
+    deleted_runs = connection.execute(delete(runs).where(runs.c.id.in_(among)))
+    return PruneCounts(
+        runs=deleted_runs.rowcount,
+        rejects=deleted_rejects.rowcount,
+        check_results=deleted_checks.rowcount,
+    )
