diff --git a/src/main/java/com/innkeep/booking/service/PromoService.java b/src/main/java/com/innkeep/booking/service/PromoService.java
new file mode 100644
index 0000000..7ba7a95
--- /dev/null
+++ b/src/main/java/com/innkeep/booking/service/PromoService.java
@@ -0,0 +1,143 @@
+package com.innkeep.booking.service;
+
+import com.innkeep.booking.domain.ConflictException;
+import com.innkeep.booking.domain.NotFoundException;
+import com.innkeep.booking.domain.PromoCode;
+import com.innkeep.booking.domain.PromoExhaustedException;
+import com.innkeep.booking.domain.Property;
+import com.innkeep.booking.domain.ValidationException;
+import com.innkeep.booking.persistence.PromoCodeRepository;
+import java.time.Clock;
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Locale;
+import java.util.regex.Pattern;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.support.TransactionTemplate;
+
+/**
+ * Promo codes of a property: the admin writes, the check a quote or hold makes before applying a
+ * code, the use a confirmation takes and a cancellation gives back. Codes are stored in upper case,
+ * so lookups ignore case.
+ */
+@Service
+public class PromoService {
+
+  private static final Pattern CODE = Pattern.compile("[A-Z0-9][A-Z0-9-]{1,39}");
+
+  private final CatalogService catalog;
+  private final PromoCodeRepository promos;
+  private final Clock clock;
+  private final TransactionTemplate tx;
+
+  public PromoService(
+      CatalogService catalog, PromoCodeRepository promos, Clock clock, TransactionTemplate tx) {
+    this.catalog = catalog;
+    this.promos = promos;
+    this.clock = clock;
+    this.tx = tx;
+  }
+
+  public PromoCode create(String propertyCode, PromoCodeDraft draft) {
+    Property property = catalog.property(propertyCode);
+    String code = normalize(draft.code());
+    if (!CODE.matcher(code).matches()) {
+      throw new ValidationException("promo codes are 2 to 40 letters, digits and hyphens");
+    }
+    if ((draft.percent() == null) == (draft.amount() == null)) {
+      throw new ValidationException("a promo code has either a percent or an amount");
+    }
+    if (draft.percent() != null && (draft.percent() < 1 || draft.percent() > 100)) {
+      throw new ValidationException("percent must be between 1 and 100");
+    }
+    if (draft.amount() != null
+        && (draft.amount().signum() <= 0
+            || draft.amount().stripTrailingZeros().scale()
+                > property.currency().getDefaultFractionDigits())) {
+      throw new ValidationException("amount must be positive, in the property's currency");
+    }
+    if (draft.validFrom() == null
+        || draft.validUntil() == null
+        || draft.validUntil().isBefore(draft.validFrom())
+        || draft.maxUses() < 1) {
+      throw new ValidationException("validUntil must not be before validFrom, maxUses at least 1");
+    }
+    if (promos.findByPropertyIdAndCode(property.getId(), code).isPresent()) {
+      throw new ConflictException("promo code " + code + " already exists");
+    }
+    return promos.save(
+        new PromoCode(
+            property,
+            code,
+            draft.percent(),
+            draft.amount(),
+            draft.validFrom(),
+            draft.validUntil(),
+            draft.maxUses()));
+  }
+
+  public List<PromoCode> list(String propertyCode) {
+    return promos.findByPropertyIdOrderByCodeAsc(catalog.property(propertyCode).getId());
+  }
+
+  public PromoCode disable(String propertyCode, String code) {
+    return tx.execute(
+        status -> {
+          PromoCode promo = find(catalog.property(propertyCode), code);
+          promo.disable();
+          return promo;
+        });
+  }
+
+  /**
+   * The code a quote or hold asks for, checked against the booking day (today at the property).
+   * Unknown, disabled and out-of-date codes are refused as invalid requests.
+   */
+  public PromoCode applicable(Property property, String code) {
+    PromoCode promo =
+        promos
+            .findByPropertyIdAndCode(property.getId(), normalize(code))
+            .orElseThrow(() -> new ValidationException("unknown promo code " + code));
+    LocalDate today = LocalDate.ofInstant(clock.instant(), property.zone());
+    if (!promo.isEnabled()) {
+      throw new ValidationException("promo code " + promo.getCode() + " is disabled");
+    }
+    if (!promo.isValidOn(today)) {
+      throw new ValidationException("promo code " + promo.getCode() + " is not valid on " + today);
+    }
+    if (!promo.hasUsesLeft()) {
+      throw new PromoExhaustedException(promo.getCode());
+    }
+    return promo;
+  }
+
+  /** Takes one use of the code for a confirmation, inside the confirmation's transaction. */
+  public void redeem(long promoCodeId) {
+    PromoCode promo = byId(promoCodeId);
+    if (!promo.hasUsesLeft()) {
+      throw new PromoExhaustedException(promo.getCode());
+    }
+    promo.recordUse();
+  }
+
+  /** Gives the use of a cancelled reservation back, inside the cancellation's transaction. */
+  public void giveBack(long promoCodeId) {
+    byId(promoCodeId).releaseUse();
+  }
+
+  private PromoCode byId(long promoCodeId) {
+    return promos
+        .findById(promoCodeId)
+        .orElseThrow(() -> new NotFoundException("promo code", promoCodeId));
+  }
+
+  private PromoCode find(Property property, String code) {
+    return promos
+        .findByPropertyIdAndCode(property.getId(), normalize(code))
+        .orElseThrow(() -> new NotFoundException("promo code", code));
+  }
+
+  private static String normalize(String code) {
+    return code == null ? "" : code.trim().toUpperCase(Locale.ROOT);
+  }
+}
