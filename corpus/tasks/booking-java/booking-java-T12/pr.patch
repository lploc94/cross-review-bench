+package com.innkeep.booking.domain;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.FetchType;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.JoinColumn;
+import jakarta.persistence.ManyToOne;
+import jakarta.persistence.Table;
+import java.time.LocalDate;
+
+/**
+ * Arrival rules of one room type for the nights from start to end (both inclusive): a minimum stay,
+ * closed to arrival, or both. They bind a stay that arrives on a covered night only.
+ */
+@Entity
+@Table(name = "stay_restriction")
+public class StayRestriction extends AbstractEntity<Long> {
+
+  @Id
+  @GeneratedValue(strategy = GenerationType.IDENTITY)
+  private Long id;
+
+  @ManyToOne(fetch = FetchType.LAZY, optional = false)
+  @JoinColumn(name = "room_type_id", nullable = false)
+  private RoomType roomType;
+
+  @Column(name = "start_date", nullable = false)
+  private LocalDate startDate;
+
+  @Column(name = "end_date", nullable = false)
+  private LocalDate endDate;
+
+  @Column(name = "min_stay")
+  private Integer minStay;
+
+  @Column(name = "closed_to_arrival", nullable = false)
+  private boolean closedToArrival;
+
+  protected StayRestriction() {}
+
+  public StayRestriction(
+      RoomType roomType,
+      LocalDate startDate,
+      LocalDate endDate,
+      Integer minStay,
+      boolean closedToArrival) {
+    this.roomType = roomType;
+    this.startDate = startDate;
+    this.endDate = endDate;
+    this.minStay = minStay;
+    this.closedToArrival = closedToArrival;
+  }
+
+  @Override
+  public Long getId() {
+    return id;
+  }
+
+  public LocalDate getStartDate() {
+    return startDate;
+  }
+
+  public LocalDate getEndDate() {
+    return endDate;
+  }
+
+  /** The fewest nights a stay arriving on a covered night may last, or null for no minimum. */
+  public Integer getMinStay() {
+    return minStay;
+  }
+
+  public boolean isClosedToArrival() {
+    return closedToArrival;
+  }
+}
