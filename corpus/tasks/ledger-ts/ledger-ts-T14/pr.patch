+import type { FastifyPluginAsync } from "fastify";
+import { requireScope } from "../plugins/auth.js";
+import { currencyParamsSchema } from "../schemas/currencies.js";
+import { serializeCurrency } from "../serializers.js";
+import { parse } from "../validation.js";
+import type { RouteOptions } from "./types.js";
+
+/**
+ * The currency catalogue: reference data shared by every tenant, so these routes read no tenant.
+ * They need `accounts:read`, which every client that shows balances already holds.
+ */
+export const currencyRoutes: FastifyPluginAsync<RouteOptions> = async (app, { services }) => {
+  app.get("/currencies", { preHandler: requireScope("accounts:read") }, async () => {
+    const currencies = await services.currencies.listCurrencies();
+    return { data: currencies.map(serializeCurrency) };
+  });
+
+  app.get("/currencies/:code", { preHandler: requireScope("accounts:read") }, async (request) => {
+    const { code } = parse(currencyParamsSchema, request.params, "params");
+    return serializeCurrency(await services.currencies.getCurrency(code));
+  });
+};
