+  /**
+   * A definition as a portable document for another installation: groups by name, a single approver
+   * by address, SLAs as ISO-8601 durations, and no database ids.
+   */
+  public record DefinitionExport(String name, int version, List<ExportedStep> steps) {
+
+    public static DefinitionExport of(WorkflowDefinition definition) {
+      return new DefinitionExport(
+          definition.getName(),
+          definition.getVersion(),
+          definition.getSteps().stream().map(ExportedStep::of).toList());
+    }
+  }
+
+  public record ExportedStep(
+      int order, StepKind kind, String assignee, String group, int quorum, String sla) {
+
+    public static ExportedStep of(StepDefinition step) {
+      return new ExportedStep(
+          step.getStepOrder(),
+          step.getKind(),
+          step.getAssignee() == null ? null : step.getAssignee().getEmail(),
+          step.getGroup() == null ? null : step.getGroup().getName(),
+          step.getQuorum(),
+          step.getSla().toString());
+    }
+  }
