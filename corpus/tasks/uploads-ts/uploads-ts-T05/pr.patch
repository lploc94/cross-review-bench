diff --git a/src/services/retention.ts b/src/services/retention.ts
new file mode 100644
index 0000000..110a0dd
--- /dev/null
+++ b/src/services/retention.ts
@@ -0,0 +1,52 @@
+import type { Pool } from "../db/pool.js";
+import { withTransaction } from "../db/tx.js";
+import { NotFoundError, ValidationError } from "../domain/errors.js";
+import { normalizeFolderPrefix } from "../domain/paths.js";
+import { MAX_RETENTION_DAYS, MAX_RETENTION_RULES, type RetentionRule } from "../domain/retention.js";
+import type { Clock } from "../infra/clock.js";
+import * as rules from "../repositories/retentionRepo.js";
+import * as tenants from "../repositories/tenantRepo.js";
+
+/** A tenant's retention rules. The cleanup job applies them (CleanupService.applyRetention). */
+export class RetentionService {
+  private readonly pool: Pool;
+  private readonly clock: Clock;
+
+  constructor(deps: { pool: Pool; clock: Clock }) {
+    this.pool = deps.pool;
+    this.clock = deps.clock;
+  }
+
+  async listRules(tenantId: string): Promise<RetentionRule[]> {
+    return rules.listRules(this.pool, tenantId);
+  }
+
+  /**
+   * Set the retention of a folder. The tenant's row is locked while the rules are counted, so
+   * concurrent requests cannot together pass MAX_RETENTION_RULES.
+   */
+  async setRule(tenantId: string, rawPrefix: string, days: number): Promise<RetentionRule> {
+    const prefix = normalizeFolderPrefix(rawPrefix);
+    if (!Number.isInteger(days) || days < 1 || days > MAX_RETENTION_DAYS) {
+      throw new ValidationError(`days must be a whole number from 1 to ${MAX_RETENTION_DAYS}`);
+    }
+    return withTransaction(this.pool, async (client) => {
+      if (!(await tenants.lockTenant(client, tenantId))) {
+        throw NotFoundError.resource("tenant", tenantId);
+      }
+      if ((await rules.countOtherRules(client, tenantId, prefix)) >= MAX_RETENTION_RULES) {
+        throw new ValidationError(`a tenant has at most ${MAX_RETENTION_RULES} retention rules`, {
+          limit: MAX_RETENTION_RULES,
+        });
+      }
+      return rules.upsertRule(client, { tenantId, prefix, days, now: this.clock.now() });
+    });
+  }
+
+  async removeRule(tenantId: string, rawPrefix: string): Promise<void> {
+    const prefix = normalizeFolderPrefix(rawPrefix);
+    if (!(await rules.deleteRule(this.pool, tenantId, prefix))) {
+      throw new NotFoundError(`no retention rule for ${prefix}`, { prefix });
+    }
+  }
+}
