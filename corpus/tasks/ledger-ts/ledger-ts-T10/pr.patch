index 0000000..a9b75c9
--- /dev/null
+++ b/migrations/0009_api_key_transfer_limits.sql
@@ -0,0 +1,12 @@
+-- An API key may cap the amount it sends per UTC day in one currency. Transfers record the key
+-- that posted them, so a key's usage for the day is the sum of its transfers since midnight UTC.
+ALTER TABLE api_keys
+    ADD COLUMN daily_transfer_limit_minor    bigint CHECK (daily_transfer_limit_minor > 0),
+    ADD COLUMN daily_transfer_limit_currency text REFERENCES currencies (code),
+    ADD CONSTRAINT api_keys_daily_transfer_limit_check
+        CHECK ((daily_transfer_limit_minor IS NULL) = (daily_transfer_limit_currency IS NULL));
+
+ALTER TABLE transfers ADD COLUMN api_key_id uuid REFERENCES api_keys (id);
+
+CREATE INDEX transfers_api_key_created_idx ON transfers (api_key_id, currency, created_at)
+    WHERE api_key_id IS NOT NULL;
