diff --git a/src/main/java/com/papertrail/workflow/service/DelegationService.java b/src/main/java/com/papertrail/workflow/service/DelegationService.java
new file mode 100644
index 0000000..4035723
--- /dev/null
+++ b/src/main/java/com/papertrail/workflow/service/DelegationService.java
@@ -0,0 +1,98 @@
+package com.papertrail.workflow.service;
+
+import com.papertrail.workflow.domain.AppUser;
+import com.papertrail.workflow.domain.BusinessCalendar;
+import com.papertrail.workflow.domain.ConflictException;
+import com.papertrail.workflow.domain.Delegation;
+import com.papertrail.workflow.domain.ForbiddenException;
+import com.papertrail.workflow.domain.NotFoundException;
+import com.papertrail.workflow.domain.Principal;
+import com.papertrail.workflow.domain.ValidationException;
+import com.papertrail.workflow.persistence.AppUserRepository;
+import com.papertrail.workflow.persistence.DelegationRepository;
+import com.papertrail.workflow.service.Views.DelegationView;
+import java.time.Clock;
+import java.time.LocalDate;
+import java.util.Set;
+import java.util.stream.Collectors;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Delegations of approval tasks. While a delegation is in force its delegate may decide the
+ * delegator's open tasks and read their documents. Days are dates in the business calendar's zone.
+ */
+@Service
+public class DelegationService {
+
+  private final DelegationRepository delegations;
+  private final AppUserRepository users;
+  private final BusinessCalendar calendar;
+  private final Clock clock;
+
+  public DelegationService(
+      DelegationRepository delegations,
+      AppUserRepository users,
+      BusinessCalendar calendar,
+      Clock clock) {
+    this.delegations = delegations;
+    this.users = users;
+    this.calendar = calendar;
+    this.clock = clock;
+  }
+
+  /**
+   * Creates a delegation. The delegator is the caller unless {@code delegatorId} names someone
+   * else. The delegator's row is locked, so two overlapping requests cannot both pass the check.
+   */
+  @Transactional
+  public DelegationView create(
+      Principal actor, Long delegatorId, long delegateId, LocalDate from, LocalDate until) {
+    AppUser delegator =
+        users
+            .lockById(delegatorId == null ? actor.userId() : delegatorId)
+            .orElseThrow(() -> new NotFoundException("delegator not found"));
+    if (delegator.isAdmin() && !actor.admin()) {
+      throw new ForbiddenException("only an admin may set up a delegation for an admin");
+    }
+    AppUser delegate =
+        users
+            .findById(delegateId)
+            .filter(AppUser::isActive)
+            .orElseThrow(() -> new ValidationException("the delegate must be an active user"));
+    if (until.isBefore(today())) {
+      throw new ValidationException("until must not be in the past");
+    }
+    if (delegations.existsOverlapping(delegator.getId(), from, until)) {
+      throw new ConflictException("the delegator already has a delegation in this period");
+    }
+    Delegation saved =
+        delegations.save(new Delegation(delegator, delegate, from, until, clock.instant()));
+    return DelegationView.of(saved);
+  }
+
+  /** Ends a delegation; its delegator or an admin may. Others get not found. */
+  @Transactional
+  public void delete(Principal actor, long id) {
+    Delegation delegation =
+        delegations
+            .findById(id)
+            .filter(d -> actor.admin() || d.getDelegator().getId() == actor.userId())
+            .orElseThrow(() -> new NotFoundException("delegation not found"));
+    delegations.delete(delegation);
+  }
+
+  /** The users whose open tasks {@code delegateId} may decide today. */
+  @Transactional(readOnly = true)
+  public Set<Long> delegatorsFor(long delegateId) {
+    LocalDate today = today();
+    return delegations.findByDelegateIdAndEndsOnGreaterThanEqual(delegateId, today).stream()
+        .filter(delegation -> delegation.coversDay(today))
+        .map(delegation -> delegation.getDelegator().getId())
+        .collect(Collectors.toSet());
+  }
+
+  private LocalDate today() {
+    return LocalDate.ofInstant(clock.instant(), calendar.getZone());
+  }
+}
