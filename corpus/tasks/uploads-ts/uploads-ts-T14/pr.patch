+      await tag(file.id, "all");
+    }
+    const seen: string[] = [];
+    let cursor: string | null = null;
+    let pages = 0;
+    do {
+      const current: Page = await page(`?tag=keep&limit=3${cursor ? `&after=${encodeURIComponent(cursor)}` : ""}`);
+      seen.push(...current.data.map((file) => file.path));
+      cursor = current.nextCursor;
+      pages++;
+    } while (cursor !== null && pages < 10);
+    expect(seen).toEqual(["a.txt", "c/d.txt", "e.txt", "f.txt"]);
