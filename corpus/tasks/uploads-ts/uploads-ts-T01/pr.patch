+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { buildTestApp, type TestApp } from "../helpers/app.js";
+import {
+  createTenant,
+  expectStatus,
+  markAvailable,
+  storeFile,
+  type ErrorResponse,
+  type FileBody,
+  type TestTenant,
+} from "../helpers/fixtures.js";
+
+/** 100 bytes, A to Z over and over, so every slice is recognisable. */
+const LETTERS = Array.from({ length: 100 }, (_, i) => String.fromCharCode(65 + (i % 26))).join("");
+
+describe("range requests on downloads", () => {
+  let t: TestApp;
+  let tenant: TestTenant;
+  let file: FileBody;
+
+  beforeEach(async () => {
+    t = await buildTestApp();
+    tenant = await createTenant(t.pool, t.clock);
+    file = await storeFile(t.app, tenant, "media/letters.txt", LETTERS);
+    await markAvailable(t.pool, file.id);
+  });
+
+  afterEach(async () => {
+    await t.close();
+  });
+
+  function download(range: string, extra: Record<string, string> = {}) {
+    return t.app.inject({
+      url: "/v1/files/media/letters.txt",
+      headers: { ...tenant.headers, range, ...extra },
+    });
+  }
+
+  it("answers 206 with the requested bytes and their Content-Range", async () => {
+    for (const url of ["/v1/files/media/letters.txt", `/v1/files/by-id/${file.id}`]) {
+      const response = await t.app.inject({ url, headers: { ...tenant.headers, range: "bytes=26-51" } });
+      expectStatus(response, 206);
+      expect(response.body).toBe(LETTERS.slice(26, 52));
+      expect(response.headers).toMatchObject({
+        "content-range": "bytes 26-51/100",
+        "accept-ranges": "bytes",
+        etag: `"${file.sha256}"`,
+        "content-disposition": 'attachment; filename="letters.txt"',
+      });
+    }
+  });
+
+  it("serves an open range to the end of the file", async () => {
+    const response = await download("bytes=95-");
+    expectStatus(response, 206);
+    expect(response.body).toBe("RSTUV");
+    expect(response.headers["content-range"]).toBe("bytes 95-99/100");
+  });
+
+  it("answers 416 with the file size when the range starts past the end", async () => {
+    const response = await download("bytes=100-");
+    expectStatus(response, 416);
+    expect(response.headers["content-range"]).toBe("bytes */100");
+    expect(response.json<ErrorResponse>().error.code).toBe("range_not_satisfiable");
+  });
+
+  it("sends the whole file for several ranges or a malformed header", async () => {
+    for (const range of ["bytes=0-1,5-6", "bytes=9-3", "lines=1-2"]) {
+      const response = await download(range);
+      expectStatus(response, 200);
+      expect(response.body).toBe(LETTERS);
+      expect(response.headers["content-length"]).toBe("100");
+    }
+  });
+
+  it("honours the range only while If-Range names the current ETag", async () => {
+    const current = await download("bytes=0-2", { "if-range": `"${file.sha256}"` });
+    expectStatus(current, 206);
+    expect(current.body).toBe("ABC");
+
+    const stale = await download("bytes=0-2", { "if-range": '"an-older-version"' });
+    expectStatus(stale, 200);
+    expect(stale.body).toBe(LETTERS);
+  });
+
+  it("serves ranges through signed links", async () => {
+    const signed = await t.app.inject({
+      method: "POST",
+      url: `/v1/files/by-id/${file.id}/signed-url`,
+      headers: tenant.headers,
+      payload: { expiresIn: 60 },
+    });
+    expectStatus(signed, 200);
+    const response = await t.app.inject({
+      url: signed.json<{ url: string }>().url,
+      headers: { range: "bytes=0-4" },
+    });
+    expectStatus(response, 206);
+    expect(response.body).toBe("ABCDE");
+    expect(response.headers["content-range"]).toBe("bytes 0-4/100");
+  });
