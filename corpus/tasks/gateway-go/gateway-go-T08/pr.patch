new file mode 100644
index 0000000..b36369f
--- /dev/null
+++ b/internal/store/quota.go
@@ -0,0 +1,53 @@
+package store
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/redis/go-redis/v9"
+
+	"github.com/relaywork/gateway/internal/core"
+)
+
+// quotaScript counts one request against a consumer's daily quota. The first request of a day
+// sets the expiry of that day's counter. A request over the limit is taken back, so refused
+// requests do not use up the quota.
+// KEYS: the day's counter. ARGV: the limit, the time left in the day in milliseconds. The expiry
+// is relative: Redis judges an absolute one by its own clock, not the store's.
+var quotaScript = redis.NewScript(`
+local count = redis.call('INCR', KEYS[1])
+if count == 1 then
+  redis.call('PEXPIRE', KEYS[1], ARGV[2])
+end
+if count > tonumber(ARGV[1]) then
+  redis.call('DECR', KEYS[1])
+  return -1
+end
+return count
+`)
+
+// SetQuotaZone sets the time zone whose calendar days daily quotas run on. It is UTC until set,
+// and is set at startup, before the store serves requests.
+func (s *Store) SetQuotaZone(loc *time.Location) { s.zone = loc }
+
+// ConsumeQuota counts one request of the consumer against its daily quota of limit requests. A
+// day runs from midnight to midnight in the quota zone, so the counter of a request is the one
+// of the day the request falls on in that zone. A refused request reports how long until the next
+// day starts.
+func (s *Store) ConsumeQuota(ctx context.Context, consumerID string, limit int64) (core.QuotaDecision, error) {
+	now := s.clock.Now()
+	local := now.In(s.zone)
+	day := now.UTC().Format("2006-01-02")
+	end := time.Date(local.Year(), local.Month(), local.Day()+1, 0, 0, 0, 0, s.zone)
+	left := end.Sub(now)
+	n, err := quotaScript.Run(ctx, s.rdb, []string{s.key("quota", consumerID, day)}, limit, left.Milliseconds()).Int64()
+	if err != nil {
+		return core.QuotaDecision{}, fmt.Errorf("daily quota: %w", err)
+	}
+	d := core.QuotaDecision{Allowed: n >= 0, Limit: limit, RetryAfter: left}
+	if d.Allowed {
+		d.Remaining = limit - n
+	}
+	return d, nil
+}
diff --git a/internal/store/quota_test.go b/internal/store/quota_test.go
new file mode 100644
index 0000000..ab5af9a
--- /dev/null
+++ b/internal/store/quota_test.go
@@ -0,0 +1,53 @@
+package store
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/relaywork/gateway/internal/model"
+)
+
+func TestDailyQuotaCountsAndRefusesUntilTheDayEnds(t *testing.T) {
+	e := newEnv(t)
+	ctx := context.Background()
+	// t0 is 12:00 UTC; the day ends in twelve hours.
+	for i := 1; i <= 2; i++ {
+		d, err := e.store.ConsumeQuota(ctx, "c_0123456789abcdef", 2)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !d.Allowed || d.Remaining != int64(2-i) || d.Limit != 2 {
+			t.Fatalf("request %d: %+v", i, d)
+		}
+	}
+	d, err := e.store.ConsumeQuota(ctx, "c_0123456789abcdef", 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if d.Allowed || d.RetryAfter != 12*time.Hour {
+		t.Fatalf("over the quota: %+v", d)
+	}
+	e.clock.Set(t0.Add(12 * time.Hour))
+	if d, _ := e.store.ConsumeQuota(ctx, "c_0123456789abcdef", 2); !d.Allowed || d.Remaining != 1 {
+		t.Errorf("next day: %+v", d)
+	}
+}
+
+func TestConsumerDailyQuotaIsStored(t *testing.T) {
+	e := newEnv(t)
+	ctx := context.Background()
+	c := e.consumer(t, "billing")
+	quota := int64(250)
+	patched, err := e.store.UpdateConsumer(ctx, c.ID, model.ConsumerPatch{DailyQuota: &quota})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if patched.DailyQuota != 250 || patched.Name != "billing" {
+		t.Errorf("after patch: %+v", patched)
+	}
+	got, err := e.store.GetConsumer(ctx, c.ID)
+	if err != nil || got.DailyQuota != 250 {
+		t.Errorf("stored: %+v, %v", got, err)
+	}
+}
