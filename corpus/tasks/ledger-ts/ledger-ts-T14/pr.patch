+++ b/test/api/currencies.test.ts
@@ -0,0 +1,74 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { listCurrencies } from "../../src/domain/currency.js";
+import { buildTestApp, type TestApp } from "../helpers/app.js";
+import { createTenant, issueKey, type ErrorResponse, type TestTenant } from "../helpers/fixtures.js";
+
+interface CurrencyBody {
+  code: string;
+  name: string;
+  exponent: number;
+  minor_unit: string;
+  sample: string;
+}
+
+describe("currencies", () => {
+  let t: TestApp;
+  let tenant: TestTenant;
+
+  beforeAll(async () => {
+    t = await buildTestApp();
+  });
+
+  afterAll(async () => {
+    await t.close();
+  });
+
+  beforeEach(async () => {
+    tenant = await createTenant(t.pool, t.clock);
+  });
+
+  function get(url: string, as: TestTenant = tenant) {
+    return t.app.inject({ method: "GET", url, headers: as.headers });
+  }
+
+  it("lists every supported currency by code", async () => {
+    const response = await get("/currencies");
+    expect(response.statusCode).toBe(200);
+    const { data } = response.json<{ data: CurrencyBody[] }>();
+    expect(data.map((c) => c.code)).toEqual(["BHD", "CHF", "EUR", "GBP", "JPY", "KWD", "USD", "VND"]);
+    expect(data.map((c) => [c.code, c.exponent])).toEqual(
+      listCurrencies()
+        .map((c) => [c.code, c.exponent])
+        .sort(([a], [b]) => String(a).localeCompare(String(b))),
+    );
+  });
+
+  it("describes one currency with its minor unit and a formatted sample", async () => {
+    const cases: [string, Omit<CurrencyBody, "code">][] = [
+      ["USD", { name: "US Dollar", exponent: 2, minor_unit: "0.01", sample: "1,234,567.89" }],
+      ["JPY", { name: "Yen", exponent: 0, minor_unit: "1", sample: "123,456,789" }],
+      ["KWD", { name: "Kuwaiti Dinar", exponent: 3, minor_unit: "0.001", sample: "123,456.789" }],
+    ];
+    for (const [code, expected] of cases) {
+      const response = await get(`/currencies/${code}`);
+      expect(response.statusCode, code).toBe(200);
+      expect(response.json<CurrencyBody>()).toEqual({ code, ...expected });
+    }
+  });
+
+  it("answers 404 for an unknown code and 400 for a malformed one", async () => {
+    const unknown = await get("/currencies/XAU");
+    expect(unknown.statusCode).toBe(404);
+    expect(unknown.json<ErrorResponse>().error.code).toBe("not_found");
+    for (const code of ["usd", "US", "USDT", "U1D"]) {
+      expect((await get(`/currencies/${code}`)).statusCode, code).toBe(400);
+    }
+  });
+
+  it("needs an API key with accounts:read", async () => {
+    const fxOnly = await issueKey(t.pool, t.clock, tenant.tenantId, ["fx:read"]);
+    expect((await get("/currencies", fxOnly)).statusCode).toBe(403);
+    const anonymous = await t.app.inject({ method: "GET", url: "/currencies/USD" });
+    expect(anonymous.statusCode).toBe(401);
+  });
+});
