diff --git a/packages/client/test/e2e/rejections.test.ts b/packages/client/test/e2e/rejections.test.ts
new file mode 100644
index 0000000..f59b99a
--- /dev/null
+++ b/packages/client/test/e2e/rejections.test.ts
@@ -0,0 +1,67 @@
+import { IN_MEMORY, InvalidResponseError, PUSH_PATH, SyncClient, openDatabase } from "@sync/client";
+import { ManualClock, formatHlc, seededRandom } from "@sync/shared";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { ScriptedTransport, openClient, type TestClient } from "../helpers/clients.js";
+import { tempDbPath } from "../helpers/tempFiles.js";
+import { startTestServer, type TestAccount, type TestServer } from "../helpers/testServer.js";
+
+let server: TestServer;
+let laptop: TestAccount;
+const opened: TestClient[] = [];
+
+beforeEach(async () => {
+  server = await startTestServer();
+  laptop = await server.createUser("Ada");
+});
+
+afterEach(async () => {
+  for (const c of opened.splice(0)) await c.client.close();
+  await server.close();
+});
+
+/** Replace the fields of a queued mutation, as a newer app version could have written them. */
+function rewriteQueued(dbPath: string, docId: string, fields: unknown): void {
+  const db = openDatabase(dbPath);
+  db.prepare("UPDATE outbox SET fields = ? WHERE doc_id = ?").run(JSON.stringify(fields), docId);
+  db.close();
+}
+
+describe("rejected mutations", () => {
+  it("are marked and kept out of later pushes while the rest of the batch syncs", async () => {
+    const dbPath = tempDbPath();
+    const writer = openClient(server, laptop, { dbPath });
+    writer.client.setMany(["n1", "n2", "n3"].map((id) => ({ collection: "notes" as const, id, fields: { title: id } })));
+    await writer.client.close();
+    rewriteQueued(dbPath, "n2", { title: "n2", archived: true });
+
+    const a = openClient(server, laptop, { dbPath });
+    opened.push(a);
+    expect(await a.client.sync()).toMatchObject({ pushed: 2 });
+    expect(a.client.pendingCount()).toBe(0);
+    expect(a.client.rejectedMutations()).toMatchObject([
+      { mutation: { docId: "n2", fields: { archived: true } }, code: "invalid_mutation" },
+    ]);
+    expect(a.client.rejectedMutations()[0]?.message).toMatch(/^mutation 1 /);
+    expect(await server.countEvents(laptop.userId)).toBe(2);
+
+    await a.client.sync();
+    expect(a.transport.count(PUSH_PATH)).toBe(1);
+  });
+
+  it("must name a mutation of the batch that was not acknowledged", async () => {
+    const serverHlc = formatHlc({ wallMs: new ManualClock().now(), counter: 0, node: "server" });
+    const rejection = { code: "invalid_mutation", message: "no", issues: [] };
+    for (const index of [0, 2]) {
+      const transport = new ScriptedTransport();
+      const client = SyncClient.open({ dbPath: IN_MEMORY, transport, clock: new ManualClock(), random: seededRandom(3) });
+      const [first] = client.setMany(
+        ["n1", "n2"].map((id) => ({ collection: "notes" as const, id, fields: { title: id } })),
+      );
+      transport.answerPush({ acked: [first?.mutationId ?? ""], rejected: [{ index, ...rejection }], serverHlc });
+      await expect(client.sync()).rejects.toBeInstanceOf(InvalidResponseError);
+      expect(client.pendingCount()).toBe(2);
+      expect(client.rejectedMutations()).toEqual([]);
+      await client.close();
+    }
+  });
+});
