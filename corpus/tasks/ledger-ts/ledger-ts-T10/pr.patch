+     WHERE tenant_id = $1 AND id = $2 AND daily_transfer_limit_currency = $3
+     FOR UPDATE`,
+    [tenantId, id, currency],
+  );
+  const row = firstRow(result.rows);
+  return row ? mapLimit(row) : null;
