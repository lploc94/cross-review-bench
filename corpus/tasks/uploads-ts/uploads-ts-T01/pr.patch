index 0000000..7f0753b
--- /dev/null
+++ b/src/api/range.ts
@@ -0,0 +1,47 @@
+import type { ByteRange } from "../storage/driver.js";
+
+/** What a download answers to its `Range` header. */
+export type RangeRequest =
+  | { readonly kind: "full" }
+  | { readonly kind: "partial"; readonly range: ByteRange }
+  | { readonly kind: "unsatisfiable" };
+
+const FULL: RangeRequest = { kind: "full" };
+const UNSATISFIABLE: RangeRequest = { kind: "unsatisfiable" };
+
+/** One range of the `bytes` unit; the unit name is case-insensitive. */
+const SINGLE_BYTE_RANGE = /^bytes=(\d*)-(\d*)$/i;
+
+/**
+ * The part of a `size`-byte file that a `Range` header asks for (RFC 9110 §14.2). A single range
+ * is served: `first-last`, `first-` (to the end of the file) and the suffix form `-length` (the
+ * last `length` bytes); a `last` past the end of the file is cut to the end. The range returned
+ * has an inclusive `end`, as in the header itself and in `Content-Range`.
+ *
+ * A missing or malformed header, another unit, a list of several ranges or a `last` before
+ * `first` is ignored, and the whole file is sent, as the RFC allows. A range that starts at or
+ * after the end of the file is unsatisfiable (416). An empty file is always sent whole.
+ */
+export function parseRange(header: string | undefined, size: number): RangeRequest {
+  if (header === undefined || size === 0) return FULL;
+  const match = SINGLE_BYTE_RANGE.exec(header.trim());
+  if (!match) return FULL;
+  const first = match[1] ?? "";
+  const last = match[2] ?? "";
+  if (first === "" && last === "") return FULL;
+  const start = first === "" ? 0 : Number(first);
+  const end = last === "" ? size - 1 : Math.min(Number(last), size - 1);
+  if (last !== "" && Number(last) < start) return FULL;
+  if (start >= size) return UNSATISFIABLE;
+  return { kind: "partial", range: { start, end } };
+}
+
+/**
+ * Whether a `Range` header may be honoured under `If-Range` (RFC 9110 §13.1.5): always without
+ * the header, otherwise only when it names the file's current entity tag. The comparison is
+ * strong, so a weak tag never matches; a date never matches either, since downloads carry no
+ * `Last-Modified`.
+ */
+export function ifRangeHolds(header: string | undefined, etag: string): boolean {
+  return header === undefined || header.trim() === etag;
+}
