+package com.innkeep.booking.service;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import com.innkeep.booking.domain.ConflictException;
+import com.innkeep.booking.domain.DateRange;
+import com.innkeep.booking.domain.GuestDetails;
+import com.innkeep.booking.domain.Hold;
+import com.innkeep.booking.domain.HoldStatus;
+import com.innkeep.booking.domain.InsufficientAvailabilityException;
+import com.innkeep.booking.domain.Property;
+import com.innkeep.booking.domain.Reservation;
+import com.innkeep.booking.domain.RoomType;
+import com.innkeep.booking.domain.ValidationException;
+import com.innkeep.booking.service.HoldService.GroupItem;
+import com.innkeep.booking.support.IntegrationTestBase;
+import com.innkeep.booking.support.TestConfig;
+import java.math.BigDecimal;
+import java.time.Duration;
+import java.time.LocalDate;
+import java.util.List;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicReference;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+
+class HoldGroupTest extends IntegrationTestBase {
+
+  private static final LocalDate JUNE_1 = LocalDate.parse("2027-06-01");
+  private static final LocalDate JUNE_2 = LocalDate.parse("2027-06-02");
+  private static final LocalDate JUNE_3 = LocalDate.parse("2027-06-03");
+  private static final DateRange STAY = new DateRange(JUNE_1, JUNE_3);
+  private static final GuestDetails GUEST =
+      new GuestDetails("Mara Quill", "guest@example.com", null);
+
+  @Autowired private HoldService holds;
+
+  private Property property;
+  private RoomType doubleRoom;
+  private RoomType suite;
+
+  @BeforeEach
+  void setUp() {
+    property = data.harbourHouse();
+    doubleRoom = data.roomType(property, "double", 2, "100.00");
+    suite = data.roomType(property, "suite", 2, "200.00");
+    data.rooms(property, doubleRoom, JUNE_1, JUNE_3, 2);
+    data.rooms(property, suite, JUNE_1, JUNE_3, 1);
+  }
+
+  private List<Hold> group(GroupItem... items) {
+    return holds.createGroup(property.getCode(), STAY, List.of(items), GUEST);
+  }
+
+  @Test
+  void aGroupHoldsEveryRoomTypeInRoomTypeOrderWithItsOwnQuote() {
+    List<Hold> group = group(new GroupItem("suite", 1, 2), new GroupItem("double", 2, 4));
+
+    assertThat(group).extracting(h -> h.getRoomType().getCode()).containsExactly("double", "suite");
+    assertThat(group).extracting(Hold::getGroupId).containsOnly(group.get(0).getGroupId());
+    assertThat(group).extracting(Hold::getExpiresAt).containsOnly(group.get(0).getExpiresAt());
+    assertThat(group.get(0).getTotal().amount()).isEqualByComparingTo("400.00");
+    assertThat(group.get(1).getTotal().amount()).isEqualByComparingTo("400.00");
+    assertThat(held(doubleRoom, JUNE_2)).isEqualTo(2);
+    assertThat(held(suite, JUNE_2)).isEqualTo(1);
+  }
+
+  @Test
+  void aShortRoomTypeHoldsNothingForTheOthers() {
+    data.hold(property, doubleRoom, JUNE_2, JUNE_3, 2);
+
+    assertThatThrownBy(() -> group(new GroupItem("double", 1, 2), new GroupItem("suite", 1, 2)))
+        .isInstanceOf(InsufficientAvailabilityException.class);
+    assertThat(held(doubleRoom, JUNE_1)).isZero();
+    assertThat(held(suite, JUNE_1)).isZero();
+    assertThat(held(suite, JUNE_2)).isZero();
+  }
+
+  @Test
+  void aRoomTypeListedTwiceIsRefused() {
+    assertThatThrownBy(() -> group(new GroupItem("double", 1, 2), new GroupItem("double", 1, 2)))
+        .isInstanceOf(ValidationException.class);
+    assertThat(held(doubleRoom, JUNE_1)).isZero();
+  }
+
+  @Test
+  void confirmingChargesTheTotalOnceAndBooksEveryRoomType() {
+    Hold first = group(new GroupItem("double", 1, 2), new GroupItem("suite", 1, 2)).get(0);
+
+    List<Reservation> booked = holds.confirmGroup(first.getGroupId());
+
+    assertThat(booked)
+        .extracting(r -> r.getRoomType().getCode())
+        .containsExactly("double", "suite");
+    assertThat(payments.movements()).hasSize(1);
+    assertThat(payments.movements().get(0).key()).isEqualTo("charge-group-" + first.getGroupId());
+    assertThat(payments.movements().get(0).amount().amount()).isEqualByComparingTo("600.00");
+    assertThat(
+            jdbc.queryForObject(
+                "select sum(amount) from ledger_entry where kind = 'CHARGE'", BigDecimal.class))
+        .isEqualByComparingTo("600.00");
+    assertThat(booked(doubleRoom, JUNE_1)).isEqualTo(1);
+    assertThat(booked(suite, JUNE_2)).isEqualTo(1);
+    assertThat(held(suite, JUNE_2)).isZero();
+  }
+
+  @Test
+  void aRoomTypeQuotedAtZeroIsBookedWithoutALedgerEntry() {
+    RoomType comp = data.roomType(property, "comp", 2, "0.00");
+    data.rooms(property, comp, JUNE_1, JUNE_3, 1);
+    Hold first = group(new GroupItem("double", 1, 2), new GroupItem("comp", 1, 2)).get(0);
+
+    List<Reservation> booked = holds.confirmGroup(first.getGroupId());
+
+    assertThat(booked).hasSize(2);
+    assertThat(payments.movements()).hasSize(1);
+    assertThat(payments.movements().get(0).amount().amount()).isEqualByComparingTo("200.00");
+    assertThat(jdbc.queryForObject("select count(*) from ledger_entry", Integer.class))
+        .isEqualTo(1);
+    assertThat(booked(comp, JUNE_1)).isEqualTo(1);
+  }
+
+  @Test
+  void aGroupQuotedAtZeroIsConfirmedWithoutACharge() {
+    RoomType comp = data.roomType(property, "comp", 2, "0.00");
+    data.rooms(property, comp, JUNE_1, JUNE_3, 1);
+    Hold only = group(new GroupItem("comp", 1, 2)).get(0);
+
+    holds.confirmGroup(only.getGroupId());
+
+    assertThat(payments.movements()).isEmpty();
+    assertThat(jdbc.queryForObject("select count(*) from ledger_entry", Integer.class)).isZero();
+    assertThat(booked(comp, JUNE_2)).isEqualTo(1);
+  }
+
+  @Test
+  void aGroupConfirmationLocksOnlyItsHoldRowsWhileItIsCharged() throws Exception {
+    Hold first = group(new GroupItem("double", 1, 2), new GroupItem("suite", 1, 2)).get(0);
+    var probe = new AtomicReference<Throwable>();
+    try (var pool = Executors.newSingleThreadExecutor()) {
+      payments.beforeNextCharge(
+          () -> {
+            try {
+              pool.submit(
+                      () -> {
+                        // NOWAIT: fails at once if the confirmation holds one of these rows.
+                        for (String table : List.of("property", "room_type")) {
+                          jdbc.queryForList("select id from " + table + " for update nowait");
+                        }
+                        data.hold(property, doubleRoom, JUNE_1, JUNE_3, 1);
+                        return null;
+                      })
+                  .get(10, TimeUnit.SECONDS);
+            } catch (Exception e) {
+              probe.set(e);
+            }
+          });
+
+      holds.confirmGroup(first.getGroupId());
+    }
+
+    assertThat(probe.get()).isNull();
+    assertThat(held(doubleRoom, JUNE_1)).isEqualTo(1);
+    assertThat(booked(doubleRoom, JUNE_1)).isEqualTo(1);
+  }
+
+  @Test
+  void aHoldOfAGroupIsReleasedOnlyWithItsGroup() {
+    List<Hold> group = group(new GroupItem("double", 1, 2), new GroupItem("suite", 1, 2));
+    Hold suiteHold = group.get(1);
+
+    assertThatThrownBy(() -> holds.release(suiteHold.getId()))
+        .isInstanceOf(ConflictException.class);
+    assertThatThrownBy(() -> holds.confirm(suiteHold.getId()))
+        .isInstanceOf(ConflictException.class);
+    assertThat(held(suite, JUNE_1)).isEqualTo(1);
+
+    holds.releaseGroup(suiteHold.getGroupId());
+
+    assertThat(holds.getGroup(suiteHold.getGroupId()))
+        .extracting(Hold::getStatus)
+        .containsOnly(HoldStatus.RELEASED);
+    assertThat(held(doubleRoom, JUNE_1)).isZero();
+    assertThat(held(suite, JUNE_2)).isZero();
+  }
+
+  @Test
+  void theSweepExpiresTheWholeGroup() {
+    List<Hold> group = group(new GroupItem("double", 1, 2), new GroupItem("suite", 1, 2));
+    clock.set(TestConfig.START.plus(Duration.ofMinutes(15)));
+
+    assertThat(holds.releaseExpired(1)).isEqualTo(2);
+
+    assertThat(holds.getGroup(group.get(0).getGroupId()))
+        .extracting(Hold::getStatus)
+        .containsOnly(HoldStatus.EXPIRED);
+    assertThat(held(doubleRoom, JUNE_1)).isZero();
+    assertThat(held(suite, JUNE_1)).isZero();
+  }
+}
