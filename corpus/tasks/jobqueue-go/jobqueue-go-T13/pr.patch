@@ -0,0 +1,32 @@
+package domain
+
+import (
+	"strings"
+	"time"
+	"unicode/utf8"
+)
+
+// MaxProgressMessageBytes bounds the message of a progress report.
+const MaxProgressMessageBytes = 200
+
+// Progress is the last progress report of a job's attempt.
+type Progress struct {
+	Percent   int    // 0 to 100
+	Message   string // optional, for people watching the job
+	UpdatedAt time.Time
+}
+
+// ValidateProgress checks a progress report before it is stored.
+func ValidateProgress(percent int, message string) error {
+	v := &ValidationError{}
+	if percent < 0 || percent > 100 {
+		v.Add("percent", "must be between 0 and 100")
+	}
+	switch {
+	case len(message) > MaxProgressMessageBytes:
+		v.Add("message", "must be at most %d bytes", MaxProgressMessageBytes)
+	case !utf8.ValidString(message) || strings.ContainsRune(message, 0):
+		v.Add("message", "must be valid UTF-8 without NUL characters")
+	}
+	return v.Err()
+}
