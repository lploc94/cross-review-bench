+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.ResultActions;
+
+/** Prices shown in another currency; the test context sets EUR→USD 1.085 and EUR→JPY 162. */
+class DisplayCurrencyApiTest extends IntegrationTestBase {
+
+  private Property property;
+  private RoomType room;
+
+  @BeforeEach
+  void setUp() {
+    property = data.harbourHouse();
+    room = data.roomType(property, "double", 2, "100.00");
+    data.rooms(property, room, LocalDate.parse("2027-06-01"), LocalDate.parse("2027-06-12"), 2);
+  }
+
+  /** Thursday and Friday night: 100.00 and 110.00 with the weekend surcharge. */
+  private ResultActions quote(String display) throws Exception {
+    var request =
+        post("/api/v1/properties/harbour-house/quotes")
+            .contentType(MediaType.APPLICATION_JSON)
+            .content(
+                "{\"roomType\":\"double\",\"checkIn\":\"2027-06-10\","
+                    + "\"checkOut\":\"2027-06-12\",\"rooms\":1,\"guests\":2}");
+    return mvc.perform(display == null ? request : request.param("display", display));
+  }
+
+  @Test
+  void aQuoteShowsEveryLineAndTheTotalInTheDisplayCurrency() throws Exception {
+    quote("USD")
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.currency").value("EUR"))
+        .andExpect(jsonPath("$.total").value(210.00))
+        .andExpect(jsonPath("$.display.currency").value("USD"))
+        .andExpect(jsonPath("$.display.rate").value(1.085))
+        .andExpect(jsonPath("$.display.indicative").value(true))
+        .andExpect(jsonPath("$.display.total").value(227.85))
+        .andExpect(jsonPath("$.display.lines[0].amount").value(108.50))
+        .andExpect(jsonPath("$.display.lines[1].amount").value(119.35));
+    quote(null).andExpect(status().isOk()).andExpect(jsonPath("$.display").doesNotExist());
+  }
+
+  @Test
+  void displayCurrenciesKeepTheirOwnMinorUnits() throws Exception {
+    quote("jpy")
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.display.currency").value("JPY"))
+        .andExpect(jsonPath("$.display.total").value(34020))
+        .andExpect(jsonPath("$.display.lines[0].amount").value(16200));
+    quote("EUR")
+        .andExpect(jsonPath("$.display.rate").value(1))
+        .andExpect(jsonPath("$.display.total").value(210.00));
+  }
+
+  @Test
+  void aCurrencyWithoutARateIsABadRequest() throws Exception {
+    quote("GBP")
+        .andExpect(status().isBadRequest())
+        .andExpect(jsonPath("$.type").value("urn:innkeep:problem:invalid-request"));
+    quote("dollars").andExpect(status().isBadRequest());
+  }
+
+  @Test
+  void aReservationShowsItsStoredPriceInTheDisplayCurrency() throws Exception {
+    String reference =
+        data.book(property, room, LocalDate.parse("2027-06-10"), LocalDate.parse("2027-06-12"), 1)
+            .getReference();
+
+    mvc.perform(get("/api/v1/reservations/" + reference).param("display", "USD"))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.total").value(210.00))
+        .andExpect(jsonPath("$.display.total").value(227.85))
+        .andExpect(jsonPath("$.display.lines.length()").value(2));
+    mvc.perform(get("/api/v1/reservations/" + reference).param("display", "CHF"))
+        .andExpect(status().isBadRequest());
+  }
+}
