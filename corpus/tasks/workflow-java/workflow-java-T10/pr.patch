diff --git a/src/main/resources/db/migration/V3__rejection_reasons.sql b/src/main/resources/db/migration/V3__rejection_reasons.sql
new file mode 100644
index 0000000..d9dee8b
--- /dev/null
+++ b/src/main/resources/db/migration/V3__rejection_reasons.sql
@@ -0,0 +1,12 @@
+-- The reasons a rejection on a definition's documents must name, in the order they are listed.
+CREATE TABLE definition_rejection_reason (
+    definition_id BIGINT       NOT NULL REFERENCES workflow_definition (id) ON DELETE CASCADE,
+    position      INTEGER      NOT NULL CHECK (position >= 0),
+    code          VARCHAR(40)  NOT NULL,
+    label         VARCHAR(120) NOT NULL,
+    PRIMARY KEY (definition_id, position),
+    -- Checked at commit, so a replaced list may move a code to another position.
+    UNIQUE (definition_id, code) DEFERRABLE INITIALLY DEFERRED
+);
+
+ALTER TABLE approval_task ADD COLUMN rejection_reason VARCHAR(40);
