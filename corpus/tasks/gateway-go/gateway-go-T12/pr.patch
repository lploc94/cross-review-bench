diff --git a/internal/core/tls.go b/internal/core/tls.go
new file mode 100644
index 0000000..cd94ae1
--- /dev/null
+++ b/internal/core/tls.go
@@ -0,0 +1,101 @@
+package core
+
+import (
+	"crypto/sha256"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/hex"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"hash"
+	"os"
+	"strings"
+
+	"github.com/relaywork/gateway/internal/config"
+)
+
+// TLSSettings is a compiled upstream TLS setting. Routes whose settings have the same Key share a
+// transport. Key covers the contents of the files, so a reload picks up a rotated certificate.
+type TLSSettings struct {
+	Key    string
+	Config *tls.Config
+}
+
+// CheckTLS reads and checks the files of a route's TLS settings as loading the routes does, and
+// returns the error the load would report.
+func CheckTLS(u *config.UpstreamTLS) error {
+	_, err := compileTLS(u)
+	return err
+}
+
+// compileTLS reads the files of a route's TLS settings and builds the client configuration. The
+// errors name the field whose file, or which pair of files, failed.
+func compileTLS(u *config.UpstreamTLS) (*TLSSettings, error) {
+	cfg := &tls.Config{ServerName: u.ServerName, MinVersion: tls.VersionTLS12}
+	if u.MinVersion == "1.3" {
+		cfg.MinVersion = tls.VersionTLS13
+	}
+	h := sha256.New()
+	fmt.Fprintf(h, "%s\x00%d\x00", u.ServerName, cfg.MinVersion)
+	if u.CAFile != "" {
+		pemData, err := hashFile(h, "ca_file", u.CAFile)
+		if err != nil {
+			return nil, fmt.Errorf("tls.ca_file: %w", err)
+		}
+		cfg.RootCAs = x509.NewCertPool()
+		if !cfg.RootCAs.AppendCertsFromPEM(pemData) {
+			return nil, errors.New("tls.ca_file: no PEM certificate in the file")
+		}
+	}
+	if u.CertFile != "" {
+		certPEM, err := hashFile(h, "cert_file", u.CertFile)
+		if err != nil {
+			return nil, fmt.Errorf("tls.cert_file: %w", err)
+		}
+		keyPEM, err := hashFile(h, "key_file", u.KeyFile)
+		if err != nil {
+			return nil, fmt.Errorf("tls.key_file: %w", err)
+		}
+		if !hasPEMBlock(certPEM, func(typ string) bool { return typ == "CERTIFICATE" }) {
+			return nil, errors.New("tls.cert_file: no PEM certificate in the file")
+		}
+		if !hasPEMBlock(keyPEM, func(typ string) bool { return strings.HasSuffix(typ, "PRIVATE KEY") }) {
+			return nil, errors.New("tls.key_file: no PEM private key in the file")
+		}
+		cert, err := tls.X509KeyPair(certPEM, keyPEM)
+		if err != nil {
+			return nil, fmt.Errorf("tls.cert_file and tls.key_file do not form a key pair: %w", err)
+		}
+		cfg.Certificates = []tls.Certificate{cert}
+	}
+	return &TLSSettings{Key: hex.EncodeToString(h.Sum(nil)), Config: cfg}, nil
+}
+
+// hashFile reads path into h, after the field it was named by and its length, and returns its
+// contents. The field and length keep the files apart: a CA file that holds a certificate and its
+// key is not the same setting as that certificate and key given as cert_file and key_file.
+func hashFile(h hash.Hash, field, path string) ([]byte, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	fmt.Fprintf(h, "%s\x00%d\x00", field, len(data))
+	h.Write(data)
+	return data, nil
+}
+
+// hasPEMBlock reports whether data holds a PEM block of a type that match accepts. Other blocks
+// may come first, as the EC PARAMETERS block that openssl ecparam writes before the key.
+func hasPEMBlock(data []byte, match func(typ string) bool) bool {
+	for {
+		block, rest := pem.Decode(data)
+		if block == nil {
+			return false
+		}
+		if match(block.Type) {
+			return true
+		}
+		data = rest
+	}
+}
