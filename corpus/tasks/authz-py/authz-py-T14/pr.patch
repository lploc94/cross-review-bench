+    assert confirmed.json()["email"] == "nina.new@example.com"
+    profile = await client.get("/v1/me", headers=me.headers)
+    assert profile.json()["email"] == "nina.new@example.com"
+    assert (await login(client, "nina@example.com")).status_code == 401
+    assert (await login(client, "nina.new@example.com")).status_code == 200
+
+
+async def test_password_is_required_again(client, container, mailer):
