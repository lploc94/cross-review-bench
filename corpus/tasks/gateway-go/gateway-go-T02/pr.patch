+// retryBudget returns the budget of route id under spec: the current one where its settings are
+// unchanged, a new one otherwise. It records the budget in budgets; the current table is not
+// modified, so that a failed Apply leaves it as it was.
+func (rt *Runtime) retryBudget(id string, spec config.RetryBudget, budgets map[string]budgetState) *RetryBudget {
+	if old, ok := rt.budgets[id]; ok && old.spec == spec {
+		budgets[id] = old
+		return old.budget
+	}
+	st := budgetState{
+		spec:   spec,
+		budget: NewRetryBudget(spec.Ratio, spec.MinPerSecond, spec.Window.D()),
+	}
+	budgets[id] = st
+	return st.budget
+}
+
