diff --git a/src/services/statementService.ts b/src/services/statementService.ts
new file mode 100644
index 0000000..5a98154
--- /dev/null
+++ b/src/services/statementService.ts
@@ -0,0 +1,74 @@
+import type { Pool } from "../db/pool.js";
+import { withTransaction } from "../db/tx.js";
+import type { Account } from "../domain/account.js";
+import { NotFoundError, ValidationError } from "../domain/errors.js";
+import { entriesTotal, type Entry } from "../domain/transfer.js";
+import * as accounts from "../repositories/accounts.js";
+import * as entries from "../repositories/entries.js";
+
+/** Statements cover at most this many entries; a busier period has to be split. */
+export const MAX_STATEMENT_ENTRIES = 10_000;
+
+/** A half-open period of time: start <= created_at < end. */
+export interface StatementPeriod {
+  readonly start: Date;
+  readonly end: Date;
+}
+
+export interface Statement {
+  readonly account: Account;
+  readonly period: StatementPeriod;
+  /** The account balance at period.start. */
+  readonly openingBalance: bigint;
+  /** The account balance at period.end. */
+  readonly closingBalance: bigint;
+  /** The period's entries, oldest first. */
+  readonly entries: readonly Entry[];
+}
+
+export class StatementService {
+  private readonly pool: Pool;
+
+  constructor(deps: { pool: Pool }) {
+    this.pool = deps.pool;
+  }
+
+  /**
+   * An account's statement for a period. The account and its entries are read in one REPEATABLE
+   * READ READ ONLY transaction, so a transfer committing in between cannot make the balances
+   * disagree with the entries listed.
+   */
+  async getStatement(
+    tenantId: string,
+    accountId: string,
+    period: StatementPeriod,
+  ): Promise<Statement> {
+    return withTransaction(
+      this.pool,
+      async (client) => {
+        await client.query("SET TRANSACTION READ ONLY");
+        const account = await accounts.findAccount(client, tenantId, accountId);
+        if (!account) throw NotFoundError.resource("account", accountId);
+        const rows = await entries.listEntriesInPeriod(client, tenantId, accountId, {
+          ...period,
+          limit: MAX_STATEMENT_ENTRIES + 1,
+        });
+        if (rows.length > MAX_STATEMENT_ENTRIES) {
+          throw new ValidationError(
+            `the period has more than ${MAX_STATEMENT_ENTRIES} entries; request a shorter one`,
+          );
+        }
+        const movement = entriesTotal(rows);
+        const openingBalance = account.balanceMinor - movement;
+        return {
+          account,
+          period,
+          openingBalance,
+          closingBalance: openingBalance + movement,
+          entries: rows,
+        };
+      },
+      { isolation: "repeatable read" },
+    );
+  }
+}
