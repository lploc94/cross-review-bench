@@ -0,0 +1,23 @@
+package com.innkeep.booking.domain;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.Currency;
+
+/**
+ * An indicative exchange rate from a property's currency to a currency a guest wants to read prices
+ * in. Converted amounts are for display only: charges and refunds stay in the property's currency.
+ */
+public record DisplayRate(Currency from, Currency to, BigDecimal rate) {
+
+  public DisplayRate {
+    if (rate == null || rate.signum() <= 0) {
+      throw new IllegalArgumentException("a display rate must be positive");
+    }
+  }
+
+  /** An amount in the {@code from} currency, converted and rounded to the display currency. */
+  public BigDecimal convert(BigDecimal amount) {
+    return amount.multiply(rate).setScale(to.getDefaultFractionDigits(), RoundingMode.HALF_UP);
+  }
+}
