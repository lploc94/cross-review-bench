+  /**
+   * `GET /v1/export`: the user's documents, checked and yielded line by line as they arrive, so
+   * memory does not grow with the export. `timeoutMs` bounds the wait for the answer and for each
+   * part of its body, not the whole export. The export is complete only when the iteration ends
+   * normally: a body cut off in transfer is a NetworkError; one that ends without the server's
+   * `end` line, has a line that breaks the protocol or another count than it announces is an
+   * InvalidResponseError.
+   */
+  async *exportDocuments(): AsyncGenerator<ExportedDocument, void, undefined> {
+    const controller = new AbortController();
+    const timed = async <T>(what: string, step: () => Promise<T>): Promise<T> => {
+      const timer = setTimeout(() => controller.abort(new Error(`no answer for ${this.timeoutMs} ms`)), this.timeoutMs);
+      try {
+        return await step();
+      } catch (err) {
+        throw new NetworkError(`GET ${EXPORT_PATH} ${what}: ${err instanceof Error ? err.message : String(err)}`, { cause: err });
+      } finally {
+        clearTimeout(timer);
+      }
+    };
+    try {
+      const response = await timed("failed", () =>
+        this.fetchImpl(`${this.baseUrl}${EXPORT_PATH}`, {
+          method: "GET",
+          headers: this.requestHeaders({ accept: EXPORT_CONTENT_TYPE }),
+          signal: controller.signal,
+        }),
+      );
+      if (!response.ok) {
+        const body = await timed("failed", () => response.text());
+        throw errorFromResponse({ status: response.status, header: (name) => response.headers.get(name) ?? undefined, body });
+      }
+      if (!response.body) throw new InvalidResponseError("the export answer has no body");
+      const reader: ReadableStreamDefaultReader<Uint8Array> = response.body.getReader();
+      const decoder = new TextDecoder();
+      let pending = "";
+      let documents = 0;
+      let end: number | null = null;
+      for (;;) {
+        const chunk = await timed(`was cut off after ${documents} documents`, () => reader.read());
+        pending += chunk.done ? decoder.decode() : decoder.decode(chunk.value, { stream: true });
+        let start = 0;
+        for (let newline = pending.indexOf("\n"); newline >= 0; newline = pending.indexOf("\n", start)) {
+          const line = parseExportLine(pending.slice(start, newline));
+          start = newline + 1;
+          if (end !== null) throw new InvalidResponseError("the export continues after its end line");
+          if (line.type === "end") {
+            end = line.documents;
+          } else {
+            documents += 1;
+            yield line;
+          }
+        }
+        pending = pending.slice(start);
+        if (pending.length > MAX_EXPORT_LINE_CHARS) throw new InvalidResponseError("the export has a line that is too long");
+        if (chunk.done) break;
+      }
+      if (end === null || pending !== "") throw new InvalidResponseError(`the export stopped after ${documents} documents without its end line`);
+      if (end !== documents) {
+        throw new InvalidResponseError(`the export announced ${end} documents but sent ${documents}`);
+      }
+    } finally {
+      // Stops the download when the caller leaves the loop early or anything above failed.
+      controller.abort();
+    }
+  }
+}
+
+function parseExportLine(text: string) {
+  let json: unknown;
+  try {
+    json = JSON.parse(text);
+  } catch {
+    json = undefined;
+  }
+  const parsed = exportLineSchema.safeParse(json);
+  if (!parsed.success) {
+    throw new InvalidResponseError("the export has a line that does not follow the protocol", { cause: parsed.error });
+  }
+  return parsed.data;
 }
