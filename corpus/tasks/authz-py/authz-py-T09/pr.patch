+
+class BulkAssignmentResult(ResponseModel):
+    """One item of a bulk assignment; results come in the order of the request's items."""
+
+    status: Literal["created", "failed"]
+    user_id: uuid.UUID
+    assignment_id: uuid.UUID | None = None
+    error: dict[str, Any] | None = None
+
+    @classmethod
+    def of(cls, outcome: AssignmentOutcome) -> BulkAssignmentResult:
+        if outcome.assignment is not None:
+            return cls(
+                status="created",
+                user_id=outcome.request.user_id,
+                assignment_id=outcome.assignment.id,
+            )
+        return cls(
+            status="failed",
+            user_id=outcome.request.user_id,
+            error=outcome.error.to_dict() if outcome.error is not None else None,
+        )
+
