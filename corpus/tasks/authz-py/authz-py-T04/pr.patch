index 0000000..28b6b5f
--- /dev/null
+++ b/src/authz/infra/pending_logins.py
@@ -0,0 +1,38 @@
+"""Logins that passed the password check and wait for a second factor, kept in Redis."""
+
+from __future__ import annotations
+
+import uuid
+from datetime import UTC, datetime, timedelta
+
+from redis.asyncio import Redis
+
+from authz.infra.clock import Clock, epoch_seconds
+from authz.infra.randomness import RandomSource, hash_token
+
+
+class PendingLoginStore:
+    """Each pending login is named by a random token, expires, and can be taken only once."""
+
+    def __init__(self, redis: Redis, clock: Clock, random: RandomSource, ttl: timedelta) -> None:
+        self._redis = redis
+        self._clock = clock
+        self._random = random
+        self.ttl_seconds = int(ttl.total_seconds())
+
+    async def open(self, user_id: uuid.UUID) -> str:
+        token = self._random.token()
+        expires_at = self._clock.now() + timedelta(seconds=self.ttl_seconds)
+        value = f"{user_id}|{epoch_seconds(expires_at)}"
+        await self._redis.set(f"authz:mfa:{hash_token(token)}", value, ex=self.ttl_seconds + 5)
+        return token
+
+    async def take(self, token: str) -> uuid.UUID | None:
+        """The user of a pending login that has not expired, removing it; None otherwise."""
+        value = await self._redis.getdel(f"authz:mfa:{hash_token(token)}")
+        if value is None:
+            return None
+        user_id, _, expires = str(value).partition("|")
+        if self._clock.now() >= datetime.fromtimestamp(int(expires), UTC):
+            return None
+        return uuid.UUID(user_id)
