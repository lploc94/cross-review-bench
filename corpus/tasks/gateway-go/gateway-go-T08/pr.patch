diff --git a/internal/proxy/quota.go b/internal/proxy/quota.go
new file mode 100644
index 0000000..29cca6a
--- /dev/null
+++ b/internal/proxy/quota.go
@@ -0,0 +1,28 @@
+package proxy
+
+import (
+	"net/http"
+	"strconv"
+)
+
+// quotaCheck counts an authenticated request against the consumer's daily quota, when it has one.
+// It returns false when it has answered the request.
+func (h *Handler) quotaCheck(w *statusRecorder, ex *exchange) bool {
+	limit := ex.consumer.DailyQuota
+	if h.quotas == nil || ex.consumer.ID == "" || limit == 0 {
+		return true
+	}
+	d, err := h.quotas.ConsumeQuota(ex.req.Context(), ex.consumer.ID, limit)
+	if err != nil {
+		h.log.Warn("daily quota unavailable; request let through", "consumer_id", ex.consumer.ID, "error", err, "request_id", ex.id)
+		return true
+	}
+	ex.headers.Set("X-Quota-Limit", strconv.FormatInt(d.Limit, 10))
+	ex.headers.Set("X-Quota-Remaining", strconv.FormatInt(d.Remaining, 10))
+	if d.Allowed {
+		return true
+	}
+	ex.headers.Set("Retry-After", strconv.FormatInt(ceilSeconds(d.RetryAfter), 10))
+	h.fail(w, ex, newError(http.StatusTooManyRequests, codeQuotaExceeded, "daily quota exceeded; it resets at the start of the next day"))
+	return false
+}
