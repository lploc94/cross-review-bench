+		"emails=-2":           `queue "emails": must be between 1 and 256, got -2`,
+		"emails=257":          `queue "emails": must be between 1 and 256, got 257`,
+		"emails=two":          `queue "emails": "two" is not an integer`,
+		"emails":              `entry "emails" must look like queue=n`,
+		"=3":                  `entry "=3" must look like queue=n`,
+		"emails=1,emails=2":   `queue "emails" is listed more than once`,
+		"emails=1, emails=1":  `queue "emails" is listed more than once`,
+		"emails=abc,emails=2": `queue "emails" is listed more than once`,
