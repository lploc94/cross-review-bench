new file mode 100644
index 0000000..632f220
--- /dev/null
+++ b/src/etl/store/fx_rates.py
@@ -0,0 +1,63 @@
+"""Daily reference exchange rates in `etl.fx_rates`, against EUR."""
+
+from __future__ import annotations
+
+from collections.abc import Collection, Sequence
+from dataclasses import dataclass
+from datetime import date, datetime
+from decimal import Decimal
+
+from sqlalchemy import Connection, select
+from sqlalchemy.dialects.postgresql import insert as pg_insert
+
+from etl.infra.tables import fx_rates
+
+
+@dataclass(frozen=True, slots=True)
+class FxRate:
+    day: date
+    currency: str
+    # EUR per unit of `currency`.
+    rate_to_eur: Decimal
+
+
+def upsert_many(connection: Connection, rates: Sequence[FxRate], *, loaded_at: datetime) -> None:
+    """Store `rates`, replacing a stored rate of the same day and currency."""
+    if not rates:
+        return
+    statement = pg_insert(fx_rates).values(
+        [
+            {
+                "day": rate.day,
+                "currency": rate.currency,
+                "rate_to_eur": rate.rate_to_eur,
+                "loaded_at": loaded_at,
+            }
+            for rate in rates
+        ]
+    )
+    connection.execute(
+        statement.on_conflict_do_update(
+            index_elements=["day", "currency"],
+            set_={
+                "rate_to_eur": statement.excluded.rate_to_eur,
+                "loaded_at": statement.excluded.loaded_at,
+            },
+        )
+    )
+
+
+def between(
+    connection: Connection, *, first: date, last: date, currencies: Collection[str]
+) -> dict[tuple[date, str], Decimal]:
+    """The rates of `currencies` from `first` to `last` (inclusive), by day and currency."""
+    if not currencies:
+        return {}
+    rows = connection.execute(
+        select(fx_rates.c.day, fx_rates.c.currency, fx_rates.c.rate_to_eur).where(
+            fx_rates.c.day >= first,
+            fx_rates.c.day <= last,
+            fx_rates.c.currency.in_(sorted(currencies)),
+        )
+    )
+    return {(row.day, row.currency): row.rate_to_eur for row in rows}
