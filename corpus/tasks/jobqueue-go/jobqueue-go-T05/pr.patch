+func TestPoolShutdownReturnsOnceDrained(t *testing.T) {
+	started := make(chan struct{})
+	release := make(chan struct{})
+	st := newFakeStore(domain.Job{ID: 1, Type: "block"})
+	h := newHarness(t, st, registry(map[string]worker.HandlerFunc{
+		"block": func(ctx context.Context, _ domain.Job) error {
+			close(started)
+			<-release
+			return ctx.Err() // the deadline has not passed: no cancellation
+		},
+	}))
+	h.start(t, context.Background())
+	<-started
+
+	ctx, cancel := context.WithTimeout(context.Background(), time.Hour)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { done <- h.pool.Shutdown(ctx) }()
+	close(release)
+	if err := <-done; err != nil {
+		t.Fatalf("Shutdown = %v, want nil once the handler returned", err)
+	}
+	if got := st.snapshot().completed; len(got) != 1 {
+		t.Errorf("completed = %v", got)
+	}
+}
+
+func TestPoolShutdownCancelsHandlersAfterDeadline(t *testing.T) {
+	started := make(chan struct{})
+	st := newFakeStore(domain.Job{ID: 1, Type: "wait"}, domain.Job{ID: 2, Type: "wait"})
+	h := newHarness(t, st, registry(map[string]worker.HandlerFunc{
+		"wait": func(ctx context.Context, _ domain.Job) error {
+			started <- struct{}{}
+			<-ctx.Done()
+			return ctx.Err()
+		},
+	}), func(o *worker.Options) { o.Concurrency = 2 })
+	h.start(t, context.Background())
+	<-started
+	<-started
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel() // the drain deadline has passed
+	if err := h.pool.Shutdown(ctx); !errors.Is(err, context.Canceled) {
+		t.Fatalf("Shutdown = %v, want the context's error", err)
+	}
+	for range 2 {
+		out := h.next(t)
+		if !errors.Is(out.Err, context.Canceled) || out.State != domain.StateAvailable {
+			t.Errorf("outcome = %+v, want a cancelled attempt to be retried", out)
+		}
+	}
+	for _, f := range st.snapshot().failed {
+		if !f.retryAt.Equal(t0.Add(retryDelay)) || f.ctxErr != nil {
+			t.Errorf("Fail call = %+v, want a retry recorded with a live context", f)
+		}
+	}
+}
