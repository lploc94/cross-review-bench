+package com.innkeep.booking.domain;
+
+import java.time.LocalDate;
+
+/** A stay breaks an arrival rule of its room type: a minimum stay or a closed arrival night. */
+public class StayRestrictedException extends BookingException {
+
+  private final String rule;
+  private final LocalDate night;
+
+  public StayRestrictedException(String rule, LocalDate night, String message) {
+    super(message);
+    this.rule = rule;
+    this.night = night;
+  }
+
+  /** {@code min-stay} or {@code closed-to-arrival}. */
+  public String rule() {
+    return rule;
+  }
+
+  /** The arrival night whose rule the stay breaks. */
+  public LocalDate night() {
+    return night;
+  }
+}
