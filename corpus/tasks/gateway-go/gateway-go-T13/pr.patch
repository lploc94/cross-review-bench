+// limitedReader passes a body through and fails the read that would take it past limit. Its
+// exceeded flag tells the forwarding loop that the body was cut short on purpose.
+type limitedReader struct {
+	r        io.Reader
+	limit    int64
+	read     int64         // touched by the goroutine that sends the body only
+	exceeded atomic.Bool   // read by the forwarding loop, which may run concurrently
+	stopped  atomic.Bool   // set by the forwarding loop once the upstream answered before the body ended
+	finished chan struct{} // closed once the body is over: ended, failed or cut short
