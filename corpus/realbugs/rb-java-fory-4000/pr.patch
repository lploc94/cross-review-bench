+  }
+
+  private static final class IncompleteStreamReader extends AbstractStreamReader {
+    private final MemoryBuffer buffer;
+
+    private IncompleteStreamReader() {
+      buffer = MemoryBuffer.fromByteArray(new byte[0], 0, 0, this);
+    }
