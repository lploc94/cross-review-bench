+/** The sum of an account's entries with created_at >= since. */
+export async function sumEntriesSince(
+  db: Queryable,
+  tenantId: string,
+  accountId: string,
+  since: Date,
+): Promise<bigint> {
+  const result = await db.query<{ total: string }>(
+    `SELECT coalesce(sum(amount_minor), 0) AS total FROM entries
+     WHERE tenant_id = $1 AND account_id = $2 AND created_at >= $3`,
+    [tenantId, accountId, since],
+  );
+  return toBigInt(result.rows[0]?.total ?? "0");
+}
