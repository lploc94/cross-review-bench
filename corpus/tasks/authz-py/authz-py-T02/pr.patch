diff --git a/src/authz/repositories/api_keys.py b/src/authz/repositories/api_keys.py
new file mode 100644
index 0000000..cfd0529
--- /dev/null
+++ b/src/authz/repositories/api_keys.py
@@ -0,0 +1,46 @@
+"""Queries on organisation API keys."""
+
+from __future__ import annotations
+
+import uuid
+from datetime import datetime
+
+from sqlalchemy import select, update
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from authz.models import ApiKey
+
+
+class ApiKeyRepository:
+    def __init__(self, session: AsyncSession) -> None:
+        self._session = session
+
+    async def add(self, key: ApiKey) -> ApiKey:
+        self._session.add(key)
+        await self._session.flush()
+        return key
+
+    async def get_for_update(self, org_id: uuid.UUID, key_id: uuid.UUID) -> ApiKey | None:
+        result = await self._session.execute(
+            select(ApiKey).where(ApiKey.org_id == org_id, ApiKey.id == key_id).with_for_update()
+        )
+        return result.scalar_one_or_none()
+
+    async def list_for_org(self, org_id: uuid.UUID) -> list[ApiKey]:
+        result = await self._session.execute(
+            select(ApiKey)
+            .where(ApiKey.org_id == org_id)
+            .order_by(ApiKey.created_at.desc(), ApiKey.id)
+        )
+        return list(result.scalars())
+
+    async def active_with_prefix(self, prefix: str) -> list[ApiKey]:
+        result = await self._session.execute(
+            select(ApiKey).where(ApiKey.prefix == prefix, ApiKey.revoked_at.is_(None))
+        )
+        return list(result.scalars())
+
+    async def touch(self, key_id: uuid.UUID, now: datetime) -> None:
+        await self._session.execute(
+            update(ApiKey).where(ApiKey.id == key_id).values(last_used_at=now)
+        )
diff --git a/src/authz/services/api_keys.py b/src/authz/services/api_keys.py
new file mode 100644
index 0000000..c0499c5
--- /dev/null
+++ b/src/authz/services/api_keys.py
@@ -0,0 +1,151 @@
+"""Organisation API keys: created by members, used by scripts and other services."""
+
+from __future__ import annotations
+
+import uuid
+from datetime import timedelta
+
+from authz.domain.permissions import API_KEY_PERMISSIONS
+from authz.domain.policy import effective_permissions
+from authz.domain.principal import Actor, Principal, PrincipalKind
+from authz.errors import AuthenticationFailed, InvalidInputError, InvalidToken, NotFoundError
+from authz.infra.clock import Clock
+from authz.infra.db import Database
+from authz.infra.hashing import PasswordHasher
+from authz.infra.randomness import RandomSource
+from authz.models import ApiKey
+from authz.repositories.api_keys import ApiKeyRepository
+from authz.repositories.roles import RoleRepository
+from authz.repositories.users import UserRepository
+from authz.services.audit import AuditAction, AuditLog
+from authz.services.auth import ClientInfo
+from authz.services.authorization import AuthorizationService, ensure_can_grant
+
+KEY_MARKER = "azk_"
+PREFIX_LENGTH = 12
+MAX_KEY_LENGTH = 200
+LAST_USED_PRECISION = timedelta(minutes=1)
+
+
+def is_api_key(token: str) -> bool:
+    return token.startswith(KEY_MARKER)
+
+
+def split_key(token: str) -> tuple[str, str]:
+    """The prefix and secret of `azk_<prefix>_<secret>`, or InvalidToken."""
+    prefix, _, secret = token.removeprefix(KEY_MARKER).partition("_")
+    if len(token) > MAX_KEY_LENGTH or len(prefix) != PREFIX_LENGTH or not secret:
+        raise InvalidToken()
+    return prefix, secret
+
+
+class ApiKeyService:
+    def __init__(
+        self,
+        *,
+        db: Database,
+        clock: Clock,
+        random: RandomSource,
+        hasher: PasswordHasher,
+        authz: AuthorizationService,
+        audit: AuditLog,
+    ) -> None:
+        self._db = db
+        self._clock = clock
+        self._random = random
+        self._hasher = hasher
+        self._authz = authz
+        self._audit = audit
+
+    async def create(
+        self, principal: Principal, org_id: uuid.UUID, *, name: str, role_id: uuid.UUID
+    ) -> tuple[ApiKey, str]:
+        """Create a key with a role. The full key is returned here and never again."""
+        prefix = self._random.uuid().hex[:PREFIX_LENGTH]
+        secret = self._random.token()
+        secret_hash = await self._hasher.hash(secret)
+        async with self._db.transaction() as session:
+            role = await RoleRepository(session).get(org_id, role_id)
+            if role is None:
+                raise NotFoundError("role")
+            snapshot = await self._authz.snapshot(session, org_id, principal.user_id)
+            ensure_can_grant(snapshot, org_id, role.id, action="give a key")
+            refused = snapshot.role_permissions(role.id) - API_KEY_PERMISSIONS
+            if refused:
+                raise InvalidInputError(
+                    "API keys cannot hold permissions that administer the organisation",
+                    details={"field": "role_id", "permissions": sorted(refused)},
+                )
+            key = await ApiKeyRepository(session).add(
+                ApiKey(
+                    id=uuid.uuid4(),
+                    org_id=org_id,
+                    role_id=role.id,
+                    name=name.strip(),
+                    prefix=prefix,
+                    secret_hash=secret_hash,
+                    created_by=principal.user_id,
+                    created_at=self._clock.now(),
+                )
+            )
+            await self._audit.record(
+                session,
+                Actor.of(principal),
+                org_id=org_id,
+                action=AuditAction.API_KEY_CREATED,
+                target_type="api_key",
+                target_id=key.id,
+                data={"name": key.name, "prefix": prefix, "role_id": role.id},
+            )
+        return key, f"{KEY_MARKER}{prefix}_{secret}"
+
+    async def list_keys(self, org_id: uuid.UUID) -> list[ApiKey]:
+        async with self._db.read() as session:
+            return await ApiKeyRepository(session).list_for_org(org_id)
+
+    async def revoke(self, principal: Principal, org_id: uuid.UUID, key_id: uuid.UUID) -> None:
+        async with self._db.transaction() as session:
+            key = await ApiKeyRepository(session).get_for_update(org_id, key_id)
+            if key is None or key.revoked_at is not None:
+                raise NotFoundError("api key")
+            key.revoked_at = self._clock.now()
+            await self._audit.record(
+                session,
+                Actor.of(principal),
+                org_id=org_id,
+                action=AuditAction.API_KEY_REVOKED,
+                target_type="api_key",
+                target_id=key.id,
+                data={"name": key.name, "prefix": key.prefix},
+            )
+
+    async def authenticate(self, token: str, client: ClientInfo) -> Principal:
+        """The service principal behind an API key that has not been revoked."""
+        prefix, secret = split_key(token)
+        async with self._db.read() as session:
+            candidates = await ApiKeyRepository(session).active_with_prefix(prefix)
+        key = None
+        for candidate in candidates:
+            if await self._hasher.verify(candidate.secret_hash, secret):
+                key = candidate
+                break
+        if key is None:
+            raise InvalidToken()
+
+        now = self._clock.now()
+        async with self._db.transaction() as session:
+            creator = await UserRepository(session).get(key.created_by)
+            if creator is None or creator.disabled_at is not None:
+                raise AuthenticationFailed()
+            graph = await RoleRepository(session).graph(key.org_id)
+            if key.last_used_at is None or now - key.last_used_at >= LAST_USED_PRECISION:
+                await ApiKeyRepository(session).touch(key.id, now)
+        return Principal(
+            kind=PrincipalKind.SERVICE,
+            user_id=key.created_by,
+            session_id=None,
+            ip=client.ip,
+            user_agent=client.user_agent,
+            api_key_id=key.id,
+            scopes=effective_permissions(graph, [key.role_id]) & API_KEY_PERMISSIONS,
+        )
