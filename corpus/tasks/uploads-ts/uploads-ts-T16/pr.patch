+/** A LIKE pattern for every path that starts with `prefix`, with `\`, `%` and `_` escaped by `\`. */
+export function likePrefixPattern(prefix: string): string {
+  return `${prefix.replace(/[\\%_]/g, (char) => `\\${char}`)}%`;
+}
+
+/**
+ * Soft-delete up to `limit` live files whose path starts with `prefix`, in path order. Returns
+ * the rows this statement deleted.
+ */
+export async function markDeletedUnderPrefix(
+  db: Queryable,
+  tenantId: string,
+  prefix: string,
+  now: Date,
+  limit: number,
+): Promise<FileRecord[]> {
+  const result = await db.query<FileRow>(
+    `WITH batch AS (
+       SELECT id FROM files
+       WHERE tenant_id = $1 AND path LIKE $2 ESCAPE '\\' AND status <> 'deleted'
+       ORDER BY path
+       LIMIT $4
+     )
+     UPDATE files SET status = 'deleted', deleted_at = $3, updated_at = $3, next_scan_at = NULL
+     FROM batch
+     WHERE files.id = batch.id AND files.status <> 'deleted'
+     RETURNING ${QUALIFIED_COLUMNS}`,
+    [tenantId, likePrefixPattern(prefix), now, limit],
+  );
+  return result.rows.map(mapFile);
+}
+
+/** Whether the tenant has a live file whose path starts with `prefix`. */
+export async function hasLiveFileUnderPrefix(
+  db: Queryable,
+  tenantId: string,
+  prefix: string,
+): Promise<boolean> {
+  const result = await db.query<{ found: boolean }>(
+    `SELECT EXISTS (
+       SELECT 1 FROM files
+       WHERE tenant_id = $1 AND path LIKE $2 ESCAPE '\\' AND status <> 'deleted'
+     ) AS found`,
+    [tenantId, likePrefixPattern(prefix)],
+  );
+  return firstRow(result.rows)?.found === true;
+}
