+
+  @Test
+  void displayRatesAreOptionalAndKeptPerPropertyCurrency() {
+    assertThat(config(Duration.ofMinutes(15), null).displayRates()).isEmpty();
+    var rates = Map.of("EUR", Map.of("USD", new BigDecimal("1.085")));
+    assertThat(config(Duration.ofMinutes(15), rates).displayRates()).isEqualTo(rates);
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"usd", "XYZ", "XAU"})
+  void displayRatesNeedIsoCurrencyCodesWithMinorUnits(String code) {
+    assertThatThrownBy(
+            () -> config(Duration.ofMinutes(15), Map.of("EUR", Map.of(code, BigDecimal.TEN))))
+        .isInstanceOf(IllegalArgumentException.class)
+        .hasMessageContaining("booking.display-rates");
+  }
+
+  @Test
+  void displayRatesMustBePositive() {
+    var rates = Map.of("EUR", Map.of("USD", BigDecimal.ZERO));
+    assertThatThrownBy(() -> config(Duration.ofMinutes(15), rates))
+        .isInstanceOf(IllegalArgumentException.class)
+        .hasMessageContaining("booking.display-rates.EUR.USD");
+  }
 }
