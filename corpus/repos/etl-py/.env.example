# Copy to .env and adjust; the service reads plain environment variables.
DATABASE_URL=postgres://etl:etl@localhost:5432/warehouse
DATABASE_POOL_SIZE=5
LOG_LEVEL=info
REPORT_DIR=reports
# IANA zone; report days are calendar days in this zone.
REPORTING_ZONE=Europe/Berlin
# A run fails when more than this fraction of the rows read is rejected.
MAX_REJECT_RATIO=0.05
BATCH_SIZE=1000
MAX_FUTURE_SKEW_SECONDS=300
