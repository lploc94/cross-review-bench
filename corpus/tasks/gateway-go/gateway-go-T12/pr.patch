+// check-routes reads the TLS files of the routes, as a reload does, so that a file the reload
+// would refuse is reported before SIGHUP.
+func TestCheckRoutesReadsTheTLSFiles(t *testing.T) {
+	dir := t.TempDir()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tmpl := &x509.Certificate{
+		SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "Internal CA"},
+		NotBefore: time.Date(2020, 1, 1, 0, 0, 0, 0, time.UTC), NotAfter: time.Date(2099, 1, 1, 0, 0, 0, 0, time.UTC),
+		IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ca := filepath.Join(dir, "ca.pem")
+	os.WriteFile(ca, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}), 0o600)
+	notPEM := filepath.Join(dir, "not-pem.txt")
+	os.WriteFile(notPEM, []byte("not a certificate"), 0o600)
+
+	check := func(caFile string) (int, string, string) {
+		t.Helper()
+		routes := filepath.Join(dir, "routes.json")
+		os.WriteFile(routes, fmt.Appendf(nil, `{"routes":[{"id":"a","path":"/a","tls":{"ca_file":%q},"upstreams":[{"url":"https://a.internal"}]}]}`, caFile), 0o600)
+		var out, errOut strings.Builder
+		code := checkRoutes(routes, &out, &errOut)
+		return code, out.String(), errOut.String()
+	}
+	if code, out, errOut := check(ca); code != 0 || !strings.Contains(out, "1 routes OK") {
+		t.Errorf("readable CA file: code %d, stdout %q, stderr %q", code, out, errOut)
+	}
+	for _, caFile := range []string{filepath.Join(dir, "missing.pem"), notPEM} {
+		if code, out, errOut := check(caFile); code != 1 || out != "" || !strings.Contains(errOut, `route "a": tls.ca_file: `) {
+			t.Errorf("CA file %s: code %d, stdout %q, stderr %q", filepath.Base(caFile), code, out, errOut)
+		}
+	}
+}
