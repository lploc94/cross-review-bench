diff --git a/tests/api/test_account_lockout.py b/tests/api/test_account_lockout.py
new file mode 100644
index 0000000..9de6e96
--- /dev/null
+++ b/tests/api/test_account_lockout.py
@@ -0,0 +1,89 @@
+from __future__ import annotations
+
+from datetime import timedelta
+
+from authz.models import User
+from authz.repositories.users import UserRepository
+from tests.helpers.clock import FrozenClock
+from tests.helpers.factories import login, make_user
+
+WRONG = "not the password at all"
+
+
+async def _stored(container, user: User) -> User:
+    async with container.db.read() as session:
+        row = await UserRepository(session).get(user.id)
+    assert row is not None
+    return row
+
+
+async def _fail(client, user: User, times: int, *, ip: str = "198.51.100.20") -> None:
+    for _ in range(times):
+        response = await login(client, user.email, WRONG, ip=ip)
+        assert response.status_code == 401
+
+
+async def test_threshold_of_wrong_passwords_locks_the_account(client, container, clock):
+    user = await make_user(container)
+    threshold = container.settings.lockout_threshold
+
+    await _fail(client, user, threshold - 1)
+    assert (await _stored(container, user)).locked_until is None
+    await _fail(client, user, 1)
+
+    stored = await _stored(container, user)
+    assert stored.failed_logins == threshold
+    assert stored.locked_until == clock.now() + timedelta(
+        seconds=container.settings.lockout_seconds
+    )
+
+
+async def test_successful_login_resets_the_count(client, container):
+    user = await make_user(container)
+    threshold = container.settings.lockout_threshold
+
+    await _fail(client, user, threshold - 1, ip="198.51.100.21")
+    assert (await login(client, user.email, ip="198.51.100.21")).status_code == 200
+    await _fail(client, user, threshold - 1, ip="198.51.100.22")
+
+    stored = await _stored(container, user)
+    assert stored.failed_logins == threshold - 1
+    assert stored.locked_until is None
+
+
+async def test_failures_during_a_lock_do_not_extend_it(client, container, clock: FrozenClock):
+    user = await make_user(container)
+    threshold = container.settings.lockout_threshold
+    await _fail(client, user, threshold)
+    locked_until = (await _stored(container, user)).locked_until
+
+    clock.advance(seconds=60)
+    await _fail(client, user, 1)
+
+    stored = await _stored(container, user)
+    assert stored.failed_logins == threshold + 1
+    assert stored.locked_until == locked_until
+
+
+async def test_count_starts_over_after_the_lock_expires(client, container, clock: FrozenClock):
+    user = await make_user(container)
+    await _fail(client, user, container.settings.lockout_threshold)
+
+    clock.advance(seconds=container.settings.lockout_seconds)
+    await _fail(client, user, 1, ip="198.51.100.23")
+
+    stored = await _stored(container, user)
+    assert stored.failed_logins == 1
+    assert stored.locked_until is None
+
+
+async def test_locked_account_answers_like_an_unknown_address(client, container):
+    user = await make_user(container)
+    await _fail(client, user, container.settings.lockout_threshold)
+
+    locked = await login(client, user.email, WRONG, ip="198.51.100.24")
+    unknown = await login(client, "nobody@example.com", WRONG, ip="198.51.100.24")
+
+    assert locked.status_code == unknown.status_code == 401
+    assert locked.json() == unknown.json()
+    assert "retry-after" not in locked.headers
