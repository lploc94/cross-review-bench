@@ -0,0 +1,30 @@
+package config
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestCanaryValidation(t *testing.T) {
+	ok := `{"routes":[{"id":"shop","path_prefix":"/shop","upstreams":[{"url":"http://stable.internal"}],
+	  "canary":{"upstreams":[{"url":"http://canary.internal"}],"percent":10}}]}`
+	rs, err := ParseRoutes([]byte(ok))
+	if err != nil {
+		t.Fatalf("valid canary rejected: %v", err)
+	}
+	if c := rs.Routes[0].Canary; c.Header != DefaultCanaryHeader || c.Upstreams[0].Weight != 1 {
+		t.Errorf("defaults not filled in: %+v", c)
+	}
+
+	bad := `{"routes":[{"id":"shop","path_prefix":"/shop","upstreams":[{"url":"http://stable.internal"}],
+	  "canary":{"upstreams":[{"url":"http://stable.internal"}],"percent":101,"header":"Host"}}]}`
+	_, err = ParseRoutes([]byte(bad))
+	if err == nil {
+		t.Fatal("invalid canary accepted")
+	}
+	for _, want := range []string{"canary.percent", "canary.upstreams[0].url", "canary.header"} {
+		if !strings.Contains(err.Error(), want) {
+			t.Errorf("error %q does not name %s", err, want)
+		}
+	}
+}
