+/** Like `findTransfer`, and locks the row for the rest of the transaction (`SELECT … FOR UPDATE`). */
+export async function lockTransfer(
+  db: Queryable,
+  tenantId: string,
+  id: string,
+): Promise<Transfer | null> {
+  const result = await db.query<TransferRow>(
+    `SELECT ${COLUMNS} FROM transfers WHERE tenant_id = $1 AND id = $2 FOR UPDATE`,
+    [tenantId, id],
+  );
+  const row = firstRow(result.rows);
+  return row ? mapTransfer(row) : null;
+}
