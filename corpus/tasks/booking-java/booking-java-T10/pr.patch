@@ -0,0 +1,64 @@
+package com.innkeep.booking.unit;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import com.innkeep.booking.domain.DateRange;
+import com.innkeep.booking.domain.PriceKind;
+import com.innkeep.booking.domain.PriceLine;
+import com.innkeep.booking.domain.PricingEngine;
+import com.innkeep.booking.domain.Property;
+import com.innkeep.booking.domain.Quote;
+import com.innkeep.booking.domain.RatePlan;
+import com.innkeep.booking.domain.RoomType;
+import com.innkeep.booking.domain.ValidationException;
+import com.innkeep.booking.support.Fixtures;
+import java.time.LocalDate;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+/** The non-refundable rate plan in the pricing rules. 4–6 January 2027 are weekday nights. */
+class RatePlanPricingTest {
+
+  private static final DateRange WEEKDAYS =
+      new DateRange(LocalDate.parse("2027-01-04"), LocalDate.parse("2027-01-06"));
+
+  private final Property property = Fixtures.property("Europe/Lisbon", 10, 0);
+  private final RoomType room = Fixtures.roomType(property, 2, "100.00");
+
+  private Quote quote(DateRange stay, RatePlan plan) {
+    return PricingEngine.quote(property, room, List.of(), stay, 1, 2, plan);
+  }
+
+  @Test
+  void aNonRefundableStayEndsWithOneDiscountLine() {
+    room.offerNonRefundable(10);
+
+    Quote quote = quote(WEEKDAYS, RatePlan.NON_REFUNDABLE);
+
+    assertThat(quote.ratePlan()).isEqualTo(RatePlan.NON_REFUNDABLE);
+    assertThat(quote.lines()).hasSize(3);
+    PriceLine last = quote.lines().get(2);
+    assertThat(last.getKind()).isEqualTo(PriceKind.RATE_PLAN_DISCOUNT);
+    assertThat(last.getNight()).isNull();
+    assertThat(last.getAmount()).isEqualByComparingTo("-20.00");
+    assertThat(quote.total().amount()).isEqualByComparingTo("180.00");
+  }
+
+  @Test
+  void aFlexibleStayHasNoDiscountLine() {
+    room.offerNonRefundable(10);
+
+    Quote quote = quote(WEEKDAYS, RatePlan.FLEXIBLE);
+
+    assertThat(quote.lines()).noneMatch(line -> line.getKind() == PriceKind.RATE_PLAN_DISCOUNT);
+    assertThat(quote.total().amount()).isEqualByComparingTo("200.00");
+  }
+
+  @Test
+  void aRoomTypeWithoutTheDiscountIsNotSoldNonRefundable() {
+    assertThatThrownBy(() -> quote(WEEKDAYS, RatePlan.NON_REFUNDABLE))
+        .isInstanceOf(ValidationException.class)
+        .hasMessageContaining("no non-refundable rate");
+  }
+}
