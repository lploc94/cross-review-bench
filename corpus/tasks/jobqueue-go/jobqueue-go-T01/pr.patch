+
+func TestEnqueueBatch(t *testing.T) {
+	e := newEnv(t)
+	runAt := t0.Add(time.Hour).Format(time.RFC3339)
+	rec := call(t, e.handler, http.MethodPost, "/v1/queues/reports/jobs/batch", `{"jobs":[
+		{"type":"report.build","payload":{"account":1}},
+		{"type":"report.build","payload":{"account":2},"priority":4,"max_attempts":2},
+		{"type":"report.mail","run_at":"`+runAt+`"}
+	]}`)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("status = %d: %s", rec.Code, rec.Body)
+	}
+	got := decode[struct {
+		Jobs []jobBody `json:"jobs"`
+	}](t, rec)
+	if len(got.Jobs) != 3 {
+		t.Fatalf("got %d jobs: %s", len(got.Jobs), rec.Body)
+	}
+	for i, j := range got.Jobs {
+		if j.Queue != "reports" || j.State != "available" {
+			t.Errorf("job %d = %+v", i, j)
+		}
+		if i > 0 && j.ID <= got.Jobs[i-1].ID {
+			t.Errorf("ids out of order: %d after %d", j.ID, got.Jobs[i-1].ID)
+		}
+	}
+	if got.Jobs[0].Payload["account"] != float64(1) || got.Jobs[1].Priority != 4 || got.Jobs[1].MaxAttempts != 2 ||
+		got.Jobs[2].Type != "report.mail" || got.Jobs[2].RunAt.Format(time.RFC3339) != runAt {
+		t.Errorf("jobs = %+v", got.Jobs)
+	}
+}
+
+func TestEnqueueBatchValidation(t *testing.T) {
+	e := newEnv(t)
+	cases := []struct {
+		name, path, body string
+		fields           []string
+	}{
+		{"invalid job", "/v1/queues/checked/jobs/batch", `{"jobs":[{"type":"x","payload":[1],"priority":9999}]}`, []string{"jobs[0].payload", "jobs[0].priority"}},
+		{"empty batch", "/v1/queues/checked/jobs/batch", `{"jobs":[]}`, []string{"jobs"}},
+		{"bad queue", "/v1/queues/Bad%20Queue/jobs/batch", `{"jobs":[{"type":"x"}]}`, []string{"queue"}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			resp := expectError(t, call(t, e.handler, http.MethodPost, tc.path, tc.body), http.StatusUnprocessableEntity, "validation_failed")
+			if got := strings.Join(fieldNames(resp), ","); got != strings.Join(tc.fields, ",") {
+				t.Errorf("fields = %s, want %v", got, tc.fields)
+			}
+		})
+	}
+	page, err := e.store.List(context.Background(), store.ListFilter{Queue: "checked"})
+	if err != nil || len(page.Jobs) != 0 {
+		t.Errorf("queue holds %d jobs (%v), want none", len(page.Jobs), err)
+	}
+}
