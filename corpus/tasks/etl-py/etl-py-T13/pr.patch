     return views
+
+
+def source_freshness(context: AppContext) -> list[FreshnessView]:
+    """Per source: when its last successful run finished, and whether that was more than the
+    source's max age ago (stale). A source without any successful run is stale."""
+    now = context.clock.now()
+    views = []
+    with context.engine.connect() as connection:
+        for name in sorted(context.sources):
+            spec = context.sources[name]
+            succeeded = runs.last_succeeded(connection, name)
+            finished = succeeded.finished_at if succeeded is not None else None
+            # A finish time ahead of this clock (another host's clock) counts as just now.
+            age = max(now - finished, timedelta(0)) if finished is not None else None
+            views.append(
+                FreshnessView(
+                    source=name,
+                    max_age=spec.max_age,
+                    last_succeeded_run_id=succeeded.id if succeeded is not None else None,
+                    last_succeeded_at=finished,
+                    age=age,
+                    stale=age is None or age > spec.max_age,
+                )
+            )
+    return views
