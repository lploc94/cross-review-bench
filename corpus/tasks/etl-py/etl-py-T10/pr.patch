+def _add_placeholder_customers(
+    connection: Connection, headers: Subquery, context: LoadContext
+) -> int:
+    """Create a current placeholder version for each customer of `headers` that has no current
+    version, and return how many were created."""
+    since = literal(context.loaded_at, TZ)
+    known = exists().where(customers.c.customer_id == headers.c.customer_id, customers.c.is_current)
+    unknown = (
+        select(
+            headers.c.customer_id,
+            since.label("valid_from"),
+            true().label("is_current"),
+            since.label("updated_at"),
+            literal(context.loaded_at, TZ).label("loaded_at"),
+            literal(context.run_id, BigInteger).label("run_id"),
+            true().label("is_placeholder"),
+        )
+        .where(not_(known))
+        .distinct()
+    )
+    names = [column.name for column in unknown.selected_columns]
+    return count_written(
+        connection,
+        pg_insert(customers).from_select(names, unknown).returning(customers.c.customer_key),
+    )
+
