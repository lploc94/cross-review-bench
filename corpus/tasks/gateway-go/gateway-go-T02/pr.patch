+++ b/internal/core/budget_test.go
@@ -0,0 +1,39 @@
+package core
+
+import (
+	"testing"
+	"time"
+)
+
+var budgetStart = time.Date(2025, time.June, 2, 12, 0, 0, 0, time.UTC)
+
+func TestRetryBudgetAllowsTheRatioPlusTheMinimum(t *testing.T) {
+	b := NewRetryBudget(0.5, 2, 4*time.Second)
+	for range 10 {
+		b.Request(budgetStart)
+	}
+	// 0.5 × 10 requests + 2 × 4 seconds allow 13 retries.
+	allowed := 0
+	for b.AllowRetry(budgetStart) {
+		allowed++
+	}
+	if allowed != 13 {
+		t.Errorf("allowed %d retries, want 13", allowed)
+	}
+}
+
+func TestRetryBudgetCountsTheRequestsOfTheWindow(t *testing.T) {
+	b := NewRetryBudget(1, 0, 4*time.Second)
+	b.Request(budgetStart)
+	b.Request(budgetStart)
+	// Three seconds later the requests are still in the four-second window: two retries fit.
+	later := budgetStart.Add(3 * time.Second)
+	for i := range 2 {
+		if !b.AllowRetry(later) {
+			t.Fatalf("retry %d refused inside the window", i+1)
+		}
+	}
+	if b.AllowRetry(later) {
+		t.Error("a third retry was allowed for two requests")
+	}
+}
