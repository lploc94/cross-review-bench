diff --git a/internal/core/budget.go b/internal/core/budget.go
new file mode 100644
index 0000000..abfef95
--- /dev/null
+++ b/internal/core/budget.go
@@ -0,0 +1,78 @@
+package core
+
+import (
+	"sync"
+	"time"
+
+	"github.com/relaywork/gateway/internal/config"
+)
+
+// RetryBudget caps the retries of one route. Requests and retries are counted in buckets of one
+// second, over the window; a retry is allowed while the retries of the window stay below
+// ratio × requests + minPerSecond × window seconds. Refused retries cost nothing: they are not
+// counted, so a route that keeps failing is held to the same share.
+type RetryBudget struct {
+	mu        sync.Mutex
+	ratio     float64
+	minPerSec float64
+	buckets   []budgetBucket // one per second of the window, indexed by second modulo its length
+}
+
+// budgetBucket holds the counts of one Unix second.
+type budgetBucket struct {
+	second   int64
+	requests int
+	retries  int
+}
+
+// NewRetryBudget returns a budget with the policy's ratio, minimum rate and window. The settings
+// are validated by the config package.
+func NewRetryBudget(ratio float64, minPerSecond int, window time.Duration) *RetryBudget {
+	seconds := max(int(window/time.Second), 1)
+	return &RetryBudget{
+		ratio:     ratio,
+		minPerSec: float64(minPerSecond),
+		buckets:   make([]budgetBucket, seconds),
+	}
+}
+
+// bucket returns the bucket of the second of now, emptied first when it still holds an earlier
+// second. The caller holds mu.
+func (b *RetryBudget) bucket(now time.Time) *budgetBucket {
+	sec := now.Unix()
+	bk := &b.buckets[sec%int64(len(b.buckets))]
+	if bk.second != sec {
+		*bk = budgetBucket{second: sec}
+	}
+	return bk
+}
+
+// Request counts a first attempt at time now.
+func (b *RetryBudget) Request(now time.Time) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	b.bucket(now).requests++
+}
+
+// AllowRetry reports whether a retry at time now is within the budget, and counts it when it is.
+func (b *RetryBudget) AllowRetry(now time.Time) bool {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	requests, retries := 0, 0
+	for _, bk := range b.buckets {
+		requests += bk.requests
+		retries += bk.retries
+	}
+	allowance := b.ratio*float64(requests) + b.minPerSec*float64(len(b.buckets))
+	if float64(retries) >= allowance {
+		return false
+	}
+	b.bucket(now).retries++
+	return true
+}
+
+// budgetState is a route's budget and the settings it was built from.
+type budgetState struct {
+	spec   config.RetryBudget
+	budget *RetryBudget
+}
