new file mode 100644
index 0000000..be228c3
--- /dev/null
+++ b/src/main/resources/db/migration/V3__document_title_search.sql
@@ -0,0 +1,5 @@
+-- Title search: the words of each title, kept by Postgres whenever the title changes. The 'simple'
+-- configuration lower-cases words and does not stem them, so names and codes match as written.
+ALTER TABLE document
+    ADD COLUMN title_search tsvector GENERATED ALWAYS AS (to_tsvector('simple', title)) STORED;
+CREATE INDEX document_title_search ON document USING gin (title_search);
