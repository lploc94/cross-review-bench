+    async def assign_many(
+        self, principal: Principal, org_id: uuid.UUID, requests: Sequence[AssignmentRequest]
+    ) -> list[AssignmentOutcome]:
+        """Apply several assignments in one transaction, each one on its own.
+
+        An item that fails (unknown member, role or project, a role the caller cannot grant, an
+        assignment that already exists) is rolled back to its savepoint and reported; the other
+        items still apply. Items are written in key order, so two bulk requests over the same
+        members insert their rows in the same order and cannot deadlock on each other.
+        """
+        outcomes: list[AssignmentOutcome] = []
+        async with self._db.transaction() as session:
+            snapshot = await self._authz.snapshot(session, org_id, principal.user_id)
+            for request in sorted(requests, key=_lock_order):
+                try:
+                    async with session.begin_nested():
+                        assignment = await self._add_assignment(
+                            session, principal, org_id, request, snapshot
+                        )
+                except DomainError as error:
+                    outcomes.append(AssignmentOutcome(request, error=error))
+                else:
+                    outcomes.append(AssignmentOutcome(request, assignment=assignment))
+        return outcomes
+
+    async def _add_assignment(
+        self,
+        session: AsyncSession,
+        principal: Principal,
+        org_id: uuid.UUID,
+        request: AssignmentRequest,
+        snapshot: PolicySnapshot,
+    ) -> RoleAssignment:
+        membership = await MembershipRepository(session).get(org_id, request.user_id)
+        if membership is None:
+            raise NotFoundError("member")
+        role = await RoleRepository(session).get(org_id, request.role_id)
+        if role is None:
+            raise NotFoundError("role")
+        if request.project_id is not None and not await ProjectRepository(session).exists(
+            org_id, request.project_id
+        ):
+            raise NotFoundError("project")
+        ensure_can_grant(snapshot, org_id, role.id, action="grant")
+        assignment = await RoleAssignmentRepository(session).add(
+            org_id=org_id,
+            user_id=request.user_id,
+            role_id=role.id,
+            project_id=request.project_id,
+            created_by=principal.user_id,
+            now=self._clock.now(),
+        )
+        await self._audit.record(
+            session,
+            Actor.of(principal),
+            org_id=org_id,
+            action=AuditAction.ROLE_ASSIGNED,
+            target_type="role_assignment",
+            target_id=assignment.id,
+            data={
+                "user_id": request.user_id,
+                "role_id": role.id,
+                "project_id": request.project_id,
+            },
+        )
