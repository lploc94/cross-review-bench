@@ -0,0 +1,138 @@
+package proxy
+
+import (
+	"bufio"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/relaywork/gateway/internal/auth"
+	"github.com/relaywork/gateway/internal/model"
+)
+
+// limitRoute accepts uploads of at most 16 bytes; retries are off unless a test turns them on.
+const limitRoute = `{"routes":[{"id":"upload","path_prefix":"/upload",
+  "upstreams":[{"url":"http://up.test"}],"max_request_bytes":16%s}]}`
+
+// chunkedRequest is a request whose length is not declared, as a chunked body arrives.
+func chunkedRequest(method, target, body string) *http.Request {
+	r := httptest.NewRequest(method, target, strings.NewReader(body))
+	r.ContentLength = -1
+	return r
+}
+
+func TestDeclaredOversizeIsRefusedBeforeTheUpstream(t *testing.T) {
+	f := newFixture(t, strings.Replace(limitRoute, "%s", "", 1), fixtureOptions{})
+	w := f.do(httptest.NewRequest(http.MethodPost, "/upload/a", strings.NewReader(strings.Repeat("x", 17))))
+	if w.Code != http.StatusRequestEntityTooLarge || !strings.Contains(w.Body.String(), `"body_too_large"`) {
+		t.Fatalf("status %d, body %s; want 413 body_too_large", w.Code, w.Body.String())
+	}
+}
+
+func TestStreamedOversizeIsCutOffWithoutRetry(t *testing.T) {
+	tr := statusTransport(200)
+	routes := strings.Replace(limitRoute, "%s", `,"retry":{"attempts":3,"non_idempotent":true}`, 1)
+	f := newFixture(t, routes, fixtureOptions{transport: tr})
+	w := f.do(chunkedRequest(http.MethodPost, "/upload/a", strings.Repeat("x", 17)))
+	if w.Code != http.StatusRequestEntityTooLarge || !strings.Contains(w.Body.String(), `"body_too_large"`) {
+		t.Fatalf("status %d, body %s; want 413 body_too_large", w.Code, w.Body.String())
+	}
+	if n := len(tr.sent()); n != 1 {
+		t.Fatalf("the upstream saw %d attempts; a cut-off body is not retried", n)
+	}
+}
+
+func TestChunkedBodyAtTheLimitPasses(t *testing.T) {
+	tr := statusTransport(200)
+	f := newFixture(t, strings.Replace(limitRoute, "%s", "", 1), fixtureOptions{transport: tr})
+	w := f.do(chunkedRequest(http.MethodPost, "/upload/a", strings.Repeat("y", 16)))
+	if w.Code != http.StatusOK {
+		t.Fatalf("status %d; want 200", w.Code)
+	}
+	if got := tr.sent(); len(got) != 1 || got[0].body != strings.Repeat("y", 16) {
+		t.Fatalf("upstream got %+v; want the 16-byte body once", got)
+	}
+}
+
+func TestRouteLimitMustNotBeNegative(t *testing.T) {
+	_, err := tryFixture(t, `{"routes":[{"id":"u","path_prefix":"/u",
+	  "upstreams":[{"url":"http://up.test"}],"max_request_bytes":-1}]}`, fixtureOptions{})
+	if err == nil || !strings.Contains(err.Error(), "max_request_bytes") {
+		t.Fatalf("error %v; want one naming max_request_bytes", err)
+	}
+}
+
+// TestBufferLimitMessageNamesTheLimit: an authenticated route buffers the body in memory, so a body
+// over BODY_BUFFER_LIMIT is refused with the limit that applied named, even when the route's own
+// max_request_bytes is larger.
+func TestBufferLimitMessageNamesTheLimit(t *testing.T) {
+	routes := `{"routes":[{"id":"s","path_prefix":"/s","upstreams":[{"url":"http://up.test"}],
+	  "auth":"hmac","max_request_bytes":1000}]}`
+	signer := &fakeAuth{needsBody: true, consumer: model.Consumer{ID: "c_0123456789abcdef"}}
+	f := newFixture(t, routes, fixtureOptions{auth: auth.Modes{"hmac": signer}, bodyLimit: 100})
+	w := f.do(chunkedRequest(http.MethodPost, "/s/x", strings.Repeat("b", 500)))
+	body := w.Body.String()
+	if w.Code != http.StatusRequestEntityTooLarge || !strings.Contains(body, "BODY_BUFFER_LIMIT") ||
+		!strings.Contains(body, "max_request_bytes is 1000") {
+		t.Fatalf("status %d, body %s; want 413 naming BODY_BUFFER_LIMIT and the route's max_request_bytes", w.Code, body)
+	}
+}
+
+// TestEarlyAnswerCannotHideAnOversizeBody: an upstream that answers at once, without reading a
+// chunked body that is sent in full, must not get its 200 relayed when that body exceeds the
+// route's limit; the body is counted while it is sent, so the answer is 413 every time.
+func TestEarlyAnswerCannotHideAnOversizeBody(t *testing.T) {
+	up := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+	}))
+	t.Cleanup(up.Close)
+	f := newFixture(t, `{"routes":[{"id":"u","path_prefix":"/u","upstreams":[{"url":"`+up.URL+`"}],"max_request_bytes":16}]}`,
+		fixtureOptions{transport: &http.Transport{}})
+	for i := range 20 {
+		w := f.do(chunkedRequest(http.MethodPost, "/u/x", strings.Repeat("e", 500)))
+		if w.Code != http.StatusRequestEntityTooLarge {
+			t.Fatalf("attempt %d: status %d; want 413", i, w.Code)
+		}
+	}
+}
+
+// TestStalledClientGetsTheEarlyAnswer: an upstream that answers 200 and closes the connection
+// without reading a chunked body is relayed while the client has sent only part of it and
+// stalls; the gateway runs as a real server, which cannot write the answer while a read of the
+// body waits on the client.
+func TestStalledClientGetsTheEarlyAnswer(t *testing.T) {
+	up := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Connection", "close")
+		_, _ = io.WriteString(w, "bye")
+	}))
+	t.Cleanup(up.Close)
+	f := newFixture(t, `{"routes":[{"id":"u","path_prefix":"/u","upstreams":[{"url":"`+up.URL+`"}],"max_request_bytes":16,"timeout":"10s"}]}`,
+		fixtureOptions{transport: &http.Transport{}})
+	gw := httptest.NewServer(f.h)
+	t.Cleanup(gw.Close)
+	conn, err := net.Dial("tcp", gw.Listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	// Three bytes of a chunked body, and then nothing more.
+	if _, err := io.WriteString(conn, "POST /u/x HTTP/1.1\r\nHost: gw\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n"); err != nil {
+		t.Fatal(err)
+	}
+	if err := conn.SetReadDeadline(time.Now().Add(5 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	resp, err := http.ReadResponse(bufio.NewReader(conn), nil)
+	if err != nil {
+		t.Fatalf("no answer while the client stalls: %v", err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil || resp.StatusCode != http.StatusOK || string(body) != "bye" {
+		t.Fatalf("status %d, body %q, error %v; want the upstream's 200 \"bye\"", resp.StatusCode, body, err)
+	}
+}
