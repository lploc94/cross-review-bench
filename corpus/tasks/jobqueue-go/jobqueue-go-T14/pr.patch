+func TestPoolQueueConcurrencyOverridesDefault(t *testing.T) {
+	queues := []string{"a", "b", "c"}
+	want := map[string]int{"a": 1, "b": 3, "c": 2}
+	started := make(chan string, 10)
+	release := make(chan struct{})
+	var jobs []domain.Job
+	for _, q := range queues {
+		for range want[q] {
+			jobs = append(jobs, domain.Job{ID: int64(len(jobs) + 1), Queue: q, Type: "block"})
+		}
+	}
+	st := newFakeStore(jobs...)
+	h := newHarness(t, st, registry(map[string]worker.HandlerFunc{
+		"block": func(ctx context.Context, _ domain.Job) error {
+			started <- worker.WorkerID(ctx)
+			<-release
+			return nil
+		},
+	}), func(o *worker.Options) {
+		o.Queues = queues
+		o.Concurrency = 2
+		o.QueueConcurrency = map[string]int{"a": 1, "b": 3}
+	})
+	// Handlers are released before the pool is stopped, even when a Fatalf below ends the test.
+	var releaseOnce sync.Once
+	releaseHandlers := func() { releaseOnce.Do(func() { close(release) }) }
+	defer releaseHandlers()
+	h.start(t, context.Background())
+
+	var ids []string
+	for range len(jobs) {
+		select {
+		case id := <-started:
+			ids = append(ids, id)
+		case <-time.After(10 * time.Second):
+			t.Fatalf("only %v started within 10s", ids)
+		}
+	}
+	releaseHandlers()
+	slices.Sort(ids)
+	if got := strings.Join(ids, " "); got != "test/a/0 test/b/0 test/b/1 test/b/2 test/c/0 test/c/1" {
+		t.Errorf("workers that ran a job at once = %s", got)
+	}
+	for range len(jobs) {
+		h.next(t)
+	}
+
+	var buf strings.Builder
+	_ = h.metrics.WriteText(&buf)
+	for q, n := range want {
+		if line := fmt.Sprintf(`jobqueue_workers{queue="%s"} %d`, q, n); !strings.Contains(buf.String(), line) {
+			t.Errorf("metrics lack %s:\n%s", line, buf.String())
+		}
+	}
+}
