+        assertEquals("resp_test_123", md.get(OpenAIOfficialConstants.MD_RESPONSE_ID));
+        assertEquals(1697000000.5, (Double) md.get(OpenAIOfficialConstants.MD_RESPONSE_CREATED_AT));
