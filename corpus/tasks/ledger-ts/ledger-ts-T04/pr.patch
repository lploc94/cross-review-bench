+/**
+ * An account's entries with start <= created_at < end, oldest first (the order a statement lists
+ * them in), at most `limit` of them.
+ */
+export async function listEntriesInPeriod(
+  db: Queryable,
+  tenantId: string,
+  accountId: string,
+  period: { start: Date; end: Date; limit: number },
+): Promise<Entry[]> {
+  const result = await db.query<EntryRow>(
+    `SELECT ${COLUMNS} FROM entries
+     WHERE tenant_id = $1 AND account_id = $2 AND created_at >= $3 AND created_at < $4
+     ORDER BY created_at ASC, id ASC
+     LIMIT $5`,
+    [tenantId, accountId, period.start, period.end, period.limit],
+  );
+  return result.rows.map(mapEntry);
+}
