+    String source =
+        "package org.apache.fory.serializer.dynamic;"
+            + " public class CompatibleHolder {"
+            + " public Object aValue;"
+            + " public Widget zWidget;"
+            + (senderOnly ? " public int senderOnly;" : "")
+            + " public static class Widget { public String name; }"
