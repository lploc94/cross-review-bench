+-- Files with identical bytes share one storage object: an upload whose sha256 and size match an
+-- available file is recorded with that file's storage key, and its own copy is removed. A storage
+-- key may therefore appear on several rows.
+DROP INDEX files_storage_key;
+CREATE INDEX files_storage_key ON files (storage_key);
+
+-- Finds the available file an upload can share its object with.
+CREATE INDEX files_available_sha256 ON files (sha256) WHERE status = 'available';
