+@router.post(
+    "/orgs/{org_id}/role-assignments:bulk",
+    response_model=ListResponse[BulkAssignmentResult],
+)
+async def bulk_create_role_assignments(
+    body: RoleAssignmentBulkCreate, auth: CanManageMembers, container: ContainerDep
+) -> ListResponse[BulkAssignmentResult]:
+    """Create several role assignments; each item succeeds or fails on its own.
+
+    The answer is 200 with one result per item, in the order of `items`, even when some failed.
+    """
+    outcomes = await container.members.assign_many(
